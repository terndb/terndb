// TernDB, a relational database written in sysl.
//
// The module is `sh.sysl.terndb`. What is here so far is the result codec: the query-tree type
// model, its canonical encoding (`docs/spec/query-tree.md` §12.3), and the columnar result format
// the wire and the C ABI share (`docs/spec/wire-protocol.md` §6); and value semantics: equality,
// the total order and the canonical text forms (`docs/spec/query-tree.md` §3); and the query tree
// itself: its nodes, their canonical encoding, the structural checks and the shape digest
// (`docs/spec/query-tree.md` §5–§12); and the native wire protocol's framing and messages: the preface,
// frames, fragmentation and reassembly, every message of its catalogue and parameter blocks
// (`docs/spec/wire-protocol.md` §1–§4, §8.1, `docs/spec/replication.md` §2–§5); and the session state
// machines of both ends, with the engine behind the server as an `Executor` (§2, §4.3–§4.6, §5, §7);
// and the core of the vectorised executor: column vectors, expression kernels and the operators that
// need no storage (`docs/design/executor.md`).

package {
  name    = "terndb"
  version = "0.0.1"
  sysl    = "0.11.0"
}

// `docs/` holds the specifications and the survey's standalone probe programs, none of them part of
// the package.
exclude = ["docs"]

// A result's size is not known until it is built or read, so buffers grow on the heap. Nothing here
// opens a file or a socket: bytes come from the caller and go back to it.
requires {
  heap = true
}
