module sh.sysl.terndb

import sysl.buf.{Buf, buf}

// Joins (`query-tree.md` §6.5, `docs/design/executor.md` §4.1).
//
// A join exposes several binders, so its batch is a **composite**: a record with one member per
// exposed binder, named after it and holding that binder's rows, handed up under the binder name
// `Composite`. An expression above the join finds each binder among the members (`Env.binder`); what
// a client sees is the flat record of every binder's columns (§8.4), which `flatten` makes.

/** The binder name of a composite batch. No binder of a tree has it, since a binder is never empty
 * (§8.2 rule 2).
 */
const Composite: string = ""

// -- what an input exposes ------------------------------------------------------------------------

/** The binders `l` exposes, in order, each with the type of its rows. */
private[terndb] exposed(l: Lowered) -> Buf[Field] =
    if l.binder == Composite then fields_of_type(l.elem) else items_of([Field(l.binder, l.elem)])

/** The rows of each binder in a batch `v` of an input exposing `binder`, in the order `exposed`
 * names them.
 */
private[terndb] parts_of(binder: string, v: ColumnVector) -> Buf[ColumnVector]
    if binder != Composite then return items_of([v])

    v.lanes match
        Members(cs) -> cs
        _ -> panic("parts_of: a composite batch is a record")

/** `fs` appended to `out`, each nullable when `outer`: the binders of an outer join's null-supplying
 * side (§6.5 rule 3).
 */
private side_fields(fs: Buf[Field], outer: bool, out: Buf[Field])
    for f in fs
        out.push(Field(f.name, if outer then nullable(f.ty) else f.ty))

private names_of(fs: Buf[Field]) -> Buf[string]
    val out = buf[string]()

    for f in fs
        out.push(f.name)

    out

// -- the flat output ------------------------------------------------------------------------------

/** A composite batch as the flat record of its binders' columns, binder by binder (§8.4): a record
 * binder's fields, a union binder's shared columns (§2.4 rule 4), a scalar binder's `value`, each
 * nullable when the binder's rows are.
 */
private[terndb] flatten(v: ColumnVector) -> ColumnVector
    val bs = fields_of_type(v.ty)
    val fs = buf[Field]()
    val cs = buf[ColumnVector]()

    for j in 0..<bs.len()
        val b = bs[j]

        for f in element_columns(b.ty.base())
            val ty = if b.ty.is_nullable() then nullable(f.ty) else f.ty
            fs.push(Field(f.name, ty))
            cs.push(column(v.member(j), f.name, ty))

    ColumnVector(Record(fs), v.len, buf[u8](), Members(cs))

/** The batches of a composite input, flattened. */
struct FlatOp
    input: &Operator

impl Operator for FlatOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError] = self.input.next_batch()? match
        Some(b) -> Ok(Some(flatten(b)))
        None -> Ok(None)

/** `l`'s operator, its batches flattened when they are composites: what a consumer of the output's
 * columns, rather than of its binders, reads.
 */
private[terndb] flat_input(l: Lowered) -> &Operator = if l.binder == Composite then FlatOp(l.op) else l.op

/** `Distinct` (§6.11) over a composite input: the rows are compared by their flat columns, which is
 * what `same` of two output rows means, and handed up as composites for the binders above.
 */
struct CompositeDistinctOp
    input: &Operator
    elem: Type
    out: Option[&Operator]

impl Operator for CompositeDistinctOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if self.out.is_none()
            val all = drain_rows(self.input, self.elem)?
            val flat = flatten(all)
            val orders = buf[KeyOrder]()

            for j in 0..<fields_of_type(flat.ty).len()
                orders.push(key_order(flat.member(j), false, true))

            val rows = sorted_rows(orders, all.len)
            val kept = buf[usize]()

            for k in 0..<rows.len()
                if k == 0 || compare_rows(orders, rows[k - 1], rows[k]) != 0 then kept.push(rows[k])

            self.out = Some(mem_source(batches_of(take(all, kept.view()))))

        self.out.unwrap().next_batch()

// -- planning -------------------------------------------------------------------------------------

/** A conjunct `eq(a, b)` or `same(a, b)` of a join's `on`, `a` reading only the left input's binders
 * and `b` only the right's: a key a hash join hashes and matches both sides by, at their common type
 * `ty`. Under `eq` a key holding a null anywhere matches nothing (§3.2); under `same` (`nulls_match`)
 * it matches the keys it is `same` as (§3.1).
 */
private struct EquiKey
    left: TExpr
    right: TExpr
    ty: Type
    nulls_match: bool

/** The binders `x` reads. */
private binders_in(x: TExpr, out: Buf[string])
    x.e match
        Col(b, _) | Row(b) -> out.push(b)
        _ -> ()

    for k in x.kids
        binders_in(k, out)

/** Whether `x` reads at least one binder and none but `names`. */
private reads_only(x: TExpr, names: Buf[string]) -> bool
    val bs = buf[string]()
    binders_in(x, bs)

    for b in bs
        var known = false

        for n in names
            if n == b then known = true

        if !known then return false

    bs.len() > 0

/** Whether `x` reads no binder but `names`, or is a literal or a parameter, one value for every row. */
private reads_within(x: TExpr, names: Buf[string]) -> bool
    x.e match
        Literal(_, _) | Param(_) | Null(_) -> true
        _ -> reads_only(x, names)

/** `x`'s conjuncts, through every `and`, sorted into equi-keys between `left` and `right` and the
 * rest.
 */
private split_on(x: TExpr, left: Buf[string], right: Buf[string], keys: Buf[EquiKey], rest: Buf[TExpr])
    x.e match
        Call(f, _) ->
            if f == "and"
                split_on(x.kids[0], left, right, keys, rest)
                split_on(x.kids[1], left, right, keys, rest)
                return

            if f == "eq" || f == "same"
                val (a, b) = (x.kids[0], x.kids[1])
                val t = common_type(a.ty, b.ty).unwrap()

                // One side may read no binder at all (a constant, or a parameter), which is the same
                // value on every row of either side: `same(true, d.k)`, joining an uncorrelated
                // subquery back to its one-row domain, is such a key.
                if reads_within(a, left) && reads_within(b, right) && (reads_only(a, left) || reads_only(b, right))
                    keys.push(EquiKey(a, b, t, f == "same"))
                    return

                if reads_within(b, left) && reads_within(a, right) && (reads_only(b, left) || reads_only(a, right))
                    keys.push(EquiKey(b, a, t, f == "same"))
                    return
        _ -> ()

    rest.push(x)
end split_on

/** What a join operator is given: its kind, each input's binder and row type, the type of a pair
 * of rows as `on` sees them (§8.3) and of an output batch, `on` and its split into equi-keys and the
 * conjuncts left over, and the execution's context.
 */
private struct JoinSpec
    kind: JoinKind
    lbinder: string
    lelem: Type
    rbinder: string
    relem: Type
    pair_ty: Type
    out_ty: Type
    on: Option[TExpr]
    keys: Buf[EquiKey]
    conds: Buf[TExpr]
    nullable_on: bool
    ctx: Ctx

/** The operator of a `Join` (§6.5) of `kind` over `l` and `r`, with its typed `on`, and for a mark
 * join its `mark` column under `binder`. When `on` has a conjunct equating the two sides it is a
 * hash join on every such conjunct, with the rest of `on` tested on the pairs the keys match;
 * otherwise, or when `keyed` is false, a block nested-loop join testing `on` on every pair.
 */
private[terndb] plan_join(kind: JoinKind, l: Lowered, r: Lowered, on: Option[TExpr], mark: Option[string], binder: Option[string], ctx: Ctx, keyed: bool) -> Lowered
    val lfs = exposed(l)
    val rfs = exposed(r)
    val pair = buf[Field]()
    side_fields(lfs, false, pair)
    side_fields(rfs, false, pair)

    val keys = buf[EquiKey]()
    val rest = buf[TExpr]()

    if keyed
        on match
            Some(x) -> split_on(x, names_of(lfs), names_of(rfs), keys, rest)
            None -> ()

    // A hash join tests what the keys leave of `on`; a nested loop tests `on` itself.
    val conds = on match
        Some(x) -> if keys.len() > 0 then rest else items_of([x])
        None -> buf[TExpr]()

    val nullable_on = on.map(x -> x.ty.is_nullable()).unwrap_or(false)
    val out = buf[Field]()

    val (out_binder, out_ty) = kind match
        Semi | Anti -> (l.binder, l.elem)
        MarkJoin ->
            side_fields(lfs, false, out)
            out.push(Field(binder.unwrap(), record([Field(mark.unwrap(), if nullable_on then nullable(Bool) else Bool)])))
            (Composite, Record(out))
        _ ->
            side_fields(lfs, kind == Right || kind == Full, out)
            side_fields(rfs, kind == Left || kind == Full || kind == SingleJoin, out)
            (Composite, Record(out))

    val spec = JoinSpec(kind, l.binder, l.elem, r.binder, r.elem, Record(pair), out_ty, on, keys, conds, nullable_on, ctx)
    Lowered(join_op(spec, l.op, r.op), out_binder, out_ty, buf[TKey]())
end plan_join

// -- the operator ---------------------------------------------------------------------------------

/** The keys of some rows of one side: each key's vector at the key's common type and the hash of
 * each of its slots (`hash_column`), and per row whether an `eq` key holds a null at any depth, and
 * which: bit `e` of its mask for the `e`-th `eq` key, the first 64 of them.
 */
private struct SideKeys
    vecs: Buf[ColumnVector]
    hashes: Buf[Buf[u64]]
    masks: Buf[u64]
    nulls: Buf[bool]

private no_side_keys() -> SideKeys = SideKeys(buf[ColumnVector](), buf[Buf[u64]](), buf[u64](), buf[bool]())

/** The hash of row `i`'s keys `keys`, in that order, masked by `h.mask`. */
private row_hash(h: KeyHash, s: SideKeys, keys: Buf[usize], i: usize) -> u64
    var acc: u64 = 0

    for k in keys
        acc = combine(h, acc, s.hashes[k][i])

    acc & h.mask

/** Whether row `i` of `a` and row `j` of `b` are `same` (§3.1) on each key of `keys`. */
private keys_same(keys: Buf[usize], a: SideKeys, i: usize, b: SideKeys, j: usize) -> bool
    for k in keys
        if !same_slots(a.vecs[k], i, b.vecs[k], j) then return false

    true

/** A hash table of some rows of one side by the keys `keys`. The rows fall into groups of rows that
 * are `same` on those keys; group `g`'s rows are `members[starts[g]..<starts[g + 1]]`, in the order
 * they came, and `ghash[g]` and `first[g]` are its hash and its first row. `slots` is open addressing
 * by linear probing, each slot empty (0) or one more than a group, with at least twice as many slots
 * as rows.
 */
private struct KeyTable
    keys: Buf[usize]
    slots: Buf[u32]
    ghash: Buf[u64]
    first: Buf[usize]
    starts: Buf[usize]
    members: Buf[usize]

    /** The group of the table's rows, whose keys are `side`'s, that row `i` of `s` is `same` as on
     * the table's keys: one more than its index, or 0 when there is none. Keys are compared only
     * where the hashes agree, and compared all the same, since unequal keys may hash alike.
     */
    find(self, h: KeyHash, side: SideKeys, s: SideKeys, i: usize, work: &Work) -> usize
        work.probed += 1
        val hv = row_hash(h, s, self.keys, i)
        val m = self.slots.len() - 1
        var at = usize.wrap(hv) & m

        loop
            val g = usize(self.slots[at])

            if g == 0 then return 0

            if self.ghash[g - 1] == hv
                work.compared += 1

                if keys_same(self.keys, side, self.first[g - 1], s, i) then return g

            at = (at + 1) & m
    end find
end KeyTable

private empty_table() -> KeyTable = KeyTable(buf[usize](), buf[u32](), buf[u64](), buf[usize](), buf[usize](), buf[usize]())

/** The table of rows `rows` of `side` by the keys `keys`. */
private build_table(h: KeyHash, side: SideKeys, keys: Buf[usize], rows: Buf[usize], work: &Work) -> KeyTable
    work.built += u64(rows.len())
    var cap: usize = 8

    while cap < 2 * rows.len()
        cap = 2 * cap

    val slots = buf[u32]()

    for _ in 0..<cap
        slots.push(0)

    val m = cap - 1
    val ghash = buf[u64]()
    val first = buf[usize]()
    val group_of = buf[usize]()

    for r in rows
        val hv = row_hash(h, side, keys, r)
        var at = usize.wrap(hv) & m
        var placed = false

        while !placed
            val g = usize(slots[at])

            if g == 0
                first.push(r)
                ghash.push(hv)
                slots[at] = u32.wrap(first.len())
                group_of.push(first.len() - 1)
                placed = true
            elif ghash[g - 1] == hv && keys_same(keys, side, first[g - 1], side, r)
                work.compared += 1
                group_of.push(g - 1)
                placed = true
            else
                if ghash[g - 1] == hv then work.compared += 1

                at = (at + 1) & m

    // Each group's rows together, by a counting sort on the group.
    val ng = first.len()
    val starts = buf[usize]()

    for _ in 0..<ng + 1
        starts.push(0)

    for g in group_of
        starts[g + 1] += 1

    for g in 0..<ng
        starts[g + 1] += starts[g]

    val fill = buf[usize]()
    val members = buf[usize]()

    for g in 0..<ng
        fill.push(starts[g])

    for _ in rows
        members.push(0)

    for k in 0..<rows.len()
        val g = group_of[k]
        members[fill[g]] = rows[k]
        fill[g] += 1

    KeyTable(keys, slots, ghash, first, starts, members)
end build_table

/** The right rows whose `eq` keys holding a null are `mask`'s: a mark join's runs of right rows for
 * deciding a null mark (all of them under mask 0 when there are more than 64 `eq` keys).
 */
private struct MaskRun
    mask: u64
    rows: Buf[usize]

/** Run `run`'s rows by the `same` keys and the `eq` keys neither they nor a left row hold a null in,
 * `both` being the two rows' masks together: where a left row of that mask looks up the right rows
 * that could make `on` null for it.
 */
private struct MaskTable
    run: usize
    both: u64
    table: KeyTable

private join_op(spec: JoinSpec, left: &Operator, right: &Operator) -> &Operator =
    JoinOp(spec, left, right, false, false, false, buf[ColumnVector](), 0, empty_vector(spec.lelem), buf[ColumnVector](), no_side_keys(),
        false, 0, 0, buf[u8](), buf[bool](), empty_vector(spec.relem), buf[ColumnVector](), no_side_keys(), buf[bool](), false, false,
        empty_table(), buf[usize](), buf[MaskRun](), buf[MaskTable](), buf[ColumnVector](), 0, 0)

private all_keys(n: usize) -> Buf[usize]
    val out = buf[usize]()

    for k in 0..<n
        out.push(k)

    out

/** The rows `nulls` does not mark. */
private unmarked(nulls: Buf[bool]) -> Buf[usize]
    val out = buf[usize]()

    for i in 0..<nulls.len()
        if !nulls[i] then out.push(i)

    out

private zeros(n: usize) -> Buf[u64]
    val out = buf[u64]()

    for _ in 0..<n
        out.push(0)

    out

private falses(n: usize) -> Buf[bool]
    val out = buf[bool]()

    for _ in 0..<n
        out.push(false)

    out

/** Whether `v` holds a null at any depth of its records and unions. */
private holds_null(v: Value) -> bool = v match
    Null -> true
    Record(fs) ->
        for f in fs
            if holds_null(f) then return true

        false
    Variant(_, p) -> holds_null(*p)
    _ -> false

/** The keys of `rows`, rows of the left side when `left` and of the right otherwise: each key's
 * expression for that side evaluated over them and coerced to the key's type, then hashed.
 */
private side_keys(spec: JoinSpec, left: bool, rows: ColumnVector) -> Result[SideKeys, CodecError]
    val env = env_of(spec.ctx, if left then spec.lbinder else spec.rbinder, rows)
    val h = spec.ctx.work.hash
    val n = rows.len
    val vecs = buf[ColumnVector]()
    val hashes = buf[Buf[u64]]()
    val masks = zeros(n)
    val nulls = falses(n)
    var e: usize = 0

    for k in spec.keys
        val v = coerce_vector(eval(if left then k.left else k.right, env)?, k.ty)?.as_type(k.ty)
        vecs.push(v)
        hashes.push(hash_column(h, v))

        if !k.nulls_match
            val bit: u64 = if e < 64 then u64(1) << u64(e) else 0
            e += 1

            for i in 0..<n
                if !v.is_valid(i) || (!is_scalar_type(k.ty) && holds_null(value_at(v, i)))
                    nulls[i] = true
                    masks[i] = masks[i] | bit

    Ok(SideKeys(vecs, hashes, masks, nulls))
end side_keys

/** A join. The right input is read whole on the first call. A nested-loop join then takes the left
 * input a batch at a time and considers every pair of that batch's rows with the right rows. A hash
 * join builds a table on the smaller side by its keys: on the right rows, probed by each left batch
 * as it arrives, or, when the left input ends with fewer rows than the right, on the left rows,
 * probed by each right row. Either way it considers only the pairs whose keys are `same`. The pairs
 * are considered `BatchSize` at a time, a left row is finished (null-extended, kept, dropped or
 * marked) once all its pairs have been, and the right rows no pair matched are null-extended at the
 * end. The output is cut into batches of `BatchSize`.
 */
private struct JoinOp
    spec: JoinSpec
    left: &Operator
    right: &Operator
    started: bool
    left_done: bool
    done: bool
    // left batches read ahead while choosing the side to build on, not yet in play
    ahead: Buf[ColumnVector]
    ahead_at: usize
    // the left rows in play, their keys, and how far their pairs have been considered
    rows: ColumnVector
    lparts: Buf[ColumnVector]
    lkeys: SideKeys
    live: bool
    cursor: usize
    offset: usize
    hits: Buf[u8]
    unknown: Buf[bool]
    // every right row, its keys, and whether some pair has matched it
    rights: ColumnVector
    rparts: Buf[ColumnVector]
    rkeys: SideKeys
    rhit: Buf[bool]
    // a hash join's table, once both sides have a row: of the right rows, probed by the left rows in
    // play, or (`build_left`) of the left rows, probed by the right rows; `found` holds each probing
    // row's group as `KeyTable.find` answers it
    hashed: bool
    build_left: bool
    table: KeyTable
    found: Buf[usize]
    // for a mark's null: the right rows by mask, and the tables built on them so far
    runs: Buf[MaskRun]
    mtables: Buf[MaskTable]
    // the output not yet handed up
    out: Buf[ColumnVector]
    out_at: usize
    out_count: usize

    private keyed(self) -> bool = self.spec.keys.len() > 0

    /** A semi, anti or mark join whose `on` is all keys needs no pair: a left row whose keys are a
     * right row's has a right row making `on` `true`, and that is all these joins ask.
     */
    private keys_alone(self) -> bool
        val k = self.spec.kind
        (k == Semi || k == Anti || k == MarkJoin) && self.spec.conds.len() == 0

    /** Reads the right input whole, and for a hash join builds its table. */
    private start(*self) -> Result[unit, CodecError]
        self.started = true
        self.rights = drain_rows(self.right, self.spec.relem)?
        self.rparts = parts_of(self.spec.rbinder, self.rights)
        self.rhit = falses(self.rights.len)
        // With no left batch at all, the null-extended right rows still need the left binders' shape.
        self.lparts = parts_of(self.spec.lbinder, self.rows)
        val nr = self.rights.len

        // An inner or semi join with no right row has no output, so its left input is never read: a
        // decorrelated `Apply` relies on it to leave its right input unevaluated over an empty outer
        // side (`plan_unnest.sysl`, §6.6 rule 4).
        if nr == 0 && (self.spec.kind == Inner || self.spec.kind == Semi)
            self.left_done = true
            return Ok(())

        // With no right row there is no table: every left row streams through unmatched.
        if !self.keyed() || nr == 0 then return Ok(())

        // The table goes on the smaller side. The left input is read ahead until it has as many rows
        // as the right, which is then the side built on; a left input ending sooner is built on.
        var nl: usize = 0
        var more = true

        while more && nl < nr
            self.left.next_batch()? match
                Some(b) ->
                    self.ahead.push(b)
                    nl += b.len
                None ->
                    self.left_done = true
                    more = false

        // A key is evaluated only when the other side has a row, as a nested loop would (§6.5 rule 8).
        if nl == 0 then return Ok(())

        self.rkeys = side_keys(self.spec, false, self.rights)?
        self.hashed = true

        if self.left_done && nl < nr
            self.build_left = true
            val all = concat(self.spec.lelem, self.ahead.view())
            self.ahead = buf[ColumnVector]()
            return self.open(all)

        self.table = build_table(self.spec.ctx.work.hash, self.rkeys, all_keys(self.spec.keys.len()), unmarked(self.rkeys.nulls), self.spec.ctx.work)
        Ok(())
    end start

    /** Puts `b` in play as the left rows, and for a hash join looks the probing rows up: `b`'s, or
     * when the table is to be of `b` (all the left rows), the right rows'.
     */
    private open(*self, b: ColumnVector) -> Result[unit, CodecError]
        self.rows = b
        self.lparts = parts_of(self.spec.lbinder, b)
        self.live = true
        self.cursor = 0
        self.offset = 0
        self.hits = buf[u8]()
        self.unknown = falses(b.len)

        for _ in 0..<b.len
            self.hits.push(0)

        if !self.hashed then return Ok(())

        val work = self.spec.ctx.work
        val h = work.hash
        self.lkeys = side_keys(self.spec, true, b)?
        val found = buf[usize]()

        if self.build_left
            self.table = build_table(h, self.lkeys, all_keys(self.spec.keys.len()), unmarked(self.lkeys.nulls), work)

            for j in 0..<self.rights.len
                found.push(if self.rkeys.nulls[j] then 0 else self.table.find(h, self.lkeys, self.rkeys, j, work))
        else
            for i in 0..<b.len
                found.push(if self.lkeys.nulls[i] then 0 else self.table.find(h, self.rkeys, self.lkeys, i, work))

        self.found = found

        if self.keys_alone()
            if self.build_left
                // A group a right row found answers each of its left rows, once.
                val seen = falses(self.table.first.len())

                for g in found
                    if g > 0 && !seen[g - 1]
                        seen[g - 1] = true

                        for x in self.table.starts[g - 1]..<self.table.starts[g]
                            self.hits[self.table.members[x]] = 1
            else
                for i in 0..<b.len
                    if found[i] > 0 then self.hits[i] = 1

        Ok(())
    end open

    /** The next pairs to consider, at most `BatchSize` of them, as left and right row indices; none
     * once every pair of the left rows in play has been.
     */
    private next_pairs(*self) -> (Buf[usize], Buf[usize])
        val li = buf[usize]()
        val ri = buf[usize]()
        val nr = self.rights.len

        if !self.keyed()
            val total = self.rows.len * nr

            while self.cursor < total && li.len() < BatchSize
                li.push(self.cursor / nr)
                ri.push(self.cursor % nr)
                self.cursor += 1

            return (li, ri)

        if !self.hashed || self.keys_alone() then return (li, ri)

        // Each probing row with each row of the group it found, in turn.
        val t = self.table

        while self.cursor < self.found.len() && li.len() < BatchSize
            val g = self.found[self.cursor]

            if g > 0
                val end = t.starts[g]

                while t.starts[g - 1] + self.offset < end && li.len() < BatchSize
                    val m = t.members[t.starts[g - 1] + self.offset]

                    if self.build_left
                        li.push(m)
                        ri.push(self.cursor)
                    else
                        li.push(self.cursor)
                        ri.push(m)

                    self.offset += 1

                if t.starts[g - 1] + self.offset < end then return (li, ri)

            self.cursor += 1
            self.offset = 0

        (li, ri)
    end next_pairs

    /** Rows `li` of the left rows in play and `ri` of the right rows, paired, as `on` sees them. */
    private pairs(self, li: []const usize, ri: []const usize) -> ColumnVector
        val cs = buf[ColumnVector]()

        for p in self.lparts
            cs.push(take(p, li))

        for p in self.rparts
            cs.push(take(p, ri))

        ColumnVector(self.spec.pair_ty, li.len, buf[u8](), Members(cs)).as_type(self.spec.pair_ty)

    /** For each pair, whether every one of `conds` is `true` for it, and whether their conjunction is
     * null rather than `false` (§7.12, three-valued `and`).
     */
    private truth(self, conds: Buf[TExpr], li: []const usize, ri: []const usize) -> Result[(Buf[bool], Buf[bool]), CodecError]
        val n = li.len
        val yes = buf[bool]()
        val unknown = falses(n)
        val no = falses(n)

        for _ in 0..<n
            yes.push(true)

        if conds.len() == 0 then return Ok((yes, unknown))

        val env = env_of(self.spec.ctx, Composite, self.pairs(li, ri))

        for c in conds
            val v = eval(c, env)?
            val bs = v.lanes match
                Bools(x) -> x
                _ -> panic("JoinOp: `on` is not bool")

            for k in 0..<n
                if !v.is_valid(k)
                    yes[k] = false
                    unknown[k] = true
                elif !bs[k]
                    yes[k] = false
                    no[k] = true

        for k in 0..<n
            if no[k] then unknown[k] = false

        Ok((yes, unknown))
    end truth

    /** Tests the pairs `li`/`ri`: a pair `on` holds for counts as a match of both rows, and is output
     * by the joins that output pairs; a second match of a left row is `R0003` for `single` (§6.5 rule 6).
     */
    private consider(*self, li: Buf[usize], ri: Buf[usize]) -> Result[unit, CodecError]
        self.spec.ctx.work.pairs += u64(li.len())
        val (yes, unknown) = self.truth(self.spec.conds, li.view(), ri.view())?
        val pl = buf[usize]()
        val pr = buf[usize]()

        for k in 0..<li.len()
            val i = li[k]

            if yes[k]
                if self.hits[i] < 2 then self.hits[i] += 1
                if self.spec.kind == SingleJoin && self.hits[i] > 1 then
                    return fail("R0003", "a row of a single join's left input matches more than one right row")

                self.rhit[ri[k]] = true
                pl.push(i)
                pr.push(ri[k])
            elif unknown[k]
                self.unknown[i] = true

        self.spec.kind match
            Semi | Anti | MarkJoin -> ()
            _ -> self.emit(pl, pr, false, false)

        Ok(())
    end consider

    /** Finishes the left rows in play, all their pairs considered: a left, full or single join
     * null-extends the ones nothing matched, a semi join keeps the matched ones and an anti join the
     * others, and a mark join marks each (§6.5 rules 3–6).
     */
    private finish_block(*self) -> Result[unit, CodecError]
        val n = self.rows.len
        val kind = self.spec.kind
        val matched = buf[usize]()
        val unmatched = buf[usize]()

        for i in 0..<n
            if self.hits[i] > 0 then matched.push(i) else unmatched.push(i)

        kind match
            Left | Full | SingleJoin -> self.emit(unmatched, unmatched, false, true)
            Semi -> self.emit_left(matched)
            Anti -> self.emit_left(unmatched)
            MarkJoin ->
                if self.hashed && self.spec.nullable_on && self.rights.len > 0 then self.mark_unknowns(unmatched)?

                self.emit_marks()
            _ -> ()

        Ok(())

    /** For a hash join's unmatched left rows, whether `on` is null for some right row (§6.5 rule 5),
     * which the keys alone do not say. A pair can have `on` null only where its `same` keys agree
     * (`same` is never null), some `eq` key holds a null on one side, and every `eq` key holding none
     * on either side agrees: two non-null keys that differ make `on` `false`, and a pair whose keys all
     * agree was considered. So the right rows are grouped by which `eq` keys hold a null (their mask),
     * and a left row looks up, in each group, the rows agreeing with it on the `same` keys and on the
     * `eq` keys neither holds a null in, in a table of the group by those keys built once per pair of
     * masks. With scalar keys and nothing in `on` but keys, such a row decides the mark; otherwise
     * `on` is evaluated on the pairs found. The work is a lookup per row and mask, not a pair per
     * right row.
     */
    private mark_unknowns(*self, rows: Buf[usize]) -> Result[unit, CodecError]
        var scalar = true
        val same_keys = buf[usize]()
        val eq_keys = buf[usize]()

        for x in 0..<self.spec.keys.len()
            val k = self.spec.keys[x]

            if k.nulls_match
                same_keys.push(x)
            else
                eq_keys.push(x)

                if !is_scalar_type(k.ty) then scalar = false

        // With no `eq` key, every pair whose keys differ has `on` false, and the pairs whose keys agree
        // were all considered.
        if eq_keys.len() == 0 || rows.len() == 0 then return Ok(())

        // Beyond 64 `eq` keys a mask cannot say which hold a null: every pair agreeing on the `same`
        // keys is a candidate.
        val wide = eq_keys.len() > 64
        val exact = scalar && self.spec.conds.len() == 0 && !wide
        val work = self.spec.ctx.work
        val h = work.hash

        // The right rows by mask, once for every block of left rows.
        if self.runs.len() == 0
            for j in 0..<self.rights.len
                val m = if wide then 0 else self.rkeys.masks[j]
                var at = self.runs.len()

                for g in 0..<self.runs.len()
                    if self.runs[g].mask == m then at = g

                if at == self.runs.len() then self.runs.push(MaskRun(m, buf[usize]()))

                self.runs[at].rows.push(j)

        val on = items_of([self.spec.on.unwrap()])
        var li = buf[usize]()
        var ri = buf[usize]()

        for i in rows
            val ml = if wide then 0 else self.lkeys.masks[i]

            for g in 0..<self.runs.len()
                val u = ml | self.runs[g].mask

                if u == 0 && !wide then continue

                val t = self.mark_table(g, u, same_keys, eq_keys, wide)
                val found = t.find(h, self.rkeys, self.lkeys, i, work)

                if found == 0 then continue

                if exact
                    self.unknown[i] = true
                    break

                for x in t.starts[found - 1]..<t.starts[found]
                    li.push(i)
                    ri.push(t.members[x])

                    if li.len() == BatchSize
                        self.note_unknowns(on, li, ri)?
                        li = buf[usize]()
                        ri = buf[usize]()

        if li.len() > 0 then self.note_unknowns(on, li, ri)?

        Ok(())
    end mark_unknowns

    /** The table of run `g`'s right rows by the `same` keys and the `eq` keys whose bit `u` leaves
     * clear (the `same` keys alone when `wide`), built the first time it is asked for.
     */
    private mark_table(*self, g: usize, u: u64, same_keys: Buf[usize], eq_keys: Buf[usize], wide: bool) -> KeyTable
        for t in self.mtables
            if t.run == g && t.both == u then return t.table

        val keys = buf[usize]()
        keys.extend(same_keys.view())

        if !wide
            for e in 0..<eq_keys.len()
                if (u & (u64(1) << u64(e))) == 0 then keys.push(eq_keys[e])

        val t = build_table(self.spec.ctx.work.hash, self.rkeys, keys, self.runs[g].rows, self.spec.ctx.work)
        self.mtables.push(MaskTable(g, u, t))
        t

    private note_unknowns(*self, on: Buf[TExpr], li: Buf[usize], ri: Buf[usize]) -> Result[unit, CodecError]
        self.spec.ctx.work.pairs += u64(li.len())
        val (_, unknown) = self.truth(on, li.view(), ri.view())?

        for k in 0..<li.len()
            if unknown[k] then self.unknown[li[k]] = true

        Ok(())

    /** The right rows no pair matched, null-extended on the left, for a right or full join. */
    private finish_right(*self)
        if self.spec.kind != Right && self.spec.kind != Full then return

        val rows = buf[usize]()

        for j in 0..<self.rights.len
            if !self.rhit[j] then rows.push(j)

        self.emit(rows, rows, true, false)

    // -- output --------------------------------------------------------------------------------------

    private push(*self, v: ColumnVector)
        if v.len == 0 then return

        self.out.push(v)
        self.out_count += v.len

    /** The pairs `li`/`ri` as output rows, a side made null where it is `absent`, `BatchSize` at a
     * time.
     */
    private emit(*self, li: Buf[usize], ri: Buf[usize], left_absent: bool, right_absent: bool)
        var at: usize = 0

        while at < li.len()
            val end = if at + BatchSize < li.len() then at + BatchSize else li.len()
            val cs = buf[ColumnVector]()
            gather(self.lparts, li.view()[at..<end], left_absent, cs)
            gather(self.rparts, ri.view()[at..<end], right_absent, cs)
            self.push(ColumnVector(self.spec.out_ty, end - at, buf[u8](), Members(cs)).as_type(self.spec.out_ty))
            at = end

    /** Left rows `rows` as they are, for a semi or anti join. */
    private emit_left(*self, rows: Buf[usize])
        var at: usize = 0

        while at < rows.len()
            val end = if at + BatchSize < rows.len() then at + BatchSize else rows.len()
            self.push(take(self.rows, rows.view()[at..<end]).as_type(self.spec.out_ty))
            at = end

    /** Every left row in play with its mark: `true` if a pair matched it, else null if `on` was null
     * for one, else `false` (§6.5 rule 5).
     */
    private emit_marks(*self)
        val fs = fields_of_type(self.spec.out_ty)
        val mark_rec = fs[fs.len() - 1].ty
        val mark_ty = fields_of_type(mark_rec)[0].ty
        var at: usize = 0

        while at < self.rows.len
            val end = if at + BatchSize < self.rows.len then at + BatchSize else self.rows.len
            val rows = buf[usize]()
            val marks = buf[bool]()
            val valid = buf[bool]()

            for i in at..<end
                rows.push(i)
                marks.push(self.hits[i] > 0)
                valid.push(self.hits[i] > 0 || !self.unknown[i])

            val cs = buf[ColumnVector]()
            gather(self.lparts, rows.view(), false, cs)

            val m = ColumnVector(mark_ty, end - at, bits_of(valid.view()), Bools(marks))
            cs.push(ColumnVector(mark_rec, end - at, buf[u8](), Members(items_of([m]))))
            self.push(ColumnVector(self.spec.out_ty, end - at, buf[u8](), Members(cs)).as_type(self.spec.out_ty))
            at = end
    end emit_marks

    /** The next `BatchSize` rows of the output, or every row left when fewer remain. */
    private pop(*self) -> ColumnVector
        val parts = buf[ColumnVector]()
        var n: usize = 0

        while n < BatchSize && self.out_at < self.out.len()
            val p = self.out[self.out_at]

            if n + p.len <= BatchSize
                parts.push(p)
                n += p.len
                self.out_at += 1
            else
                parts.push(slice(p, 0, BatchSize - n))
                self.out[self.out_at] = slice(p, BatchSize - n, p.len)
                n = BatchSize

        self.out_count -= n

        if self.out_at == self.out.len()
            self.out = buf[ColumnVector]()
            self.out_at = 0

        concat(self.spec.out_ty, parts.view())
    end pop

    /** One step: the inputs read, a block of pairs considered, the left rows in play finished, the
     * next left batch put in play, or the right rows finished.
     */
    private step(*self) -> Result[unit, CodecError]
        if !self.started then return self.start()

        if self.live
            val (li, ri) = self.next_pairs()

            if li.len() > 0 then return self.consider(li, ri)

            self.live = false
            return self.finish_block()

        if self.ahead_at < self.ahead.len()
            val b = self.ahead[self.ahead_at]
            self.ahead_at += 1
            return self.open(b)

        if !self.left_done
            self.left.next_batch()? match
                Some(b) -> return self.open(b)
                None -> self.left_done = true

        self.finish_right()
        self.done = true
        Ok(())
    end step
end JoinOp

/** Rows `rows` of each of `parts` appended to `out`, or as many nulls when the side is `absent`. */
private gather(parts: Buf[ColumnVector], rows: []const usize, absent: bool, out: Buf[ColumnVector])
    for p in parts
        out.push(if absent then repeated(nullable(p.ty), Null, rows.len) else take(p, rows))

impl Operator for JoinOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        loop
            if self.out_count >= BatchSize || (self.done && self.out_count > 0) then return Ok(Some(self.pop()))
            if self.done then return Ok(None)

            self.step()?
