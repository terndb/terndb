module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.slices.sort_by

// The store's secondary indexes and its constraint machinery beyond the primary key (`ddl.md`
// §2.5–§2.6, `isolation.md` §4.2–§4.4): every secondary index of a table, unique or not, kept as a
// sorted buffer of entries, its unique keys checked once a batch of a statement's writes is applied,
// and read through by `scan_index` (`docs/design/executor.md` §4.6); the lookups a foreign key needs (the
// referenced row of a referencing value, under a `LOCK_ONLY` lock, and the referencing rows of a
// referenced value); the foreign-key checks deferred to commit; and the statement undo log that lets
// a statement wait part-way and leave no trace (`docs/design/store.md`).

// -- secondary indexes ------------------------------------------------------------------------------

/** One entry of a secondary index: the value of its components that some version of the row keyed
 * `key` holds, null components included (`ddl.md` §2.5 rule 1; a value with one never conflicts in a
 * unique index, Q48). A version the index's predicate is not true of has no entry. Entries are
 * sorted by value, then by primary key, and never removed: a reader fetches the row and reads its
 * version to decide whether the value is still there, as `on-disk-format.md` §4.9 rule 2 has it do.
 */
struct IxEntry
    value: Value
    key: Value

/** A secondary index of a table as the store keeps it (`ddl.md` §2.5): a `unique` constraint's, or an
 * index `building` or `ready`, unique or not, partial or over expressions. `oid` is the index's (the
 * constraint's own when it has none); `keys` and `predicate` its definition; `columns` the column of
 * each component and `plain` whether every component is a column and there is no predicate, so that
 * a version's entry is read straight from its image. A version of any other index has its entry
 * computed by evaluating the definition over the row (`ix_values`); the versions installed since the
 * last check wait in `pending` to be computed together, and `unindexed` holds the keys of the rows
 * one of whose versions the definition could not be evaluated over, which a read through the index
 * fetches as well, so that the filter above it meets them as a full scan's would. `unique` is whether
 * it enforces uniqueness (rule 2), `ready` whether it may answer a read (rule 5): its catalog state
 * is `ready`, or it is a `unique` constraint's with no index object of its own. `ty` is the record
 * type of the components.
 */
struct SecIndex
    oid: u64
    name: string
    keys: Buf[CatKey]
    predicate: Option[Expr]
    columns: Buf[u32]
    plain: bool
    unique: bool
    ready: bool
    ty: Type
    entries: Buf[IxEntry]
    pending: Buf[Hit]
    unindexed: Buf[Value]

/** A unique key as the catalog defines it: its name and its columns. */
struct KeyColumns
    name: string
    columns: Buf[u32]

/** A secondary index the store keeps, as the catalog defines it (`SecIndex`). */
struct IxDef
    oid: u64
    name: string
    keys: Buf[CatKey]
    predicate: Option[Expr]
    unique: bool
    ready: bool

/** The secondary indexes of table `oid` the store keeps (`ddl.md` §2.5, §8.9): every `unique`
 * constraint's, and every index that backs none and is `building` or `ready`, unique or not, partial
 * or over expressions. A unique one's writers check it; a `building` one is checked against the
 * entries present, which in this store are those of every row from the moment it is created (Q71).
 */
maintained_indexes(c: MemCatalog, oid: u64) -> Buf[IxDef]
    val out = buf[IxDef]()

    for k in c.constraints
        if k.table == oid
            k.kind match
                ConUnique(ids) ->
                    val keys = buf[CatKey]()

                    for id in ids
                        keys.push(CatKey(KeyOn(id), false))

                    val ready = if k.index == 0 then true else c.index_by_oid(k.index) match
                        Some(i) -> c.indexes[i].state == IndexReady
                        None -> false

                    out.push(IxDef(if k.index != 0 then k.index else k.oid, k.name, keys, None, true, ready))
                _ -> ()

    for x in c.indexes
        if x.table == oid && x.constraint == 0 && x.state != IndexFailed
            out.push(IxDef(x.oid, x.name, x.keys, x.predicate, x.unique, x.state == IndexReady))

    out
end maintained_indexes

/** The column of each of `keys`' components, and whether every one is a column. */
private key_columns(keys: Buf[CatKey]) -> (Buf[u32], bool)
    val ids = buf[u32]()
    var plain = true

    for k in keys
        k.key match
            KeyOn(id) -> ids.push(id)
            KeyOver(_) -> plain = false

    (ids, plain)

/** The record type of `keys`' components over table `oid`, in their current types. */
private keys_type(c: MemCatalog, oid: u64, keys: Buf[CatKey]) -> Result[Type, CodecError]
    val fs = buf[Field]()

    val i = c.table_by_oid(oid) match
        Some(i) -> i
        None -> return Ok(record(fs.view()))

    for j in 0..<keys.len()
        keys[j].key match
            KeyOn(id) -> c.tables[i].column_by_id(id) match
                Some(col) -> fs.push(Field(col.name, col.ty))
                None -> ()
            KeyOver(e) -> fs.push(Field(s"k$j", definition_type(c, c.tables[i].columns, e)?))

    Ok(record(fs.view()))

/** Each of `exprs`, definition expressions over the row binder `row` (`ddl.md` §2.12), evaluated over
 * `rows`, records of type `row`: one value per row for each expression. A definition is
 * deterministic, so it needs no clock and draws from no sequence.
 */
private def_values(c: MemCatalog, row: Type, rows: Buf[Value], exprs: Buf[Expr]) -> Result[Buf[Buf[Value]], CodecError]
    val out = buf[Buf[Value]]()

    if rows.len() == 0
        for _ in exprs
            out.push(buf[Value]())

        return Ok(out)

    if exprs.len() == 0 then return Ok(out)
    val items = buf[Item]()

    for i in 0..<exprs.len()
        items.push(Item(s"d$i", exprs[i]))

    val env = envelope([ParamDecl(None, bag(row))], Query(Project(ParamScan("row", 0), "d", items)))
    val typing = type_envelope(env, c)?
    val plan = plan_query(env, typing, Ctx(items_of([rel(rows.view())]), 0, None, no_work()), buf[MemTable]())
    val r = drain_rows(plan.op, plan.elem)?

    for j in 0..<exprs.len()
        out.push(values_of(r.member(j)))

    Ok(out)
end def_values

/** The entry in `ix` of `row`, the `n`th of the rows `cols` was evaluated over (`def_values`, the
 * predicate first if `ix` has one, then each expression component), a row of table `t` in its
 * current schema version: none where the predicate is not true. A null component stays in it.
 */
private index_entry(t: CatTable, ix: &SecIndex, row: Value, cols: Buf[Buf[Value]], n: usize) -> Option[Value]
    var at: usize = 0

    if ix.predicate.is_some()
        if cols[0][n] != Bool(true) then return None
        at = 1

    val fields = row match
        Record(fs) -> fs
        _ -> return None

    val parts = buf[Value]()

    for k in ix.keys
        var v: Value = Null

        k.key match
            KeyOn(id) ->
                for j in 0..<t.columns.len()
                    if t.columns[j].id == id && j < fields.len() then v = fields[j]
            KeyOver(_) ->
                v = cols[at][n]
                at += 1

        parts.push(v)

    Some(Record(parts))
end index_entry

/** The secondary unique keys of table `oid`: its `unique` constraints, and every ready unique index
 * over columns alone with no predicate that backs no constraint — the keys a statement may name as
 * an upsert target (`MemCatalog.table_info`) apart from the primary key.
 */
unique_keys(c: MemCatalog, oid: u64) -> Buf[KeyColumns]
    val out = buf[KeyColumns]()

    for k in c.constraints
        if k.table == oid
            k.kind match
                ConUnique(ids) -> out.push(KeyColumns(k.name, ids))
                _ -> ()

    for x in c.indexes
        if x.table == oid && x.unique && x.constraint == 0 && x.state == IndexReady && x.predicate.is_none()
            val ids = buf[u32]()
            var plain = true

            for k in x.keys
                k.key match
                    KeyOn(id) -> ids.push(id)
                    KeyOver(_) -> plain = false

            if plain then out.push(KeyColumns(x.name, ids))

    out
end unique_keys

/** The schema versions of table `oid`, through which a stored row's columns are read. */
table_versions(c: MemCatalog, oid: u64) -> Buf[SchemaVersion] = c.table_by_oid(oid) match
    Some(i) -> c.tables[i].versions
    None -> buf[SchemaVersion]()

/** The record type of columns `ids` of table `oid`, in their current types. */
columns_type(c: MemCatalog, oid: u64, ids: Buf[u32]) -> Type
    val fs = buf[Field]()

    c.table_by_oid(oid) match
        Some(i) ->
            for id in ids
                c.tables[i].column_by_id(id) match
                    Some(col) -> fs.push(Field(col.name, col.ty))
                    None -> ()
        None -> ()

    record(fs.view())

/** Columns `ids` of `r`, read through `r`'s own schema version, as a record; none when one is null
 * or absent, since a key with a null component never conflicts (`ddl.md` §2.5 rule 2) and a
 * referencing value with one is not checked (§2.6 rule 2).
 */
image_values(versions: Buf[SchemaVersion], r: StoredRow, ids: Buf[u32]) -> Option[Value] = columns_of(versions, r, ids, false)

/** Columns `ids` of `r`, read through `r`'s own schema version, as a record, null ones included: a
 * version's entry in a plain index. None when one is absent.
 */
private entry_values(versions: Buf[SchemaVersion], r: StoredRow, ids: Buf[u32]) -> Option[Value] = columns_of(versions, r, ids, true)

// Columns `ids` of `r` as a record; none when one is absent, or null and `nulls` is false.
private columns_of(versions: Buf[SchemaVersion], r: StoredRow, ids: Buf[u32], nulls: bool) -> Option[Value]
    val fields = r.value match
        Record(fs) -> fs
        _ -> return None

    for v in versions
        if v.number == r.schema
            val parts = buf[Value]()

            for id in ids
                var found = false

                for j in 0..<v.columns.len()
                    if v.columns[j].id == id && j < fields.len()
                        if fields[j].is_null() && !nulls then return None
                        parts.push(fields[j])
                        found = true

                if !found then return None

            return Some(Record(parts))

    None
end columns_of

/** Whether entry value `u` has a null component: such a value never conflicts (`ddl.md` §2.5 rule 2). */
private[terndb] has_null_part(u: Value) -> bool
    u match
        Record(fs) ->
            for f in fs
                if f.is_null() then return true
        _ -> ()

    false

/** Whether `r` holds `u` in columns `ids` (compared by `same`, through `cmp`). */
row_holds(versions: Buf[SchemaVersion], ids: Buf[u32], ty: Type, u: Value, r: StoredRow) -> bool = image_values(versions, r, ids) match
    Some(x) -> cmp(ty, x, u) == 0
    None -> false

/** As `row_holds`, for an image that may be absent or deleted. */
image_holds(versions: Buf[SchemaVersion], ids: Buf[u32], ty: Type, u: Value, img: Option[StoredRow]) -> bool = img match
    Some(r) -> row_holds(versions, ids, ty, u, r)
    None -> false

// The first entry of `ix` whose value is not below `u`.
private ix_first(ix: &SecIndex, u: Value) -> usize
    var lo: usize = 0
    var hi = ix.entries.len()

    while lo < hi
        val mid = lo + (hi - lo) / 2
        if cmp(ix.ty, ix.entries[mid].value, u) < 0 then lo = mid + 1 else hi = mid

    lo

// Adds the entry `(u, key)` to `ix` unless it is there already.
private ix_add(ix: &SecIndex, key_type: Type, u: Value, key: Value)
    var lo: usize = 0
    var hi = ix.entries.len()

    while lo < hi
        val mid = lo + (hi - lo) / 2
        val e = ix.entries[mid]
        var c = cmp(ix.ty, e.value, u)
        if c == 0 then c = cmp(key_type, e.key, key)
        if c == 0 then return
        if c < 0 then lo = mid + 1 else hi = mid

    ix.entries.insert(lo, IxEntry(u, key))

/** One end of a read of a secondary index (`Store.scan_index`): no end (`IxAny`), or the entries
 * whose leading components, as many as `values` holds, compare with `values` (by `cmp`, in order)
 * at or beyond it — inclusive or not — on that end's side.
 */
enum IxBound
    IxAny
    IxAt(values: Buf[Value], inclusive: bool)

/** The leading components of entry value `v`, of record type `ty`, compared with `bound` (§3.3): the
 * first component that differs decides, and a value equal on every one of them compares as 0.
 */
private prefix_cmp(ty: Type, v: Value, bound: Buf[Value]) -> int
    val fs = ty.base() match
        Record(fs) -> fs
        _ -> return 0

    val xs = v match
        Record(xs) -> xs
        _ -> return 0

    for i in 0..<bound.len()
        if i >= xs.len() || i >= fs.len() then return 0
        val c = cmp(fs[i].ty, xs[i], bound[i])
        if c != 0 then return c

    0

/** Whether entry value `u` of `ix` lies before lower bound `lo`. */
private before_lo(ix: &SecIndex, u: Value, lo: IxBound) -> bool = lo match
    IxAny -> false
    IxAt(vs, inclusive) ->
        val c = prefix_cmp(ix.ty, u, vs)
        c < 0 || (c == 0 && !inclusive)

/** Whether entry value `u` of `ix` lies past upper bound `hi`. */
private past_hi(ix: &SecIndex, u: Value, hi: IxBound) -> bool = hi match
    IxAny -> false
    IxAt(vs, inclusive) ->
        val c = prefix_cmp(ix.ty, u, vs)
        c > 0 || (c == 0 && !inclusive)

/** The first entry of `ix` not before `lo`: the entries are sorted, so those before it form a prefix. */
private ix_from(ix: &SecIndex, lo: IxBound) -> usize
    var a: usize = 0
    var b = ix.entries.len()

    while a < b
        val mid = a + (b - a) / 2
        if before_lo(ix, ix.entries[mid].value, lo) then a = mid + 1 else b = mid

    a

/** The index of `d` whose oid is `oid`, if the store keeps it. */
private index_of_oid(d: &TableData, oid: u64) -> Option[&SecIndex]
    for ix in d.indexes
        if ix.oid == oid then return Some(ix)

    None

/** A `ready` index of `d` with no predicate whose leading components are columns `ids` in order:
 * one the referencing rows of a foreign key over `ids` can be found through.
 */
private leading_index(d: &TableData, ids: Buf[u32]) -> Option[&SecIndex]
    for ix in d.indexes
        if ix.ready && ix.predicate.is_none() && ix.keys.len() >= ids.len() && ids.len() > 0
            var ok = true

            for i in 0..<ids.len()
                ix.keys[i].key match
                    KeyOn(id) -> if id != ids[i] then ok = false
                    KeyOver(_) -> ok = false

            if ok then return Some(ix)

    None

/** Whether `xs` holds `x`. */
private holds_value(xs: Buf[Value], x: Value) -> bool
    for v in xs
        if v == x then return true

    false

/** A row's encoded key and its key: what the rows read through an index are sorted by. */
private struct KeyAt
    kb: Buf[u8]
    key: Value

/** Enters the image `img` of the row keyed `key` in every secondary index of `d`: at once in a plain
 * index, and in any other once its entry is computed (`Store.settle`).
 */
private[terndb] index_image(c: MemCatalog, d: &TableData, key: Value, img: Option[StoredRow])
    if d.indexes.len() == 0 then return

    val r = img match
        Some(r) -> r
        None -> return

    val versions = table_versions(c, d.oid)

    for ix in d.indexes
        if ix.plain
            entry_values(versions, r, ix.columns) match
                Some(u) -> ix_add(ix, d.key_type, u, key)
                None -> ()
        else
            ix.pending.push(Hit(key, r))

/** The keys of the rows whose versions may hold `value` in columns `ids` of `d`: that key itself
 * when `ids` is the primary key, else those of the entries of a plain index over exactly `ids`, which
 * a unique key always has.
 */
private keys_holding(d: &TableData, ids: Buf[u32], value: Value) -> Result[Buf[Value], CodecError]
    val out = buf[Value]()

    if same_ids(ids, d.key_columns)
        out.push(value)
        return Ok(out)

    for ix in d.indexes
        if ix.plain && same_ids(ix.columns, ids)
            var i = ix_first(ix, value)

            while i < ix.entries.len() && cmp(ix.ty, ix.entries[i].value, value) == 0
                out.push(ix.entries[i].key)
                i += 1

            return Ok(out)

    fail("D1001", "no unique key of the table is over these columns")

private unique_fail[T](name: string) -> Result[T, CodecError] =
    fail("T3001", s"a row with this value of unique key '$name' is visible to the transaction")

// -- foreign keys -----------------------------------------------------------------------------------

/** A foreign key (`ddl.md` §2.6): `columns` of `table` referencing `ref_columns` of `ref_table`,
 * which are a unique or primary key of it, with its actions and whether it is deferred.
 */
struct ForeignKey
    name: string
    table: u64
    columns: Buf[u32]
    ref_table: u64
    ref_columns: Buf[u32]
    on_delete: FkAction
    on_update: FkAction
    deferred: bool

/** The foreign keys of table `oid` (`to` false) or referencing it (`to` true). */
foreign_keys(c: MemCatalog, oid: u64, to: bool) -> Buf[ForeignKey]
    val out = buf[ForeignKey]()

    for k in c.constraints
        k.kind match
            ConForeignKey(cols, ref_table, ref_cols, on_delete, on_update, deferred) ->
                if (!to && k.table == oid) || (to && ref_table == oid)
                    out.push(ForeignKey(k.name, k.table, cols, ref_table, ref_cols, on_delete, on_update, deferred))
            _ -> ()

    out

/** A foreign-key check deferred to commit: that the row of `fk.table` keyed `key` still has its
 * referenced row, or that no row references `value`, a referenced value the transaction removed
 * (`no_action` on a deferred foreign key).
 */
enum Deferred
    ChildCheck(fk: ForeignKey, key: Value)
    ParentCheck(fk: ForeignKey, value: Value)

private fk_fail[T](name: string, what: string) -> Result[T, CodecError] = fail("T3003", s"$what foreign key '$name'")

// Whether the sorted `values` hold `x`.
private holds_sorted(ty: Type, values: Buf[Value], x: Value) -> bool
    var lo: usize = 0
    var hi = values.len()

    while lo < hi
        val mid = lo + (hi - lo) / 2
        val c = cmp(ty, values[mid], x)
        if c == 0 then return true
        if c < 0 then lo = mid + 1 else hi = mid

    false

// Whether `img` holds, in columns `ids`, one of the sorted `values`.
private within(versions: Buf[SchemaVersion], ids: Buf[u32], ty: Type, values: Buf[Value], img: Option[StoredRow]) -> bool = img match
    Some(r) -> image_values(versions, r, ids) match
        Some(x) -> holds_sorted(ty, values, x)
        None -> false
    None -> false

// -- the statement undo log ---------------------------------------------------------------------------

impl Store
    /** Where `t`'s statement log, writes, locks, deferred checks and rollback chain stand now. */
    private[terndb] mark_of(self, t: &Txn) -> Mark =
        Mark(t.undo.len(), t.writes.len(), t.locks.len(), t.deferred.len(), self.rows.last_record(t.id))

    /** Undoes what `t` installed, locked and deferred since `m`, newest first: its undo records
     * after the mark's are rolled back (`UndoRows.rollback_to`), which restores every row and lets
     * go of every row and `LOCK_ONLY` lock taken since, and its write list is restored.
     */
    private[terndb] undo_to(*self, t: &Txn, m: Mark)
        val _ = self.rows.rollback_to(t.id, m.addr)
        var i = t.undo.len()

        while i > m.undo
            i -= 1
            val u = t.undo[i]

            if !u.pushed
                val w = t.writes[u.write_at]
                t.writes[u.write_at] = Write(w.table, w.key, w.before, u.prev_after)

        t.undo.truncate(m.undo)
        t.writes.truncate(m.writes)
        t.locks.truncate(m.locks)
        t.deferred.truncate(m.deferred)

    /** The visible row of `table` whose columns `ids` (a unique or primary key, in its own order)
     * hold `value`, if any; logged as a read of that value, found or not, reading every column
     * (`isolation.md` §4.4, an upsert's conflict check).
     */
    lookup_unique(*self, t: &Txn, table: u64, ids: Buf[u32], value: Value) -> Result[Option[Hit], CodecError]
        val r = self.lookup_in(t, table, ids, value)
        self.guard(t, r)

    /** Checks that a row of `fk.ref_table` holds `value`, a non-null referencing value written by
     * `t` (`ddl.md` §2.6 rule 3). The referenced row is locked `LOCK_ONLY` to the end of `t`, at
     * every level, and the read is logged at serializable. A row another live transaction is writing
     * answers its id to wait for (`Some`); none is `foreign_key_violation`, and a referenced row
     * changed or found only by a commit after `t`'s snapshot is `serialization_failure` at snapshot
     * and serializable, as an insert's key is (§4.2 rule 4).
     */
    check_reference(*self, t: &Txn, fk: ForeignKey, value: Value) -> Result[Option[u64], CodecError]
        val r = self.reference_in(t, fk, value, false)
        self.guard(t, r)

    /** The rows of `fk.table` referencing one of `values` through `fk`: `t`'s own version of a row it
     * wrote, else the newest committed version, as a read committed write sees it (`ddl.md` §2.6
     * rule 3), so that a referencing row committed after the snapshot is not missed; at snapshot and
     * serializable such a row is `serialization_failure` unless its version in the snapshot
     * references the value too. The scan is logged at serializable.
     */
    referencing(*self, t: &Txn, fk: ForeignKey, values: Buf[Value]) -> Result[Buf[Hit], CodecError]
        val r = self.referencing_in(t, fk, values)
        self.guard(t, r)

    /** The rows of `table` visible to `t` whose visible version's entry in secondary index `index`
     * lies between `lo` and `hi`, in key order, the read logged as `logged` under serializable
     * (§4.4) whatever it finds: a scan narrowed through an index (`exec_access.sysl`). Each entry in
     * the range names a row some version of which held the value; the row is fetched by its key and
     * its version visible to `t` read, and kept unless that version's own entry lies outside the
     * range. A row whose visible version has no entry, because the index's predicate is not true of
     * it or its definition cannot be evaluated over it, is kept too, and so is every row one of whose
     * versions the definition could not be evaluated over: the filter above decides them. `logged`
     * must hold for every row the statement's result depends on, and the range must hold every such
     * row's entry. An index the store does not keep reads the whole table.
     */
    scan_index(*self, t: &Txn, table: u64, index: u64, lo: IxBound, hi: IxBound, logged: Pred) -> Result[Buf[Hit], CodecError]
        val r = self.scan_index_in(t, table, index, lo, hi, logged)
        self.guard(t, r)

    /** Whether a row `t` sees holds `value` in columns `ids` of `table`. */
    holds_key(*self, t: &Txn, table: u64, ids: Buf[u32], value: Value) -> Result[bool, CodecError]
        val r = self.holds_in(t, table, ids, value)
        self.guard(t, r)

    /** Defers `check` to `t`'s commit; it is undone with the statement that deferred it. */
    defer_check(*self, t: &Txn, check: Deferred) = t.deferred.push(check)

    // The secondary unique checks of the rows a batch of writes installed since `m` (`write_rows`).
    private[terndb] checked(*self, t: &Txn, table: u64, m: Mark, r: Result[WriteOutcome, CodecError]) -> Result[WriteOutcome, CodecError]
        val outcome = r?

        val n = outcome match
            Wait(h) -> return Ok(Wait(h))
            Done(n) -> n

        val d = self.table_data(table)?
        self.sync_indexes(d)?
        if d.indexes.len() == 0 then return Ok(Done(n))
        val keys = buf[Value]()

        for i in m.undo..<t.undo.len()
            if t.undo[i].table == d.oid then keys.push(t.undo[i].key)

        self.unique_checks(t, d, keys)? match
            Some(h) ->
                self.undo_to(t, m)
                return self.wait_on(t, h)
            None -> ()

        t.waits_for = 0
        Ok(Done(n))

    // Brings `d`'s secondary indexes in line with the catalog: an index added since is built from
    // every version of every row still reachable, an index dropped is forgotten, and one renamed or
    // made ready keeps its entries.
    private[terndb] sync_indexes(*self, d: &TableData) -> Result[unit, CodecError]
        val defs = maintained_indexes(self.catalog, d.oid)
        if defs.len() == 0 && d.indexes.len() == 0 then return Ok(())

        val kept = buf[&SecIndex]()

        for k in defs
            var found = false

            for ix in d.indexes
                if !found && ix.oid == k.oid && ix.keys == k.keys && ix.predicate == k.predicate && ix.unique == k.unique
                    ix.name = k.name
                    ix.ready = k.ready
                    kept.push(ix)
                    found = true

            if !found
                val (ids, columns_only) = key_columns(k.keys)
                val plain = columns_only && k.predicate.is_none()
                val ty = keys_type(self.catalog, d.oid, k.keys)?
                val ix: &SecIndex = SecIndex(k.oid, k.name, k.keys, k.predicate, ids, plain, k.unique, k.ready, ty, buf(), buf(), buf())

                for s in self.slots_of(d)?
                    for r in self.all_versions(d, s)?
                        ix.pending.push(Hit(s.key, r))

                kept.push(ix)

        d.indexes = kept
        self.settle(d)
    end sync_indexes

    /** Enters in each secondary index of `d` the versions waiting for their entries
     * (`SecIndex.pending`), computed together. A version the index's definition cannot be evaluated
     * over has no entry: it holds no value of the key, and its row's key joins `unindexed`.
     */
    private settle(*self, d: &TableData) -> Result[unit, CodecError]
        for ix in d.indexes
            if ix.pending.len() > 0
                val rows = buf[StoredRow]()

                for h in ix.pending
                    rows.push(h.row)

                if ix.plain
                    val vs = self.ix_values(d, ix, rows, false)?

                    for i in 0..<vs.len()
                        vs[i] match
                            Some(u) -> ix_add(ix, d.key_type, u, ix.pending[i].key)
                            None -> ()

                    ix.pending.clear()
                    continue

                // The definition over all of them at once; over each alone only when that fails.
                self.evaluated(d, ix, rows) match
                    Ok(vs) ->
                        for i in 0..<vs.len()
                            vs[i] match
                                Some(u) -> ix_add(ix, d.key_type, u, ix.pending[i].key)
                                None -> ()
                    Err(_) ->
                        for h in ix.pending
                            val one = buf[StoredRow]()
                            one.push(h.row)

                            self.evaluated(d, ix, one) match
                                Ok(vs) -> vs[0] match
                                    Some(u) -> ix_add(ix, d.key_type, u, h.key)
                                    None -> ()
                                Err(_) -> if !holds_value(ix.unindexed, h.key) then ix.unindexed.push(h.key)

                ix.pending.clear()

        Ok(())
    end settle

    /** The entry of each of `rows`, versions of rows of `d`, in `ix`: the key's components as a
     * record, null components included, or none where `ix`'s predicate is not true of the version
     * (`ddl.md` §2.5 rules 1–3; a value with a null component never conflicts, Q48). An index that is
     * not plain has its definition evaluated over each version as a row of the current schema version
     * (§8.9 "old rows"); a version it cannot be evaluated over is the evaluation's error when
     * `strict`, else has no entry.
     */
    private[terndb] ix_values(*self, d: &TableData, ix: &SecIndex, rows: Buf[StoredRow], strict: bool) -> Result[Buf[Option[Value]], CodecError]
        val out = buf[Option[Value]]()

        if ix.plain
            val versions = table_versions(self.catalog, d.oid)

            for r in rows
                out.push(entry_values(versions, r, ix.columns))

            return Ok(out)

        val all = self.evaluated(d, ix, rows)
        if strict || all.is_ok() then return all

        for r in rows
            val one = buf[StoredRow]()
            one.push(r)

            self.evaluated(d, ix, one) match
                Ok(vs) -> out.push(vs[0])
                Err(_) -> out.push(None)

        Ok(out)
    end ix_values

    // `ix_values` of an index that is not plain: its predicate and expression components evaluated
    // over `rows` together.
    private evaluated(*self, d: &TableData, ix: &SecIndex, rows: Buf[StoredRow]) -> Result[Buf[Option[Value]], CodecError]
        val out = buf[Option[Value]]()

        val ti = self.catalog.table_by_oid(d.oid) match
            Some(i) -> i
            None ->
                for _ in rows
                    out.push(None)

                return Ok(out)

        val t = self.catalog.tables[ti]
        val fs = buf[Field]()

        for c in t.columns
            fs.push(Field(c.name, resolve_type(self.catalog, c.ty)?))

        val values = buf[Value]()

        for r in rows
            values.push(self.translated(d.oid, r)?.value)

        val exprs = buf[Expr]()

        ix.predicate match
            Some(p) -> exprs.push(p)
            None -> ()

        for k in ix.keys
            k.key match
                KeyOver(e) -> exprs.push(e)
                KeyOn(_) -> ()

        val cols = def_values(self.catalog, record(fs.view()), values, exprs)?

        for n in 0..<rows.len()
            out.push(index_entry(t, ix, values[n], cols, n))

        Ok(out)
    end evaluated

    // Whether the version `img` of a row of `d` holds `u` in `ix`; an absent or deleted one holds
    // nothing, and so does one the index's definition cannot be evaluated over.
    private ix_holds(*self, d: &TableData, ix: &SecIndex, u: Value, img: Option[StoredRow]) -> Result[bool, CodecError]
        val r = img match
            Some(r) -> r
            None -> return Ok(false)

        val one = buf[StoredRow]()
        one.push(r)

        self.ix_values(d, ix, one, false)?[0] match
            Some(x) -> Ok(cmp(ix.ty, x, u) == 0)
            None -> Ok(false)

    /** Reconciliation of `t`'s rows of `table` with the unique keys a DDL committed since added
     * (`ddl.md` §6.4 rule 1): each row `t` wrote is checked as an aware writer's would be. A row
     * another live transaction is writing that holds the value is `lock_timeout`, since a commit
     * does not wait.
     */
    private[terndb] reconcile_uniques(*self, t: &Txn, table: u64) -> Result[unit, CodecError]
        val d = self.table_data(table)?
        self.sync_indexes(d)?
        val keys = buf[Value]()

        for w in t.writes
            if w.table == table then keys.push(w.key)

        self.unique_checks(t, d, keys)? match
            Some(_) -> return fail("T1003", "a row holding a value of a unique key added during the transaction is locked by a live transaction at its commit")
            None -> ()

        Ok(())

    // Whether `t`'s versions of the rows keyed `keys` conflict on a secondary unique key of `d` with
    // other rows (`isolation.md` §4.2 rules 1 and 4, applied to the key's value): an error, the id
    // of a live transaction writing a row that holds the value (`Some`, to wait for), or none. The
    // rows are taken in order, each against every key. A version whose entry in a key has a null
    // component (Q48), or that has none because a predicate is not true of it, is not checked against
    // that key. An index that is not unique checks nothing.
    private unique_checks(*self, t: &Txn, d: &TableData, keys: Buf[Value]) -> Result[Option[u64], CodecError]
        self.settle(d)?
        val slots = buf[Slot]()
        val rows = buf[StoredRow]()

        for key in keys
            self.slot_at(d, key)? match
                Some(s) -> if owns(s, t.id)
                    self.image_row(d, s.key, s.img)? match
                        Some(r) ->
                            slots.push(s)
                            rows.push(r)
                        None -> ()
                None -> ()

        if rows.len() == 0 then return Ok(None)
        val values = buf[Buf[Option[Value]]]()

        for ix in d.indexes
            values.push(if ix.unique then self.ix_values(d, ix, rows, true)? else buf[Option[Value]]())

        for n in 0..<rows.len()
            for x in 0..<d.indexes.len()
                if d.indexes[x].unique
                    values[x][n] match
                        Some(u) -> if !has_null_part(u)
                            self.conflict_on(t, d, d.indexes[x], slots[n], u)? match
                                Some(h) -> return Ok(Some(h))
                                None -> ()
                        None -> ()

        Ok(None)
    end unique_checks

    // Whether a row other than `s` whose entry in `ix` is `u` conflicts with `t`'s version of `s`
    // (`unique_conflict`).
    private conflict_on(*self, t: &Txn, d: &TableData, ix: &SecIndex, s: Slot, u: Value) -> Result[Option[u64], CodecError]
        var i = ix_first(ix, u)

        while i < ix.entries.len() && cmp(ix.ty, ix.entries[i].value, u) == 0
            val ok = ix.entries[i].key
            i += 1

            if ok != s.key
                self.slot_at(d, ok)? match
                    Some(o) -> self.unique_conflict(t, d, ix, o, u)? match
                        Some(h) -> return Ok(Some(h))
                        None -> ()
                    None -> ()

        Ok(None)

    private lookup_in(*self, t: &Txn, table: u64, ids: Buf[u32], value: Value) -> Result[Option[Hit], CodecError]
        live(t)?
        val d = self.table_data(table)?

        if same_ids(ids, d.key_columns)
            return Ok(self.get_in(t, table, value)?.map(r -> Hit(value, r)))

        self.sync_indexes(d)?
        val versions = table_versions(self.catalog, table)
        val ty = columns_type(self.catalog, table, ids)
        self.log_read(t, table, pred_all(r -> row_holds(versions, ids, ty, value, r)), None)

        for k in keys_holding(d, ids, value)?
            self.slot_at(d, k)? match
                Some(o) -> self.visible(d, o, t.snapshot, t.id)? match
                    Some(r) -> if row_holds(versions, ids, ty, value, r) then return Ok(Some(Hit(o.key, self.translated(table, r)?)))
                    None -> ()
                None -> ()

        Ok(None)

    // `check_reference`; at commit (`at_commit`) a referenced row another transaction is writing is
    // `lock_timeout` instead of a wait, since a commit does not wait.
    private reference_in(*self, t: &Txn, fk: ForeignKey, value: Value, at_commit: bool) -> Result[Option[u64], CodecError]
        live(t)?
        val d = self.table_data(fk.ref_table)?
        self.sync_indexes(d)?
        val ids = fk.ref_columns
        val versions = table_versions(self.catalog, fk.ref_table)
        val ty = columns_type(self.catalog, fk.ref_table, ids)
        val key = if same_ids(ids, d.key_columns) then Some(value) else None
        self.log_read(t, fk.ref_table, pred(ids.view(), r -> row_holds(versions, ids, ty, value, r)), key)

        for k in keys_holding(d, ids, value)?
            self.slot_at(d, k)? match
                Some(o) -> self.reference_row(t, fk, d, o, versions, ty, value, at_commit)? match
                    Some(answer) -> return Ok(answer)
                    None -> ()
                None -> ()

        fk_fail(fk.name, "no row of the referenced table holds the value of")
    end reference_in

    // `reference_in` for one row `o` of the referenced table `d` that may hold `value`: the answer
    // (`Some`), or none to go on to the next row.
    private reference_row(*self, t: &Txn, fk: ForeignKey, d: &TableData, o: Slot, versions: Buf[SchemaVersion], ty: Type, value: Value,
            at_commit: bool) -> Result[Option[Option[u64]], CodecError]
        val ids = fk.ref_columns

        val top = self.top_version(d, o)? match
            Some(v) -> v.row
            None -> None

        val committed = self.newest_committed(d, o)?
        val held = committed.is_some() && image_holds(versions, ids, ty, value, committed.unwrap().row)
        val lock = self.lock_of(o)

        if owns(o, t.id)
            if image_holds(versions, ids, ty, value, top) then return Ok(Some(None))
        elif lock != 0 && lock != t.id && (held || image_holds(versions, ids, ty, value, top))
            if at_commit then return fail("T1003", s"the row foreign key '${fk.name}' references is locked by a live transaction, and a commit does not wait")

            val _ = self.wait_on(t, lock)?
            return Ok(Some(Some(lock)))
        elif held
            if t.level != ReadCommitted && committed.unwrap().commit > t.snapshot
                return fail("T1001", s"the row foreign key '${fk.name}' references was committed after the snapshot")

            // The referenced row is locked `LOCK_ONLY` (a LOCK undo record, Q49) unless `t` holds
            // it already.
            if lock == 0
                self.rows.lock(t.id, d.oid, o.kb.view())? match
                    UndoDone(_) -> t.locks.push(o.key)
                    _ -> return fail("D1001", "a referenced row the store found unlocked could not be locked")

            return Ok(Some(None))
        elif t.level != ReadCommitted && image_holds(versions, ids, ty, value, self.visible(d, o, t.snapshot, t.id)?)
            return fail("T1001", s"the row foreign key '${fk.name}' references was changed after the snapshot")

        Ok(None)
    end reference_row

    private referencing_in(*self, t: &Txn, fk: ForeignKey, values: Buf[Value]) -> Result[Buf[Hit], CodecError]
        live(t)?
        val d = self.table_data(fk.table)?
        val ids = fk.columns
        val versions = table_versions(self.catalog, fk.table)
        val ty = columns_type(self.catalog, fk.table, ids)
        var sorted = buf[Value]()
        sorted.extend(values.view())
        sort_by(sorted.view_mut(), (x, y) -> cmp(ty, x, y) < 0)

        self.log_read(t, fk.table, pred(ids.view(), r -> within(versions, ids, ty, sorted, Some(r))), None)
        val out = buf[Hit]()

        // Through an index whose leading components are the referencing columns when there is one,
        // which names every row some version of which holds one of the values; else every row.
        self.sync_indexes(d)?

        val slots = leading_index(d, ids) match
            Some(ix) ->
                val keys = buf[Value]()

                for v in sorted
                    val at = v match
                        Record(xs) -> IxAt(xs, true)
                        _ -> IxAny

                    var i = ix_from(ix, at)

                    while i < ix.entries.len() && !past_hi(ix, ix.entries[i].value, at)
                        self.entries_read += 1
                        keys.push(ix.entries[i].key)
                        i += 1

                keys.extend(ix.unindexed.view())
                self.fetched(d, keys)?
            None ->
                val all = self.slots_of(d)?
                self.slots_read += u64(all.len())
                all

        for s in slots
            if owns(s, t.id)
                val top = self.image_row(d, s.key, s.img)?
                if within(versions, ids, ty, sorted, top) then out.push(Hit(s.key, top.unwrap()))
            else
                self.newest_committed(d, s)? match
                    Some(v) -> if within(versions, ids, ty, sorted, v.row)
                        if t.level != ReadCommitted && v.commit > t.snapshot && !within(versions, ids, ty, sorted, self.visible(d, s, t.snapshot, t.id)?)
                            return fail("T1001", s"a row referencing through foreign key '${fk.name}' was committed after the snapshot")

                        out.push(Hit(s.key, v.row.unwrap()))
                    None -> ()

        Ok(out)
    end referencing_in

    private scan_index_in(*self, t: &Txn, table: u64, index: u64, lo: IxBound, hi: IxBound, logged: Pred) -> Result[Buf[Hit], CodecError]
        live(t)?
        val d = self.table_data(table)?
        self.sync_indexes(d)?

        val ix = index_of_oid(d, index) match
            Some(ix) -> ix
            None -> return self.scan_range_in(t, table, KeyAny, KeyAny, logged)

        val keys = buf[Value]()
        var i = ix_from(ix, lo)

        while i < ix.entries.len() && !past_hi(ix, ix.entries[i].value, hi)
            self.entries_read += 1
            keys.push(ix.entries[i].key)
            i += 1

        keys.extend(ix.unindexed.view())
        val slots = buf[Slot]()
        val rows = buf[StoredRow]()

        for s in self.fetched(d, keys)?
            self.visible(d, s, t.snapshot, t.id)? match
                Some(r) ->
                    slots.push(s)
                    rows.push(r)
                None -> ()

        // The entry of each version read: one outside the range is of a row that has left it.
        val vs = self.ix_values(d, ix, rows, false)?
        val out = buf[Hit]()

        for n in 0..<rows.len()
            val kept = vs[n] match
                Some(u) -> !before_lo(ix, u, lo) && !past_hi(ix, u, hi)
                None -> true

            if kept then out.push(Hit(slots[n].key, self.translated(table, rows[n])?))

        self.log_read(t, table, logged, None)
        Ok(out)
    end scan_index_in

    // The rows of `d` keyed `keys` as the leaf holds them now, each once and in key order; a key no
    // row holds any more is skipped. Each row fetched counts in `rows_fetched`.
    private fetched(*self, d: &TableData, keys: Buf[Value]) -> Result[Buf[Slot], CodecError]
        var at = buf[KeyAt]()

        for k in keys
            at.push(KeyAt(self.key_bytes(d, k)?, k))

        sort_by(at.view_mut(), (a, b) -> a.kb.view() < b.kb.view())
        val out = buf[Slot]()

        for n in 0..<at.len()
            if n > 0 && at[n].kb.view() == at[n - 1].kb.view() then continue
            self.rows_fetched += 1

            self.slot_at(d, at[n].key)? match
                Some(s) -> out.push(s)
                None -> ()

        Ok(out)

    private holds_in(*self, t: &Txn, table: u64, ids: Buf[u32], value: Value) -> Result[bool, CodecError]
        live(t)?
        val d = self.table_data(table)?
        self.sync_indexes(d)?
        val versions = table_versions(self.catalog, table)
        val ty = columns_type(self.catalog, table, ids)

        for k in keys_holding(d, ids, value)?
            self.slot_at(d, k)? match
                Some(o) -> if image_holds(versions, ids, ty, value, self.visible(d, o, t.snapshot, t.id)?) then return Ok(true)
                None -> ()

        Ok(false)

    // The foreign-key checks `t` deferred to its commit (`ddl.md` §2.6 rule 2).
    private[terndb] check_deferred(*self, t: &Txn) -> Result[unit, CodecError]
        for x in t.deferred
            x match
                ChildCheck(fk, key) ->
                    val d = self.table_data(fk.table)?

                    self.slot_at(d, key)? match
                        Some(s) -> self.visible(d, s, t.snapshot, t.id)? match
                            Some(r) -> image_values(table_versions(self.catalog, fk.table), r, fk.columns) match
                                Some(v) ->
                                    val _ = self.reference_in(t, fk, v, true)?
                                None -> ()
                            None -> ()
                        None -> ()
                ParentCheck(fk, value) ->
                    if !self.holds_in(t, fk.ref_table, fk.ref_columns, value)?
                        val one = buf[Value]()
                        one.push(value)
                        if self.referencing_in(t, fk, one)?.len() > 0 then return fk_fail(fk.name, "a row still references a removed row through")

        Ok(())
    end check_deferred

    // Whether row `o`, another than the one `t` wrote, conflicts with `u` on `ix`: `t`'s own version
    // of it holding `u` is `unique_violation`; a version another live transaction is writing, or the
    // committed one under it, holding `u` answers that transaction to wait for, its outcome deciding
    // (§4.2 rule 1); else the version in `t`'s snapshot holding `u` is `unique_violation`, and the
    // newest committed one holding it is a race (`serialization_failure`) at snapshot and
    // serializable and `unique_violation` at read committed (rule 4). A row another transaction only
    // holds `LOCK_ONLY` is judged by its committed version, which that lock does not change.
    private unique_conflict(*self, t: &Txn, d: &TableData, ix: &SecIndex, o: Slot, u: Value) -> Result[Option[u64], CodecError]
        val top = self.top_version(d, o)? match
            Some(v) -> v
            None -> return Ok(None)

        val committed = self.newest_committed(d, o)?

        val held = committed match
            Some(v) -> self.ix_holds(d, ix, u, v.row)?
            None -> false

        // A live writer's version has commit number 0 and names its writer; a committed version whose
        // record purge has passed has commit number 0 too, but names none, and every snapshot sees it.
        if top.commit == 0 && top.writer != 0
            if top.writer == t.id
                if self.ix_holds(d, ix, u, top.row)? then return unique_fail(ix.name)
                return Ok(None)

            if held || self.ix_holds(d, ix, u, top.row)? then return Ok(Some(top.writer))
            return Ok(None)

        if self.ix_holds(d, ix, u, self.visible(d, o, t.snapshot, t.id)?)? then return unique_fail(ix.name)

        if held
            if t.level == ReadCommitted then return unique_fail(ix.name)
            return fail("T1001", s"a row with this value of unique key '${ix.name}' was committed after the snapshot")

        Ok(None)
    end unique_conflict
end Store
