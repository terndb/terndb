module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// Transactions (`wire-protocol.md` §5): handles, begin, errors inside a transaction, commit and
// rollback, savepoints and unknown outcomes (§10.1 properties 11–13, 18, 29).

/** The txid the server answered `Begin` on `stream` with. */
sx_txid(d: Duo, stream: u64) -> u64 = d.on(stream)[0] match
    TxnBegun(txid, _, _) -> txid
    _ -> 0

sx_error(m: Message) -> WireError = m match
    ErrorReply(e) -> e
    _ ->
        assert(false, "an Error")
        WireError(buf(), false, Unaffected, None, None)

@test
stx_an_explicit_transaction_with_savepoints()
    var d = sx_open()
    val b = d.send(Begin(1, TxnOptions(Some(Snapshot), None, None, None, None, None, None)))
    assert(d.on(b)[0] == TxnBegun(10, 100, Snapshot), "TxnBegun")
    assert(d.c.handle_state(1) == Some(Live), "the client holds it open")

    assert_eq(sx_codes(d.on(d.send(sx_execute(1, 6)))), "type 145 type 146 type 147")
    assert_eq(sx_codes(d.on(d.send(Savepoint(1, "a")))), "type 148")

    // An error after the savepoint aborts the transaction...
    val bad = d.send(sx_execute(1, 4))
    assert_eq(sx_error(d.on(bad)[0]).txn_state, Aborted)
    assert(d.c.handle_state(1) == Some(Doomed), "the client knows it is aborted")
    val refused = d.send(sx_execute(1, 1))
    assert_eq(sx_codes(d.on(refused)), "W2003")
    assert_eq(sx_codes(d.on(d.send(Savepoint(1, "b")))), "W2003")

    // ...until the client rolls back to it.
    assert_eq(sx_codes(d.on(d.send(RollbackToSavepoint(1, "a")))), "type 148")
    assert(d.c.handle_state(1) == Some(Live), "live again")
    assert_eq(sx_codes(d.on(d.send(sx_execute(1, 1)))), "type 145 type 146 type 146 type 146 type 147")
    assert_eq(sx_codes(d.on(d.send(ReleaseSavepoint(1, "a")))), "type 148")

    val c = d.send(Commit(1))
    assert(d.on(c)[0] == TxnCommitted(10, Some(500)), "committed with its commit number")
    assert(d.c.handle_state(1).is_none() && d.s.open_txns() == 0, "the handle is closed")
    assert_eq(d.c.causal_token(), 500)
    assert(d.engine.logged("savepoint 10 a") && d.engine.logged("rollback_to 10 a") && d.engine.logged("release 10 a"), "the engine saw each")

@test
stx_a_newer_savepoint_shadows_an_older_one_and_release_forgets_later_ones()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))
    d.send(Savepoint(1, "a"))
    d.send(Savepoint(1, "b"))
    d.send(Savepoint(1, "a"))

    // Releasing the newer "a" forgets only it; "b" and the older "a" stay.
    assert_eq(sx_codes(d.on(d.send(ReleaseSavepoint(1, "a")))), "type 148")
    assert_eq(sx_codes(d.on(d.send(RollbackToSavepoint(1, "b")))), "type 148")
    // Releasing the older "a" forgets "b" after it.
    assert_eq(sx_codes(d.on(d.send(ReleaseSavepoint(1, "a")))), "type 148")
    assert_eq(sx_codes(d.on(d.send(RollbackToSavepoint(1, "b")))), "W2012")

@test
stx_an_unknown_savepoint_aborts_and_commit_names_the_cause()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))

    val r = d.send(RollbackToSavepoint(1, "nope"))
    assert_eq(sx_codes(d.on(r)), "W2012")
    assert_eq(sx_error(d.on(r)[0]).txn_state, Aborted)
    assert_eq(sx_codes(d.on(d.send(ReleaseSavepoint(1, "nope")))), "W2003")

    val c = d.send(Commit(1))
    val e = sx_error(d.on(c)[0])
    assert(e.entries[0].code == "W2012" && e.txn_state == Closed && e.txid == Some(10), "the original code, closed")
    assert(d.engine.logged("rollback 10"), "rolled back")
    assert_eq(sx_codes(d.on(d.send(Commit(1)))), "W2001")

@test
stx_begin_execute_execute_commit_in_one_flight()
    var d = sx_open()
    val ss = d.pipeline([Begin(1, no_txn_options()), sx_execute(1, 6), sx_execute(1, 1), Commit(1)])

    assert_eq(sx_codes(d.on(ss[0])), "type 160")
    assert_eq(sx_codes(d.on(ss[1])), "type 145 type 146 type 147")
    assert_eq(sx_codes(d.on(ss[2])), "type 145 type 146 type 146 type 146 type 147")
    assert(d.on(ss[3])[0] == TxnCommitted(10, Some(500)), "committed")

    // An aborted pipeline still ends with one definite answer from its Commit.
    val bad = d.pipeline([Begin(2, no_txn_options()), sx_execute(2, 4), sx_execute(2, 1), Commit(2)])
    assert_eq(sx_codes(d.on(bad[1])), "Q3001")
    assert_eq(sx_codes(d.on(bad[2])), "W2003")
    assert_eq(sx_codes(d.on(bad[3])), "Q3001")

@test
stx_handles_that_are_not_open_or_already_open()
    var d = sx_open()
    assert_eq(sx_codes(d.on(d.send(Commit(5)))), "W2001")
    assert_eq(sx_codes(d.on(d.send(Rollback(5)))), "W2001")
    assert_eq(sx_codes(d.on(d.send(sx_execute(5, 1)))), "W2001")
    assert_eq(sx_codes(d.on(d.send(Savepoint(5, "a")))), "W2001")
    assert_eq(sx_codes(d.on(d.send(Begin(0, no_txn_options())))), "W2001")

    d.send(Begin(1, no_txn_options()))
    val twice = d.send(Begin(1, no_txn_options()))
    assert_eq(sx_codes(d.on(twice)), "W2002")
    assert_eq(sx_error(d.on(twice)[0]).txn_state, Unaffected)
    assert_eq(sx_codes(d.on(d.send(sx_execute(1, 2)))), "type 145 type 147")

    // A closed handle may be begun again.
    d.send(Rollback(1))
    assert_eq(sx_codes(d.on(d.send(Begin(1, no_txn_options())))), "type 160")

@test
stx_more_than_max_open_txns_is_w2016()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))
    d.send(Begin(2, no_txn_options()))

    val third = d.send(Begin(3, no_txn_options()))
    assert_eq(sx_codes(d.on(third)), "W2016")
    assert(sx_error(d.on(third)[0]).txn_state == Closed && d.c.handle_state(3).is_none(), "the handle is not open")

    d.send(Commit(1))
    assert_eq(sx_codes(d.on(d.send(Begin(3, no_txn_options())))), "type 160")

@test
stx_rollback_preempts_its_transaction()
    var d = sx_open()
    val ss = d.pipeline([Begin(1, no_txn_options()), sx_execute(1, 3), sx_execute(1, 1), Rollback(1)])

    assert_eq(sx_codes(d.on(ss[1])), "type 145 T1007")
    assert_eq(sx_codes(d.on(ss[2])), "T1007")
    assert_eq(sx_codes(d.on(ss[3])), "type 148")
    assert(d.engine.logged("cancel 1") && d.engine.logged("rollback 10"), "the running one stopped, then rolled back")
    assert(!d.engine.logged("start 1 in 10"), "the queued one never ran")
    assert_eq(d.s.open_txns(), 0)

@test
stx_a_commit_with_an_unknown_outcome_is_resolved_by_status()
    var d = sx_open()
    d.engine.commit_fails = Some(sx_failure("T2001"))
    d.send(Begin(1, no_txn_options()))
    d.send(sx_execute(1, 6))

    val c = d.send(Commit(1))
    val e = sx_error(d.on(c)[0])
    assert(e.entries[0].code == "T2001" && !e.retryable && e.txn_state == Closed && e.txid == Some(10), "commit_unknown")
    assert(d.saw(Unresolved(10)) && d.c.unresolved().len() == 1, "the client must resolve it")

    // Still in progress: the client asks again.
    assert_eq(sx_codes(d.on(d.send(TransactionStatus(10)))), "type 162")
    assert_eq(d.c.unresolved().len(), 1)

    d.engine.settle(10, Committed, Some(77))
    d.send(TransactionStatus(10))
    assert(d.saw(Resolved(10, Committed)) && d.c.unresolved().len() == 0, "resolved")

    assert_eq(sx_codes(d.on(d.send(TransactionStatus(3)))), "W2010")

@test
stx_a_lost_connection_leaves_commits_and_implicit_writes_unresolved()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))
    d.send(sx_execute(0, 3))

    // The Commit goes out, and the connection is lost before any answer.
    d.c.request(Commit(1), 0)
    val st = d.c.lost()
    d.take_client(st)

    assert(d.saw(Unresolved(10)) && d.saw(Unresolved(11)), "the commit's txid and the implicit statement's")

    // A read-only implicit statement leaves nothing to resolve.
    var r = sx_open()
    val ro = ExecuteMsg(Execute(0, Some(TxnOptions(None, None, Some(true), None, None, None, None)), no_exec_options(),
        sx_envelope(3), buf(), None))
    r.send(ro)
    r.take_client(r.c.lost())
    assert_eq(r.c.unresolved().len(), 0)

@test
stx_a_server_whose_connection_ends_rolls_back_every_open_transaction()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))
    d.send(Begin(2, no_txn_options()))
    d.send(sx_execute(2, 3))

    d.take_server(d.s.lost())
    assert(d.engine.logged("rollback 10") && d.engine.logged("rollback 11") && d.engine.logged("cancel 1"), "all rolled back")
    assert(d.s.phase == Ended, "ended")

@test
stx_terminate_rolls_back_and_the_server_says_nothing()
    var d = sx_open()
    d.send(Begin(1, no_txn_options()))
    val before = d.served.len()

    d.take_client(d.c.terminate(0))
    d.flush()

    assert(d.engine.logged("rollback 10") && d.served.len() == before && d.s.phase == Ended, "silent close")

@test
stx_options_absent_from_begin_take_the_session_defaults()
    var cc = sx_client_config("alice", [ScramPlus])
    cc.defaults = SessionDefaults(Some(ReadCommitted), None, None, None, None)
    var d = sx_duo_with(cc, sx_server_config())
    d.connect()

    val b = d.send(Begin(1, no_txn_options()))
    assert(d.on(b)[0] == TxnBegun(10, 100, ReadCommitted), "the connection's default")
    val o = d.send(Begin(2, TxnOptions(Some(Snapshot), None, None, None, None, None, None)))
    assert(d.on(o)[0] == TxnBegun(11, 100, Snapshot), "an explicit option wins")
