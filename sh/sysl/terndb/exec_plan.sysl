module sh.sysl.terndb

import sysl.buf.{Buf, buf}

// From a typed query tree to a tree of operators. The type checker gives every `Rel` and `Expr` node
// its type in pre-order (`Typing.nodes`, `qtree_types.sysl`); this walk visits the nodes in the same
// order and takes each one's type as it goes, so that no type is derived twice.
//
// The executor runs the nodes `docs/design/executor.md` lists; handing it any other is a caller's
// error and stops the program, as handing `compare.sysl` a value of the wrong shape does.

/** A table's rows held in memory, which a `Scan` of `name` reads (a stand-in for storage). */
struct MemTable
    name: QualName
    batches: Buf[ColumnVector]

/** A lowered relation: its operator, the binder it exposes and the type of its batches, and, for a
 * `Sort`, its keys (which a `Limit` with ties above it compares by). A node exposing several binders
 * exposes them as one composite (`exec_join.sysl`): binder `Composite`, batches a record of binders.
 */
struct Lowered
    op: &Operator
    binder: string
    elem: Type
    keys: Buf[TKey]

private[terndb] struct Planner
    types: Buf[Type]
    at: usize
    ctx: Ctx
    tables: Buf[MemTable]
    /** The outer rows a correlated subtree is planned for, one per binder (`exec_nest.sysl`). */
    outer: Buf[Binder]
    /** The CTEs in scope, innermost last (`exec_setop.sysl`). A buffer here is never changed once
     * made, since a `SubPlan` keeps it.
     */
    ctes: Buf[CteFrame]
    /** The store a `Scan` reads, when the statement runs in a transaction (`exec_dml.sysl`). */
    db: Option[Db]
    /** The parameter an `Action` of a `returning` item reads (`exec_dml.sysl`), once one is planned. */
    action: Option[u64]

    /** The parameter every `Action` reads, appended on first use. */
    action_param(*self) -> u64
        self.action match
            Some(i) -> return i
            None -> ()

        val i = self.bind(Null)
        self.action = Some(i)
        i

    take_type(*self) -> Type
        val t = self.types[self.at]
        self.at += 1
        t

    /** `v` appended to the parameters: the index a correlated reference reads it at. */
    bind(*self, v: Value) -> u64
        val ps = buf[Value]()
        ps.extend(self.ctx.params.view())
        ps.push(v)
        self.ctx = self.ctx.with_params(ps)
        u64(ps.len() - 1)

    /** `r` kept to be planned per outer row, and planned here once for its shape, which steps over
     * its types.
     */
    sub(*self, r: Rel) -> (SubPlan, Lowered)
        val s = SubPlan(r, self.types, self.at, self.tables, self.outer, self.ctes, self.db)
        (s, self.rel(r))

    expr(*self, e: Expr) -> TExpr
        val ty = self.take_type()
        val kids = buf[TExpr]()

        e match
            Col(_, _) | Row(_) ->
                outer_value(self.outer, e, ty) match
                    Some(v) -> return TExpr(Param(self.bind(v)), ty, kids, None)
                    None -> ()
            Relation(r) | Scalar(r) | Exists(r) ->
                val (s, _) = self.sub(*r)
                return TExpr(e, ty, kids, Some(s))
            In(es, r) ->
                for a in es
                    kids.push(self.expr(a))

                val (s, _) = self.sub(*r)
                return TExpr(e, ty, kids, Some(s))
            Param(_) | Null(_) | Literal(_, _) -> ()
            Call(_, args) ->
                for a in args
                    kids.push(self.expr(a))
            Cast(inner, _, _) | Field(inner, _) | Variant(_, _, inner) -> kids.push(self.expr(*inner))
            If(arms, otherwise) ->
                for a in arms
                    kids.push(self.expr(a.cond))
                    kids.push(self.expr(a.value))

                otherwise match
                    Some(x) -> kids.push(self.expr(*x))
                    None -> ()
            Match(scrutinee, arms, otherwise) ->
                kids.push(self.expr(*scrutinee))

                for a in arms
                    kids.push(self.expr(a.expr))

                otherwise match
                    Some(x) -> kids.push(self.expr(*x))
                    None -> ()
            Record(fields) ->
                for f in fields
                    kids.push(self.expr(f.expr))
            Action -> return TExpr(Param(self.action_param()), ty, kids, None)

        TExpr(e, ty, kids, None)
    end expr

    opt_expr(*self, e: Option[Expr]) -> Option[TExpr] = e match
        Some(x) -> Some(self.expr(x))
        None -> None

    rel(*self, r: Rel) -> Lowered
        val elem = self.take_type() match
            Bag(e) | List(e) -> *e
            _ -> panic("a relation's type is a bag or a list")

        val none = buf[TKey]()

        r match
            Scan(table, binder) ->
                self.db match
                    Some(d) -> return Lowered(scan_op(d, table, binder, elem, None, self.ctx), binder, elem, none)
                    None -> ()

                for t in self.tables
                    if t.name == table then return Lowered(mem_source(t.batches), binder, elem, none)

                panic(s"no table '${table.schema}.${table.name}' is in memory")
            Values(binder, _, rows) ->
                val cells = buf[Buf[TExpr]]()

                for row in rows
                    val out = buf[TExpr]()

                    for e in row
                        out.push(self.expr(e))

                    cells.push(out)

                Lowered(ValuesOp(elem, cells, self.ctx, 0), binder, elem, none)
            ParamScan(binder, param) -> Lowered(param_scan(elem, self.ctx.params[usize(param)]), binder, elem, none)
            Filter(input, predicate) ->
                // A filter right over a scan of the store is the scan's logged predicate (`isolation.md`
                // §4.4), unless it holds a subquery, which would read other rows when validated.
                (*input, self.db) match
                    (Scan(table, b), Some(d)) ->
                        val _ = self.take_type()
                        val p = self.expr(predicate)
                        val logged = if has_subquery(p) then None else Some(p)
                        val src = scan_op(d, table, b, elem, logged, self.ctx)
                        return Lowered(FilterOp(src, b, p, self.ctx), b, elem, none)
                    _ -> ()

                val inner = self.rel(*input)
                val p = self.expr(predicate)
                Lowered(FilterOp(inner.op, inner.binder, p, self.ctx), inner.binder, inner.elem, none)
            Project(input, binder, items) ->
                val inner = self.rel(*input)
                val xs = buf[TExpr]()

                for it in items
                    xs.push(self.expr(it.expr))

                Lowered(ProjectOp(inner.op, inner.binder, elem, xs, self.ctx), binder, elem, none)
            Sort(input, keys) ->
                val inner = self.rel(*input)
                val ks = buf[TKey]()

                for k in keys
                    ks.push(TKey(self.expr(k.expr), k.desc, k.nulls_first))

                Lowered(SortOp(inner.op, inner.binder, inner.elem, ks, self.ctx, None), inner.binder, inner.elem, ks)
            Limit(input, count, offset, ties, _) ->
                val inner = self.rel(*input)
                val c = self.opt_expr(count)
                val o = self.opt_expr(offset)
                val op = LimitOp(inner.op, inner.binder, c, o, ties, inner.keys, self.ctx, false, 0, false, 0, None, false)
                Lowered(op, inner.binder, inner.elem, none)
            Distinct(input) ->
                val inner = self.rel(*input)
                val op: &Operator = if inner.binder == Composite then CompositeDistinctOp(inner.op, inner.elem, None) else DistinctOp(inner.op, elem, None)
                Lowered(op, inner.binder, inner.elem, none)
            Tag(input, binder, _, tag) ->
                val inner = self.rel(*input)
                Lowered(TagOp(flat_input(inner), elem, member_index(fields_of_type(elem), tag)), binder, elem, none)
            Join(kind, left, right, on, mark, binder) ->
                val l = self.rel(*left)
                val r2 = self.rel(*right)
                plan_join(kind, l, r2, self.opt_expr(on), mark, binder, self.ctx, true)
            Aggregate(input, binder, keys, aggs) ->
                val inner = self.rel(*input)
                val ks = buf[TExpr]()

                for k in keys
                    ks.push(self.expr(k.expr))

                val cs = buf[TAgg]()

                for a in aggs
                    val c = a.call
                    val args = buf[TExpr]()

                    for x in c.args
                        args.push(self.expr(x))

                    val filter = self.opt_expr(c.filter)
                    val order = buf[TKey]()

                    for k in c.order
                        order.push(TKey(self.expr(k.expr), k.desc, k.nulls_first))

                    cs.push(TAgg(c.function, args, c.distinct, filter, order))

                Lowered(AggregateOp(inner.op, inner.binder, inner.elem, elem, ks, cs, self.ctx, None), binder, elem, none)
            Window(input, binder, items) ->
                val inner = self.rel(*input)
                val ws = buf[TWin]()

                for it in items
                    val c = it.call
                    val args = buf[TExpr]()
                    val part = buf[TExpr]()
                    val order = buf[TKey]()

                    for x in c.args
                        args.push(self.expr(x))

                    for x in c.partition
                        part.push(self.expr(x))

                    for k in c.order
                        order.push(TKey(self.expr(k.expr), k.desc, k.nulls_first))

                    val frame = c.frame match
                        Some(f) ->
                            val s = self.opt_expr(f.start.offset)
                            val e = self.opt_expr(f.end.offset)
                            Some(TFrame(f.unit, TBound(f.start.kind, s), TBound(f.end.kind, e), f.exclude))
                        None -> None

                    ws.push(TWin(c.function, args, part, order, frame))

                plan_window(inner, binder, elem, ws, self.ctx)
            Nest(input, binder, keys, _, items, order) ->
                val inner = self.rel(*input)
                val ks = buf[TExpr]()
                val xs = buf[TExpr]()
                val os = buf[TKey]()

                for k in keys
                    ks.push(self.expr(k.expr))

                for it in items
                    xs.push(self.expr(it.expr))

                for k in order
                    os.push(TKey(self.expr(k.expr), k.desc, k.nulls_first))

                plan_nest(inner, binder, elem, ks, items, xs, os, self.ctx)
            Unnest(input, binder, value, padded, ordinality) ->
                val inner = self.rel(*input)
                val v = self.expr(value)
                plan_unnest(inner, binder, v, padded, ordinality, self.ctx)
            Apply(kind, left, right, on, mark, binder) ->
                val l = self.rel(*left)
                val (s, shape) = self.sub(*right)
                plan_apply(kind, l, s, shape, self.opt_expr(on), mark, binder, self.ctx)
            SetOp(op, all, binder, inputs) ->
                val parts = buf[&Operator]()

                for i in inputs
                    parts.push(flat_input(self.rel(i)))

                Lowered(SetOperator(op, all, elem, parts, 0, None), binder, elem, none)
            With(recursive, ctes, body) ->
                val saved = self.ctes

                if recursive
                    // Every CTE is in scope in every query (§6.13 rule 1), so all are framed first.
                    val stores = buf[&CteStore]()
                    var fs = saved

                    for c in ctes
                        val s: &CteStore = CteStore(c.name, None, None, false)
                        stores.push(s)
                        fs = with_frame(fs, c.name, s)

                    self.ctes = fs

                    for i in 0..<ctes.len()
                        stores[i].source = Some(self.recursive_cte(ctes[i], saved.len() + i))
                else
                    for c in ctes
                        val s: &CteStore = CteStore(c.name, Some(flat_input(self.rel(c.rel))), None, false)
                        self.ctes = with_frame(self.ctes, c.name, s)

                val out = self.rel(*body)
                self.ctes = saved
                out
            CteRef(name, binder) -> Lowered(CteScanOp(cte_store(self.ctes, name), elem, 0), binder, elem, none)
    end rel

    /** The recursive CTE `c`, framed at `slot` (§6.13 rules 3 and 4): its seed planned here, and each
     * recursive input kept to be planned per step.
     */
    recursive_cte(*self, c: CteDef, slot: usize) -> &Operator
        val (all, inputs) = c.rel match
            SetOp(_, all, _, inputs) -> (all, inputs)
            _ -> panic("a recursive CTE is a union (§6.13 rule 3)")

        val elem = self.take_type() match
            Bag(e) | List(e) -> *e
            _ -> panic("a relation's type is a bag or a list")

        val seed = flat_input(self.rel(inputs[0]))
        val steps = buf[SubPlan]()

        for k in 1..<inputs.len()
            val (s, _) = self.sub(inputs[k])
            steps.push(s)

        RecursiveOp(c.name, seed, steps, slot, elem, all, self.ctx, None)
end Planner

/** The operator tree of `env`, a `Query` that `typing` is the type checker's answer for, run with
 * `ctx` against the in-memory `tables`.
 */
plan_query(env: Envelope, typing: Typing, ctx: Ctx, tables: Buf[MemTable]) -> Lowered
    val rel = env.statement match
        Query(r) -> r
        _ -> panic("plan_query: the statement is not a query")

    var p = Planner(typing.nodes, 0, ctx, tables, buf[Binder](), buf[CteFrame](), None, None)
    p.rel(rel)

/** The correlated subtree `s` planned with `ctx` for the outer rows `outer` (`exec_nest.sysl`). */
private[terndb] plan_sub(s: SubPlan, ctx: Ctx, outer: Buf[Binder]) -> Lowered
    var p = Planner(s.types, s.at, ctx, s.tables, outer, s.ctes, s.db, None)
    p.rel(s.rel)

/** `env` type-checked against `catalog`, run with `ctx` over `tables`, and its output as the result
 * format's batches for parameter tuple 0: what an `Execute` of the query sends after its header.
 */
run_query(env: Envelope, catalog: &Catalog, ctx: Ctx, tables: Buf[MemTable]) -> Result[(Type, Buf[Buf[u8]]), CodecError]
    val typing = type_envelope(env, catalog)?
    val result = typing.result.unwrap()
    val root = plan_query(env, typing, ctx, tables)
    Ok((result, result_batches(result, flat_input(root), 0)?))
