module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.slices.sort_stable_by

// The relational operators (`query-tree.md` §6, `docs/design/executor.md` §4). Each is pulled for
// its next batch: one vector of the node's element type, never empty, or `None` at the end. Every
// node here exposes one binder, so a batch is that binder's rows.

trait Operator
    /** The next batch of at least one row, or `None` once every row has been handed up. */
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]

/** A sort key with its expression typed (§6.9). */
struct TKey
    expr: TExpr
    desc: bool
    nulls_first: bool

/** Every batch `op` hands up, in order. */
drain(op: &Operator) -> Result[Buf[ColumnVector], CodecError]
    val out = buf[ColumnVector]()

    loop
        op.next_batch()? match
            Some(b) -> out.push(b)
            None -> return Ok(out)

/** Every row `op` hands up, as one vector of `elem`. */
drain_rows(op: &Operator, elem: Type) -> Result[ColumnVector, CodecError] = Ok(concat(elem, drain(op)?.view()))

// -- sources ------------------------------------------------------------------------------------

/** Batches already in memory, handed up in order: a stand-in for `Scan` (§6.1), and what `Values`
 * and `ParamScan` produce once their rows are built. Empty batches are skipped.
 */
struct MemSource
    batches: Buf[ColumnVector]
    at: usize

impl Operator for MemSource
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        while self.at < self.batches.len()
            val b = self.batches[self.at]
            self.at += 1

            if b.len > 0 then return Ok(Some(b))

        Ok(None)

mem_source(batches: Buf[ColumnVector]) -> &Operator = MemSource(batches, 0)

/** `Values` (§6.2): each row's expressions, evaluated with no binder of the input in sight and
 * coerced to their column's type, cut into batches in row order.
 */
struct ValuesOp
    elem: Type
    rows: Buf[Buf[TExpr]]
    ctx: Ctx
    at: usize

impl Operator for ValuesOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if self.at >= self.rows.len() then return Ok(None)

        val fs = fields_of_type(self.elem)
        val end = if self.at + BatchSize < self.rows.len() then self.at + BatchSize else self.rows.len()
        val one = rows_env(self.ctx, 1)
        val cs = buf[ColumnVector]()

        for j in 0..<fs.len()
            val cells = buf[ColumnVector]()

            for r in self.at..<end
                cells.push(coerce_vector(eval(self.rows[r][j], one)?, fs[j].ty)?)

            cs.push(concat(fs[j].ty, cells.view()))

        val n = end - self.at
        self.at = end
        Ok(Some(ColumnVector(self.elem, n, buf[u8](), Members(cs))))
end ValuesOp

/** `ParamScan` (§6.3): the relation-valued parameter `value`'s elements, cut into batches. */
param_scan(elem: Type, value: Value) -> &Operator
    val elems = value match
        Relation(es) -> es
        _ -> panic("param_scan: a relation value was expected")

    mem_source(batches_of(vector_of(elem, elems.view())))

// -- Filter and Project, §6.4 --------------------------------------------------------------------

/** The rows where the predicate is `true`; `false` and null drop the row. Order is kept. */
struct FilterOp
    input: &Operator
    binder: string
    predicate: TExpr
    ctx: Ctx

impl Operator for FilterOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        loop
            val b = self.input.next_batch()? match
                Some(x) -> x
                None -> return Ok(None)

            val p = eval(self.predicate, env_of(self.ctx, self.binder, b))?
            val keep = p.lanes match
                Bools(x) -> x
                _ -> panic("FilterOp: the predicate is not bool")

            // The compress step the design note marks: the kept rows, gathered by a scalar loop.
            val rows = buf[usize]()

            for i in 0..<b.len
                if keep[i] && p.is_valid(i) then rows.push(i)

            if rows.len() == b.len then return Ok(Some(b))
            if rows.len() > 0 then return Ok(Some(take(b, rows.view())))

/** One vector per item, evaluated once per input row, as the binder's record `elem`. */
struct ProjectOp
    input: &Operator
    binder: string
    elem: Type
    items: Buf[TExpr]
    ctx: Ctx

impl Operator for ProjectOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        val b = self.input.next_batch()? match
            Some(x) -> x
            None -> return Ok(None)

        val env = env_of(self.ctx, self.binder, b)
        val fs = fields_of_type(self.elem)
        val cs = buf[ColumnVector]()

        for j in 0..<self.items.len()
            cs.push(eval(self.items[j], env)?.as_type(fs[j].ty))

        Ok(Some(ColumnVector(self.elem, b.len, buf[u8](), Members(cs))))

// -- ordering rows ------------------------------------------------------------------------------

/** How two rows of one vector compare, by `cmp` (§3.3) below the top level. A scalar compares on its
 * typed lane; a record, union or relation through `compare.cmp` on its values.
 */
private[terndb] slot_order(v: ColumnVector) -> &Fn(usize, usize) -> i8 = v.lanes match
    Bools(x) -> (i, j) -> sign(u8(x[i]), u8(x[j]))
    I8s(x) -> (i, j) -> sign(x[i], x[j])
    I16s(x) -> (i, j) -> sign(x[i], x[j])
    I32s(x) -> (i, j) -> sign(x[i], x[j])
    I64s(x) -> (i, j) -> sign(x[i], x[j])
    I128s(x) -> (i, j) -> sign(x[i], x[j])
    U8s(x) -> (i, j) -> sign(x[i], x[j])
    U16s(x) -> (i, j) -> sign(x[i], x[j])
    U32s(x) -> (i, j) -> sign(x[i], x[j])
    U64s(x) -> (i, j) -> sign(x[i], x[j])
    Uuids(x) -> (i, j) -> sign(x[i], x[j])
    F32s(_) | F64s(_) ->
        val x = reals_of(v.lanes)
        (i, j) -> float_order(x[i], x[j])
    Intervals(x) -> (i, j) -> ival_order(x[i], x[j])
    Bins(o, d) -> (i, j) -> octet_order(d.view()[usize(o[i])..<usize(o[i + 1])], d.view()[usize(o[j])..<usize(o[j + 1])])
    _ ->
        val t = v.ty
        val vals = values_of(v)
        (i, j) -> i8(cmp(t, vals[i], vals[j]))

/** A sort key's values for every row, and how its rows order: null first or last at the top level
 * per `nulls_first`, `desc` reversing the order of the values (§6.9).
 */
private[terndb] struct KeyOrder
    v: ColumnVector
    order: &Fn(usize, usize) -> i8
    desc: bool
    nulls_first: bool

    compare(self, i: usize, j: usize) -> i8
        val (a, b) = (self.v.is_valid(i), self.v.is_valid(j))

        if !a || !b
            if a == b then return 0

            return if !a == self.nulls_first then -1 else 1

        val order = self.order
        val c = order(i, j)
        if self.desc then -c else c

private[terndb] key_order(v: ColumnVector, desc: bool, nulls_first: bool) -> KeyOrder = KeyOrder(v, slot_order(v), desc, nulls_first)

private[terndb] compare_rows(keys: Buf[KeyOrder], i: usize, j: usize) -> i8
    for k in keys
        val c = k.compare(i, j)

        if c != 0 then return c

    0

/** The rows `0..<n` in the order of `keys`, rows equal on every key in their input order. */
private[terndb] sorted_rows(keys: Buf[KeyOrder], n: usize) -> Buf[usize]
    var rows = all_rows(n)
    var scratch = all_rows(n)

    if !sort_stable_by(rows.view_mut(), scratch.view_mut(), (p, q) -> compare_rows(keys, p, q) < 0) then
        panic("sorted_rows: the scratch is too short")

    rows

// -- Sort, §6.9 ---------------------------------------------------------------------------------

/** Every input row, ordered by its keys; the sort is stable. It reads its whole input on the first
 * call and hands the rows up in batches.
 */
struct SortOp
    input: &Operator
    binder: string
    elem: Type
    keys: Buf[TKey]
    ctx: Ctx
    out: Option[&Operator]

impl Operator for SortOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if self.out.is_none()
            val all = drain_rows(self.input, self.elem)?
            val env = env_of(self.ctx, self.binder, all)
            val orders = buf[KeyOrder]()

            for k in self.keys
                orders.push(key_order(eval(k.expr, env)?, k.desc, k.nulls_first))

            self.out = Some(mem_source(batches_of(take(all, sorted_rows(orders, all.len).view()))))

        self.out.unwrap().next_batch()

// -- Limit, §6.10 -------------------------------------------------------------------------------

/** The rows after the first `offset`, at most `count` of them (all of them without a count). With
 * `ties`, every further row equal on all of `keys` (the `Sort` below's) to the last kept row is kept
 * as well. `count` and `offset` are evaluated before the first batch and cannot see the input.
 */
struct LimitOp
    input: &Operator
    binder: string
    count: Option[TExpr]
    offset: Option[TExpr]
    ties: bool
    keys: Buf[TKey]
    ctx: Ctx
    started: bool
    left: i64
    unbounded: bool
    skip: i64
    last: Option[Buf[Value]]
    done: bool

    private bound(self, e: Option[TExpr], absent: i64) -> Result[i64, CodecError]
        val x = e match
            Some(x) -> x
            None -> return Ok(absent)

        val n = value_at(eval(x, rows_env(self.ctx, 1))?, 0) match
            Int(v) -> i64(v)
            _ -> panic("LimitOp: a count is int64")

        if n < 0 then return fail("R0006", "a Limit count or offset is negative")

        Ok(n)

    // The key values of row `i` of `b`.
    private key_values(self, b: ColumnVector, i: usize) -> Result[Buf[Value], CodecError]
        val env = env_of(self.ctx, self.binder, slice(b, i, i + 1))
        val out = buf[Value]()

        for k in self.keys
            out.push(value_at(eval(k.expr, env)?, 0))

        Ok(out)

    private ties_last(self, row: Buf[Value]) -> bool
        val last = self.last.unwrap()

        for j in 0..<self.keys.len()
            if !same(self.keys[j].expr.ty, row[j], last[j]) then return false

        true
end LimitOp

impl Operator for LimitOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if !self.started
            self.started = true
            self.unbounded = self.count.is_none()
            self.left = self.bound(self.count, 0)?
            self.skip = self.bound(self.offset, 0)?

        loop
            if self.done then return Ok(None)

            val b = self.input.next_batch()? match
                Some(x) -> x
                None -> return Ok(None)

            var start: usize = 0

            if self.skip > 0
                if i64(b.len) <= self.skip
                    self.skip -= i64(b.len)
                    continue

                start = usize(self.skip)
                self.skip = 0

            if self.unbounded then return Ok(Some(if start == 0 then b else slice(b, start, b.len)))

            var end = start

            while end < b.len && self.left > 0
                end += 1
                self.left -= 1

            if self.ties && end > start then self.last = Some(self.key_values(b, end - 1)?)

            if self.left == 0
                if self.ties && self.last.is_some()
                    while end < b.len && self.ties_last(self.key_values(b, end)?)
                        end += 1

                    // A batch's last row may tie with the next batch's first.
                    if end < b.len then self.done = true
                else
                    self.done = true

            if end > start then return Ok(Some(slice(b, start, end)))
end LimitOp

// -- Distinct, §6.11 ----------------------------------------------------------------------------

/** One row of each set of rows that are `same` (§3.1). The rows are sorted by `cmp` (§3.3) over
 * every column, which is zero exactly where `same` holds, and the first of each run kept; the output
 * is a bag, handed up in that order.
 */
struct DistinctOp
    input: &Operator
    elem: Type
    out: Option[&Operator]

impl Operator for DistinctOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if self.out.is_none()
            val all = drain_rows(self.input, self.elem)?
            val orders = buf[KeyOrder]()

            // A record's rows order field by field; any other element orders as itself.
            all.ty.base() match
                Record(fs) ->
                    if all.has_nulls()
                        orders.push(key_order(all, false, true))
                    else
                        for j in 0..<fs.len()
                            orders.push(key_order(all.member(j), false, true))
                _ -> orders.push(key_order(all, false, true))

            val rows = sorted_rows(orders, all.len)
            val kept = buf[usize]()

            for k in 0..<rows.len()
                if k == 0 || compare_rows(orders, rows[k - 1], rows[k]) != 0 then kept.push(rows[k])

            self.out = Some(mem_source(batches_of(take(all, kept.view()))))

        self.out.unwrap().next_batch()

// -- Tag, §6.15 ---------------------------------------------------------------------------------

/** The input rows, coerced to the payload of variant `tag` of the union `elem`, as that variant. */
struct TagOp
    input: &Operator
    elem: Type
    tag: usize

impl Operator for TagOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        val b = self.input.next_batch()? match
            Some(x) -> x
            None -> return Ok(None)

        val vs = fields_of_type(self.elem)
        val tags = buf[u16]()
        val offsets = buf[u32]()
        val cs = buf[ColumnVector]()

        for i in 0..<b.len
            tags.push(u16(self.tag))
            offsets.push(u32(i))

        for k in 0..<vs.len()
            cs.push(if k == self.tag then coerce_vector(b, vs[k].ty)? else empty_vector(vs[k].ty))

        Ok(Some(ColumnVector(self.elem, b.len, buf[u8](), Tags(tags, offsets, cs))))

// -- the result ---------------------------------------------------------------------------------

/** The `Batch` payloads (`wire-protocol.md` §6.4) of every batch `op` hands up, for parameter tuple
 * `tuple` of a result of type `result_type`; each decodes with `decode_batch`.
 */
result_batches(result_type: Type, op: &Operator, tuple: u64) -> Result[Buf[Buf[u8]], CodecError]
    val out = buf[Buf[u8]]()

    loop
        op.next_batch()? match
            Some(b) -> out.push(encode_batch(result_type, values_of(b).view(), tuple)?)
            None -> return Ok(out)
