module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// `AlterTable`, `AlterType` and the conversions they rest on, against the in-memory catalog: every
// action applied and refused for each catalog rule, the schema versions they add (`ddl.md` §5.1), and
// the rewriting of the definitions and views a rename touches (§8.4).

private version_of(c: MemCatalog, name: string) -> u64 = cat_table_of(c, name).schema_version()

private column_of(c: MemCatalog, table: string, name: string) -> CatColumn = cat_table_of(c, table).column_named(name).unwrap()

private constraint_named(c: MemCatalog, name: string) -> Option[CatConstraint]
    for k in c.constraints
        if k.name == name then return Some(k)

    None

/** `cat_base()` with a check `a_pos` on `a`, an index `t_a` on `a`, and a view `va` reading `a`. */
private with_dependents() -> MemCatalog
    var c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_check("a_pos", call("gt", [cat_row("a"), Literal(Int32, Int(0))])), false)]))
    c = cat_ok(c, cat_index("t_a", "t", ["a"]))
    cat_ok(c, cat_view("va", cat_pick("t", "x", "r", ["id", "a"])))

// -- add_column --------------------------------------------------------------------------------------

@test
an_added_column_with_a_constant_default_is_ready_with_that_fill()
    val d = ColumnDef("n", Int64, Some(cat_int(5)), None, NoIdentity, None)
    val c = cat_ok(cat_base(), cat_alter("t", [AddColumn(d), AddColumn(cat_col("m", nullable(Text)))]))
    assert_eq(version_of(c, "t"), 2)
    assert_eq(cat_columns(cat_info(c, "t")), "id,a,b,n,m")
    val n = column_of(c, "t", "n")
    assert(n.state == ColumnReady && n.fill == Some(cat_int(5)) && n.id == 4)
    assert(column_of(c, "t", "m").fill.is_none())

    // The old version keeps the old column list.
    assert_eq(cat_table_of(c, "t").versions[0].columns.len(), 3)
    assert_eq(cat_table_of(c, "t").versions[1].columns.len(), 5)

@test
an_added_column_that_needs_a_job_is_filling_and_invisible()
    val volatile = ColumnDef("at", Timestamp, Some(call("statement_timestamp", [])), None, NoIdentity, None)
    val ident = ColumnDef("seq", Int64, None, None, ByDefault, None)
    val c = cat_ok(cat_base(), cat_alter("t", [AddColumn(volatile), AddColumn(ident)]))
    assert(column_of(c, "t", "at").state == ColumnFilling && column_of(c, "t", "at").fill.is_none())
    assert(column_of(c, "t", "seq").state == ColumnFilling)
    assert_eq(cat_columns(cat_info(c, "t")), "id,a,b")
    assert(c.sequences[c.sequence_at(cat_q("t_seq_seq")).unwrap()].owner_column == 5)

@test
an_added_column_is_new_non_null_only_with_a_default()
    assert_eq(cat_code(cat_base(), cat_alter("t", [AddColumn(cat_col("n", Int64))])), "Q3005")
    assert_eq(cat_code(cat_base(), cat_alter("t", [AddColumn(cat_col("b", nullable(Text)))])), "Q6002")
    assert_eq(cat_code(cat_base(), cat_alter("missing", [AddColumn(cat_col("n", nullable(Int64)))])), "Q2001")

@test
a_statement_that_changes_only_constraints_keeps_the_schema_version()
    val c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_unique("t_b", ["b"]), false), RenameConstraint("t_b", "t_b_key")]))
    assert_eq(version_of(c, "t"), 1)
    assert(c.indexes[c.index_at(cat_q("t_b_key")).unwrap()].state == IndexBuilding)

@test
the_sixty_five_thousand_five_hundred_thirty_sixth_version_is_refused()
    var c = cat_base()
    c.tables[c.table_at(cat_q("t")).unwrap()].versions.push(SchemaVersion(65535, cat_table_of(c, "t").columns.copy(), buf[u32]()))
    assert_eq(cat_code(c, cat_alter("t", [AddColumn(cat_col("n", nullable(Int64)))])), "Q6012")
    assert_eq(cat_code(c, cat_alter("t", [AddConstraint(cat_unique("t_b", ["b"]), false)])), "ok")

// -- drop_column -------------------------------------------------------------------------------------

@test
a_dropped_column_leaves_the_current_version_only()
    val c = cat_ok(cat_base(), cat_alter("t", [DropColumn("b", false)]))
    assert_eq(cat_columns(cat_info(c, "t")), "id,a")
    assert_eq(version_of(c, "t"), 2)
    assert_eq(cat_code(cat_base(), cat_alter("t", [DropColumn("id", true)])), "Q6007")
    assert_eq(cat_code(cat_base(), cat_alter("t", [DropColumn("nope", false)])), "Q2003")

@test
a_column_that_an_index_check_or_view_uses_drops_only_with_cascade()
    val c = with_dependents()
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("a", false)])), "Q6007")

    val d = cat_ok(c, cat_alter("t", [DropColumn("a", true)]))
    assert(d.index_at(cat_q("t_a")).is_none())
    assert(constraint_named(d, "a_pos").is_none())
    assert(d.view_at(cat_q("va")).is_none())
    assert_eq(cat_columns(cat_info(d, "t")), "id,b")

    // Each dependent alone is enough to refuse it.
    val only_index = cat_ok(cat_base(), cat_index("t_a", "t", ["a"]))
    assert_eq(cat_code(only_index, cat_alter("t", [DropColumn("a", false)])), "Q6007")
    val only_check = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_check("a_pos", call("gt", [cat_row("a"), Literal(Int32, Int(0))])), false)]))
    assert_eq(cat_code(only_check, cat_alter("t", [DropColumn("a", false)])), "Q6007")
    val only_view = cat_ok(cat_base(), cat_view("va", cat_pick("t", "x", "r", ["a"])))
    assert_eq(cat_code(only_view, cat_alter("t", [DropColumn("a", false)])), "Q6007")
    val whole_row = cat_ok(cat_base(), cat_view("vr", Project(scan("app", "t", "x"), "r", items_of([item("all", Row("x"))]))))
    assert_eq(cat_code(whole_row, cat_alter("t", [DropColumn("b", false)])), "Q6007")

    // A view of another table that happens to name a column `a` is not a dependent.
    var other = cat_ok(cat_base(), cat_table("u", [cat_col("id", Int64), cat_col("a", Int32)], ["id"]))
    other = cat_ok(other, cat_view("ua", cat_pick("u", "x", "r", ["a"])))
    assert_eq(cat_code(other, cat_alter("t", [DropColumn("a", false)])), "ok")

@test
a_column_a_generated_column_reads_never_drops_even_with_cascade()
    val g = ColumnDef("g", nullable(Int32), None, Some(call("add", [cat_row("a"), Literal(Int32, Int(1))])), NoIdentity, None)
    val c = cat_ok(cat_base(), cat_alter("t", [AddColumn(g)]))
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("a", true)])), "Q6007")
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("g", false)])), "ok")

@test
a_column_a_foreign_key_references_drops_with_the_key_and_its_foreign_keys()
    var c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_unique("t_b", ["b"]), true)]))
    c = cat_ok(c, cat_table("child", [cat_col("id", Int64), cat_col("tb", Text)], ["id"], [cat_fk("child_tb", ["tb"], "t", ["b"])]))
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("b", false)])), "Q6007")

    val d = cat_ok(c, cat_alter("t", [DropColumn("b", true)]))
    assert(constraint_named(d, "t_b").is_none() && constraint_named(d, "child_tb").is_none())
    assert(d.index_at(cat_q("t_b")).is_none())
    assert_eq(cat_columns(cat_info(d, "child")), "id,tb")

    // The referencing column goes with its foreign key.
    val e = cat_ok(c, cat_alter("child", [DropColumn("tb", true)]))
    assert(constraint_named(e, "child_tb").is_none() && constraint_named(e, "t_b").is_some())
    assert_eq(cat_code(c, cat_alter("child", [DropColumn("tb", false)])), "Q6007")

@test
an_identity_column_takes_its_sequence_when_it_drops()
    val c = cat_ok(cat_base(), cat_alter("t", [AddColumn(ColumnDef("n", Int64, None, None, ByDefault, None))]))
    assert(c.sequence_at(cat_q("t_n_seq")).is_some())
    val d = cat_ok(c, cat_alter("t", [DropColumn("n", false)]))
    assert(d.sequence_at(cat_q("t_n_seq")).is_none())
    assert_eq(cat_code(c, DropSequence(cat_q("t_n_seq"), false)), "Q6007")

// -- rename_column -----------------------------------------------------------------------------------

@test
a_renamed_column_is_renamed_in_every_definition_and_view_that_reads_it()
    val c = cat_ok(with_dependents(), cat_alter("t", [RenameColumn("a", "alpha")]))
    assert_eq(cat_columns(cat_info(c, "t")), "id,alpha,b")
    assert_eq(version_of(c, "t"), 2)

    constraint_named(c, "a_pos").unwrap().kind match
        ConCheck(e) -> assert(e == call("gt", [cat_row("alpha"), Literal(Int32, Int(0))]))
        _ -> assert(false)

    // The index names the column by id and is untouched; the view reads the new name and keeps its own.
    assert(c.indexes[c.index_at(cat_q("t_a")).unwrap()].keys[0].key == KeyOn(2))
    val v = c.views[c.view_at(cat_q("va")).unwrap()]
    assert(v.query == Project(scan("app", "t", "x"), "r", items_of([item("id", col("x", "id")), item("a", col("x", "alpha"))])))
    assert_eq(cat_columns(cat_info(c, "va")), "id,a")

    assert_eq(cat_code(with_dependents(), cat_alter("t", [RenameColumn("a", "b")])), "Q6002")
    assert_eq(cat_code(with_dependents(), cat_alter("t", [RenameColumn("nope", "x")])), "Q2003")

@test
a_rename_that_would_change_a_views_own_columns_is_refused()
    val c = cat_ok(cat_base(), cat_view("whole", scan("app", "t", "x")))
    assert_eq(cat_code(c, cat_alter("t", [RenameColumn("a", "alpha")])), "Q6007")

@test
a_renamed_table_is_renamed_in_the_views_that_scan_it()
    val c = cat_ok(with_dependents(), cat_alter("t", [RenameTable("t2")]))
    assert(c.table_at(cat_q("t")).is_none())
    assert_eq(cat_columns(cat_info(c, "t2")), "id,a,b")
    assert(rel_refs(c.views[c.view_at(cat_q("va")).unwrap()].query).scans[0].table == cat_q("t2"))
    assert_eq(version_of(c, "t2"), 1)
    assert_eq(cat_code(with_dependents(), cat_alter("t", [RenameTable("va")])), "Q6002")

// -- retype_column -----------------------------------------------------------------------------------

@test
a_lossless_retype_is_metadata_only_and_another_converts()
    val c = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("a", nullable(Int64), None)]))
    assert(column_of(c, "t", "a").ty == nullable(Int64) && column_of(c, "t", "a").state == ColumnReady)
    assert_eq(version_of(c, "t"), 2)

    val d = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    val a = column_of(d, "t", "a")
    assert(a.state == ColumnConverting && a.ty == nullable(Int32) && a.target == Some(nullable(Int16)))
    assert(a.using == Some(Cast(cat_row("a"), nullable(Int16), Strict)))
    assert_eq(cat_columns(cat_info(d, "t")), "id,b")

    val using = call("length", [cat_row("b")])
    val e = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("b", Int64, Some(using))]))
    assert(column_of(e, "t", "b").state == ColumnConverting)

@test
a_retype_with_no_conversion_or_under_a_view_is_refused()
    assert_eq(cat_code(cat_base(), cat_alter("t", [RetypeColumn("a", nullable(Date), None)])), "Q6008")
    assert_eq(cat_code(cat_base(), cat_alter("t", [RetypeColumn("a", Int64, None)])), "Q6008")
    assert_eq(cat_code(cat_base(), cat_alter("t", [RetypeColumn("b", Int64, Some(cat_text("x")))])), "Q3001")
    assert_eq(cat_code(with_dependents(), cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6007")
    assert_eq(cat_code(cat_base(), cat_alter("t", [RetypeColumn("id", nullable(Int64), None)])), "Q6005")
    assert_eq(cat_code(cat_base(), cat_alter("t", [RetypeColumn("id", Json, Some(Literal(Json, Text("1"))))])), "Q6005")

    // A view that reads the column only in a filter still holds it.
    val filtered = Project(Filter(scan("app", "t", "x"), call("gt", [col("x", "a"), Literal(Int32, Int(0))])), "r", items_of([item("id", col("x", "id"))]))
    val c = cat_ok(cat_base(), cat_view("vf", filtered))
    assert_eq(cat_code(c, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6007")

@test
lossless_conversions_are_exactly_those_of_section_five_point_three()
    assert(is_lossless(Int16, Int32) && !is_lossless(Int32, Int16) && !is_lossless(Int32, UInt64))
    assert(is_lossless(UInt16, Int32) && !is_lossless(UInt32, Int32) && is_lossless(UInt8, UInt16))
    assert(is_lossless(Int32, Decimal(10, 0)) && !is_lossless(Int32, Decimal(9, 0)) && is_lossless(UInt64, Decimal(20, 0)))
    assert(is_lossless(Decimal(5, 2), Decimal(7, 3)) && !is_lossless(Decimal(5, 2), Decimal(5, 3)))
    assert(is_lossless(Float32, Float64) && is_lossless(Int16, Float32) && !is_lossless(Int32, Float32) && is_lossless(Int32, Float64))
    assert(!is_lossless(Int64, Float64) && is_lossless(Json, Text) && !is_lossless(Text, Json))
    assert(is_lossless(Int32, nullable(Int32)) && !is_lossless(nullable(Int32), Int32))
    assert(is_lossless(list(Int16), bag(Int32)) && !is_lossless(bag(Int16), list(Int16)))
    assert(is_lossless(record([Field("x", Int16)]), record([Field("y", Int32), Field("z", nullable(Text))])))
    assert(!is_lossless(record([Field("x", Int16)]), record([Field("x", Int16), Field("z", Text)])))
    assert(is_lossless(union_of([Field("a", record([]))]), union_of([Field("b", record([])), Field("c", record([]))])))
    assert(!is_lossless(union_of([Field("a", record([])), Field("b", record([]))]), union_of([Field("a", record([]))])))

// -- defaults and nullability ------------------------------------------------------------------------

@test
a_default_is_set_and_dropped_on_an_ordinary_column_only()
    val c = cat_ok(cat_base(), cat_alter("t", [SetColumnDefault("b", Some(cat_text("none")))]))
    assert(column_of(c, "t", "b").default == Some(cat_text("none")))
    assert_eq(version_of(c, "t"), 2)
    val d = cat_ok(c, cat_alter("t", [SetColumnDefault("b", None)]))
    assert(column_of(d, "t", "b").default.is_none())

    assert_eq(cat_code(cat_base(), cat_alter("t", [SetColumnDefault("b", Some(cat_int(1)))])), "Q3001")
    val g = cat_ok(cat_base(), cat_alter("t", [AddColumn(ColumnDef("g", Int64, None, Some(cat_row("id")), NoIdentity, None))]))
    assert_eq(cat_code(g, cat_alter("t", [SetColumnDefault("g", Some(cat_int(1)))])), "Q6006")

@test
not_null_is_dropped_at_once_and_set_through_a_check()
    val c = cat_ok(cat_base(), cat_alter("t", [SetNullable("b", true)]))
    assert(column_of(c, "t", "b").ty == nullable(Text))
    assert_eq(version_of(c, "t"), 2)
    assert_eq(cat_code(cat_base(), cat_alter("t", [SetNullable("id", true)])), "Q6005")

    val d = cat_ok(cat_base(), cat_alter("t", [SetNullable("a", false)]))
    val k = constraint_named(d, "a_not_null").unwrap()
    assert(!k.validated && k.job)
    assert(column_of(d, "t", "a").ty == nullable(Int32))
    assert_eq(version_of(d, "t"), 1)

    // Dropping not null under a view that outputs the column would change the view.
    assert_eq(cat_code(with_dependents(), cat_alter("t", [SetNullable("b", true)])), "ok")
    val v = cat_ok(cat_base(), cat_view("vb", cat_pick("t", "x", "r", ["b"])))
    assert_eq(cat_code(v, cat_alter("t", [SetNullable("b", true)])), "Q6007")

// -- constraints ---------------------------------------------------------------------------------------

@test
an_added_constraint_is_not_validated_and_validation_is_a_job()
    val check = cat_check("b_long", call("gt", [call("length", [cat_row("b")]), cat_int(3)]))
    val c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(check, false)]))
    val k = constraint_named(c, "b_long").unwrap()
    assert(!k.validated && k.job)

    val d = cat_ok(cat_base(), cat_alter("t", [AddConstraint(check, true)]))
    assert(!constraint_named(d, "b_long").unwrap().job)
    val e = cat_ok(d, cat_alter("t", [ValidateConstraint("b_long")]))
    assert(constraint_named(e, "b_long").unwrap().job)
    assert_eq(cat_code(d, cat_alter("t", [ValidateConstraint("nope")])), "Q6003")

@test
a_constraint_is_dropped_unless_it_is_the_primary_key_or_referenced()
    val c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_unique("t_b", ["b"]), true)]))
    val d = cat_ok(c, cat_alter("t", [DropConstraint("t_b", false)]))
    assert(constraint_named(d, "t_b").is_none() && d.index_at(cat_q("t_b")).is_none())

    assert_eq(cat_code(c, cat_alter("t", [DropConstraint("t_pkey", false)])), "Q6009")
    assert_eq(cat_code(c, cat_alter("t", [DropConstraint("nope", false)])), "Q6003")
    assert_eq(cat_code(c, cat_alter("t", [DropConstraint("nope", true)])), "ok")

    val f = cat_ok(c, cat_table("child", [cat_col("id", Int64), cat_col("tb", Text)], ["id"], [cat_fk("child_tb", ["tb"], "t", ["b"])]))
    assert_eq(cat_code(f, cat_alter("t", [DropConstraint("t_b", false)])), "Q6007")
    assert_eq(cat_code(f, cat_alter("child", [DropConstraint("child_tb", false)])), "ok")

@test
a_renamed_constraint_renames_its_index_and_needs_a_free_name()
    val c = cat_ok(cat_base(), cat_alter("t", [AddConstraint(cat_unique("t_b", ["b"]), true), RenameConstraint("t_b", "t_b2")]))
    assert(c.index_at(cat_q("t_b2")).is_some() && c.index_at(cat_q("t_b")).is_none())
    assert_eq(cat_code(c, cat_alter("t", [RenameConstraint("t_b2", "t")])), "Q6002")
    assert_eq(cat_code(c, cat_alter("t", [RenameConstraint("nope", "x")])), "Q6003")

@test
a_new_primary_key_is_non_null_and_unreferenced()
    val c = cat_ok(cat_base(), cat_alter("t", [SetPrimaryKey(items_of(["b", "id"]))]))
    assert_eq(cat_info(c, "t").unique[0].columns.len(), 2)
    assert_eq(cat_code(cat_base(), cat_alter("t", [SetPrimaryKey(items_of(["a"]))])), "Q6005")
    assert_eq(cat_code(cat_base(), cat_alter("t", [SetPrimaryKey(items_of(["nope"]))])), "Q2003")

    val f = cat_ok(cat_base(), cat_table("child", [cat_col("id", Int64), cat_col("tid", Int64)], ["id"], [cat_fk("child_t", ["tid"], "t", ["id"])]))
    assert_eq(cat_code(f, cat_alter("t", [SetPrimaryKey(items_of(["b"]))])), "Q6007")

@test
a_new_owner_is_a_role_and_takes_the_identity_sequences_too()
    var c = cat_ok(cat_base(), cat_role("alice"))
    c = cat_ok(c, cat_alter("t", [AddColumn(ColumnDef("n", Int64, None, None, ByDefault, None)), SetOwner("alice")]))
    val alice = c.roles[c.role_at("alice").unwrap()].oid
    assert(cat_table_of(c, "t").owner == alice)
    assert(c.sequences[c.sequence_at(cat_q("t_n_seq")).unwrap()].owner == alice)
    assert_eq(cat_code(c, cat_alter("t", [SetOwner("nobody")])), "Q6003")
    assert_eq(cat_code(c, cat_alter("t", [Rewrite])), "ok")

// -- AlterType ---------------------------------------------------------------------------------------

private with_status() -> MemCatalog
    var c = cat_ok(cat_base(), CreateType(cat_q("status"), union_of([Field("active", record([])), Field("banned", record([]))]), false))
    c = cat_ok(c, CreateType(cat_q("point"), record([Field("x", Int32), Field("y", Int32)]), false))
    cat_ok(c, cat_table("u", [cat_col("id", Int64), cat_col("s", Named("app", "status")), cat_col("p", nullable(Named("app", "point")))], ["id"]))

@test
appending_to_a_named_type_gives_each_table_using_it_a_new_version()
    val c = cat_ok(with_status(), AlterType(cat_q("status"), AppendVariants(items_of([Field("gone", record([]))]))))
    assert(c.named_type(cat_q("status")) == Some(union_of([Field("active", record([])), Field("banned", record([])), Field("gone", record([]))])))
    assert_eq(version_of(c, "u"), 2)
    assert_eq(version_of(c, "t"), 1)
    assert(cat_info(c, "u").columns[1].ty == Named("app", "status"))

    val fill = FieldFill("z", Int32, Some(Literal(Int32, Int(0))))
    val d = cat_ok(with_status(), AlterType(cat_q("point"), AppendFields(items_of([fill, FieldFill("w", nullable(Text), None)]))))
    assert(d.named_type(cat_q("point")) == Some(record([Field("x", Int32), Field("y", Int32), Field("z", Int32), Field("w", nullable(Text))])))

    // An enum that gains a variant stays a key component.
    val e = cat_ok(with_status(), cat_index("u_s", "u", ["s"]))
    assert_eq(cat_code(e, AlterType(cat_q("status"), AppendVariants(items_of([Field("gone", record([]))])))), "ok")

@test
only_the_lossless_changes_apply_to_a_named_type()
    val c = with_status()
    assert_eq(cat_code(c, AlterType(cat_q("status"), AppendFields(items_of([FieldFill("z", nullable(Int32), None)])))), "Q6018")
    assert_eq(cat_code(c, AlterType(cat_q("point"), AppendVariants(items_of([Field("z", record([]))])))), "Q6018")
    assert_eq(cat_code(c, AlterType(cat_q("status"), AppendVariants(items_of([Field("active", record([]))])))), "Q6002")
    assert_eq(cat_code(c, AlterType(cat_q("status"), AppendVariants(items_of([Field("odd", Int32)])))), "Q3014")
    assert_eq(cat_code(c, AlterType(cat_q("point"), AppendFields(items_of([FieldFill("z", Int32, Some(cat_text("0")))])))), "Q3001")
    assert_eq(cat_code(c, AlterType(cat_q("nope"), RenameType("x"))), "Q6004")

    // An enum index over a type that gains a payload variant no longer is one.
    val e = cat_ok(c, cat_index("u_s", "u", ["s"]))
    assert_eq(cat_code(e, AlterType(cat_q("status"), AppendVariants(items_of([Field("why", record([Field("r", Text)]))])))), "Q6007")

@test
a_type_change_that_would_make_a_type_refer_to_itself_is_refused()
    var c = cat_ok(cat_base(), CreateType(cat_q("a"), record([Field("x", Int32)]), false))
    c = cat_ok(c, CreateType(cat_q("b"), record([Field("a", nullable(Named("app", "a")))]), false))
    assert_eq(cat_code(c, AlterType(cat_q("a"), AppendFields(items_of([FieldFill("b", nullable(Named("app", "b")), None)])))), "Q6005")
    assert_eq(cat_code(c, AlterType(cat_q("a"), AppendFields(items_of([FieldFill("a", nullable(Named("app", "a")), None)])))), "Q6005")

@test
a_renamed_type_is_renamed_in_every_column_type_and_definition()
    var c = cat_ok(with_status(), CreateType(cat_q("holder"), record([Field("s", Named("app", "status"))]), false))
    val dflt: Expr = Variant(Named("app", "status"), "active", Record(buf[Item]()))
    c = cat_ok(c, cat_alter("u", [SetColumnDefault("s", Some(dflt))]))
    c = cat_ok(c, AlterType(cat_q("status"), RenameType("state")))
    assert(c.type_at(cat_q("status")).is_none())
    assert(cat_info(c, "u").columns[1].ty == Named("app", "state"))
    assert(column_of(c, "u", "s").default == Some(Variant(Named("app", "state"), "active", Record(buf[Item]()))))
    assert(c.named_type(cat_q("holder")) == Some(record([Field("s", Named("app", "state"))])))
    assert_eq(cat_code(c, AlterType(cat_q("state"), RenameType("u"))), "Q6002")

@test
a_renamed_member_applies_unless_a_definition_reads_the_old_name()
    val c = cat_ok(with_status(), AlterType(cat_q("point"), RenameMember("x", "east")))
    assert(c.named_type(cat_q("point")) == Some(record([Field("east", Int32), Field("y", Int32)])))
    assert_eq(version_of(c, "u"), 2)
    assert_eq(cat_code(c, AlterType(cat_q("point"), RenameMember("x", "z"))), "Q6003")
    assert_eq(cat_code(c, AlterType(cat_q("point"), RenameMember("east", "y"))), "Q6002")

    val check = cat_check("p_east", call("gt", [Field(cat_row("p"), "x"), Literal(Int32, Int(0))]))
    val d = cat_ok(with_status(), cat_alter("u", [AddConstraint(check, false)]))
    assert_eq(cat_code(d, AlterType(cat_q("point"), RenameMember("x", "east"))), "Q6007")

// -- retype_column of a converting column (§8.5 rule 4) ------------------------------------------------

/** `a` of `cat_base`, retyped to a type that makes it `converting`. */
private converting_base() -> MemCatalog = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))

/** `c` with the conversion of column `name` of `table` finished: the target is the type and the column is ready. */
private finish_conversion(c: MemCatalog, table: string, name: string) -> MemCatalog
    var x = c.clone()
    val ti = x.table_at(cat_q(table)).unwrap()
    val ci = x.tables[ti].column_at(name).unwrap()
    x.tables[ti].columns[ci].ty = x.tables[ti].columns[ci].target.unwrap()
    x.tables[ti].columns[ci].state = ColumnReady
    x.tables[ti].columns[ci].target = None
    x.tables[ti].columns[ci].using = None
    x

/** `c` with the conversion of column `name` of `table` failed: the column is ready in its old type. */
private abandon_conversion(c: MemCatalog, table: string, name: string) -> MemCatalog
    var x = c.clone()
    val ti = x.table_at(cat_q(table)).unwrap()
    val ci = x.tables[ti].column_at(name).unwrap()
    x.tables[ti].columns[ci].state = ColumnReady
    x.tables[ti].columns[ci].target = None
    x.tables[ti].columns[ci].using = None
    x

@test
a_second_retype_of_a_converting_column_is_refused_with_its_own_code()
    val d = converting_base()
    assert(column_of(d, "t", "a").state == ColumnConverting)

    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int8), None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int32), None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int64), Some(call("length", [cat_text("x")])))])), "Q6023")

@test
a_second_retype_of_a_converting_column_is_refused_before_the_conversion_is_looked_at()
    val d = converting_base()

    // Neither a type with no conversion (Q6008), a bad `using` (Q3001), a primary-key type (Q6005) nor a name (Q6004) is reported.
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Date), None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", Int64, Some(cat_text("x")))])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", Json, None)])), "Q6023")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", Named("app", "nope"), None)])), "Q6023")

@test
a_refused_second_retype_leaves_the_catalog_and_the_other_actions_unapplied()
    val d = converting_base()
    val before = column_of(d, "t", "a")
    val columns = cat_table_of(d, "t").columns.len()
    val version = version_of(d, "t")

    var first = d
    val added = cat_alter("t", [AddColumn(cat_col("n", nullable(Int64))), RenameColumn("b", "bb"), RetypeColumn("a", nullable(Int64), None)])
    assert_eq(first.apply(envelope([], added), BootstrapRole).unwrap_err().code, "Q6023")
    assert_eq(cat_table_of(first, "t").columns.len(), columns)
    assert(cat_table_of(first, "t").column_named("n").is_none())
    assert(cat_table_of(first, "t").column_named("bb").is_none() && cat_table_of(first, "t").column_named("b").is_some())
    assert_eq(version_of(first, "t"), version)
    assert(column_of(first, "t", "a").state == ColumnConverting && column_of(first, "t", "a").ty == before.ty && column_of(first, "t", "a").target == before.target)

    // The retype may come first or last among the actions.
    var second = d
    val last = cat_alter("t", [RetypeColumn("a", nullable(Int64), None), AddColumn(cat_col("n", nullable(Int64)))])
    assert_eq(second.apply(envelope([], last), BootstrapRole).unwrap_err().code, "Q6023")
    assert(cat_table_of(second, "t").column_named("n").is_none())
    assert_eq(version_of(second, "t"), version)

@test
a_converting_column_is_retyped_again_once_the_conversion_finishes()
    val done = finish_conversion(converting_base(), "t", "a")
    assert(column_of(done, "t", "a").state == ColumnReady && column_of(done, "t", "a").ty == nullable(Int16))

    assert_eq(cat_code(done, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "ok")
    assert_eq(cat_code(done, cat_alter("t", [RetypeColumn("a", nullable(Int8), None)])), "ok")

    // A column that converts again is again refused until that conversion finishes.
    val again = cat_ok(done, cat_alter("t", [RetypeColumn("a", nullable(Int8), None)]))
    assert(column_of(again, "t", "a").state == ColumnConverting)
    assert_eq(cat_code(again, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6023")
    assert_eq(cat_code(finish_conversion(again, "t", "a"), cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "ok")

@test
a_column_whose_conversion_failed_is_retyped_again()
    val failed = abandon_conversion(converting_base(), "t", "a")
    assert(column_of(failed, "t", "a").state == ColumnReady && column_of(failed, "t", "a").ty == nullable(Int32))
    assert_eq(cat_code(failed, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), "ok")

@test
a_retype_of_another_column_while_one_converts_is_accepted()
    val d = converting_base()
    val using = call("length", [cat_row("b")])
    val e = cat_ok(d, cat_alter("t", [RetypeColumn("b", Int64, Some(using))]))
    assert(column_of(e, "t", "b").state == ColumnConverting && column_of(e, "t", "a").state == ColumnConverting)

    // Both then refuse a second retype, and each finishes on its own.
    assert_eq(cat_code(e, cat_alter("t", [RetypeColumn("b", Int32, Some(using))])), "Q6023")
    assert_eq(cat_code(e, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6023")
    val f = finish_conversion(e, "t", "a")
    assert_eq(cat_code(f, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "ok")
    assert_eq(cat_code(f, cat_alter("t", [RetypeColumn("b", Int32, Some(using))])), "Q6023")

    // A lossless retype of another column and the retype of a column of another table.
    val g = cat_ok(cat_base(), cat_table("u", [cat_col("id", Int64), cat_col("a", nullable(Int32))], ["id"]))
    val h = cat_ok(g, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    assert_eq(cat_code(h, cat_alter("u", [RetypeColumn("a", nullable(Int16), None)])), "ok")
    assert_eq(cat_code(h, cat_alter("t", [RetypeColumn("id", nullable(Int64), None)])), "Q6005")

@test
a_metadata_only_retype_never_blocks_another_retype()
    val c = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("a", nullable(Int64), None)]))
    assert(column_of(c, "t", "a").state == ColumnReady)
    assert_eq(cat_code(c, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), "ok")
    assert_eq(cat_code(c, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "ok")

    // A conversion that follows it blocks the next as any other does.
    val d = cat_ok(c, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6023")

@test
a_converting_column_is_invisible_to_a_constraint_added_over_it()
    // `ddl.md` §2.3 rule 3, §2.13 rule 3: a check names only ready columns, so a converting one is `Q2003`.
    val d = converting_base()
    val check = cat_check("a_pos", call("gt", [cat_row("a"), Literal(Int32, Int(0))]))
    assert_eq(cat_code(d, cat_alter("t", [AddConstraint(check, false)])), "Q2003")
    assert_eq(cat_code(finish_conversion(d, "t", "a"), cat_alter("t", [AddConstraint(check, false)])), "ok")

// -- DDL actions on a column that is not ready (§2.13 rule 11) -----------------------------------------

/** Whether table `table` has the same columns, schema version, indexes and constraints in `a` and in `b`. */
private same_table(a: MemCatalog, b: MemCatalog, table: string) -> bool
    val x = cat_table_of(a, table)
    val y = cat_table_of(b, table)
    if x.columns.len() != y.columns.len() || x.schema_version() != y.schema_version() then return false

    for i in 0..<x.columns.len()
        if x.columns[i] != y.columns[i] then return false

    a.indexes.len() == b.indexes.len() && a.constraints.len() == b.constraints.len()

/** The code `stmt` is refused with on `c`, asserting the catalog is the same table afterwards. */
private refused_unchanged(c: MemCatalog, table: string, stmt: Statement) -> string
    var x = c
    val code = x.apply(envelope([], stmt), BootstrapRole).unwrap_err().code
    assert(same_table(c, x, table))
    code

/** `cat_base` with `f`, a column being filled, added. */
private filling_base() -> MemCatalog
    val volatile = ColumnDef("f", nullable(Timestamp), Some(call("statement_timestamp", [])), None, NoIdentity, None)
    cat_ok(cat_base(), cat_alter("t", [AddColumn(volatile)]))

/** `c` with the fill of column `name` of `table` finished. */
private finish_fill(c: MemCatalog, table: string, name: string) -> MemCatalog
    var x = c.clone()
    val ti = x.table_at(cat_q(table)).unwrap()
    x.tables[ti].columns[x.tables[ti].column_at(name).unwrap()].state = ColumnReady
    x

/** Whether any column of table `table` is converting. */
private any_converting(c: MemCatalog, table: string) -> bool
    for col in cat_table_of(c, table).columns
        if col.state == ColumnConverting || col.target.is_some() || col.using.is_some() then return true

    false

/** `cat_base` with `b` converting from text to int64 by `length`. */
private converting_text() -> MemCatalog = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("b", Int64, Some(call("length", [cat_row("b")])))]))

// -- drop_column (Q54) ---------------------------------------------------------------------------------

@test
a_converting_column_drops_and_leaves_no_conversion_behind()
    val d = converting_base()
    val version = version_of(d, "t")
    val c = cat_ok(d, cat_alter("t", [DropColumn("a", false)]))

    assert(cat_table_of(c, "t").column_named("a").is_none())
    assert_eq(cat_table_of(c, "t").columns.len(), 2)
    assert_eq(version_of(c, "t"), version + 1)
    assert(!any_converting(c, "t"))
    assert_eq(cat_code(c, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q2003")
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("a", false)])), "Q2003")
    assert(column_of(c, "t", "b") == column_of(cat_base(), "t", "b"))

@test
a_column_dropped_while_converting_and_added_again_is_a_new_ready_column()
    val d = converting_base()
    val old_id = column_of(d, "t", "a").id
    // One statement touching the name twice is Q6016 (§3.3 rule 3), so the column is added in a second statement.
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [DropColumn("a", false), AddColumn(cat_col("a", nullable(Int32)))])), "Q6016")
    val c = cat_ok(cat_ok(d, cat_alter("t", [DropColumn("a", false)])), cat_alter("t", [AddColumn(cat_col("a", nullable(Int32)))]))
    val again = column_of(c, "t", "a")

    assert(again.id != old_id)
    assert(again.state == ColumnReady && again.target.is_none() && again.using.is_none())
    assert_eq(cat_code(c, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), "ok")

    // The same with another type.
    val e = cat_ok(cat_ok(d, cat_alter("t", [DropColumn("a", false)])), cat_alter("t", [AddColumn(cat_col("a", nullable(Text)))]))
    assert(column_of(e, "t", "a").id != old_id && column_of(e, "t", "a").state == ColumnReady && column_of(e, "t", "a").ty == nullable(Text))
    assert(!any_converting(e, "t"))

@test
a_column_that_finished_or_abandoned_its_conversion_drops_as_any_ready_column()
    assert_eq(cat_code(finish_conversion(converting_base(), "t", "a"), cat_alter("t", [DropColumn("a", false)])), "ok")
    assert_eq(cat_code(abandon_conversion(converting_base(), "t", "a"), cat_alter("t", [DropColumn("a", false)])), "ok")

@test
a_drop_of_another_column_leaves_a_conversion_running()
    val d = converting_base()
    val c = cat_ok(d, cat_alter("t", [DropColumn("b", false)]))
    assert(column_of(c, "t", "a") == column_of(d, "t", "a") && column_of(c, "t", "a").state == ColumnConverting)
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("a", false)])), "ok")

    // Two conversions: dropping one leaves the other.
    val e = converting_text()
    val f = cat_ok(cat_ok(e, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), cat_alter("t", [DropColumn("a", false)]))
    assert(column_of(f, "t", "b").state == ColumnConverting && cat_table_of(f, "t").column_named("a").is_none())
    assert(finish_conversion(f, "t", "b").tables.len() == f.tables.len())

@test
a_converting_column_drops_in_one_statement_with_other_actions_in_any_order()
    val d = converting_base()
    val n = cat_col("n", nullable(Int64))
    val orders: Buf[Buf[AlterAction]] = buf[Buf[AlterAction]]()
    orders.push(items_of([DropColumn("a", false), AddColumn(n), DropColumn("b", false)]))
    orders.push(items_of([AddColumn(n), DropColumn("b", false), DropColumn("a", false)]))
    orders.push(items_of([DropColumn("b", false), DropColumn("a", false), AddColumn(n)]))

    for actions in orders
        val c = cat_ok(d, AlterTable(cat_q("t"), actions))
        assert_eq(cat_columns(cat_info(c, "t")), "id,n")
        assert(!any_converting(c, "t"))

    // A drop followed by a use of the dropped name, or a repeat of it, is refused whole (§3.3 rule 3).
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [DropColumn("a", false), RenameColumn("a", "x")])), "Q6016")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [DropColumn("a", false), DropColumn("a", false)])), "Q6016")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [DropColumn("a", false), RetypeColumn("a", nullable(Int64), None)])), "Q6016")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [AddColumn(n), DropColumn("a", false), DropColumn("nope", false)])), "Q2003")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [DropColumn("a", false), AddColumn(cat_col("b", Text))])), "Q6002")

@test
a_column_converted_and_dropped_in_one_statement_is_refused_as_two_actions_on_one_name()
    // A statement cannot start a conversion and abandon it: the name is touched twice (§3.3 rule 3).
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [RetypeColumn("a", nullable(Int16), None), DropColumn("a", false)])), "Q6016")
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [DropColumn("a", false), RetypeColumn("a", nullable(Int16), None)])), "Q6016")
    assert_eq(refused_unchanged(converting_base(), "t", cat_alter("t", [RetypeColumn("a", nullable(Int64), None), DropColumn("a", false)])), "Q6016")

    // Two statements do it.
    val c = cat_ok(converting_base(), cat_alter("t", [DropColumn("a", false)]))
    assert(cat_table_of(c, "t").column_named("a").is_none())
    assert(!any_converting(c, "t"))

@test
a_converting_column_in_an_index_drops_with_cascade_and_is_refused_without()
    var c = cat_ok(cat_base(), cat_index("t_a", "t", ["a"]))
    c = cat_ok(c, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    assert(column_of(c, "t", "a").state == ColumnConverting)

    assert_eq(refused_unchanged(c, "t", cat_alter("t", [DropColumn("a", false)])), "Q6007")
    val d = cat_ok(c, cat_alter("t", [DropColumn("a", true)]))
    assert(d.index_at(cat_q("t_a")).is_none())
    assert(cat_table_of(d, "t").column_named("a").is_none() && !any_converting(d, "t"))

@test
a_converting_primary_key_column_cannot_be_dropped()
    // A key column converts only when the key encoding changes; the drop is still `Q6007`.
    var c = cat_ok(cat_base(), cat_table("k", [cat_col("id", Int32), cat_col("v", Text)], ["id"]))
    c = cat_ok(c, cat_alter("k", [RetypeColumn("id", Int64, Some(cat_row("id")))]))
    assert_eq(refused_unchanged(c, "k", cat_alter("k", [DropColumn("id", true)])), "Q6007")

// -- rename_column (Q55) -------------------------------------------------------------------------------

@test
a_converting_column_renames_and_the_conversion_continues_under_the_new_name()
    val d = converting_base()
    val before = column_of(d, "t", "a")
    val c = cat_ok(d, cat_alter("t", [RenameColumn("a", "alpha")]))
    val after = column_of(c, "t", "alpha")

    assert(after.id == before.id && after.state == ColumnConverting && after.ty == before.ty && after.target == before.target)
    assert_eq(version_of(c, "t"), version_of(d, "t") + 1)
    assert(cat_table_of(c, "t").column_named("a").is_none())
    assert_eq(cat_code(c, cat_alter("t", [RenameColumn("a", "x")])), "Q2003")
    assert_eq(cat_code(c, cat_alter("t", [DropColumn("a", false)])), "Q2003")

@test
a_retype_of_a_renamed_converting_column_is_refused_under_the_new_name_only()
    val c = cat_ok(converting_base(), cat_alter("t", [RenameColumn("a", "alpha")]))
    assert_eq(refused_unchanged(c, "t", cat_alter("t", [RetypeColumn("alpha", nullable(Int64), None)])), "Q6023")
    assert_eq(refused_unchanged(c, "t", cat_alter("t", [RetypeColumn("alpha", nullable(Date), None)])), "Q6023")
    assert_eq(refused_unchanged(c, "t", cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q2003")

@test
a_conversion_that_finishes_after_a_rename_lands_on_the_renamed_column()
    val c = cat_ok(converting_base(), cat_alter("t", [RenameColumn("a", "alpha")]))
    val done = finish_conversion(c, "t", "alpha")
    assert(column_of(done, "t", "alpha").state == ColumnReady && column_of(done, "t", "alpha").ty == nullable(Int16))
    assert(cat_table_of(done, "t").column_named("a").is_none())
    assert_eq(cat_code(done, cat_alter("t", [RetypeColumn("alpha", nullable(Int64), None)])), "ok")

    assert(column_of(c, "t", "alpha").state == ColumnConverting, "source kept")
    assert(column_of(c, "t", "alpha").ty == nullable(Int32), "source type kept")
    val failed = abandon_conversion(c, "t", "alpha")
    assert(column_of(failed, "t", "alpha").ty == nullable(Int32), "type")
    assert(column_of(failed, "t", "alpha").state == ColumnReady, "state")

@test
a_rename_rewrites_the_conversion_expression_of_a_converting_column()
    val c = cat_ok(converting_text(), cat_alter("t", [RenameColumn("b", "bb")]))
    assert(column_of(c, "t", "bb").using == Some(call("length", [cat_row("bb")])))
    assert(column_of(c, "t", "bb").target == Some(Int64) && column_of(c, "t", "bb").state == ColumnConverting)

    // Renamed again, and back.
    val d = cat_ok(cat_ok(c, cat_alter("t", [RenameColumn("bb", "b3")])), cat_alter("t", [RenameColumn("b3", "b")]))
    assert(column_of(d, "t", "b") == column_of(converting_text(), "t", "b"))

@test
a_renamed_converting_column_in_an_index_or_check_keeps_them_in_step()
    // A check over the column would already have refused the retype (Q6007), so an index is the definition left.
    var c = cat_ok(cat_base(), cat_index("t_a", "t", ["a"]))
    c = cat_ok(c, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    val d = cat_ok(c, cat_alter("t", [RenameColumn("a", "alpha")]))

    assert(d.indexes[d.index_at(cat_q("t_a")).unwrap()].keys[0].key == KeyOn(column_of(d, "t", "alpha").id))

@test
a_column_that_finished_or_abandoned_its_conversion_renames_as_any_ready_column()
    assert_eq(cat_code(finish_conversion(converting_base(), "t", "a"), cat_alter("t", [RenameColumn("a", "alpha")])), "ok")
    assert_eq(cat_code(abandon_conversion(converting_base(), "t", "a"), cat_alter("t", [RenameColumn("a", "alpha")])), "ok")

@test
a_rename_of_another_column_leaves_a_conversion_running_and_a_clash_is_refused()
    val d = converting_base()
    val c = cat_ok(d, cat_alter("t", [RenameColumn("b", "bb")]))
    assert(column_of(c, "t", "a") == column_of(d, "t", "a"))

    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("a", "b")])), "Q6002")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("b", "a")])), "Q6002")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("a", "a")])), "Q6002")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("nope", "x")])), "Q2003")

@test
a_converting_column_renames_in_one_statement_with_other_actions_in_any_order()
    val d = converting_base()
    val n = cat_col("n", nullable(Int64))

    // Renamed twice, then dropped under the last name.
    val c = cat_ok(d, cat_alter("t", [RenameColumn("a", "x"), RenameColumn("x", "y"), AddColumn(n)]))
    assert(column_of(c, "t", "y").state == ColumnConverting && cat_table_of(c, "t").column_named("n").is_some())
    val e = cat_ok(d, cat_alter("t", [AddColumn(n), RenameColumn("a", "x"), DropColumn("x", false)]))
    assert(cat_table_of(e, "t").column_named("x").is_none() && !any_converting(e, "t"))

    // The old name of a rename is touched, so a later action on it is Q6016; the new name may be named once.
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("a", "x"), AddColumn(cat_col("a", Text))])), "Q6016")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("a", "x"), RetypeColumn("x", nullable(Int64), None)])), "Q6023")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("a", "x"), RetypeColumn("a", nullable(Int64), None)])), "Q6016")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [AddColumn(n), RenameColumn("a", "x"), RenameColumn("a", "z")])), "Q6016")

    // A column renamed and then retyped in one statement converts under the new name.
    val g = cat_ok(cat_base(), cat_alter("t", [RenameColumn("a", "x"), RetypeColumn("x", nullable(Int16), None)]))
    assert(column_of(g, "t", "x").state == ColumnConverting && column_of(g, "t", "x").using.is_some())

// -- set_default (Q56) ---------------------------------------------------------------------------------

@test
a_converting_column_takes_a_default_valid_at_its_type_and_its_target()
    val d = converting_base()
    val both = Literal(Int16, Int(5))
    val c = cat_ok(d, cat_alter("t", [SetColumnDefault("a", Some(both))]))
    assert(column_of(c, "t", "a").default == Some(both) && column_of(c, "t", "a").state == ColumnConverting)
    assert_eq(version_of(c, "t"), version_of(d, "t") + 1)

@test
a_converting_column_refuses_a_default_valid_at_only_one_of_its_types()
    val d = converting_base()

    // int32 -> int16: an int32 literal fits the old type only.
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("a", Some(Literal(Int32, Int(5))))])), "Q3001")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("a", Some(cat_text("x")))])), "Q3001")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("a", Some(cat_int(1)))])), "Q3001")

    // text -> int64: a text literal fits the old type only, an int64 literal the new one only.
    val e = converting_text()
    assert_eq(refused_unchanged(e, "t", cat_alter("t", [SetColumnDefault("b", Some(cat_text("x")))])), "Q3001")
    assert_eq(refused_unchanged(e, "t", cat_alter("t", [SetColumnDefault("b", Some(cat_int(1)))])), "Q3001")

    // The same defaults without a conversion are judged by the column's own type alone.
    assert_eq(cat_code(cat_base(), cat_alter("t", [SetColumnDefault("b", Some(cat_text("x")))])), "ok")
    assert_eq(cat_code(cat_base(), cat_alter("t", [SetColumnDefault("a", Some(Literal(Int32, Int(5))))])), "ok")

@test
a_converting_column_takes_and_drops_a_null_default_only_where_both_types_are_nullable()
    val d = converting_base()
    assert_eq(cat_code(d, cat_alter("t", [SetColumnDefault("a", Some(Null(Int16)))])), "ok")
    assert_eq(cat_code(d, cat_alter("t", [SetColumnDefault("a", Some(Null(Int32)))])), "Q3001")

    // Nullable now, not nullable at the target: a null default fits the old type only.
    val fill = call("coalesce", [Cast(cat_row("a"), nullable(Int16), Strict), Literal(Int16, Int(0))])
    val e = cat_ok(cat_base(), cat_alter("t", [RetypeColumn("a", Int16, Some(fill))]))
    assert(column_of(e, "t", "a").state == ColumnConverting)
    assert_eq(refused_unchanged(e, "t", cat_alter("t", [SetColumnDefault("a", Some(Null(Int32)))])), "Q3001")
    assert_eq(refused_unchanged(e, "t", cat_alter("t", [SetColumnDefault("a", Some(Null(Int16)))])), "Q3001")
    assert_eq(cat_code(e, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int16, Int(1))))])), "ok")

@test
a_default_of_a_converting_column_drops_and_survives_the_conversion()
    val d = converting_base()
    val both = Literal(Int16, Int(5))
    val c = cat_ok(d, cat_alter("t", [SetColumnDefault("a", Some(both))]))
    assert(column_of(cat_ok(c, cat_alter("t", [SetColumnDefault("a", None)])), "t", "a").default.is_none())
    assert_eq(cat_code(d, cat_alter("t", [SetColumnDefault("a", None)])), "ok")

    assert(column_of(finish_conversion(c, "t", "a"), "t", "a").default == Some(both))
    assert(column_of(abandon_conversion(c, "t", "a"), "t", "a").default == Some(both))

@test
a_column_whose_conversion_ended_takes_defaults_of_its_own_type_alone()
    val done = finish_conversion(converting_base(), "t", "a")
    assert_eq(cat_code(done, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int16, Int(5))))])), "ok")
    assert_eq(cat_code(done, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int32, Int(5))))])), "Q3001")

    val failed = abandon_conversion(converting_base(), "t", "a")
    assert_eq(cat_code(failed, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int32, Int(5))))])), "ok")
    assert_eq(cat_code(failed, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int16, Int(5))))])), "ok")
    assert_eq(cat_code(failed, cat_alter("t", [SetColumnDefault("a", Some(cat_text("x")))])), "Q3001")

@test
a_default_of_another_column_is_judged_by_its_own_type_while_one_converts()
    val d = converting_base()
    assert_eq(cat_code(d, cat_alter("t", [SetColumnDefault("b", Some(cat_text("x")))])), "ok")
    assert_eq(cat_code(d, cat_alter("t", [SetColumnDefault("b", Some(cat_int(1)))])), "Q3001")

    // Another column converting does not widen or narrow what `a` takes.
    val e = converting_text()
    assert_eq(cat_code(e, cat_alter("t", [SetColumnDefault("a", Some(Literal(Int32, Int(5))))])), "ok")
    assert_eq(cat_code(e, cat_alter("t", [SetColumnDefault("a", Some(cat_text("x")))])), "Q3001")

@test
a_default_of_a_converting_column_combines_with_other_actions_in_any_order()
    val d = converting_base()
    val both = Literal(Int16, Int(5))
    val old_only = Literal(Int32, Int(5))

    val c = cat_ok(d, cat_alter("t", [SetColumnDefault("a", Some(both)), SetColumnDefault("b", Some(cat_text("x")))]))
    assert(column_of(c, "t", "a").default == Some(both) && column_of(c, "t", "b").default == Some(cat_text("x")))
    val e = cat_ok(d, cat_alter("t", [RenameColumn("a", "alpha"), SetColumnDefault("alpha", Some(both))]))
    assert(column_of(e, "t", "alpha").default == Some(both))

    // A refusal anywhere leaves every action unapplied.
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("b", Some(cat_text("x"))), SetColumnDefault("a", Some(old_only))])), "Q3001")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("a", Some(old_only)), SetColumnDefault("b", Some(cat_text("x")))])), "Q3001")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [AddColumn(cat_col("n", nullable(Int64))), SetColumnDefault("a", Some(old_only))])), "Q3001")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [SetColumnDefault("a", Some(both)), SetColumnDefault("a", Some(old_only))])), "Q6016")

    // A statement cannot start a conversion and set the default of the same column: the name is touched twice.
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [RetypeColumn("a", nullable(Int16), None), SetColumnDefault("a", Some(old_only))])), "Q6016")
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [SetColumnDefault("a", Some(old_only)), RetypeColumn("a", nullable(Int16), None)])), "Q6016")
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [RetypeColumn("a", nullable(Int16), None), SetColumnDefault("a", Some(both))])), "Q6016")

// -- retype_column of a filling column (Q57) -----------------------------------------------------------

@test
a_retype_of_a_filling_column_is_refused_with_its_own_code()
    val d = filling_base()
    assert(column_of(d, "t", "f").state == ColumnFilling)

    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RetypeColumn("f", nullable(Date), None)])), "Q6024")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RetypeColumn("f", nullable(Timestamp), None)])), "Q6024")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RetypeColumn("f", nullable(Int64), Some(cat_int(1)))])), "Q6024")

@test
a_retype_of_a_filling_column_is_refused_before_the_conversion_is_looked_at()
    val d = filling_base()

    // Neither a type with no conversion (Q6008), a bad `using` (Q3001), a name (Q6004) nor a key type (Q6005) is reported.
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("f", Json, None)])), "Q6024")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("f", Int64, Some(cat_text("x")))])), "Q6024")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("f", Named("app", "nope"), None)])), "Q6024")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("f", list(Int32), None)])), "Q6024")

@test
a_filling_column_is_retyped_once_the_fill_finishes()
    val done = finish_fill(filling_base(), "t", "f")
    assert_eq(cat_code(done, cat_alter("t", [RetypeColumn("f", nullable(Text), None)])), "ok")
    assert_eq(cat_code(done, cat_alter("t", [RetypeColumn("f", nullable(Timestamp), None)])), "ok")

@test
a_retype_of_another_column_is_unaffected_by_a_column_being_filled()
    val d = filling_base()
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)])), "ok")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "ok")
    assert_eq(cat_code(d, cat_alter("t", [RetypeColumn("b", Int64, Some(call("length", [cat_row("b")])))])), "ok")

    // A converting and a filling column each answer with their own code.
    val e = cat_ok(d, cat_alter("t", [RetypeColumn("a", nullable(Int16), None)]))
    assert_eq(cat_code(e, cat_alter("t", [RetypeColumn("a", nullable(Int64), None)])), "Q6023")
    assert_eq(cat_code(e, cat_alter("t", [RetypeColumn("f", nullable(Date), None)])), "Q6024")
    assert(column_of(e, "t", "f").state == ColumnFilling)

@test
a_refused_retype_of_a_filling_column_applies_none_of_the_statement_in_any_order()
    val d = filling_base()
    val n = cat_col("n", nullable(Int64))
    val bad = RetypeColumn("f", nullable(Date), None)

    assert_eq(refused_unchanged(d, "t", cat_alter("t", [bad, AddColumn(n), RenameColumn("b", "bb")])), "Q6024")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [AddColumn(n), bad, RenameColumn("b", "bb")])), "Q6024")
    assert_eq(refused_unchanged(d, "t", cat_alter("t", [RenameColumn("b", "bb"), RetypeColumn("a", nullable(Int16), None), bad])), "Q6024")

@test
a_column_added_and_retyped_in_one_statement_is_refused_as_two_actions_on_one_name()
    // The name is touched twice (§3.3 rule 3), whatever the added column's default; the retype is never reached.
    val volatile = ColumnDef("g", nullable(Timestamp), Some(call("statement_timestamp", [])), None, NoIdentity, None)
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [AddColumn(volatile), RetypeColumn("g", nullable(Date), None)])), "Q6016")

    val constant = ColumnDef("g", nullable(Int32), Some(Literal(Int32, Int(1))), None, NoIdentity, None)
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [AddColumn(constant), RetypeColumn("g", nullable(Int16), None)])), "Q6016")

    val ident = ColumnDef("seq", Int64, None, None, ByDefault, None)
    assert_eq(refused_unchanged(cat_base(), "t", cat_alter("t", [AddColumn(ident), RetypeColumn("seq", Int32, None)])), "Q6016")

@test
a_filling_column_still_drops_renames_and_takes_a_default()
    val d = filling_base()
    val dropped = cat_ok(d, cat_alter("t", [DropColumn("f", false)]))
    assert(cat_table_of(dropped, "t").column_named("f").is_none())

    val renamed = cat_ok(d, cat_alter("t", [RenameColumn("f", "g")]))
    assert(column_of(renamed, "t", "g").state == ColumnFilling)

    val set = cat_ok(d, cat_alter("t", [SetColumnDefault("f", Some(call("statement_timestamp", [])))]))
    assert(column_of(set, "t", "f").state == ColumnFilling)
