module sh.sysl.terndb

import sysl.buf.{Buf, buf}

// The in-memory table store and its multi-version concurrency control (`isolation.md` §4.1–§4.5,
// §5): transactions begun at one of the three levels, reads at a snapshot through each row's chain of
// versions, writes under first-updater-wins, and commit-time validation of a serializable
// transaction's predicate log. StoredRows are `Value` records, each carrying the schema version it was
// encoded in (`ddl.md` §5.2). Rows are kept as `on-disk-format.md` §8.1 has in-memory mode keep them:
// one B+tree per table over 16 KB pages, each row in the row format (§4), every older version in the
// undo log (§5), all through `UndoRows` (`undo.sysl`). The store is single-threaded: transactions interleave by the order
// their operations are called in, and a write that would wait for another transaction's row lock
// answers `Wait` instead of blocking (`docs/design/store.md`).

/** Where a transaction is: live, committed at `c`, or aborted with the §5.2 code that ended it
 * (empty when the client rolled it back).
 */
enum TxnPhase derives Eq
    Live
    CommittedAt(c: u64)
    AbortedWith(code: string)

/** A stored row: the schema version it was encoded in and its value, a record of that version's
 * columns in ordinal order.
 */
struct StoredRow derives Eq
    schema: u64
    value: Value

    /** The value of the column at ordinal `i` of the row's own version. */
    at(self, i: usize) -> Value = self.value match
        Record(fields) -> fields[i]
        _ -> Null

/** A read's membership predicate over a table's rows (§4.4), and the columns, by column id, that the
 * read used: those its predicate and its result read. `every` widens them to every column.
 */
struct Pred
    matches: &Fn(StoredRow) -> bool
    columns: Buf[u32]
    every: bool

/** A predicate that read `columns`. */
pred(columns: []const u32, matches: &Fn(StoredRow) -> bool) -> Pred
    val b = buf[u32]()
    b.extend(columns)
    Pred(matches, b, false)

/** A predicate that read every column. */
pred_all(matches: &Fn(StoredRow) -> bool) -> Pred = Pred(matches, buf[u32](), true)

/** Every row, every column: a full scan with no filter. */
all_rows() -> Pred = pred_all(r -> true)

/** One version of a row: the transaction that wrote it, its commit sequence number (0 while
 * uncommitted), and its image, `None` for a delete.
 */
struct RowVersion
    writer: u64
    commit: u64
    row: Option[StoredRow]

/** A row as the clustered leaf holds it now: its key, the key's §4.6 encoding, which is its key in
 * the table's B+tree, and its current image (§4.1 header and non-key columns), ghost or not. Its
 * older versions are reached through the undo log from the image's `undo`.
 */
struct Slot
    key: Value
    kb: Buf[u8]
    img: RowImage

/** How rows of one schema version of a table are stored (§4.2): the version's columns, the ordinal
 * of each primary-key column among them, and the type of each non-key column in ordinal order,
 * named types resolved to their structure as they stood when the first row of the version was
 * written.
 */
struct SchemaCodec
    number: u64
    columns: Buf[CatColumn]
    key_at: Buf[usize]
    types: Buf[Type]

/** A table's place in the store: its oid, its primary key's columns (every table has one, `Q6009`)
 * and their record type, the key's encoding (§4.6, each component ascending), the codec of each
 * schema version a row has been written in, and its secondary unique keys. Its rows are the
 * table's B+tree in the store's `UndoRows`.
 */
struct TableData
    oid: u64
    key_columns: Buf[u32]
    key_type: Type
    key_spec: Buf[KeyColumn]
    codecs: Buf[SchemaCodec]
    uniques: Buf[&UniqueIx]

/** One row a transaction wrote: its key, the newest committed image it replaced and the image it
 * installed (§4.3 `before(w)` and `after(w)`); `None` is absent or deleted.
 */
struct Write
    table: u64
    key: Value
    before: Option[StoredRow]
    after: Option[StoredRow]

/** One entry of the predicate log: a table, the predicate of a read of it, and, for a point lookup,
 * the key it looked up, which then decides membership by itself.
 */
struct LogEntry
    table: u64
    pred: Pred
    key: Option[Value]

/** A row `install` wrote, kept so that the unique checks of a batch find the rows it wrote and so
 * that undoing a statement restores `t`'s write list: a first write of the row (`pushed`), or a
 * later one, with the `after` the write at `write_at` had before it. The versions themselves are
 * undone through the undo log.
 */
struct Undo
    table: u64
    key: Value
    pushed: bool
    write_at: usize
    prev_after: Option[StoredRow]

/** How much of a transaction's statement log, writes, lock-only locks and deferred checks existed
 * when a statement (or one batch of its writes) began, and the head of its rollback chain in the
 * undo log then (`UndoRows.last_record`).
 */
struct Mark
    undo: usize
    writes: usize
    locks: usize
    deferred: usize
    addr: u64

/** A transaction: its id, level, whether it was declared read-only, its snapshot (at read committed,
 * the current statement's), its state, its predicate log (serializable only), its writes, one per
 * row, and the transaction whose row lock it is waiting for (0 for none); the rows it holds a
 * lock on without having written them (`LOCK_ONLY`, `ddl.md` §2.6 rule 3), the foreign-key checks
 * deferred to its commit, the undo log and mark of its current statement, and its savepoints, oldest
 * first (`store_savepoint.sysl`). While a savepoint is set the undo log runs from the oldest one,
 * not from the current statement.
 */
struct Txn
    id: u64
    level: Isolation
    read_only: bool
    snapshot: u64
    state: TxnPhase
    log: Buf[LogEntry]
    writes: Buf[Write]
    waits_for: u64
    locks: Buf[Value]
    deferred: Buf[Deferred]
    undo: Buf[Undo]
    mark: Mark
    saves: Buf[Save]

/** A row a read returned: its key and its version visible to the reader. */
struct Hit
    key: Value
    row: StoredRow

/** What a write statement did: changed `rows` rows, or nothing at all because a row it must write is
 * locked by `holder`. A `Wait` is retried once `holder` has committed or aborted (§4.2 rule 1).
 */
enum WriteOutcome derives Eq
    Done(rows: usize)
    Wait(holder: u64)

/** One row a write statement writes (`Store.write_rows`): a new row, the row keyed `key` replaced by
 * `row`, or the row keyed `key` removed.
 */
enum RowChange
    Put(row: StoredRow)
    Replace(key: Value, row: StoredRow)
    Remove(key: Value)

/** The writes of a committed transaction, kept for validating the serializable transactions that
 * were running when it committed (§4.3 retention).
 */
struct CommittedWrites
    c: u64
    writes: Buf[Write]

/** The fault-injected builds of §7.1 "prove the checker can fail". All off in a real store.
 * `si_statement_snapshot` takes a snapshot transaction's snapshot afresh at each statement, as read
 * committed does. `stale_snapshot` takes every snapshot one commit behind the horizon, so that a
 * transaction begun after a commit was acknowledged need not see it: what publication out of order,
 * or acknowledgement before publication, look like to a single-threaded store.
 */
struct Faults
    skip_validation: bool
    skip_first_updater_wins: bool
    si_statement_snapshot: bool
    stale_snapshot: bool

/** The store: the catalog of the operation in progress (`catalog_mvcc.sysl`), the id and commit
 * counters, the visible horizon `h` (§4.1), each table's place, the rows of every table with their
 * undo log and transaction table (`rows`: one B+tree per table over 16 KB pages, rows in the row
 * format, old versions in undo records, `on-disk-format.md` §8.1), the live transactions, the
 * retained committed write sets, and the catalog's committed versions. `horizon` is always
 * `rows.last_commit`, and a transaction's id is its id in `rows`.
 */
struct Store
    catalog: MemCatalog
    faults: Faults
    next_txid: u64
    horizon: u64
    tables: Buf[&TableData]
    rows: &UndoRows
    active: Buf[&Txn]
    history: Buf[CommittedWrites]
    cat: CatalogVersions
    /** How many times a live transaction has let locks go by rolling back to a savepoint, so that a
     * statement waiting for one of them runs again although its holder is still live.
     */
    released: u64
    /** Every job a commit started, oldest first, with how it ended (`store_jobs.sysl`). */
    jobs: Buf[JobRecord]
    /** How many leaf entries the executor's scans have visited (`scan_range`): what a test reads to
     * know a scan read only the key range its filter allows.
     */
    slots_read: u64

    /** A transaction at `level`, with its snapshot `s = h` (§4.1). */
    begin(*self, level: Isolation, read_only: bool = false) -> &Txn
        val id = self.rows.begin()
        val t: &Txn = Txn(id, level, read_only, self.snapshot_now(), Live, buf(), buf(), 0, buf(), buf(), buf(), Mark(0, 0, 0, 0, 0), buf())
        self.next_txid = id + 1
        self.active.push(t)
        t

    /** The snapshot a transaction or statement beginning now takes: the horizon (§4.1). */
    snapshot_now(self) -> u64 = if self.faults.stale_snapshot && self.horizon > 0 then self.horizon - 1 else self.horizon

    /** The start of a statement: read committed takes a new snapshot (§3.3); the other levels keep
     * the one taken at begin.
     */
    statement(*self, t: &Txn)
        val fresh = t.level == ReadCommitted || t.level == Snapshot && self.faults.si_statement_snapshot
        if t.state == Live && fresh then t.snapshot = self.snapshot_now()
        if t.saves.len() == 0 then t.undo.clear()
        t.mark = self.mark_of(t)

    /** Undoes everything the current statement (begun by `statement`) wrote, locked and deferred, so
     * that a statement answering `Wait` part-way leaves no trace and is simply run again (§4.2 rule
     * 1). Its reads stay logged: logging only widens.
     */
    undo_statement(*self, t: &Txn) = self.undo_to(t, t.mark)

    /** The rows of `table` visible to `t` that satisfy `p`, logged under serializable (§4.4). */
    scan(*self, t: &Txn, table: u64, p: Pred) -> Result[Buf[Hit], CodecError]
        val r = self.scan_in(t, table, p)
        self.guard(t, r)

    /** The row of `table` with key `key` visible to `t`, if any; logged as the point read `key = k`
     * of every column, found or not.
     */
    get(*self, t: &Txn, table: u64, key: Value) -> Result[Option[StoredRow], CodecError]
        val r = self.get_in(t, table, key)
        self.guard(t, r)

    /** Inserts `row`. A key visible to `t` is `unique_violation`; one committed after `t`'s snapshot
     * is `serialization_failure` at snapshot and serializable (§4.2 rule 4).
     */
    insert(*self, t: &Txn, table: u64, row: StoredRow) -> Result[WriteOutcome, CodecError]
        val m = self.mark_of(t)
        val r = self.insert_in(t, table, row)
        val checked = self.checked(t, table, m, r)
        self.guard(t, checked)

    /** `UPDATE table SET … WHERE p`: every row visible to `t` that satisfies `p` is replaced by
     * `change` of it, encoded in schema version `version` (0: the table's current one). `p` must
     * name the columns `change` reads.
     */
    update_where(*self, t: &Txn, table: u64, p: Pred, change: &Fn(StoredRow) -> Value, version: u64 = 0) -> Result[WriteOutcome, CodecError]
        val m = self.mark_of(t)
        val r = self.modify_in(t, table, p, Some(change), version)
        val checked = self.checked(t, table, m, r)
        self.guard(t, checked)

    /** `DELETE FROM table WHERE p`. */
    delete_where(*self, t: &Txn, table: u64, p: Pred) -> Result[WriteOutcome, CodecError]
        val r = self.modify_in(t, table, p, None, 0)
        self.guard(t, r)

    /** Every row of `table` visible to `t`, the read logged as `logged` under serializable (§4.4): what
     * the executor's `Scan` reads, its filter then applied to the rows by the executor. `logged` must
     * hold for every row the statement's result depends on.
     */
    scan_rows(*self, t: &Txn, table: u64, logged: Pred) -> Result[Buf[Hit], CodecError] = self.scan_range(t, table, KeyAny, KeyAny, logged)

    /** The rows of `table` visible to `t` whose encoded keys (§4.6) lie between `lo` and `hi`, in key
     * order, the read logged as `logged` under serializable (§4.4) whatever the range: a scan
     * narrowed to the keys its filter allows (`exec_access.sysl`). `logged` must hold for every row
     * the statement's result depends on, and the range must hold every such row.
     */
    scan_range(*self, t: &Txn, table: u64, lo: KeyBound, hi: KeyBound, logged: Pred) -> Result[Buf[Hit], CodecError]
        val r = self.scan_range_in(t, table, lo, hi, logged)
        self.guard(t, r)

    /** The primary key `table`'s tree is keyed by: its columns' ids and their §4.6 encodings. */
    key_of_table(*self, table: u64) -> Result[(Buf[u32], Buf[KeyColumn]), CodecError]
        val d = self.table_data(table)?
        Ok((d.key_columns, d.key_spec))

    /** One write statement's changes to `table`, which the executor computed from rows it read at
     * `t`'s snapshot: each a new row, a row replaced or a row removed, by key, applied in order under
     * §4.2. A statement answers `Wait` before writing any of them if one of their keys is locked by
     * another transaction. A `Put` of a key visible to `t` is `unique_violation`. Once every change
     * is applied, each row written is checked against the table's secondary unique keys
     * (`unique_check`); a conflict with a row another live transaction is writing undoes the batch
     * and answers `Wait`.
     */
    write_rows(*self, t: &Txn, table: u64, changes: Buf[RowChange]) -> Result[WriteOutcome, CodecError]
        val m = self.mark_of(t)
        val r = self.write_rows_in(t, table, changes)
        val checked = self.checked(t, table, m, r)
        self.guard(t, checked)

    /** Whether `t` may run a statement: `W2001` once it has committed, `W2003` once it is aborted. */
    usable(self, t: &Txn) -> Result[unit, CodecError] = live(t)

    /** `e`, raised inside `t` outside the store: it aborts `t` with its code (§5.1, `fail_txn`),
     * unless `t` has already ended.
     */
    abort_with(*self, t: &Txn, e: CodecError) -> CodecError
        if t.state == Live then self.fail_txn(t, e.code)
        e

    /** Commits `t` and answers its commit sequence number, or, for a transaction with an empty write
     * set, its snapshot, at which it is serialized (§5.5). A serializable writer is validated first
     * (§4.3) and aborted with `serialization_failure` if a write committed during its lifetime
     * matches a read it logged. A transaction already aborted answers the code that aborted it.
     */
    commit(*self, t: &Txn) -> Result[u64, CodecError]
        t.state match
            Live -> ()
            CommittedAt(_) -> return fail("W2001", "the transaction has already committed")
            AbortedWith(code) ->
                if self.holds(t) then self.rollback(t, code)
                if code.len == 0 then return fail("W2003", "the transaction was rolled back")
                return fail(code, "the transaction was aborted")

        // The catalog read is validated and the transaction's DDL merged first, so that what follows
        // runs against the newest definitions (`ddl.md` §6.3, §6.4). The deferred foreign-key checks
        // run next, so that a serializable transaction's reads among them are validated with the
        // rest (`ddl.md` §2.6 rule 2).
        self.commit_catalog(t) match
            Ok(_) -> ()
            Err(e) ->
                self.rollback(t, e.code)
                return Err(e)

        self.check_deferred(t) match
            Ok(_) -> ()
            Err(e) ->
                self.rollback(t, e.code)
                return Err(e)

        // A transaction with an empty write set is serialized at its snapshot; its `LOCK_ONLY`
        // locks, which are no versions, end with it.
        if t.writes.len() == 0 && !self.has_ddl(t)
            val _ = self.rows.commit_at(t.id, t.snapshot)
            t.state = CommittedAt(t.snapshot)
            self.retire(t)
            return Ok(t.snapshot)

        if t.level == Serializable && !self.faults.skip_validation && !self.valid(t)
            self.rollback(t, "T1001")
            return fail("T1001", "a write committed during the transaction matches a read it made")

        // Commit changes no row: whether a snapshot sees `t`'s versions is read from its commit
        // number, and its row locks, which are its id in the rows' `txn`, lapse with it (§4.1).
        val ddl = self.has_ddl(t)
        val c = self.rows.commit(t.id).unwrap()
        self.publish_catalog(t, c)
        self.horizon = c
        t.state = CommittedAt(c)
        self.history.push(CommittedWrites(c, t.writes))
        self.retire(t)

        // The jobs its DDL started run now, after its commit (`ddl.md` §7 rule 1).
        if ddl then self.run_jobs(t.id)
        Ok(c)
    end commit

    /** Rolls `t` back at the client's request. Its writes are undone; none was ever visible. An
     * aborted transaction still holding its writes for a savepoint (`fail_txn`) lets them go now.
     */
    abort(*self, t: &Txn) -> Result[unit, CodecError]
        t.state match
            Live -> self.rollback(t, "")
            CommittedAt(_) -> return fail("W2001", "the transaction has already committed")
            AbortedWith(code) -> if self.holds(t) then self.rollback(t, code)

        Ok(())

    /** The predicate-log entries `t` holds. */
    logged(self, t: &Txn) -> usize = t.log.len()

    /** The number of committed write sets retained for validation. */
    retained(self) -> usize = self.history.len()

    // -- reading ------------------------------------------------------------------------------------

    private scan_in(*self, t: &Txn, table: u64, p: Pred) -> Result[Buf[Hit], CodecError]
        live(t)?
        val d = self.table_data(table)?
        val f = p.matches
        val out = buf[Hit]()

        for s in self.slots_of(d)?
            self.visible(d, s, t.snapshot, t.id)? match
                Some(r) -> if f(r) then out.push(Hit(s.key, self.translated(table, r)?))
                None -> ()

        self.log_read(t, table, p, None)
        Ok(out)

    private[terndb] get_in(*self, t: &Txn, table: u64, key: Value) -> Result[Option[StoredRow], CodecError]
        live(t)?
        val d = self.table_data(table)?
        self.log_read(t, table, all_rows(), Some(key))

        val s = self.slot_at(d, key)? match
            Some(s) -> s
            None -> return Ok(None)

        self.visible(d, s, t.snapshot, t.id)? match
            Some(r) -> Ok(Some(self.translated(table, r)?))
            None -> Ok(None)

    private scan_range_in(*self, t: &Txn, table: u64, lo: KeyBound, hi: KeyBound, logged: Pred) -> Result[Buf[Hit], CodecError]
        live(t)?
        val d = self.table_data(table)?
        val out = buf[Hit]()

        for r in self.rows.table_rows(d.oid, lo, hi)?
            self.slots_read += 1
            val s = Slot(self.key_value(d, r.key.view())?, r.key, r.row)

            self.visible(d, s, t.snapshot, t.id)? match
                Some(r) -> out.push(Hit(s.key, self.translated(table, r)?))
                None -> ()

        self.log_read(t, table, logged, None)
        Ok(out)

    // A read is logged only by a serializable transaction not declared read-only (§4.3, §5.5).
    private[terndb] log_read(*self, t: &Txn, table: u64, p: Pred, key: Option[Value])
        if t.level == Serializable && !t.read_only then t.log.push(LogEntry(table, p, key))

    // -- writing ------------------------------------------------------------------------------------

    private insert_in(*self, t: &Txn, table: u64, row: StoredRow) -> Result[WriteOutcome, CodecError]
        live(t)?
        if t.read_only then return fail("T4001", "a write in a read-only transaction")
        val d = self.table_data(table)?
        val key = self.key_of(d, row)?

        val s = self.slot_at(d, key)? match
            Some(s) -> s
            None -> return self.install(t, d, key, Some(row))

        val lock = self.lock_of(s)
        if lock != 0 && lock != t.id then return self.wait_on(t, lock)
        if self.visible(d, s, t.snapshot, t.id)?.is_some() then return duplicate()

        // A key this transaction deleted is free for it again.
        if owns(s, t.id) then return self.install(t, d, key, Some(row))

        // A live key committed after the snapshot is a race at snapshot and serializable (rule 4); at
        // read committed the check reads the newest committed version, as rule 3 does.
        self.newest_committed(d, s)? match
            Some(v) -> if v.row.is_some()
                if t.level == ReadCommitted then return duplicate()
                return fail("T1001", "the key was inserted by a transaction that committed after the snapshot")
            None -> ()

        self.install(t, d, key, Some(row))
    end insert_in

    private modify_in(*self, t: &Txn, table: u64, p: Pred, change: Option[&Fn(StoredRow) -> Value], version: u64) -> Result[WriteOutcome, CodecError]
        live(t)?
        if t.read_only then return fail("T4001", "a write in a read-only transaction")
        val d = self.table_data(table)?
        val f = p.matches
        val targets = buf[Slot]()

        for s in self.slots_of(d)?
            self.visible(d, s, t.snapshot, t.id)? match
                Some(r) -> if f(r) then targets.push(s)
                None -> ()

        // The statement writes nothing until no row it must write is locked, so a `Wait` leaves no
        // trace and the statement is simply called again.
        for s in targets
            val lock = self.lock_of(s)
            if lock != 0 && lock != t.id then return self.wait_on(t, lock)

        self.log_read(t, table, p, None)
        val schema = if version == 0 then self.current_version(table) else version
        var n: usize = 0

        for s in targets
            val base = if owns(s, t.id)
                self.image_row(d, s.key, s.img)?
            elif t.level == ReadCommitted
                // Rule 3: re-read the newest committed version and re-evaluate the predicate on it.
                self.newest_committed(d, s)? match
                    Some(v) -> v.row match
                        Some(r) -> if f(r) then Some(r) else None
                        None -> None
                    None -> None
            else
                self.visible(d, s, t.snapshot, t.id)?

            base match
                Some(r) ->
                    val after = change match
                        Some(g) -> Some(StoredRow(schema, g(r)))
                        None -> None

                    self.install(t, d, s.key, after)?
                    n += 1
                None -> ()

        t.waits_for = 0
        Ok(Done(n))
    end modify_in

    private write_rows_in(*self, t: &Txn, table: u64, changes: Buf[RowChange]) -> Result[WriteOutcome, CodecError]
        live(t)?
        if t.read_only then return fail("T4001", "a write in a read-only transaction")
        val d = self.table_data(table)?

        // As `modify_in`: nothing is written until no row the statement writes is locked.
        for c in changes
            val key = c match
                Put(row) -> self.key_of(d, row)?
                Replace(k, _) | Remove(k) -> k

            self.slot_at(d, key)? match
                Some(s) ->
                    val lock = self.lock_of(s)
                    if lock != 0 && lock != t.id then return self.wait_on(t, lock)
                None -> ()

        var n: usize = 0

        for c in changes
            c match
                Put(row) ->
                    val _ = self.insert_in(t, table, row)?
                Replace(k, row) -> self.replace_in(t, d, k, Some(row))?
                Remove(k) -> self.replace_in(t, d, k, None)?

            n += 1

        t.waits_for = 0
        Ok(Done(n))
    end write_rows_in

    // `t`'s version of the row keyed `key`, which `t` sees, becomes `after`.
    private replace_in(*self, t: &Txn, d: &TableData, key: Value, after: Option[StoredRow]) -> Result[unit, CodecError]
        val visible = self.slot_at(d, key)? match
            Some(s) -> self.visible(d, s, t.snapshot, t.id)?.is_some()
            None -> false

        if !visible then return fail("D1001", "a written row is not visible to its writer")
        val _ = self.install(t, d, key, after)?
        Ok(())

    // Installs `after` as `t`'s version of the row keyed `key` (§4.2 rule 2), or writes over `t`'s
    // own version: either way one undo record and the row rewritten in its B+tree.
    private install(*self, t: &Txn, d: &TableData, key: Value, after: Option[StoredRow]) -> Result[WriteOutcome, CodecError]
        t.waits_for = 0
        val found = self.slot_at(d, key)?

        // `t`'s own version is written over (another undo record, so that a statement or savepoint
        // can take back just the later write); a row `t` only holds `LOCK_ONLY` gets its first
        // version of `t` below, as any other row does.
        val own = found match
            Some(s) -> owns(s, t.id)
            None -> false

        if own
            self.put_version(t, d, key, found, after)?

            for i in 0..<t.writes.len()
                val w = t.writes[i]

                if w.table == d.oid && w.key == key
                    t.undo.push(Undo(d.oid, key, false, i, w.after))
                    t.writes[i] = Write(w.table, w.key, w.before, after)

            index_image(self.catalog, d, key, after)
            return Ok(Done(1))

        var c: u64 = 0
        var before: Option[StoredRow] = None

        found match
            Some(s) -> self.newest_committed(d, s)? match
                Some(v) ->
                    c = v.commit
                    before = v.row
                None -> ()
            None -> ()

        if t.level != ReadCommitted && !self.faults.skip_first_updater_wins && c > t.snapshot
            return fail("T1001", "the row was changed by a transaction that committed after the snapshot")

        // `ddl.md` §5.4 rule 3: no writer replaces a newer encoding.
        (before, after) match
            (Some(b), Some(a)) -> if b.schema > a.schema
                return fail("T1004", "the row is encoded in a schema version newer than the statement's")
            _ -> ()

        self.put_version(t, d, key, found, after)?
        t.writes.push(Write(d.oid, key, before, after))
        t.undo.push(Undo(d.oid, key, true, 0, None))
        index_image(self.catalog, d, key, after)
        Ok(Done(1))
    end install

    // Writes `after` as `t`'s newest version of the row keyed `key`, whose leaf image is `found`:
    // an insert where there is no live row (none, or a ghost), an update over a live row, a delete
    // for `None`. The undo log writes the record and the row (`UndoRows`); a row the leaf cannot
    // hold is refused before either, with `entry_too_large` for one that would need an overflow
    // chain (§4.7, §4.8).
    private put_version(*self, t: &Txn, d: &TableData, key: Value, found: Option[Slot], after: Option[StoredRow]) -> Result[unit, CodecError]
        val kb = self.key_bytes(d, key)?

        val live_row = found match
            Some(s) -> s.img.header.flags & RowDeleted == 0
            None -> false

        val outcome = after match
            Some(r) ->
                val (schema, cols) = self.images_of(d, r)?
                if live_row then self.rows.update(t.id, d.oid, kb.view(), schema, cols.view())? else self.rows.insert(t.id, d.oid, kb.view(), schema, cols.view())?
            None ->
                if !live_row then return Ok(())
                self.rows.delete(t.id, d.oid, kb.view())?

        outcome match
            UndoDone(_) -> Ok(())
            UndoLocked(h) -> fail("D1001", s"a row the store found unlocked is locked by transaction $h")
            _ -> fail("D1001", "a row write the store checked was refused by the undo log")

    // `t` waits for `holder`. A wait that would close a cycle in the wait-for graph aborts `t`, the
    // transaction that closed it (§4.2 rule 1).
    private[terndb] wait_on(*self, t: &Txn, holder: u64) -> Result[WriteOutcome, CodecError]
        var h = holder

        while h != 0
            if h == t.id then return fail("T1002", "waiting for the row lock would close a cycle")
            h = self.waiting_of(h)

        t.waits_for = holder
        Ok(Wait(holder))

    private waiting_of(self, id: u64) -> u64
        for a in self.active
            if a.id == id then return a.waits_for

        0

    // -- validation (§4.3) ------------------------------------------------------------------------

    // Whether no write committed during `t`'s lifetime matches an entry of its predicate log.
    private valid(self, t: &Txn) -> bool
        for h in self.history
            if h.c > t.snapshot
                for w in h.writes
                    for e in t.log
                        if e.table == w.table && self.changes(e, w) && (matches(e, w, w.before) || matches(e, w, w.after))
                            return false

        true

    // Whether `w` changes visibility or a column `e` read.
    private changes(self, e: LogEntry, w: Write) -> bool
        val (b, a) = (w.before, w.after) match
            (Some(b), Some(a)) -> (b, a)
            _ -> return true

        if e.pred.every then return b != a

        for id in e.pred.columns
            val x = self.column_value(w.table, b, id)
            val y = self.column_value(w.table, a, id)

            (x, y) match
                (Some((ty, u)), Some((_, v))) -> if !same(ty, u, v) then return true
                (None, None) -> ()
                _ -> return true

        false

    // -- the catalog ------------------------------------------------------------------------------

    private[terndb] table_data(*self, oid: u64) -> Result[&TableData, CodecError]
        for d in self.tables
            if d.oid == oid then return Ok(d)

        val i = self.catalog.table_by_oid(oid) match
            Some(i) -> i
            None -> return fail("Q2001", "no table has this oid")

        val ct = self.catalog.tables[i]
        val fields = buf[Field]()

        val spec = buf[KeyColumn]()

        for id in ct.primary_key
            ct.column_by_id(id) match
                Some(c) ->
                    fields.push(Field(c.name, c.ty))
                    spec.push(KeyColumn(resolve_type(self.catalog, c.ty)?.base(), false))
                None -> ()

        val d: &TableData = TableData(oid, ct.primary_key.copy(), record(fields.view()), spec, buf(), buf())
        self.tables.push(d)
        Ok(d)

    // -- rows in pages ----------------------------------------------------------------------------

    /** The §4.6 encoding of `key`, a record of `d`'s primary-key columns: the row's key in its tree.
     * A key over 1,024 bytes is `key_too_long`.
     */
    private[terndb] key_bytes(self, d: &TableData, key: Value) -> Result[Buf[u8], CodecError]
        val parts = key match
            Record(fs) -> fs
            _ -> return fail("D1001", "a primary key is not a record")

        val kb = encode_key(d.key_spec.view(), parts.view())?
        if kb.len() > MaxKeyLen then return fail("D2001", "an encoded primary key longer than 1,024 bytes")
        Ok(kb)

    /** The key a tree entry's key bytes `kb` encode, as a record. */
    private key_value(self, d: &TableData, kb: []const u8) -> Result[Value, CodecError] =
        Ok(Record(decode_key(d.key_spec.view(), kb)?))

    /** The codec of schema version `schema` of `d`, made from the installed catalog's column list the
     * first time a row of that version is written, and declared to the rows as the version's layout.
     * For a write (`writing`) the codec is made again when the catalog's columns of that version are
     * not the codec's: a version number a rolled-back `ALTER` used is given out again, and no row of
     * the rolled-back version is left in any tree.
     */
    private[terndb] codec_of(*self, d: &TableData, schema: u64, writing: bool = false) -> Result[SchemaCodec, CodecError]
        for c in d.codecs
            if c.number == schema && !writing then return Ok(c)

        val now = self.columns_at(d.oid, schema)

        for i in 0..<d.codecs.len()
            val c = d.codecs[i]

            if c.number == schema
                val stale = now match
                    Some(cs) -> cs != c.columns
                    None -> false

                if !stale then return Ok(c)
                d.codecs.remove(i)
                break

        if schema > 0xFFFF then return fail("D1001", "a schema version past what a row header holds")

        val columns = now match
            Some(cs) -> cs
            None -> return fail("D1001", "the row is not encoded in a schema version of its table")

        val key_at = buf[usize]()

        for id in d.key_columns
            for j in 0..<columns.len()
                if columns[j].id == id then key_at.push(j)

        if key_at.len() != d.key_columns.len() then return fail("D1001", "a schema version without every primary-key column")
        val types = buf[Type]()
        val widths = buf[usize]()

        for j in 0..<columns.len()
            if !held(key_at, j)
                val ty = resolve_type(self.catalog, columns[j].ty)?
                types.push(ty)
                widths.push(row_width(ty.base()))

        val c = SchemaCodec(schema, columns, key_at, types)
        d.codecs.push(c)
        self.rows.layout(d.oid, u16(schema), widths.view())
        Ok(c)

    /** `r` as the leaf stores it: its schema version and the image of each non-key column (§4.2,
     * §4.4), null or its encoding.
     */
    private images_of(*self, d: &TableData, r: StoredRow) -> Result[(u16, Buf[ColumnImage]), CodecError]
        val c = self.codec_of(d, r.schema, true)?

        val fields = r.value match
            Record(fs) -> fs
            _ -> return fail("D1001", "a stored row is not a record")

        if fields.len() != c.columns.len() then return fail("Q3001", "a row whose values do not match its schema version's columns")
        val cols = buf[ColumnImage]()
        var k: usize = 0

        for j in 0..<fields.len()
            if !held(c.key_at, j)
                val v = fields[j]
                cols.push(if v.is_null() then ColumnImage(true, buf[u8]()) else ColumnImage(false, encode_value(c.types[k], v)?))
                k += 1

        Ok((u16(r.schema), cols))

    /** The stored row of key `key` whose leaf or rebuilt image is `img`; none for a ghost. */
    private[terndb] image_row(*self, d: &TableData, key: Value, img: RowImage) -> Result[Option[StoredRow], CodecError]
        if img.header.flags & RowDeleted != 0 then return Ok(None)
        val c = self.codec_of(d, u64(img.header.schema_version))?

        val parts = key match
            Record(fs) -> fs
            _ -> return fail("D1001", "a primary key is not a record")

        if img.cols.len() != c.types.len() then return fail("D1001", "a row with another column count than its schema version")
        val out = buf[Value]()
        var k: usize = 0

        for j in 0..<c.columns.len()
            var kp: Option[usize] = None

            for i in 0..<c.key_at.len()
                if c.key_at[i] == j then kp = Some(i)

            kp match
                Some(i) -> out.push(parts[i])
                None ->
                    val col = img.cols[k]
                    out.push(if col.is_null then Value.Null else decode_value(c.types[k], col.bytes.view())?)
                    k += 1

        Ok(Some(StoredRow(u64(img.header.schema_version), Record(out))))

    /** Every row of `d` in key order, ghosts included, as the leaf holds it now. */
    private[terndb] slots_of(self, d: &TableData) -> Result[Buf[Slot], CodecError]
        val out = buf[Slot]()

        for r in self.rows.table_rows(d.oid, KeyAny, KeyAny)?
            out.push(Slot(self.key_value(d, r.key.view())?, r.key, r.row))

        Ok(out)

    /** The row of `d` keyed `key`, ghost or not, as the leaf holds it now. */
    private[terndb] slot_at(self, d: &TableData, key: Value) -> Result[Option[Slot], CodecError]
        val kb = self.key_bytes(d, key)?

        self.rows.current(d.oid, kb.view())? match
            Some(img) -> Ok(Some(Slot(key, kb, img)))
            None -> Ok(None)

    /** The live transaction holding `s`'s write lock, by a version or `LOCK_ONLY`; 0 for none. */
    private[terndb] lock_of(self, s: Slot) -> u64 = if self.rows.is_active(s.img.header.txn) then s.img.header.txn else 0

    /** The image of `s` a reader with snapshot `snap` and id `me` sees: its own uncommitted version,
     * else the newest committed at or before `snap` (§4.1), rebuilt through the undo log (§5.4). A
     * ghost is none.
     */
    private[terndb] visible(*self, d: &TableData, s: Slot, snap: u64, me: u64) -> Result[Option[StoredRow], CodecError] =
        self.rows.version_of(s.img, snap, me)? match
            Some(img) -> self.image_row(d, s.key, img)
            None -> Ok(None)

    /** The newest committed version of `s`, its writer and commit number, rebuilt past a live
     * writer's versions; none when no committed version exists. A version whose record is below
     * `undo_low` is reported with commit number 0: every snapshot sees it.
     */
    private[terndb] newest_committed(*self, d: &TableData, s: Slot) -> Result[Option[RowVersion], CodecError]
        var cur = s.img

        loop
            val w = self.rows.writer_of(cur)?
            if w == 0 then return Ok(Some(RowVersion(0, 0, self.image_row(d, s.key, cur)?)))

            self.rows.txn_of(w) match
                Some(x) -> if x.state == UndoTxnCommitted then return Ok(Some(RowVersion(w, x.commit, self.image_row(d, s.key, cur)?)))
                None -> return fail("D1001", "a row version names a transaction that never began")

            if cur.header.undo < self.rows.space.low then return fail("D1001", "a live writer's version whose record is below undo_low")
            val rec = self.rows.space.read(cur.header.undo)?

            undo_back(cur, rec)? match
                Some(prev) -> cur = prev
                None -> return Ok(None)

    /** The newest version of `s`: a live writer's (commit 0), else the newest committed one. */
    private[terndb] top_version(*self, d: &TableData, s: Slot) -> Result[Option[RowVersion], CodecError]
        val w = self.rows.writer_of(s.img)?
        if w != 0 && self.rows.is_active(w) then return Ok(Some(RowVersion(w, 0, self.image_row(d, s.key, s.img)?)))
        self.newest_committed(d, s)

    /** Every version of `s` still reachable, newest first, ghosts left out. */
    private[terndb] all_versions(*self, d: &TableData, s: Slot) -> Result[Buf[StoredRow], CodecError]
        val out = buf[StoredRow]()
        var cur = s.img

        loop
            self.image_row(d, s.key, cur)? match
                Some(r) -> out.push(r)
                None -> ()

            if cur.header.undo < self.rows.space.low then return Ok(out)
            val rec = self.rows.space.read(cur.header.undo)?

            undo_back(cur, rec)? match
                Some(prev) -> cur = prev
                None -> return Ok(out)

    /** The structural checks of the store's pages: every table's B+tree (`check_btrees`) and the undo
     * log with every row's version chain (`check_undo`).
     */
    check_pages(self) -> Result[UndoStats, CodecError] = check_undo(self.rows)

    /** Purges the undo log up to the oldest snapshot a live transaction holds or one beginning now
     * would take (§5.5, §5.6): ghosts no snapshot can see leave their trees, and undo pages no
     * snapshot needs are dropped.
     */
    purge(*self) -> Result[PurgeStats, CodecError]
        var low = self.snapshot_now()

        for a in self.active
            if a.snapshot < low then low = a.snapshot

        self.rows.purge(low)

    private current_version(self, oid: u64) -> u64 = self.catalog.table_by_oid(oid) match
        Some(i) -> self.catalog.tables[i].schema_version()
        None -> 0

    /** `r` as a row of the current schema version of table `oid` in the installed catalog (`ddl.md`
     * §5.3), each column matched by id: one present in `r`'s version converted through every retype
     * since (`translate.sysl`); one added since reads its fill (a literal, else null); one dropped
     * since is skipped. A value that does not convert is `data_corrupted` (`D1001`).
     */
    private[terndb] translated(self, oid: u64, r: StoredRow) -> Result[StoredRow, CodecError]
        val now = self.current_version(oid)
        if r.schema == now || now == 0 then return Ok(r)

        val i = self.catalog.table_by_oid(oid) match
            Some(i) -> i
            None -> return Ok(r)

        val from = self.columns_at(oid, r.schema) match
            Some(c) -> c
            None -> return fail("D1001", "the row is not encoded in a schema version of its table")

        val fields = r.value match
            Record(fs) -> fs
            _ -> return fail("D1001", "a stored row is not a record")

        val to = self.columns_at(oid, now) match
            Some(c) -> c
            None -> return Ok(r)

        val out = buf[Value]()

        for c in to
            var v = fill_of(c.fill)

            for j in 0..<from.len()
                if from[j].id == c.id && j < fields.len() then v = translated_column(self.catalog, self.catalog.tables[i], c.id, r.schema, fields[j])?

            out.push(v)

        Ok(StoredRow(now, Record(out)))
    end translated

    private columns_at(self, oid: u64, schema: u64) -> Option[Buf[CatColumn]]
        val i = self.catalog.table_by_oid(oid)?

        for v in self.catalog.tables[i].versions
            if v.number == schema then return Some(v.columns)

        None

    // The type and value of column `id` in `r`, read through `r`'s own schema version.
    private column_value(self, oid: u64, r: StoredRow, id: u32) -> Option[(Type, Value)]
        val columns = self.columns_at(oid, r.schema)?

        val fields = r.value match
            Record(fs) -> fs
            _ -> return None

        for j in 0..<columns.len()
            if columns[j].id == id && j < fields.len() then return Some((columns[j].ty, fields[j]))

        None

    // The key of `r`: its primary-key columns as a record.
    private key_of(self, d: &TableData, r: StoredRow) -> Result[Value, CodecError]
        val parts = buf[Value]()

        for id in d.key_columns
            self.column_value(d.oid, r, id) match
                Some((_, v)) -> parts.push(v)
                None -> return fail("D1001", "the row is not encoded in a schema version of its table")

        Ok(Record(parts))

    // -- ending -----------------------------------------------------------------------------------

    // Wraps an operation: any error inside a transaction aborts it with that error's code (§5.1).
    private[terndb] guard[T](*self, t: &Txn, r: Result[T, CodecError]) -> Result[T, CodecError] = r match
        Ok(v) -> Ok(v)
        Err(e) ->
            if t.state == Live then self.fail_txn(t, e.code)
            Err(e)

    // Undoes `t`'s writes and locks through its rollback chain, newest first (§5.3); none was ever
    // visible. A chain the undo log finds damaged leaves the rows as far as it got, and the next
    // structural check names the damage.
    private[terndb] rollback(*self, t: &Txn, code: string)
        val _ = self.rows.abort(t.id)
        t.locks.clear()
        t.saves.clear()
        t.state = AbortedWith(code)
        self.retire(t)

    private[terndb] retire(*self, t: &Txn)
        t.waits_for = 0

        for i in 0..<self.active.len()
            if self.active[i].id == t.id
                val _ = self.active.remove(i)
                break

        self.retire_catalog(t)
        self.prune()
        val _ = self.purge()

    // Drops the committed write sets no live serializable transaction can be validated against: those
    // committed at or before every such transaction's snapshot.
    private prune(*self)
        var low = self.horizon

        for a in self.active
            if a.level == Serializable && !a.read_only && a.snapshot < low then low = a.snapshot

        val kept = buf[CommittedWrites]()

        for h in self.history
            if h.c > low then kept.push(h)

        self.history = kept
end Store

/** The value a row of an older version reads for a column added since: its fill. */
private fill_of(fill: Option[Expr]) -> Value = fill match
    Some(Literal(_, v)) -> v
    _ -> Null

/** A store over `catalog`'s tables, empty. */
mem_store(catalog: MemCatalog) -> &Store =
    Store(catalog, Faults(false, false, false, false), 1, 0, buf(), undo_rows(), buf(), buf(), catalog_versions(catalog), 0, buf(), 0)

/** `value` as a row of `table` in its current schema version. */
store_row(s: &Store, table: u64, value: Value) -> StoredRow
    val v = s.catalog.table_by_oid(table) match
        Some(i) -> s.catalog.tables[i].schema_version()
        None -> 0

    StoredRow(v, value)

private[terndb] live(t: &Txn) -> Result[unit, CodecError] = t.state match
    Live -> Ok(())
    CommittedAt(_) -> fail("W2001", "the transaction has already committed")
    AbortedWith(_) -> fail("W2003", "the transaction is aborted")

private duplicate[T]() -> Result[T, CodecError] = fail("T3001", "a row with this key is visible to the transaction")

/** Whether the newest version of `s` is the uncommitted one of transaction `id`: the row carries
 * `id` as a writer, not as a `LOCK_ONLY` locker.
 */
private[terndb] owns(s: Slot, id: u64) -> bool = s.img.header.txn == id && s.img.header.flags & RowLockOnly == 0

/** Whether `ns` holds `j`. */
private held(ns: Buf[usize], j: usize) -> bool
    for n in ns
        if n == j then return true

    false

// Whether the image `img` of write `w` satisfies the log entry `e`; an absent image matches nothing.
private matches(e: LogEntry, w: Write, img: Option[StoredRow]) -> bool = img match
    Some(r) -> e.key match
        Some(k) -> w.key == k
        None ->
            val f = e.pred.matches
            f(r)
    None -> false
