module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// `sql.md` end to end: SQL scripts translated by the front end, with the engine's catalog as the
// resolver, and run over the wire against an in-memory engine (the engine tests' `Duo`): every tree
// sent as an encoded envelope, every transaction statement as the wire's own request, every result
// decoded from its batches. These are the tests that say the 0.0.1 subset works.

/** A connection running SQL: its engine, its wire client, and the open transaction's handle (0 for
 * none).
 */
struct SqSession
    e: &Engine
    d: Duo
    txn: u64

    /** Each statement of `script`, run in order: the replies to each. A statement that fails stops the
     * script; its replies are the last.
     */
    run(*self, script: string, values: []const Value = [], file: string = __FILE__, line: long = __LINE__) -> Buf[Buf[Message]]
        val out = buf[Buf[Message]]()
        val statements = sql_statements(script, "public", self.e.store.latest_catalog()) match
            Ok(s) -> s
            Err(err) ->
                print(s"\n$script\n  -> ${err.code}@${err.line}:${err.column} ${err.message}\n")
                assert(false, "the script translates", file, line)
                return out

        for st in statements
            val replies = st.action match
                SqlTree(env) -> self.d.seen(self.d.send(ew_exec(self.txn, env, values)))
                SqlControl(c) -> self.control(c)
            out.push(replies)
            if sq_failed(replies) then break

        out

    control(*self, c: SqlTxn) -> Buf[Message]
        c match
            SqlBegin(o) ->
                self.txn = 1
                self.d.seen(self.d.send(Begin(1, o)))
            SqlCommit ->
                val r = self.d.seen(self.d.send(Commit(self.txn)))
                self.txn = 0
                r
            SqlRollback ->
                val r = self.d.seen(self.d.send(Rollback(self.txn)))
                self.txn = 0
                r
            SqlSavepoint(n) -> self.d.seen(self.d.send(Savepoint(self.txn, n)))
            SqlRelease(n) -> self.d.seen(self.d.send(ReleaseSavepoint(self.txn, n)))
            SqlRollbackTo(n) -> self.d.seen(self.d.send(RollbackToSavepoint(self.txn, n)))

    /** Runs `script`, every statement of which must succeed. */
    ok(*self, script: string, file: string = __FILE__, line: long = __LINE__)
        for r in self.run(script, [], file, line)
            if sq_failed(r) then print(s"\n$script\n  -> ${ew_kinds(r)}\n")
            assert(!sq_failed(r), "every statement succeeds", file, line)

    /** The rows of `script`'s last statement, every statement of which must succeed. */
    rows(*self, script: string, values: []const Value = [], file: string = __FILE__, line: long = __LINE__) -> Buf[Value]
        val all = self.run(script, values, file, line)
        for r in all
            if sq_failed(r) then print(s"\n$script\n  -> ${ew_kinds(r)}\n")
            assert(!sq_failed(r), "every statement succeeds", file, line)
        if all.len() == 0 then return buf()
        ew_rows(all[all.len() - 1])

    /** The row count of `script`'s last statement. */
    count(*self, script: string, file: string = __FILE__, line: long = __LINE__) -> u64
        val all = self.run(script, [], file, line)
        for r in all
            if sq_failed(r) then print(s"\n$script\n  -> ${ew_kinds(r)} ${ew_error(r).entries[0].code}\n")
            assert(!sq_failed(r), "every statement succeeds", file, line)
        val (counts, _) = ew_complete(all[all.len() - 1])
        counts[0]

    /** The code of the error that stopped `script`, or `ok`. */
    code(*self, script: string, file: string = __FILE__, line: long = __LINE__) -> string
        sql_statements(script, "public", self.e.store.latest_catalog()) match
            Err(err) -> return err.code
            Ok(_) -> ()
        val all = self.run(script, [], file, line)
        if all.len() == 0 then return "untranslated"
        val last = all[all.len() - 1]
        if !sq_failed(last) then return "ok"
        ew_error(last).entries[0].code
end SqSession

private sq_failed(ms: Buf[Message]) -> bool
    for m in ms
        m match
            ErrorReply(_) -> return true
            _ -> ()
    false

/** A connection to a new engine holding the `public` schema and the tables `users` and `posts`. */
private sq_db() -> SqSession
    val e = ew_engine()
    var s = SqSession(e, ew_duo(e), 0)
    s.ok("""
        CREATE SCHEMA public;
        CREATE TABLE users (id int64 PRIMARY KEY, name text NOT NULL, age int16, city text);
        INSERT INTO users VALUES (1, 'ann', 30, 'oslo'), (2, 'bob', NULL, 'rome'), (3, 'cy', 25, NULL);
        CREATE TABLE posts (id int64 PRIMARY KEY, author int64 NOT NULL REFERENCES users, title text NOT NULL, score int32 DEFAULT 0);
        INSERT INTO posts VALUES (10, 1, 'a', 5), (11, 1, 'b', 7), (12, 2, 'c', 1), (13, 3, 'd', NULL);
        """)
    s

private sq_ints(rows: Buf[Value]) -> Buf[i128]
    val out = buf[i128]()
    for r in rows
        r match
            Record(fs) -> out.push(fs[0] match
                Value.Int(n) -> n
                Value.UInt(n) -> i128(n)
                Value.Null -> -999
                _ -> -998)
            _ -> out.push(-997)
    out

private sq_is(xs: []const i128) -> Buf[i128]
    val b = buf[i128]()
    b.extend(xs)
    b

private sq_strs(rows: Buf[Value]) -> Buf[string]
    val out = buf[string]()
    for r in rows
        r match
            Record(fs) -> out.push(fs[0] match
                Value.Text(s) -> s
                Value.Null -> "<null>"
                _ -> "<?>")
            _ -> out.push("<?>")
    out

@test
a_fresh_database_has_no_public_schema_until_one_is_created()
    val e = ew_engine()
    var s = SqSession(e, ew_duo(e), 0)
    assert_eq(s.code("CREATE TABLE t (a int PRIMARY KEY)"), "Q6003")
    s.ok("CREATE SCHEMA public; CREATE TABLE t (a int PRIMARY KEY)")
    assert_eq(s.rows("SELECT * FROM t").len(), 0)

@test
select_filters_projects_orders_and_limits()
    var s = sq_db()
    assert(sq_strs(s.rows("SELECT name FROM users WHERE age > 26")) == sql_names(["ann"]), "where")
    assert(sq_strs(s.rows("SELECT name, id FROM users ORDER BY name DESC LIMIT 2")) == sql_names(["cy", "bob"]), "order and limit")
    assert(sq_strs(s.rows("SELECT name FROM users ORDER BY id OFFSET 1")) == sql_names(["bob", "cy"]), "offset")
    assert(sq_strs(s.rows("SELECT name FROM users ORDER BY id FETCH FIRST 1 ROW ONLY")) == sql_names(["ann"]), "fetch")
    assert_eq(s.rows("SELECT * FROM users LIMIT 2").len(), 2)
    assert(s.rows("SELECT * FROM users WHERE id = 1")[0] == rec([Int(1), Text("ann"), Int(30), Text("oslo")]), "select *")
    assert(s.rows("SELECT id * 10 AS x, upper(name) || '!', length(name) FROM users WHERE id = 2")[0] == rec([Int(20), Text("BOB!"), Int(3)]), "expressions")
    assert(s.rows("SELECT 1 + 1, 'x' || 'y', 7 / 2, 7 % 2, -3")[0] == rec([Int(2), Text("xy"), Int(3), Int(1), Int(-3)]), "without from")

@test
nulls_follow_sql_s_three_valued_logic()
    var s = sq_db()
    assert_eq(s.rows("SELECT id FROM users WHERE age = NULL").len(), 0)
    assert(sq_ints(s.rows("SELECT id FROM users WHERE age IS NULL")) == sq_is([2]), "is null")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE age IS NOT NULL ORDER BY id")) == sq_is([1, 3]), "is not null")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE age <> 30")) == sq_is([3]), "a null comparison drops the row")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE NOT (age > 26)")) == sq_is([3]), "not of null is null")
    assert_eq(s.rows("SELECT id FROM users WHERE age NOT IN (30, NULL)").len(), 0)
    assert(sq_ints(s.rows("SELECT id FROM users WHERE age IN (30, NULL)")) == sq_is([1]), "in with a null")
    assert(sq_ints(s.rows("SELECT coalesce(age, -1) FROM users ORDER BY id")) == sq_is([30, -1, 25]), "coalesce")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE city IS NULL OR age IS NULL ORDER BY id")) == sq_is([2, 3]), "or")
    // Nulls sort last ascending and first descending.
    assert(sq_ints(s.rows("SELECT id FROM users ORDER BY age")) == sq_is([3, 1, 2]), "nulls last")
    assert(sq_ints(s.rows("SELECT id FROM users ORDER BY age DESC")) == sq_is([2, 1, 3]), "nulls first descending")
    assert(sq_ints(s.rows("SELECT id FROM users ORDER BY age NULLS FIRST")) == sq_is([2, 3, 1]), "nulls first")
    assert(s.rows("SELECT CASE WHEN age > 26 THEN 'old' WHEN age IS NULL THEN NULL ELSE 'young' END FROM users ORDER BY id") ==
        items_of([rec([Text("old")]), rec([Value.Null]), rec([Text("young")])]), "case")

@test
aggregates_ignore_nulls_and_count_rows()
    var s = sq_db()
    assert(s.rows("SELECT count(*), count(age), sum(age), min(age), max(age), avg(age) FROM users")[0] ==
        rec([Int(3), Int(2), Int(55), Int(25), Int(30), Int(27500000)]), "aggregates")
    assert(s.rows("SELECT count(*), sum(age) FROM users WHERE id > 99")[0] == rec([Int(0), Value.Null]), "over no rows")
    assert(s.rows("SELECT count(DISTINCT author), count(*) FILTER (WHERE score > 4) FROM posts")[0] == rec([Int(3), Int(2)]), "distinct and filter")
    assert(s.rows("SELECT string_agg(title, ',' ORDER BY title DESC) FROM posts")[0] == rec([Text("d,c,b,a")]), "string_agg")

@test
grouping_by_keys_with_having_and_order()
    var s = sq_db()
    assert(s.rows("SELECT author, count(*) AS n, sum(score) FROM posts GROUP BY author HAVING count(*) > 1") == items_of([rec([Int(1), Int(2), Int(12)])]), "having")
    assert(sq_ints(s.rows("SELECT author FROM posts GROUP BY author ORDER BY sum(score) DESC")) == sq_is([3, 1, 2]), "order by an aggregate")
    assert(s.rows("SELECT age IS NULL, count(*) FROM users GROUP BY 1 ORDER BY 1") == items_of([rec([Value.Bool(false), Int(2)]), rec([Value.Bool(true), Int(1)])]), "an expression key")
    assert(s.rows("SELECT u.name, count(p.id) FROM users u LEFT JOIN posts p ON p.author = u.id GROUP BY u.name ORDER BY u.name") ==
        items_of([rec([Text("ann"), Int(2)]), rec([Text("bob"), Int(1)]), rec([Text("cy"), Int(1)])]), "grouped join")

@test
joins_of_every_kind()
    var s = sq_db()
    s.ok("INSERT INTO users (id, name) VALUES (4, 'dee')")
    assert(s.rows("SELECT u.name, p.title FROM users u JOIN posts p ON p.author = u.id ORDER BY p.id") ==
        items_of([rec([Text("ann"), Text("a")]), rec([Text("ann"), Text("b")]), rec([Text("bob"), Text("c")]), rec([Text("cy"), Text("d")])]), "inner")
    assert(s.rows("SELECT u.id, p.id FROM users u LEFT JOIN posts p ON p.author = u.id WHERE p.id IS NULL") == items_of([rec([Int(4), Value.Null])]), "left")
    assert(sq_ints(s.rows("SELECT p.id FROM posts p RIGHT JOIN users u ON p.author = u.id ORDER BY u.id, p.id")) == sq_is([10, 11, 12, 13, -999]), "right")
    assert_eq(s.rows("SELECT * FROM users u FULL JOIN posts p ON p.author = u.id AND p.score > 4").len(), 7)
    assert_eq(s.rows("SELECT u.id FROM users u CROSS JOIN posts").len(), 16)
    assert_eq(s.rows("SELECT u.id FROM users u, posts p WHERE u.id = p.author").len(), 4)
    s.ok("CREATE TABLE likes (id int64 PRIMARY KEY, author int64)")
    s.ok("INSERT INTO likes VALUES (1, 1), (2, 3)")
    assert(sq_ints(s.rows("SELECT author FROM posts JOIN likes USING (author) ORDER BY 1")) == sq_is([1, 1, 3]), "using")

@test
subqueries_ctes_and_derived_tables()
    var s = sq_db()
    assert(sq_ints(s.rows("SELECT id FROM users WHERE id IN (SELECT author FROM posts WHERE score > 4)")) == sq_is([1]), "in")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE id NOT IN (SELECT author FROM posts WHERE score > 4) ORDER BY id")) == sq_is([2, 3]), "not in")
    assert(sq_ints(s.rows("SELECT id FROM users u WHERE EXISTS (SELECT 1 FROM posts p WHERE p.author = u.id AND p.score IS NULL)")) == sq_is([3]), "correlated exists")
    assert(s.rows("SELECT name, (SELECT count(*) FROM posts p WHERE p.author = u.id) FROM users u ORDER BY id") ==
        items_of([rec([Text("ann"), Int(2)]), rec([Text("bob"), Int(1)]), rec([Text("cy"), Int(1)])]), "scalar")
    assert(sq_ints(s.rows("SELECT s.n FROM (SELECT author, count(*) AS n FROM posts GROUP BY author) s WHERE s.author = 1")) == sq_is([2]), "derived")
    assert(sq_ints(s.rows("WITH top AS (SELECT author FROM posts WHERE score >= 5), names AS (SELECT u.id FROM users u JOIN top ON top.author = u.id) SELECT DISTINCT id FROM names")) == sq_is([1]), "ctes")
    assert(s.rows("SELECT * FROM (VALUES (1, 'one'), (2, 'two')) v (n, word) WHERE n = 2") == items_of([rec([Int(2), Text("two")])]), "values in from")

@test
set_operations_and_values()
    var s = sq_db()
    assert(sq_ints(s.rows("SELECT author FROM posts UNION SELECT id FROM users ORDER BY 1")) == sq_is([1, 2, 3]), "union")
    assert_eq(s.rows("SELECT author FROM posts UNION ALL SELECT id FROM users").len(), 7)
    assert(sq_ints(s.rows("SELECT id FROM users INTERSECT SELECT author FROM posts WHERE score > 4")) == sq_is([1]), "intersect")
    assert(sq_ints(s.rows("SELECT id FROM users EXCEPT SELECT author FROM posts WHERE score > 4 ORDER BY 1")) == sq_is([2, 3]), "except")
    assert(s.rows("VALUES (2, 'b'), (1, 'a') ORDER BY 1") == items_of([rec([Int(1), Text("a")]), rec([Int(2), Text("b")])]), "values")

@test
expressions_evaluate()
    var s = sq_db()
    assert(sq_ints(s.rows("SELECT id FROM users WHERE age BETWEEN 20 AND 29")) == sq_is([3]), "between")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE name LIKE 'b%' OR name LIKE '_y'")) == sq_is([2, 3]), "like")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE name NOT LIKE '%n%' ORDER BY id")) == sq_is([2, 3]), "not like")
    assert(s.rows("SELECT CAST(age AS text), CAST('42' AS int64), '2024-02-29'::date FROM users WHERE id = 1")[0] ==
        rec([Text("30"), Int(42), from_text(Date, "2024-02-29").unwrap()]), "casts")
    assert(s.rows("SELECT CASE city WHEN 'oslo' THEN 1 WHEN 'rome' THEN 2 END FROM users ORDER BY id") == items_of([rec([Int(1)]), rec([Int(2)]), rec([Value.Null])]), "simple case")
    assert(s.rows("SELECT 1.5 + 2.25, 2.5e0 * 2.0e0")[0] == rec([Int(375), Float(5.0)]), "decimal and float")
    assert(s.rows("SELECT 2.5e0 * 2")[0] == rec([Float(5.0)]), "an integer beside a float widens")
    assert(s.rows("SELECT age * 1.5 FROM users WHERE id = 1")[0] == rec([Int(450)]), "a constant beside a column")
    assert_eq(s.code("SELECT 1 / 0"), "R0002")
    assert_eq(s.code("SELECT 2147483647 + 1"), "R0001")

@test
insert_update_delete_with_returning()
    var s = sq_db()
    assert(s.rows("INSERT INTO users (id, name) VALUES (5, 'eve') RETURNING id, name, age") == items_of([rec([Int(5), Text("eve"), Value.Null])]), "insert returning")
    assert_eq(s.count("INSERT INTO users (id, name, age) SELECT id + 100, title, 1 FROM posts"), 4)
    assert_eq(s.count("UPDATE users SET age = age + 1 WHERE id > 100"), 4)
    assert(sq_ints(s.rows("UPDATE users SET city = 'x' WHERE id = 3 RETURNING age")) == sq_is([25]), "update returning")
    assert(sq_strs(s.rows("SELECT city FROM users WHERE id = 3")) == sql_names(["x"]), "updated")
    assert_eq(s.count("DELETE FROM users WHERE id > 100"), 4)
    assert(sq_ints(s.rows("DELETE FROM posts WHERE score IS NULL RETURNING id")) == sq_is([13]), "delete returning")
    assert_eq(s.count("UPDATE posts p SET score = p.score + 1 FROM users u WHERE p.author = u.id AND u.name = 'ann'"), 2)
    assert(sq_ints(s.rows("SELECT score FROM posts WHERE author = 1 ORDER BY id")) == sq_is([6, 8]), "update from")
    assert_eq(s.count("DELETE FROM posts p USING users u WHERE p.author = u.id AND u.name = 'bob'"), 1)
    s.ok("INSERT INTO posts (id, author, title) VALUES (20, 1, 'defaulted')")
    assert(sq_ints(s.rows("SELECT score FROM posts WHERE id = 20")) == sq_is([0]), "a default")

@test
upserts_and_constraints()
    var s = sq_db()
    s.ok("INSERT INTO users (id, name) VALUES (1, 'x') ON CONFLICT DO NOTHING")
    assert(sq_strs(s.rows("SELECT name FROM users WHERE id = 1")) == sql_names(["ann"]), "do nothing")
    s.ok("INSERT INTO users (id, name, age) VALUES (1, 'ann2', 5), (9, 'new', 5) ON CONFLICT (id) DO UPDATE SET name = excluded.name, age = users.age + excluded.age")
    assert(s.rows("SELECT name, age FROM users WHERE id IN (1, 9) ORDER BY id") == items_of([rec([Text("ann2"), Int(35)]), rec([Text("new"), Int(5)])]), "do update")
    assert_eq(s.code("INSERT INTO users (id, name) VALUES (2, 'dup')"), "T3001")
    assert_eq(s.code("INSERT INTO users (id, name) VALUES (7, NULL)"), "Q3005")
    assert_eq(s.code("INSERT INTO users (id) VALUES (7)"), "Q3005")
    assert_eq(s.code("INSERT INTO posts (id, author, title) VALUES (99, 42, 'orphan')"), "T3003")
    s.ok("CREATE TABLE acct (id int64 PRIMARY KEY, bal int64 NOT NULL CHECK (bal >= 0), code text UNIQUE)")
    assert_eq(s.code("INSERT INTO acct VALUES (1, -1, 'a')"), "T3002")
    s.ok("INSERT INTO acct VALUES (1, 1, 'a')")
    assert_eq(s.code("INSERT INTO acct VALUES (2, 1, 'a')"), "T3001")
    assert_eq(s.code("UPDATE acct SET bal = bal - 5"), "T3002")
    assert_eq(s.code("DELETE FROM users WHERE id = 3"), "T3003")

@test
ddl_creates_alters_and_drops()
    var s = sq_db()
    s.ok("ALTER TABLE users ADD COLUMN email text DEFAULT 'none', RENAME COLUMN city TO town")
    assert(s.rows("SELECT email, town FROM users WHERE id = 1")[0] == rec([Text("none"), Text("oslo")]), "added and renamed")
    s.ok("ALTER TABLE users DROP COLUMN email")
    assert_eq(s.code("SELECT email FROM users"), "Q2003")
    s.ok("CREATE INDEX users_by_name ON users (name); CREATE UNIQUE INDEX users_town ON users (town)")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE name = 'bob'")) == sq_is([2]), "an indexed read")
    s.ok("DROP INDEX users_town")
    s.ok("UPDATE users SET town = 'oslo' WHERE id = 2")
    s.ok("CREATE VIEW busy AS SELECT author, count(*) AS n FROM posts GROUP BY author")
    assert(s.rows("SELECT n FROM busy WHERE author = 1") == items_of([rec([Int(2)])]), "a view")
    s.ok("DROP VIEW busy")
    s.ok("CREATE TABLE tmp (a int PRIMARY KEY, b text); DROP TABLE tmp; DROP TABLE IF EXISTS tmp")
    assert_eq(s.code("SELECT * FROM tmp"), "Q2001")
    s.ok("ALTER TABLE users ALTER COLUMN age TYPE int64")
    assert(sq_ints(s.rows("SELECT age FROM users WHERE id = 1")) == sq_is([30]), "retyped")
    s.ok("CREATE TABLE seq (id serial PRIMARY KEY, v text); INSERT INTO seq (v) VALUES ('a'), ('b')")
    assert(sq_ints(s.rows("SELECT id FROM seq ORDER BY id")) == sq_is([1, 2]), "serial")

@test
a_unique_index_enforces()
    var s = sq_db()
    s.ok("CREATE UNIQUE INDEX users_city ON users (city)")
    assert_eq(s.code("UPDATE users SET city = 'oslo' WHERE id = 2"), "T3001")

@test
a_partial_unique_index_enforces_among_the_rows_it_covers()
    var s = sq_db()
    s.ok("CREATE UNIQUE INDEX users_town ON users (city) WHERE city IS NOT NULL")
    assert_eq(s.code("UPDATE users SET city = 'oslo' WHERE id = 2"), "T3001")
    s.ok("UPDATE users SET city = NULL WHERE id = 1")
    s.ok("UPDATE users SET city = 'oslo' WHERE id = 2")

@test
transactions_commit_roll_back_and_keep_savepoints()
    var s = sq_db()
    s.ok("BEGIN; INSERT INTO users (id, name) VALUES (50, 'tx'); ROLLBACK")
    assert_eq(s.rows("SELECT id FROM users WHERE id = 50").len(), 0)
    s.ok("BEGIN ISOLATION LEVEL SNAPSHOT; INSERT INTO users (id, name) VALUES (51, 'tx'); COMMIT")
    assert_eq(s.rows("SELECT id FROM users WHERE id = 51").len(), 1)
    s.ok("START TRANSACTION; INSERT INTO users (id, name) VALUES (52, 'a'); SAVEPOINT sp; INSERT INTO users (id, name) VALUES (53, 'b'); ROLLBACK TO SAVEPOINT sp; RELEASE sp; COMMIT")
    assert(sq_ints(s.rows("SELECT id FROM users WHERE id >= 52 ORDER BY id")) == sq_is([52]), "rolled back to the savepoint")
    // An error aborts the transaction; later statements fail until it is rolled back.
    assert_eq(s.code("BEGIN; INSERT INTO users (id, name) VALUES (1, 'dup')"), "T3001")
    assert_eq(s.code("SELECT 1"), "W2003")
    s.ok("ROLLBACK")
    // A savepoint before the error rescues the transaction.
    s.ok("BEGIN; INSERT INTO users (id, name) VALUES (60, 'kept'); SAVEPOINT sp")
    assert_eq(s.code("INSERT INTO users (id, name) VALUES (1, 'dup')"), "T3001")
    s.ok("ROLLBACK TO sp; COMMIT")
    assert_eq(s.rows("SELECT id FROM users WHERE id = 60").len(), 1)
    // A read-only transaction refuses writes.
    assert_eq(s.code("BEGIN READ ONLY; INSERT INTO users (id, name) VALUES (70, 'ro')"), "T4001")
    s.ok("ROLLBACK")
    // DDL is transactional.
    s.ok("BEGIN; CREATE TABLE gone (a int PRIMARY KEY); INSERT INTO gone VALUES (1); ROLLBACK")
    assert_eq(s.code("SELECT * FROM gone"), "Q2001")

@test
parameters_are_bound_by_the_client()
    var s = sq_db()
    assert(sq_strs(s.rows("SELECT name FROM users WHERE id = $1", [Int(2)])) == sql_names(["bob"]), "a parameter")
    assert(sq_strs(s.rows("SELECT name FROM users WHERE id = $1::int64 OR name = $2", [Int(3), Text("ann")])) == sql_names(["ann", "cy"]) ||
        sq_strs(s.rows("SELECT name FROM users WHERE id = $1::int64 OR name = $2", [Int(3), Text("ann")])) == sql_names(["cy", "ann"]), "two parameters")
    s.run("INSERT INTO users (id, name, age) VALUES ($1, $2, $3)", [Int(80), Text("p"), Value.Null])
    assert(s.rows("SELECT name, age FROM users WHERE id = 80") == items_of([rec([Text("p"), Value.Null])]), "inserted by parameters")

// -- the PostgreSQL-like readings: `sql.md` §5.8 rule 7, §3.2 rule 4, §5.9 rule 3, §4.1 -------------------

/** `sq_db` and a table `m` of integer, float and decimal columns, `f` declared with bare `double`. */
private sq_mixed() -> SqSession
    var s = sq_db()
    s.ok("""
        CREATE TABLE m (id int64 PRIMARY KEY, i int32 NOT NULL, b int64 NOT NULL, f double NOT NULL, r real NOT NULL, n int32, d decimal(5, 2) NOT NULL);
        INSERT INTO m VALUES (1, 2, 3, 0.5, 0.25, NULL, 1.5), (2, 4, 9007199254740993, 1.5, 2, 7, 2.25);
        """)
    s

/** The first column of each row, a float; -999 for null. */
private sq_floats(rows: Buf[Value]) -> Buf[real]
    val out = buf[real]()
    for r in rows
        r match
            Record(fs) -> out.push(fs[0] match
                Value.Float(x) -> x
                Value.Null -> -999.0
                _ -> -998.0)
            _ -> out.push(-997.0)
    out

private sq_fs(xs: []const real) -> Buf[real]
    val b = buf[real]()
    b.extend(xs)
    b

@test
an_integer_beside_a_float_widens_in_arithmetic()
    var s = sq_mixed()
    assert(sq_floats(s.rows("SELECT i * f FROM m ORDER BY id")) == sq_fs([1.0, 6.0]), "int * double")
    assert(sq_floats(s.rows("SELECT f * i FROM m ORDER BY id")) == sq_fs([1.0, 6.0]), "double * int")
    assert(s.rows("SELECT i + f, i - f, f - i, i / f FROM m WHERE id = 1")[0] == rec([Float(2.5), Float(1.5), Float(-1.5), Float(4.0)]), "each operator")
    assert(s.rows("SELECT 2.5e0 * 2, 2 * 2.5e0, 2147483647 * 2e0")[0] == rec([Float(5.0), Float(5.0), Float(4294967294.0)]), "constants")
    assert(sq_floats(s.rows("SELECT -i * f FROM m ORDER BY id")) == sq_fs([-1.0, -6.0]), "a negated integer")
    assert(sq_floats(s.rows("SELECT i + i * f FROM m ORDER BY id")) == sq_fs([3.0, 10.0]), "a widened product beside an integer")
    assert(sq_floats(s.rows("SELECT r * i FROM m ORDER BY id")) == sq_fs([0.5, 8.0]), "real beside an integer")

@test
an_integer_beside_a_float_widens_in_comparisons()
    var s = sq_mixed()
    assert(sq_ints(s.rows("SELECT id FROM m WHERE f < i ORDER BY id")) == sq_is([1, 2]), "double < int")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE f * 4 > i ORDER BY id")) == sq_is([2]), "double > int")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i < f * 4 ORDER BY id")) == sq_is([2]), "int < double")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i = 2e0")) == sq_is([1]), "int = float constant")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE 4e0 = i")) == sq_is([2]), "float constant = int")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i <> 2e0")) == sq_is([2]), "<>")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE 2e0 >= i")) == sq_is([1]), ">=")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE f BETWEEN 1 AND i")) == sq_is([2]), "between")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i NOT BETWEEN 0.5e0 AND 3e0")) == sq_is([2]), "not between")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i IN (2e0, 5e0)")) == sq_is([1]), "in")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE i NOT IN (2e0)")) == sq_is([2]), "not in")
    assert(sq_strs(s.rows("SELECT CASE i WHEN 4e0 THEN 'four' ELSE 'other' END FROM m ORDER BY id")) == sql_names(["other", "four"]), "simple case")

@test
int32_and_int64_both_widen_and_a_large_int64_rounds()
    var s = sq_mixed()
    assert(s.rows("SELECT i * 1e0, b * 1e0 FROM m WHERE id = 1")[0] == rec([Float(2.0), Float(3.0)]), "int32 and int64")
    assert(s.rows("SELECT b * 1e0 FROM m WHERE id = 2")[0] == rec([Float(9007199254740992.0)]), "an int64 past 2^53 rounds, as in PostgreSQL")
    assert(s.rows("SELECT b = 9007199254740992e0 FROM m WHERE id = 2")[0] == rec([Value.Bool(true)]), "and compares as its rounded value")
    assert(s.rows("SELECT 9007199254740993 * 1e0")[0] == rec([Float(9007199254740992.0)]), "an int64 constant")
    assert(s.rows("SELECT CAST(3 AS int16) * 0.5e0, CAST(3 AS uint8) * 0.5e0, CAST(1 AS int64) * 0.5e0")[0] == rec([Float(1.5), Float(1.5), Float(0.5)]), "int16, uint8, int64")

@test
integer_arithmetic_overflows_before_it_widens()
    var s = sq_mixed()
    assert_eq(s.code("SELECT (2147483647 + 1) * 2.5e0"), "R0001")
    assert_eq(s.code("SELECT (i + 2147483647) * 1e0 FROM m"), "R0001")
    assert(s.rows("SELECT 2147483647 + 1 * 2.5e0")[0] == rec([Float(2147483649.5)]), "the product widens first, so the sum does not overflow")

@test
a_null_operand_of_a_widened_operator_is_null()
    var s = sq_mixed()
    assert(sq_floats(s.rows("SELECT n * f FROM m ORDER BY id")) == sq_fs([-999.0, 10.5]), "a nullable integer column")
    assert(sq_floats(s.rows("SELECT f * NULL FROM m ORDER BY id")) == sq_fs([-999.0, -999.0]), "a null beside a float")
    assert(s.rows("SELECT CAST(NULL AS int32) * 2e0")[0] == rec([Value.Null]), "a typed null")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE n > 6.5e0")) == sq_is([2]), "the null row is not kept")
    assert(sq_ints(s.rows("SELECT id FROM m WHERE n * 1e0 IS NULL")) == sq_is([1]), "is null")

@test
aggregates_over_mixed_types_widen()
    var s = sq_mixed()
    assert(s.rows("SELECT sum(i) * 1.5e0 FROM m")[0] == rec([Float(9.0)]), "sum of int32")
    assert(s.rows("SELECT sum(f) + sum(i) FROM m")[0] == rec([Float(8.0)]), "sum of double and sum of int32")
    assert(s.rows("SELECT sum(i * f) FROM m")[0] == rec([Float(7.0)]), "sum of a widened product")
    assert(s.rows("SELECT avg(f) * count(*) FROM m")[0] == rec([Float(2.0)]), "avg of double and count")
    assert(s.rows("SELECT max(i) > max(f), min(i) < min(f) FROM m")[0] == rec([Value.Bool(true), Value.Bool(false)]), "min and max")
    assert(sq_ints(s.rows("SELECT id FROM m GROUP BY id HAVING sum(i) > 3.5e0")) == sq_is([2]), "having")
    assert(sq_floats(s.rows("SELECT i * 2e0 FROM m GROUP BY i ORDER BY 1")) == sq_fs([4.0, 8.0]), "a group key")
    assert(sq_ints(s.rows("SELECT count(*) FROM m WHERE i > 1.5e0")) == sq_is([2]), "count")

@test
widening_leaves_other_mixes_refused()
    var s = sq_mixed()
    assert_eq(s.code("SELECT d * f FROM m"), "Q3002")
    assert_eq(s.code("SELECT f + d FROM m"), "Q3002")
    assert_eq(s.code("SELECT 1.5 * 2e0"), "Q3002")
    assert_eq(s.code("SELECT avg(i) * 2e0 FROM m"), "Q3002")
    assert_eq(s.code("SELECT 'a' * 2e0"), "Q3002")

@test
a_widened_value_is_nullable_so_a_not_null_target_needs_assert_not_null()
    var s = sq_mixed()
    s.ok("CREATE TABLE g (id int64 PRIMARY KEY, v double NOT NULL)")
    assert_eq(s.code("INSERT INTO g SELECT id, i * f FROM m"), "Q3005")
    assert_eq(s.count("INSERT INTO g SELECT id, assert_not_null(i * f) FROM m"), 2)
    assert_eq(s.count("INSERT INTO g SELECT 3, 2.5e0 * 2"), 1)
    assert(sq_floats(s.rows("SELECT v FROM g ORDER BY id")) == sq_fs([1.0, 6.0, 5.0]), "inserted")

@test
an_insert_select_constant_takes_its_target_column_s_type()
    var s = sq_db()
    s.ok("CREATE TABLE every (id int64 PRIMARY KEY, s int16 NOT NULL, t text, dt date, d decimal(5, 2), f double, r real, u uint8, ts timestamp, iv interval, bo bool, n int16)")
    assert_eq(s.count("INSERT INTO every (id, s, t, dt, d, f, r, u, ts, iv, bo, n) SELECT 1, 7, 'x', '2024-02-29', 1.5, 2, 0.5, 255, '2024-01-01T00:00:00Z', 'P1D', 'true', NULL"), 1)
    assert(s.rows("SELECT s, t, dt, d, f, r, u, bo, n FROM every WHERE id = 1")[0] ==
        rec([Int(7), Text("x"), from_text(Date, "2024-02-29").unwrap(), Int(150), Float(2.0), Float(0.5), from_text(UInt8, "255").unwrap(), Value.Bool(true), Value.Null]), "each type")
    assert(s.rows("SELECT ts, iv FROM every WHERE id = 1")[0] == rec([from_text(Timestamp, "2024-01-01T00:00:00Z").unwrap(), from_text(Interval, "P1D").unwrap()]), "timestamp and interval")

@test
an_insert_select_assigns_to_a_nullable_target_and_refuses_null_into_a_not_null_one()
    var s = sq_db()
    s.ok("CREATE TABLE every (id int64 PRIMARY KEY, s int16 NOT NULL, n int16)")
    assert_eq(s.count("INSERT INTO every (id, s, n) SELECT 2, 1, NULL"), 1)
    assert(s.rows("SELECT n FROM every WHERE id = 2")[0] == rec([Value.Null]), "null kept")
    assert_eq(s.code("INSERT INTO every (id, s) SELECT 3, NULL"), "Q3005")
    assert_eq(s.code("INSERT INTO users (id, name) SELECT 9, NULL"), "Q3005")

@test
an_insert_select_constant_that_does_not_fit_is_refused()
    var s = sq_db()
    s.ok("CREATE TABLE every (id int64 PRIMARY KEY, s int16 NOT NULL, t text, dt date, d decimal(5, 2), u uint8)")
    assert_eq(s.code("INSERT INTO every (id, s) SELECT 4, 70000"), "Q8004")
    assert_eq(s.code("INSERT INTO every (id, s) SELECT 4, 1.5"), "Q8004")
    assert_eq(s.code("INSERT INTO every (id, s, u) SELECT 4, 1, -1"), "Q8004")
    assert_eq(s.code("INSERT INTO every (id, s, dt) SELECT 4, 1, 'nope'"), "Q8004")
    assert_eq(s.code("INSERT INTO every (id, s, d) SELECT 4, 1, 12345.6"), "Q8004")
    assert_eq(s.code("INSERT INTO every (id, s, t) SELECT 4, 1, 5"), "Q3001")
    assert_eq(s.code("INSERT INTO every (id, s) SELECT 41, v FROM (SELECT 1 AS v) x"), "Q3001")
    assert_eq(s.rows("SELECT id FROM every").len(), 0)

@test
an_insert_select_mixes_columns_constants_set_operations_values_and_with()
    var s = sq_db()
    s.ok("CREATE TABLE every (id int64 PRIMARY KEY, s int16 NOT NULL)")
    assert_eq(s.count("INSERT INTO users (id, name, age) SELECT id + 200, 'p', 4 FROM posts"), 4)
    assert(sq_ints(s.rows("SELECT age FROM users WHERE id > 200")) == sq_is([4, 4, 4, 4]), "a constant beside columns")
    assert_eq(s.count("INSERT INTO every (id, s) SELECT 10, 1 UNION ALL SELECT 11, 2"), 2)
    assert_eq(s.count("INSERT INTO every (id, s) SELECT 12, 1 EXCEPT SELECT 13, 1"), 1)
    assert_eq(s.count("INSERT INTO every (id, s) VALUES (14, 1), (15, 2) ORDER BY 1 LIMIT 1"), 1)
    assert_eq(s.count("INSERT INTO every (id, s) WITH k AS (SELECT 1 AS v) SELECT 16, 3 FROM k"), 1)
    s.run("INSERT INTO every (id, s) SELECT $1, $2", [Int(17), Int(5)])
    assert(sq_ints(s.rows("SELECT s FROM every ORDER BY id")) == sq_is([1, 2, 1, 1, 3, 5]), "every row")

@test
null_in_a_boolean_context_keeps_no_row()
    var s = sq_db()
    assert_eq(s.rows("SELECT id FROM users WHERE NULL").len(), 0)
    assert_eq(s.rows("SELECT id FROM users WHERE NOT NULL").len(), 0)
    assert(sq_ints(s.rows("SELECT id FROM users WHERE id > 1 OR NULL ORDER BY id")) == sq_is([2, 3]), "or")
    assert_eq(s.rows("SELECT id FROM users WHERE id > 1 AND NULL").len(), 0)
    assert(sq_ints(s.rows("SELECT id FROM users WHERE NOT (id > 1 AND NULL) ORDER BY id")) == sq_is([1]), "not of and")
    assert_eq(s.rows("SELECT count(*) FROM users HAVING NULL").len(), 0)
    assert_eq(s.rows("SELECT city, count(*) FROM users GROUP BY city HAVING NULL").len(), 0)
    assert_eq(s.rows("SELECT u.id FROM users u JOIN posts p ON NULL").len(), 0)
    assert(s.rows("SELECT u.id, p.id FROM users u LEFT JOIN posts p ON NULL ORDER BY u.id") ==
        items_of([rec([Int(1), Value.Null]), rec([Int(2), Value.Null]), rec([Int(3), Value.Null])]), "left join")
    assert(s.rows("SELECT CASE WHEN NULL THEN 1 ELSE 2 END")[0] == rec([Int(2)]), "case")
    assert(s.rows("SELECT CASE WHEN NULL THEN 1 END")[0] == rec([Value.Null]), "case without else")
    assert(s.rows("SELECT NOT NULL, NULL AND false, NULL OR true, NULL AND true")[0] == rec([Value.Null, Value.Bool(false), Value.Bool(true), Value.Null]), "three-valued")
    assert(s.rows("SELECT count(*) FILTER (WHERE NULL) FROM users")[0] == rec([Int(0)]), "filter")
    assert_eq(s.count("UPDATE users SET city = 'z' WHERE NULL"), 0)
    assert_eq(s.count("DELETE FROM users WHERE NULL"), 0)
    s.ok("INSERT INTO users (id, name) VALUES (1, 'q') ON CONFLICT (id) DO UPDATE SET name = 'q' WHERE NULL")
    assert(sq_strs(s.rows("SELECT name FROM users WHERE id = 1")) == sql_names(["ann"]), "the conflict's update is skipped")

@test
double_names_float64_end_to_end()
    var s = sq_db()
    s.ok("CREATE TABLE dd (id int64 PRIMARY KEY, a double, b double precision, c double NOT NULL DEFAULT 1.5)")
    s.ok("INSERT INTO dd (id, a, b) VALUES (1, 0.5, 2)")
    assert(s.rows("SELECT a, b, c, CAST(id AS double), id::double, double '2.5' FROM dd")[0] ==
        rec([Float(0.5), Float(2.0), Float(1.5), Float(1.0), Float(1.0), Float(2.5)]), "every spelling")
    s.ok("ALTER TABLE dd ADD COLUMN e double")
    s.ok("INSERT INTO dd (id, e) VALUES (2, 0.25)")
    assert(sq_floats(s.rows("SELECT e FROM dd WHERE id = 2")) == sq_fs([0.25]), "an added double column")
