module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.slices.{contains, sort_by}

// Statements run in a transaction of the in-memory store (`query-tree.md` §5, §9,
// `docs/design/executor.md` §4.5): a query reads the store at the transaction's snapshot, and a DML
// statement reads every row it needs first — its source, its targets, its conflicts and its
// `returning` values — and then hands the store all of its writes at once, so that a statement that
// must wait for a row lock writes nothing (`isolation.md` §4.2 rule 1). Any error aborts the
// transaction with its code (§5.1).

/** What a statement did: `Ran`, with its row count (§5 rule 2) and, for a query or a DML statement
 * with `returning`, its result type and the result format's batches; or `Blocked`, having written
 * nothing because a row it must write is locked by transaction `holder`. A blocked statement is run
 * again once `holder` has committed or aborted.
 */
enum Executed
    Ran(count: u64, result: Option[Type], batches: Buf[Buf[u8]])
    Blocked(holder: u64)

/** `env` validated against the store's catalog and run in `t` with `ctx`. At read committed the
 * statement takes a new snapshot first (`isolation.md` §3.3).
 */
run_statement(env: Envelope, s: &Store, t: &Txn, ctx: Ctx) -> Result[Executed, CodecError]
    s.statement(t)
    val c = if ctx.draws.is_some() then ctx else Ctx(ctx.params, ctx.now, Some(Draws(s, None)), ctx.work)

    run_in(env, s, t, c) match
        Ok(o) -> Ok(o)
        Err(e) -> Err(s.abort_with(t, e))

private run_in(env: Envelope, s: &Store, t: &Txn, ctx: Ctx) -> Result[Executed, CodecError]
    s.usable(t)?
    val typing = type_envelope(env, s.catalog)?

    env.statement match
        // Correlation is unnested before planning (`query-tree.md` §6.6 rule 2), as `run_query` does.
        Query(_) -> run_unnested(env, unnest_plan(env, typing, s.catalog, ctx.params), s, t, ctx)
        Insert(table, binder, old, columns, source, on_conflict, returning) ->
            run_insert(s, t, ctx, typing, table, binder, old, columns, source, on_conflict, returning)
        Update(table, binder, old, from, filter, set, returning) ->
            run_update(s, t, ctx, typing, table, binder, old, from, filter, set, returning)
        Delete(table, binder, old, using, filter, returning) ->
            run_update(s, t, ctx, typing, table, binder, old, using, filter, buf[Item](), returning, true)
        _ -> panic("the executor runs no DDL statement")
end run_in

/** The query of `plan`, made of `env`'s, run over the store, its scans logging what they read. */
private run_unnested(env: Envelope, plan: UnnestPlan, s: &Store, t: &Txn, ctx: Ctx) -> Result[Executed, CodecError]
    val r = plan.env.statement match
        Query(q) -> q
        _ -> panic("unnesting keeps a query a query")

    var u = no_uses()
    u.add_rel(r, true)
    var p = Planner(plan.typing.nodes, 0, ctx, buf[MemTable](), buf[Binder](), buf[CteFrame](), Some(u.db(s, t)), None)

    // A rewritten tree's nodes are not the ones the client sent, so its runtime errors name none.
    val rows = drain(flat_input(p.rel(r))) match
        Ok(rows) -> rows
        Err(e) -> return Err(if plan.env.statement != env.statement then e.nodeless() else e)

    ran(plan.typing.result, rows)

/** A statement that ran and returned `rows` as its result of type `result`, or nothing. */
private ran(result: Option[Type], rows: Buf[ColumnVector]) -> Result[Executed, CodecError]
    var n: u64 = 0

    for b in rows
        n += u64(b.len)

    result match
        Some(ty) -> Ok(Ran(n, Some(ty), result_batches(ty, mem_source(rows), 0)?))
        None -> Ok(Ran(n, None, buf[Buf[u8]]()))

// -- the target table ---------------------------------------------------------------------------

/** The table a DML statement writes: its catalog entry, its row type, the positions of its primary
 * key's columns and the schema version its rows are written in (`ddl.md` §5.4 rule 1).
 */
private struct Target
    oid: u64
    table: CatTable
    row: Type
    key: Buf[usize]
    version: u64

    /** The key of row `i` of `rows`: its primary-key columns, as the store keys it. */
    key_at(self, rows: ColumnVector, i: usize) -> Value
        val parts = buf[Value]()

        for j in self.key
            parts.push(value_at(rows.member(j), i))

        rec(parts.view())

    key_type(self) -> Type
        val fs = fields_of_type(self.row)
        val out = buf[Field]()

        for j in self.key
            out.push(fs[j])

        record(out.view())

    stored(self, rows: ColumnVector, i: usize) -> StoredRow = StoredRow(self.version, value_at(rows, i))

    column(self, name: string) -> usize
        for j in 0..<self.table.columns.len()
            if self.table.columns[j].name == name then return j

        panic(s"the table has no column '$name'")

    /** The positions of columns `ids` in the row. */
    positions(self, ids: Buf[u32]) -> Buf[usize]
        val out = buf[usize]()

        for id in ids
            for j in 0..<self.table.columns.len()
                if self.table.columns[j].id == id then out.push(j)

        out

    /** The record type of columns `ids`. */
    type_of(self, ids: Buf[u32]) -> Type
        val fs = fields_of_type(self.row)
        val out = buf[Field]()

        for j in self.positions(ids)
            out.push(fs[j])

        record(out.view())

    /** Columns `ids` of the row `v` as a record, or none when one of them is null: a key that cannot
     * conflict (`ddl.md` §2.5 rule 2), a referencing value that is not checked (§2.6 rule 2).
     */
    values_of(self, ids: Buf[u32], v: Value) -> Option[Value]
        val fs = v match
            Record(fs) -> fs
            _ -> return None

        val parts = buf[Value]()

        for j in self.positions(ids)
            if fs[j].is_null() then return None
            parts.push(fs[j])

        Some(rec(parts.view()))

    /** The primary key of the row `v`, as the store keys it. */
    pk_of(self, v: Value) -> Value
        val parts = buf[Value]()

        v match
            Record(fs) ->
                for j in self.key
                    parts.push(fs[j])
            _ -> ()

        rec(parts.view())
end Target

private target_of(s: &Store, q: QualName) -> Result[Target, CodecError] = target_by_oid(s, s.catalog.tables[s.catalog.table_at(q).unwrap()].oid)

private target_by_oid(s: &Store, oid: u64) -> Result[Target, CodecError]
    val ct = s.catalog.tables[s.catalog.table_by_oid(oid).unwrap()]
    val fs = buf[Field]()

    for c in ct.columns
        fs.push(Field(c.name, resolve_type(s.catalog, c.ty)?))

    val key = buf[usize]()

    for id in ct.primary_key
        for j in 0..<ct.columns.len()
            if ct.columns[j].id == id then key.push(j)

    Ok(Target(ct.oid, ct, record(fs.view()), key, ct.schema_version()))

/** Row vector `rows` with member `j` replaced by `v`. */
private with_column(rows: ColumnVector, j: usize, v: ColumnVector) -> ColumnVector
    val cs = buf[ColumnVector]()

    for k in 0..<fields_of_type(rows.ty).len()
        cs.push(if k == j then v else rows.member(k))

    ColumnVector(rows.ty, rows.len, rows.validity, Members(cs))

// -- definition expressions: defaults, generated columns, checks (`ddl.md` §2.6, §2.7) -----------

/** Each of `exprs`, a definition expression over the row binder `row` (`ddl.md` §2.12), evaluated
 * over every row of `rows`: a `Project` over the rows as a relation-valued parameter, type-checked
 * against the catalog.
 */
private eval_defs(s: &Store, ctx: Ctx, rows: ColumnVector, exprs: Buf[Expr]) -> Result[Buf[ColumnVector], CodecError]
    val out = buf[ColumnVector]()
    if exprs.len() == 0 || rows.len == 0 then return Ok(out)

    val items = buf[Item]()

    for i in 0..<exprs.len()
        items.push(Item(s"d$i", exprs[i]))

    val env = envelope([ParamDecl(None, bag(rows.ty))], Query(Project(ParamScan("row", 0), "d", items)))
    val typing = type_envelope(env, s.catalog)?
    val plan = plan_query(env, typing, Ctx(items_of([rel(values_of(rows).view())]), ctx.now, as_definer(ctx.draws), ctx.work), buf[MemTable]())
    val r = drain_rows(plan.op, plan.elem)?

    for j in 0..<exprs.len()
        out.push(r.member(j))

    Ok(out)

private reads_any(e: Expr, names: Buf[string]) -> bool
    val refs = expr_refs(e)
    val row = items_of(["row"])

    for n in names
        if refs.reads_column(row, n) then return true

    false

/** `rows` with their generated columns computed (`ddl.md` §2.7 rule 2): every one for inserted rows
 * (`changed` absent), else those reading a column of `changed`; and the names of those computed.
 */
private with_generated(s: &Store, ctx: Ctx, tg: Target, rows: ColumnVector, changed: Option[Buf[string]]) -> Result[(ColumnVector, Buf[string]), CodecError]
    val fs = fields_of_type(tg.row)
    val gens = buf[Expr]()
    val at = buf[usize]()
    val names = buf[string]()

    for j in 0..<tg.table.columns.len()
        tg.table.columns[j].generated match
            Some(g) ->
                val due = changed match
                    Some(cs) -> reads_any(g, cs)
                    None -> true

                if due
                    gens.push(g)
                    at.push(j)
                    names.push(fs[j].name)
            None -> ()

    val vs = eval_defs(s, ctx, rows, gens)?
    var out = rows

    for k in 0..<vs.len()
        out = with_column(out, at[k], coerce_vector(vs[k], fs[at[k]].ty)?)

    Ok((out, names))
end with_generated

/** The constraints `rows`, about to be written, must meet (`ddl.md` §2.6): every check constraint of
 * the table for inserted rows (`changed` absent), else those reading a column of `changed`, and NOT
 * NULL for every top-level column. Unique keys are the store's (`T3001`), foreign keys `fk_effects`'.
 * The guard of a `converting` column (§8.5 rule 2) is checked the same way: its recorded conversion
 * is evaluated over the rows, and one that fails refuses the write with the conversion's own code.
 */
private check_rows(s: &Store, ctx: Ctx, tg: Target, rows: ColumnVector, changed: Option[Buf[string]]) -> Result[unit, CodecError]
    val guards = buf[Expr]()

    for c in tg.table.columns
        if c.state == ColumnConverting
            c.using match
                Some(u) ->
                    val due = changed match
                        Some(cs) -> reads_any(u, cs)
                        None -> true

                    if due then guards.push(u)
                None -> ()

    val _ = eval_defs(s, ctx, rows, guards)?
    val checks = buf[Expr]()
    val names = buf[string]()

    for c in s.catalog.constraints
        if c.table == tg.oid
            c.kind match
                ConCheck(e) ->
                    val due = changed match
                        Some(cs) -> reads_any(e, cs)
                        None -> true

                    if due
                        checks.push(e)
                        names.push(c.name)
                _ -> ()

    val vs = eval_defs(s, ctx, rows, checks)?

    for k in 0..<vs.len()
        val v = vs[k]

        v.lanes match
            Bools(x) ->
                for i in 0..<v.len
                    if v.is_valid(i) && !x[i] then return fail("T3002", s"a row fails check constraint '${names[k]}'")
            _ -> ()

    val fs = fields_of_type(tg.row)

    for j in 0..<fs.len()
        if !fs[j].ty.is_nullable() && rows.member(j).has_nulls()
            return fail("T3004", s"a null is written to the NOT NULL column '${fs[j].name}'")

    Ok(())
end check_rows

// -- evaluation helpers -------------------------------------------------------------------------

/** Whether `cond` is true over the one row of `env`; an absent condition is. */
private passes(cond: Option[TExpr], env: Env) -> Result[bool, CodecError]
    val x = cond match
        Some(c) -> c
        None -> return Ok(true)

    val v = eval(x, env)?

    v.lanes match
        Bools(b) -> Ok(b[0] && v.is_valid(0))
        _ -> panic("a condition is not bool")

/** `rows` with each `set` item's value, evaluated over `env`, coerced into its column. */
private apply_set(tg: Target, rows: ColumnVector, set: Buf[Item], values: Buf[TExpr], env: Env) -> Result[ColumnVector, CodecError]
    val fs = fields_of_type(tg.row)
    var out = rows

    for i in 0..<set.len()
        val j = tg.column(set[i].name)
        out = with_column(out, j, coerce_vector(eval(values[i], env)?, fs[j].ty)?)

    Ok(out)

/** The `returning` records of the rows of `env`, row `i`'s `Action()` (§9.5) being variant `acts[i]`:
 * 0 inserted, 1 updated, 2 deleted. The rows of each action are evaluated together, with the
 * action's value in the parameter `action` the planner gave it, and put back in statement order.
 */
private returning_rows(result: Option[Type], items: Buf[TExpr], env: Env, action: Option[u64], acts: Buf[u16]) -> Result[Option[ColumnVector], CodecError]
    val elem = result match
        Some(Bag(e)) -> *e
        _ -> return Ok(None)

    val parts = buf[ColumnVector]()
    val order = buf[usize]()

    for tag in 0..<3
        val idx = buf[usize]()

        for i in 0..<acts.len()
            if usize(acts[i]) == tag then idx.push(i)

        if idx.len() > 0
            val ps = buf[Value]()
            ps.extend(env.ctx.params.view())

            action match
                Some(a) -> ps[usize(a)] = variant(tag, rec([]))
                None -> ()

            val group = env.take(idx.view())
            val genv = Env(group.n, group.binders, env.ctx.with_params(ps))
            val cs = buf[ColumnVector]()

            for x in items
                cs.push(eval(x, genv)?)

            parts.push(ColumnVector(elem, idx.len(), buf[u8](), Members(cs)))
            order.extend(idx.view())

    val back = buf[usize]()

    for _ in 0..<order.len()
        back.push(0)

    for k in 0..<order.len()
        back[order[k]] = k

    Ok(Some(take(concat(elem, parts.view()), back.view())))
end returning_rows

/** The store's answer to a statement's writes, `deltas` being the rows they change, and its outcome:
 * `rows` rows written, and its `returning` rows `ret` as its result. The foreign keys the writes
 * touch act and are checked at the end of the statement (`fk_effects`); a statement that must wait
 * for a row lock part-way is undone and answers `Blocked`.
 */
private written(s: &Store, t: &Txn, c: Ctx, tg: Target, changes: Buf[RowChange], deltas: Buf[Delta], rows: usize, result: Option[Type], ret: Option[ColumnVector]) -> Result[Executed, CodecError]
    s.write_rows(t, tg.oid, changes)? match
        Wait(h) -> return Ok(Blocked(h))
        Done(_) -> ()

    fk_effects(s, t, c, tg, deltas)? match
        Some(h) ->
            s.undo_statement(t)
            return Ok(Blocked(h))
        None -> ()

    ret match
        Some(r) -> ran(result, batches_of(r))
        None -> Ok(Ran(u64(rows), None, buf[Buf[u8]]()))

// -- foreign keys, `ddl.md` §2.6 -----------------------------------------------------------------------

/** One row a statement changed, in its table's row type: the row before (none for an insert) and
 * after (none for a delete).
 */
private struct Delta
    before: Option[Value]
    after: Option[Value]

/** Rows of table `tg` a statement or one of its cascades changed, whose foreign keys are yet to act. */
private struct Pending
    tg: Target
    deltas: Buf[Delta]

/** Referencing values whose referenced rows must exist at the end of the statement, or referenced
 * values removed under `no_action` that no row may reference then.
 */
private struct FkValues
    fk: ForeignKey
    values: Buf[Value]

/** The foreign keys a statement's changes `deltas` to `tg` touch (`ddl.md` §2.6 rule 2), acting in
 * turn on every table a cascade reaches: each referenced value removed or changed runs its key's
 * action (`restrict` checked at once; `cascade`, `set_null` and `set_default` changing the
 * referencing rows, whose own foreign keys then act; `no_action` checked at the end), and each
 * referencing value written is checked at the end of the statement, or at commit for a deferred key.
 * The answer is a transaction to wait for, or none.
 */
private fk_effects(s: &Store, t: &Txn, c: Ctx, tg: Target, deltas: Buf[Delta]) -> Result[Option[u64], CodecError]
    val work = buf[Pending]()
    work.push(Pending(tg, deltas))
    val referencing = buf[FkValues]()
    val removed = buf[FkValues]()
    var i: usize = 0

    while i < work.len()
        val p = work[i]
        i += 1

        for fk in foreign_keys(s.catalog, p.tg.oid, false)
            val ty = p.tg.type_of(fk.columns)
            val vs = buf[Value]()

            for dl in p.deltas
                dl.after match
                    Some(a) -> p.tg.values_of(fk.columns, a) match
                        Some(v) ->
                            // A row whose referencing value an update left as it was is not checked.
                            val unchanged = dl.before match
                                Some(b) -> p.tg.values_of(fk.columns, b) match
                                    Some(w) -> same(ty, w, v)
                                    None -> false
                                None -> false

                            if !unchanged
                                if fk.deferred then s.defer_check(t, ChildCheck(fk, p.tg.pk_of(a))) else vs.push(v)
                        None -> ()
                    None -> ()

            if vs.len() > 0 then referencing.push(FkValues(fk, vs))

        for fk in foreign_keys(s.catalog, p.tg.oid, true)
            fk_actions(s, t, c, p.tg, fk, p.deltas, work, removed)? match
                Some(h) -> return Ok(Some(h))
                None -> ()

    for r in referencing
        for v in r.values
            s.check_reference(t, r.fk, v)? match
                Some(h) -> return Ok(Some(h))
                None -> ()

    for r in removed
        val gone = buf[Value]()

        for v in r.values
            if !s.holds_key(t, r.fk.ref_table, r.fk.ref_columns, v)? then gone.push(v)

        if gone.len() > 0 && s.referencing(t, r.fk, gone)?.len() > 0
            return fail("T3003", s"a row still references a removed row through foreign key '${r.fk.name}'")

    Ok(None)
end fk_effects

/** The actions of `fk`, which references `ptg`, for the changes `deltas` to `ptg`: `on_delete` for
 * each referenced value a deleted row held, `on_update` for each an update changed.
 */
private fk_actions(s: &Store, t: &Txn, c: Ctx, ptg: Target, fk: ForeignKey, deltas: Buf[Delta], work: Buf[Pending], removed: Buf[FkValues]) -> Result[Option[u64], CodecError]
    val ty = ptg.type_of(fk.ref_columns)
    val deleted = buf[Value]()
    val olds = buf[Value]()
    val news = buf[Value]()

    for dl in deltas
        dl.before match
            Some(b) -> ptg.values_of(fk.ref_columns, b) match
                Some(ov) -> dl.after match
                    None -> deleted.push(ov)
                    Some(a) -> ptg.values_of(fk.ref_columns, a) match
                        Some(nv) -> if !same(ty, nv, ov)
                            olds.push(ov)
                            news.push(nv)
                        None ->
                            olds.push(ov)
                            news.push(Null)
                None -> ()
            None -> ()

    fk_act(s, t, c, fk, fk.on_delete, deleted, None, work, removed)? match
        Some(h) -> return Ok(Some(h))
        None -> ()

    fk_act(s, t, c, fk, fk.on_update, olds, Some(news), work, removed)
end fk_actions

/** `action` of `fk` for the referenced values `olds`, removed by a delete (`news` absent) or changed
 * to `news` by an update.
 */
private fk_act(s: &Store, t: &Txn, c: Ctx, fk: ForeignKey, action: FkAction, olds: Buf[Value], news: Option[Buf[Value]], work: Buf[Pending], removed: Buf[FkValues]) -> Result[Option[u64], CodecError]
    if olds.len() == 0 then return Ok(None)

    action match
        FkNoAction ->
            if fk.deferred
                for v in olds
                    s.defer_check(t, ParentCheck(fk, v))
            else
                removed.push(FkValues(fk, olds))

            return Ok(None)
        FkRestrict ->
            if s.referencing(t, fk, olds)?.len() > 0
                return fail("T3003", s"a row references a removed row through foreign key '${fk.name}', whose action is restrict")

            return Ok(None)
        _ -> ()

    val ctg = target_by_oid(s, fk.table)?
    val hits = s.referencing(t, fk, olds)?
    if hits.len() == 0 then return Ok(None)

    val befores = buf[Value]()
    val keys = buf[Option[Value]]()

    for h in hits
        befores.push(h.row.value)
        keys.push(Some(h.key))

    val deltas = buf[Delta]()

    val deleting = action match
        FkCascade -> news.is_none()
        _ -> false

    if deleting
        val changes = buf[RowChange]()

        for i in 0..<hits.len()
            changes.push(Remove(hits[i].key))
            deltas.push(Delta(Some(befores[i]), None))

        s.write_rows(t, ctg.oid, changes)? match
            Wait(h) -> return Ok(Some(h))
            Done(_) -> ()

        work.push(Pending(ctg, deltas))
        return Ok(None)

    // Every other action rewrites the referencing columns of each referencing row.
    val at = ctg.positions(fk.columns)
    val fs = fields_of_type(ctg.row)
    var rows = vector_of(ctg.row, befores.view())
    val names = buf[string]()

    for j in at
        names.push(fs[j].name)

    val defaults = buf[Expr]()
    val has_default = buf[bool]()

    action match
        FkSetDefault ->
            for j in at
                ctg.table.columns[j].default match
                    Some(e) ->
                        defaults.push(e)
                        has_default.push(true)
                    None -> has_default.push(false)
        _ -> ()

    val dv = eval_defs(s, c, rows, defaults)?
    val ref_ty = ctg.type_of(fk.columns)
    val order = sorted_order(ref_ty, olds)
    var d: usize = 0

    for k in 0..<at.len()
        val j = at[k]
        val vals = buf[Value]()
        val dcol = if has_default.len() > k && has_default[k] then Some(coerce_vector(dv[d], fs[j].ty)?) else None

        for i in 0..<hits.len()
            val v = action match
                FkCascade ->
                    val nv = news.unwrap()[matching(ref_ty, olds, order, ctg.values_of(fk.columns, befores[i]))]
                    nv match
                        Record(parts) -> parts[k]
                        _ -> Null
                FkSetDefault -> dcol match
                    Some(col) -> value_at(col, i)
                    None -> Null
                _ -> Null

            if v.is_null() && !fs[j].ty.is_nullable()
                return fail("T3004", s"a null is written to the NOT NULL column '${fs[j].name}' by foreign key '${fk.name}'")

            vals.push(v)

        if has_default.len() > k && has_default[k] then d += 1
        rows = with_column(rows, j, vector_of(fs[j].ty, vals.view()))

    val (after, regenerated) = with_generated(s, c, ctg, rows, Some(names))?
    names.extend(regenerated.view())
    check_rows(s, c, ctg, after, Some(names))?

    for i in 0..<hits.len()
        deltas.push(Delta(Some(befores[i]), Some(value_at(after, i))))

    s.write_rows(t, ctg.oid, ordered_changes(ctg, after, keys))? match
        Wait(h) -> return Ok(Some(h))
        Done(_) -> ()

    work.push(Pending(ctg, deltas))
    Ok(None)
end fk_act

/** The positions of `values`, sorted by `cmp` of their values. */
private sorted_order(ty: Type, values: Buf[Value]) -> Buf[usize]
    var order = buf[usize]()

    for i in 0..<values.len()
        order.push(i)

    sort_by(order.view_mut(), (a, b) -> cmp(ty, values[a], values[b]) < 0)
    order

/** The position in `values` (sorted through `order`) of the value `v` holds; a referencing row found
 * for one of `values` holds one of them.
 */
private matching(ty: Type, values: Buf[Value], order: Buf[usize], v: Option[Value]) -> usize
    val x = v.unwrap()
    var lo: usize = 0
    var hi = order.len()

    while lo < hi
        val mid = lo + (hi - lo) / 2
        val c = cmp(ty, values[order[mid]], x)
        if c == 0 then return order[mid]
        if c < 0 then lo = mid + 1 else hi = mid

    panic("a referencing row holds none of the values it was found for")

/** The binders `returning` sees (§9.5): the written row as `binder`, the row before the statement as
 * `old`, and any `from`/`using` binders in the composite `joined`.
 */
private returning_env(ctx: Ctx, binder: string, rows: ColumnVector, old: Option[string], olds: ColumnVector, joined: Option[ColumnVector]) -> Env
    val bs = buf[Binder]()
    bs.push(Binder(binder, rows))

    old match
        Some(o) -> bs.push(Binder(o, olds))
        None -> ()

    joined match
        Some(m) -> bs.push(Binder(Composite, m))
        None -> ()

    Env(rows.len, bs, ctx)

/** Keys kept sorted by `cmp` (§3.3), each with a position: the rows a statement has written. */
private struct KeySet
    ty: Type
    keys: Buf[Value]
    at: Buf[usize]

    find(self, k: Value) -> (bool, usize)
        var lo: usize = 0
        var hi = self.keys.len()

        while lo < hi
            val mid = lo + (hi - lo) / 2
            val c = cmp(self.ty, self.keys[mid], k)
            if c == 0 then return (true, mid)
            if c < 0 then lo = mid + 1 else hi = mid

        (false, lo)

    get(self, k: Value) -> Option[usize]
        val (found, i) = self.find(k)
        if found then Some(self.at[i]) else None

    put(*self, k: Value, v: usize)
        val (_, i) = self.find(k)
        self.keys.insert(i, k)
        self.at.insert(i, v)
end KeySet

private key_set(ty: Type) -> KeySet = KeySet(ty, buf[Value](), buf[usize]())

// -- Insert and upsert, §9.2–§9.3 ---------------------------------------------------------------

/** The rows `src` inserts: each source column in the target column it names, coerced to its type
 * (§9.2 rule 1), every other column its default or null (`ddl.md` §2.7 rule 1), and the generated
 * columns computed.
 */
private insert_rows(s: &Store, ctx: Ctx, tg: Target, columns: Buf[string], src: ColumnVector) -> Result[ColumnVector, CodecError]
    val fs = fields_of_type(tg.row)
    val defaults = buf[Expr]()
    val at = buf[usize]()
    val drawn = buf[usize]()

    for j in 0..<tg.table.columns.len()
        val c = tg.table.columns[j]

        if !contains(columns.view(), c.name) && c.generated.is_none()
            c.default match
                Some(e) ->
                    defaults.push(e)
                    at.push(j)
                None ->
                    if c.identity != NoIdentity then drawn.push(j)
                    else if !fs[j].ty.is_nullable() then return fail("Q3005", s"column '${c.name}' is NOT NULL and has no default")

    val dv = eval_defs(s, ctx, src, defaults)?
    val cs = buf[ColumnVector]()

    for j in 0..<fs.len()
        var v = repeated(fs[j].ty, placeholder(fs[j].ty), src.len)

        for i in 0..<columns.len()
            if columns[i] == fs[j].name then v = coerce_vector(src.member(i), fs[j].ty)?

        for k in 0..<at.len()
            if at[k] == j then v = coerce_vector(dv[k], fs[j].ty)?

        if contains(drawn.view(), j) then v = identity_values(s, tg.table.columns[j].sequence, fs[j].ty, src.len)?

        cs.push(v)

    Ok(with_generated(s, ctx, tg, ColumnVector(tg.row, src.len, buf[u8](), Members(cs)), None)?.0)
end insert_rows

private run_insert(s: &Store, t: &Txn, ctx: Ctx, typing: Typing, table: QualName, binder: string, old: Option[string], columns: Buf[string], source: Rel, on_conflict: Option[OnConflict], returning: Buf[Item]) -> Result[Executed, CodecError]
    val tg = target_of(s, table)?
    var u = no_uses()
    u.add_rel(source, true)
    var set = buf[Item]()
    var where: Option[Expr] = None

    on_conflict match
        Some(oc) -> oc.action match
            DoUpdate(items, w) ->
                set = items
                where = w
            Nothing -> ()
        None -> ()

    u.add_items(set)

    where match
        Some(w) -> u.add_expr(w)
        None -> ()

    u.add_items(returning)

    // The planner takes the types in the checker's order: the source, the conflict action's `set`
    // and `where`, then `returning`.
    var p = Planner(typing.nodes, 0, ctx, buf[MemTable](), buf[Binder](), buf[CteFrame](), Some(u.db(s, t)), None)
    val src = p.rel(source)
    val values = buf[TExpr]()

    for it in set
        values.push(p.expr(it.expr))

    val cond = p.opt_expr(where)
    val rets = buf[TExpr]()

    for it in returning
        rets.push(p.expr(it.expr))

    val c = p.ctx
    val batches = drain(flat_input(src))?
    val proposed = if batches.len() == 0 then empty_vector(tg.row) else insert_rows(s, c, tg, columns, concat(batches[0].ty, batches.view()))?
    val olds_ty = nullable(tg.row)

    val oc = on_conflict match
        Some(x) -> x
        None ->
            check_rows(s, c, tg, proposed, None)?
            val acts = buf[u16]()
            val changes = buf[RowChange]()
            val deltas = buf[Delta]()

            for i in 0..<proposed.len
                acts.push(0)
                changes.push(Put(tg.stored(proposed, i)))
                deltas.push(Delta(None, Some(value_at(proposed, i))))

            val env = returning_env(c, binder, proposed, old, repeated(olds_ty, Null, proposed.len), None)
            return written(s, t, c, tg, changes, deltas, proposed.len, typing.result, returning_rows(typing.result, rets, env, p.action, acts)?)

    // §9.3 rule 2, row by row in source order, on the unique key `target` names. A row whose key this
    // statement has already written conflicts with that write: skipped by `nothing`, `R0007` for an
    // update (rule 3). A row with a null in the key conflicts with none (`ddl.md` §2.5 rule 2).
    val cids = conflict_columns(s, tg, oc.target)?
    var seen = key_set(tg.type_of(cids))
    val rows = buf[Value]()
    val olds = buf[Value]()
    val keys = buf[Option[Value]]()
    val acts = buf[u16]()

    for i in 0..<proposed.len
        val ck = tg.values_of(cids, value_at(proposed, i))

        val mine = ck match
            Some(k) -> seen.get(k)
            None -> None

        val existing = mine match
            Some(at) -> Some(rows[at])
            None -> ck match
                Some(k) -> s.lookup_unique(t, tg.oid, cids, k)?.map(h -> h.row.value)
                None -> None

        existing match
            None ->
                ck match
                    Some(k) -> seen.put(k, rows.len())
                    None -> ()

                rows.push(value_at(proposed, i))
                olds.push(Null)
                keys.push(None)
                acts.push(0)
            Some(e) -> oc.action match
                Nothing -> ()
                DoUpdate(_, _) ->
                    val before = vector_of(tg.row, [e])
                    val bs = buf[Binder]()
                    bs.push(Binder(binder, before))
                    bs.push(Binder(oc.excluded, take(proposed, [i])))
                    val one = Env(1, bs, c)

                    if passes(cond, one)?
                        if mine.is_some() then return fail("R0007", "the statement would write one row twice")
                        seen.put(ck.unwrap(), rows.len())
                        rows.push(value_at(apply_set(tg, before, set, values, one)?, 0))
                        olds.push(e)
                        keys.push(Some(tg.pk_of(e)))
                        acts.push(1)

    val names = buf[string]()

    for it in set
        names.push(it.name)

    // Generated columns reading a set column are computed again, and each row meets the constraints
    // its own kind of write must (`ddl.md` §2.6).
    val (all, regenerated) = with_generated(s, c, tg, vector_of(tg.row, rows.view()), Some(names))?
    names.extend(regenerated.view())
    val inserted = buf[usize]()
    val updated = buf[usize]()

    for i in 0..<acts.len()
        if acts[i] == 0 then inserted.push(i) else updated.push(i)

    check_rows(s, c, tg, take(all, inserted.view()), None)?
    check_rows(s, c, tg, take(all, updated.view()), Some(names))?

    val env = returning_env(c, binder, all, old, vector_of(olds_ty, olds.view()), None)
    val ret = returning_rows(typing.result, rets, env, p.action, acts)?
    val deltas = buf[Delta]()

    for i in 0..<all.len
        deltas.push(Delta(if acts[i] == 0 then None else Some(olds[i]), Some(value_at(all, i))))

    written(s, t, c, tg, ordered_changes(tg, all, keys), deltas, all.len, typing.result, ret)
end run_insert

/** The columns, by id and in the key's own order, of the unique key an upsert's `target` names
 * (§9.3 rules 1–2): the primary key, a `unique` constraint, or a unique index over columns with no
 * predicate, matched by its columns in any order or by its name.
 */
private conflict_columns(s: &Store, tg: Target, target: ConflictTarget) -> Result[Buf[u32], CodecError]
    val keys = buf[KeyColumns]()

    s.catalog.primary_key_of(tg.oid) match
        Some(pk) -> keys.push(KeyColumns(pk.name, tg.table.primary_key))
        None -> ()

    keys.extend(unique_keys(s.catalog, tg.oid).view())

    for k in keys
        val hit = target match
            Columns(names) ->
                val mine = s.catalog.column_names(tg.table, k.columns)
                var all = names.len() == mine.len()

                for n in mine
                    if !contains(names.view(), n) then all = false

                all
            Constraint(name) -> k.name == name

        if hit then return Ok(k.columns)

    fail("Q5004", "the conflict target names no unique key of the table")

/** The store's changes for `rows`, each a new row (`keys[i]` absent) or one replacing the row keyed
 * `keys[i]`: removals of rows whose key changes first, then replacements, then new rows, so that a
 * key a row leaves is free for the row taking it.
 */
private ordered_changes(tg: Target, rows: ColumnVector, keys: Buf[Option[Value]]) -> Buf[RowChange]
    val removes = buf[RowChange]()
    val replaces = buf[RowChange]()
    val puts = buf[RowChange]()

    for i in 0..<rows.len
        val row = tg.stored(rows, i)

        keys[i] match
            Some(k) ->
                if tg.key_at(rows, i) == k
                    replaces.push(Replace(k, row))
                else
                    removes.push(Remove(k))
                    puts.push(Put(row))
            None -> puts.push(Put(row))

    removes.extend(replaces.view())
    removes.extend(puts.view())
    removes

// -- Update and Delete, §9.4 ---------------------------------------------------------------------

/** An `Update`, or with `deleting` a `Delete` (whose `set` is empty and `from` is its `using`). */
private run_update(s: &Store, t: &Txn, ctx: Ctx, typing: Typing, table: QualName, binder: string, old: Option[string], from: Option[Rel], filter: Option[Expr], set: Buf[Item], returning: Buf[Item], deleting: bool = false) -> Result[Executed, CodecError]
    val tg = target_of(s, table)?
    var u = no_uses()

    from match
        Some(f) -> u.add_rel(f, false)
        None -> ()

    filter match
        Some(f) -> u.add_expr(f)
        None -> ()

    u.add_items(set)
    u.add_items(returning)
    val db = u.db(s, t)

    // The checker's order: `from`, `filter`, `set`, `returning`.
    var p = Planner(typing.nodes, 0, ctx, buf[MemTable](), buf[Binder](), buf[CteFrame](), Some(db), None)

    val joined = from match
        Some(f) -> Some(p.rel(f))
        None -> None

    val f = p.opt_expr(filter)
    val values = buf[TExpr]()

    for it in set
        values.push(p.expr(it.expr))

    val rets = buf[TExpr]()

    for it in returning
        rets.push(p.expr(it.expr))

    val c = p.ctx

    // The targets are a scan of the table, logging `filter` when nothing but the target is in it.
    val logged = if joined.is_none() && f.is_some() && !has_subquery(f.unwrap()) then f else None
    val binders = items_of([binder])

    old match
        Some(o) -> binders.push(o)
        None -> ()

    val none = buf[TKey]()
    // The rows `filter` keeps, or whose pairs an inner join's `on` keeps, lie in the key range its
    // comparisons of the target's primary key allow (`exec_access.sysl`).
    val scan = store_scan(db, tg.oid, tg.row, read_pred(db, tg.table, binders, tg.row, logged, c), access_of(db, tg.table, binder, f, c))
    val target = Lowered(scan, binder, tg.row, none)

    val input = joined match
        Some(r) -> plan_join(Inner, target, r, f, None, None, c, true)
        None -> f match
            Some(x) -> Lowered(FilterOp(target.op, binder, x, c), binder, tg.row, none)
            None -> target

    val matched = concat(input.elem, drain(input.op)?.view())
    val env = env_of(c, input.binder, matched)
    val rows = env.binder(binder)
    val keys = buf[Option[Value]]()

    // §9.4 rule 2: a target row matched by two `from` rows is refused.
    var seen = key_set(tg.key_type())

    for i in 0..<rows.len
        val k = tg.key_at(rows, i)
        if joined.is_some() && seen.get(k).is_some() then return fail("R0007", "a target row is matched by more than one row of 'from'")
        if joined.is_some() then seen.put(k, i)
        keys.push(Some(k))

    val acts = buf[u16]()

    for _ in 0..<rows.len
        acts.push(if deleting then 2 else 1)

    val composite = if joined.is_some() then Some(matched) else None
    val olds = rows.as_type(nullable(tg.row))

    if deleting
        val changes = buf[RowChange]()
        val gone = buf[Delta]()

        for i in 0..<keys.len()
            changes.push(Remove(keys[i].unwrap()))
            gone.push(Delta(Some(value_at(rows, i)), None))

        val ret = returning_rows(typing.result, rets, returning_env(c, binder, rows, old, olds, composite), p.action, acts)?
        return written(s, t, c, tg, changes, gone, rows.len, typing.result, ret)

    val names = buf[string]()

    for it in set
        names.push(it.name)

    val (after, regenerated) = with_generated(s, c, tg, apply_set(tg, rows, set, values, env)?, Some(names))?
    names.extend(regenerated.view())
    check_rows(s, c, tg, after, Some(names))?

    val ret = returning_rows(typing.result, rets, returning_env(c, binder, after, old, olds, composite), p.action, acts)?
    val deltas = buf[Delta]()

    for i in 0..<after.len
        deltas.push(Delta(Some(value_at(rows, i)), Some(value_at(after, i))))

    written(s, t, c, tg, ordered_changes(tg, after, keys), deltas, after.len, typing.result, ret)
end run_update
