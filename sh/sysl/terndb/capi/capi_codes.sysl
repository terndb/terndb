module sh.sysl.terndb.capi

// The registry of `docs/spec/errors.md` as static C strings, for `terndb_error_code`,
// `terndb_error_name` and `terndb_code_name` (`c-api.md` §10.2): every live code, its name, in the
// registry's order. Written by `sysl run tests/capi/tools -- codes docs/spec/errors.md <this file>`;
// `capi_tests.sysl` holds it to the registry row for row.

/** A registered code and its name, NUL-terminated and static. */
struct CodeName
    code: *u8
    name: *u8
    code_text: string
    name_text: string

/** How many live codes the registry holds. */
const CodeCount: usize = 190

/** Live code `i` of the registry, in its order; `i` < `CodeCount`. */
code_at(i: usize) -> CodeName = i match
    0 -> CodeName(c"Q1001", c"malformed_encoding", "Q1001", "malformed_encoding")
    1 -> CodeName(c"Q1002", c"unknown_kind", "Q1002", "unknown_kind")
    2 -> CodeName(c"Q1003", c"non_canonical_encoding", "Q1003", "non_canonical_encoding")
    3 -> CodeName(c"Q1004", c"invalid_utf8", "Q1004", "invalid_utf8")
    4 -> CodeName(c"Q1005", c"unsupported_tree_version", "Q1005", "unsupported_tree_version")
    5 -> CodeName(c"Q1006", c"nesting_too_deep", "Q1006", "nesting_too_deep")
