// -- callbacks (§12) ------------------------------------------------------------------------------

@export("terndb_alloc_fn")
type AllocFn = *extern(*unit, usize, usize) -> *unit

@export("terndb_free_fn")
type FreeFn = *extern(*unit, *unit, usize, usize)

@export("terndb_log_fn")
type LogFn = *extern(*unit, *const LogRecordH)

// -- handles (§2) ---------------------------------------------------------------------------------

/** What kind of handle a pointer is (§2.4 rule 2). */
const KindConfig: u32 = 0x7464_0001
const KindDb: u32 = 0x7464_0002
const KindConn: u32 = 0x7464_0003
const KindTxnOptions: u32 = 0x7464_0004
const KindExecOptions: u32 = 0x7464_0005
const KindTxn: u32 = 0x7464_0006
const KindStmt: u32 = 0x7464_0007
const KindResult: u32 = 0x7464_0008
const KindBatch: u32 = 0x7464_0009
const KindColumn: u32 = 0x7464_000a
const KindType: u32 = 0x7464_000b
const KindError: u32 = 0x7464_000c
const KindQueue: u32 = 0x7464_000d
const KindOp: u32 = 0x7464_000e
const KindMetrics: u32 = 0x7464_000f
const KindLogRecord: u32 = 0x7464_0010

/** A handle's life: live until its `_free`, then freed for good. */
const Live: u32 = 1
const Freed: u32 = 2

/** The record every handle begins with: its kind and whether it is live. A debug build reads it on
 * every call (§2.4 rule 2); a freed handle's memory is never given back there, so the record stays
 * readable and the address is never handed out again.
 */
struct Head
    kind: u32
    state: Atomic[u32]

head(kind: u32) -> Head = Head(kind, Atomic(Live))

/** Whether this build checks every handle on every call (§2.4 rule 2). */
#if debug
const DebugChecks: bool = true
#else
const DebugChecks: bool = false
#endif

/** Handles allocated and not yet freed, of every kind, in the process (§12.1 rule 1). */
var live_handles: Atomic[u64] = Atomic(0)

/** A handle has been made. */
counted() = live_handles.add(1)

/** A handle has been freed. */
uncounted() = live_handles.sub(1)

/** Why a handle argument is refused, if it is: `C1002` for NULL, `C1001` (debug builds) for a freed
 * handle or one of another kind.
 */
enum Refusal
    NoRefusal
    NullHandle
    BadHandle

/** The verdict on handle `p`, which should be of kind `kind`. */
check_handle(p: *const unit, kind: u32) -> Refusal
    if p == null then return NullHandle

    if DebugChecks
        val h: *Head = ptr_cast(p)
        if h.kind != kind || h.state.load() != Live then return BadHandle

    NoRefusal

/** Marks handle `p` freed; false when it already was (a double free, which a debug build reports). */
mark_freed(p: *const unit) -> bool
    val h: *Head = ptr_cast(p)
    h.state.cas(Live, Freed) == Live

/** Stops the process naming `code` and `function`, for a precondition violation found by a function
 * with no error channel in a debug build (§1 rule 7).
 */
abort_with(code: string, function: string) -> never
    eprints(s"terndb: $code in $function\n")
    trap()

/** `check_handle` for a function with no error channel: a violation aborts in a debug build. */
expect_handle(p: *const unit, kind: u32, function: string)
    check_handle(p, kind) match
        NoRefusal -> ()
        NullHandle -> if DebugChecks then abort_with("C1002", function)
        BadHandle -> abort_with("C1001", function)

// -- initialisation (§3) --------------------------------------------------------------------------

/** What `terndb_init` installed, once: the host's allocator (both null for the system's) and its
 * context. `init_state` is 0 before the first `terndb_init`, 1 while it runs and 2 after.
 */
var init_state: Atomic[u32] = Atomic(0)
var host_alloc: *extern(*unit, usize, usize) -> *unit = null
var host_free: *extern(*unit, *unit, usize, usize) = null
var host_ctx: *unit = null

/** Whether `terndb_init` has succeeded. */
initialized() -> bool = init_state.load() == 2

@export("terndb_abi_version")
abi_version() -> u32 = AbiVersion

@export("terndb_version")
version() -> *const CChar = ptr_cast(c"0.0.1")

@export("terndb_debug_checks")
debug_checks() -> bool = DebugChecks

@export("terndb_debug_live_handles")
debug_live_handles() -> usize = usize(live_handles.load())

@export("terndb_init")
init(abi_version: u32, alloc: AllocFn, free_fn: FreeFn, ctx: *unit, err: **ErrorH) -> CInt
    if abi_version >> 16 != AbiMajor || abi_version & 0xffff > AbiMinor
        return fail(err, c_error("C1009", s"the caller's header is ABI ${abi_version >> 16}.${abi_version & 0xffff}, and the library is $AbiMajor.$AbiMinor"))

    if (alloc == null) != (free_fn == null)
        return fail(err, c_error("C1002", "alloc and free are both given or both NULL"))

    // The first call installs; any later one must name the same allocator (§3 rule 4).
    if init_state.cas(0, 1) == 0
        host_alloc = alloc
        host_free = free_fn
        host_ctx = ctx
        init_state.store(2)
        return 0

    while init_state.load() != 2
        sysl.threads.yield_now()

    if host_alloc == alloc && host_free == free_fn && host_ctx == ctx then return 0

    fail(err, c_error("C1005", "terndb_init was already called with another allocator"))

/** The refusal of a call made before `terndb_init` (§3 rule 1). */
not_initialized() -> ErrorData = c_error("C1008", "terndb_init has not been called")

@export("terndb_code_name")
code_name(code: *const CChar) -> *const CChar
    if code == null then return null

    val text = c_text(code)
    for i in 0..<CodeCount
        val row = code_at(i)
        if row.code_text == text then return ptr_cast(row.name)

    null

/** The NUL-terminated text at `p`, copied. */
c_text(p: *const CChar) -> string
    val bytes: *const u8 = ptr_cast(p)
    var n: usize = 0
    while bytes[n] != 0
        n += 1
    text_of(bytes, n)

/** `n` octets at `p` as text, copied; invalid UTF-8 is replaced, never trusted. */
text_of(p: *const u8, n: usize) -> string
    if n == 0 || p == null then return ""
    sysl.text.from_utf8_lossy(p[0..<n])

/** `n` octets at `p`, copied. */
bytes_of(p: *const u8, n: usize) -> sysl.buf.Buf[u8]
    val out = sysl.buf.buf[u8]()
    if n == 0 || p == null then return out
    out.extend(p[0..<n])
    out

// -- the allocator (§3 rule 3) --------------------------------------------------------------------

extern "posix_memalign" c_posix_memalign(out: **unit, align: usize, size: usize) -> i32
extern "free" c_free(p: *unit)

/** Octets the library holds from its allocator now, for `terndb.memory.bytes` and `memory_limit`. */
var heap_bytes: Atomic[u64] = Atomic(0)

/** Every block the library allocates, with the size and boundary sysl asks for: from the host's
 * `alloc` once `terndb_init` installed one, otherwise from the system. Of the calls allowed before
 * `terndb_init` only `terndb_code_name` allocates, and it gives back what it took before it returns,
 * so no block taken from the system is ever handed to the host's `free`.
 */
@export("terndb_capi_alloc")
private heap_alloc(size: usize, align: usize) -> *u8
    val f = host_alloc
    if f != null
        val p = f(host_ctx, size, align)
        if p != null then heap_bytes.add(u64(size))
        return ptr_cast(p)

    var p: *unit = null
    if c_posix_memalign(&p, align, size) != 0 then return null
    heap_bytes.add(u64(size))
    ptr_cast(p)

@export("terndb_capi_free")
private heap_free(p: *u8, size: usize, align: usize)
    if p == null then return
    heap_bytes.sub(u64(size))
    val f = host_free
    if f != null
        f(host_ctx, ptr_cast(p), size, align)
        return
    c_free(ptr_cast(p))
