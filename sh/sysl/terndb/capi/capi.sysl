module sh.sysl.terndb.capi

@include("<stddef.h>")

import sysl.raw.ptr_cast
import sysl.sync.Atomic

// `libterndb`, TernDB's C ABI (`docs/spec/c-api.md`). Every function of the header `terndb.h` (§12) is
// an `@export` of this module; `capi/` builds it with `sysl build-c --shared` into `libterndb.dylib`.
//
// This file holds what every other file of the module stands on: the C spellings the header needs,
// its constants, the record at the start of every handle (§2.4), library initialisation (§3) and the
// allocator the whole library allocates through.

c type
    /** C's `int`: what every fallible function returns (§1 rule 4). */
    CInt = "int"
    /** C's `char`, so that text crosses as `const char *` (§1 rule 3). */
    CChar = "char"

// -- versions (§3, §13) ---------------------------------------------------------------------------

@export("TERNDB_ABI_MAJOR")
const AbiMajor: u32 = 1

@export("TERNDB_ABI_MINOR")
const AbiMinor: u32 = 0

@export("TERNDB_ABI_VERSION")
const AbiVersion: u32 = (AbiMajor << 16) | AbiMinor

/** The release version `terndb_version` answers. */
const ReleaseVersion: string = "0.0.1"

