module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf, buf_filled}
import sysl.checksum.crc32c
import sysl.encoding.{get_u32_le, get_u64_le, put_u16_le, put_u32_le, put_u64_le}

// The WAL's records (`wal_record.sysl`, `on-disk-format.md` §6.1–§6.4): LSN arithmetic, every record
// kind round-tripping through its encoding (at its largest as well), the header's layout and CRC,
// what the encoder refuses, and what a frame that passes its CRC but does not parse is.

/** `n` bytes counting up from `seed`. */
wr_bytes(n: usize, seed: u8) -> Buf[u8]
    val out = buf[u8]()

    for i in 0..<n
        out.push(u8((usize(seed) + i) % 251))

    out

/** A `Buf` of `xs`. */
wr_buf[T](xs: []const T) -> Buf[T]
    val out = buf[T]()
    out.extend(xs)
    out

private wr_entry(slot: u16, key_len: usize, value_len: usize) -> WalEntry =
    WalEntry(slot, 0x0102, wr_bytes(key_len, 3), wr_bytes(value_len, 7))

/** A body of each kind with every field set to something other than zero. */
wr_sample(kind: u8) -> WalBody = kind match
    WkPad -> WbPad(24)
    WkPageInit -> WbPageInit(0x1000000000000007, 3, 0x81, 0x55aa, 2, 1, wr_bytes(5, 1), wr_bytes(9, 2))
    WkFpi -> WbFpi(42, 0, wr_bytes(DbPageSize, 9))
    WkNodeInsert -> WbNodeInsert(42, wr_entry(17, 11, 23))
    WkNodeDelete -> WbNodeDelete(42, 300)
    WkNodePatch -> WbNodePatch(42, 5, wr_buf([WalPatch(20, wr_bytes(3, 4)), WalPatch(100, wr_bytes(0, 0)), WalPatch(4000, wr_bytes(17, 5))]))
    WkRowHeader -> WbRowHeader(42, 6, 0x123456789, 0x1000000000000099, 0x8001)
    WkNodeSlotFlags -> WbNodeSlotFlags(42, 7, 0xbeef)
    WkNodeTruncate -> WbNodeTruncate(42, 31, wr_bytes(12, 6), 0xfeedface)
    WkNodeBulk -> WbNodeBulk(42, wr_buf([wr_entry(0, 1, 2), wr_entry(1, 0, 0), wr_entry(2, 40, 300)]))
    WkNodeSetExtra -> WbNodeSetExtra(42, 0x7fffffffffffffff)
    WkNodeCompact -> WbNodeCompact(42)
    WkOverflowWrite -> WbOverflowWrite(42, 43, wr_bytes(5000, 8))
    WkUndoAppend -> WbUndoAppend(0x1000000000000003, 128, wr_bytes(77, 9))
    WkPageAlloc -> WbPageAlloc(2, 4095)
    WkPageFree -> WbPageFree(2, 65535)
    WkFormatPage -> WbFormatPage(42, wr_bytes(DbPageSize, 10))
    WkTxnCommit -> WbTxnCommit(-5, 0x1000000000000123, 99, 1)
    WkTxnAbort -> WbTxnAbort
    WkCheckpointBegin -> WbCheckpointBegin
    WkCheckpointEnd -> WbCheckpointEnd(WalCheckpoint(4096, 4096, 10, 20, 30, 40, 50, wr_buf([WalActiveTxn(7, 8, 9), WalActiveTxn(10, 11, 0)])))
    WkFileCreate -> WbFileCreate(1, 3)
    WkFileExtend -> WbFileExtend(0, 2, 65536)
    WkFileDelete -> WbFileDelete(1, 0xffffffffffffffff)
    WkUndoTruncate -> WbUndoTruncate(0x1000000000004000)
    WkFormatUpgrade -> WbFormatUpgrade(1, 2)
    WkFormatMin -> WbFormatMin(2)
    WkTimelineSwitch -> WbTimelineSwitch(1, 2, 77, wr_bytes(16, 11))
    WkRestorePoint -> WbRestorePoint(wr_bytes(9, 12))
    WkPurgeHorizon -> WbPurgeHorizon(555)
    WkSyncConfig -> WbSyncConfig(2, wr_buf([wr_bytes(3, 1), wr_bytes(0, 0), wr_bytes(8, 2)]))
    _ -> panic(s"no sample of kind $kind")

/** Encodes `rec` at LSN `lsn`, checks the frame, decodes it, and expects `rec` back. */
wr_roundtrips(rec: WalRecord, lsn: u64)
    val at = WalRecord(lsn, rec.txn, rec.flags, rec.undo_next, rec.body)
    var b = wal_encoded(at).unwrap()
    assert_eq(b.len() % 8, usize(0))
    assert_eq(usize(wal_frame_len(b.view())), b.len())
    assert(wal_frame_valid(b.view(), lsn))
    assert_eq(b[24], wal_kind(rec.body))
    assert_eq(wal_decode(b.view()), Ok(at))

/** The sample of `kind` round-trips, plain and in a transaction. */
wr_kind_roundtrips(kind: u8)
    wr_roundtrips(wal_record(0, wr_sample(kind)), 4096)
    if kind != WkPad then wr_roundtrips(wal_record(0x1234, wr_sample(kind)), 0x40000008)

/** The error code of a result, or "ok". */
wr_code[T](r: Result[T, CodecError]) -> string = r match
    Ok(_) -> "ok"
    Err(e) -> e.code

/** Seals an encoded record's CRC again after a test has changed its bytes. */
wr_reseal(b: []u8) = put_u32_le(b[0..<4], crc32c(b[4..<b.len]))

// -- LSN arithmetic --------------------------------------------------------------------------------

@test
the_format_segment_is_64_mib_and_its_records_start_after_a_4_kib_header()
    assert_eq(wal_segment_size(WalFormatShift), u64(67108864))
    assert_eq(wal_segment_capacity(WalFormatShift), u64(67104768))
    assert_eq(wal_segment_first_record(0, WalFormatShift), WalFirstLsn)

@test
an_lsn_lies_in_segment_lsn_shifted_by_26_at_its_low_bits()
    val lsn: u64 = 3 * 67108864 + 12345
    assert_eq(wal_segment_of(lsn, WalFormatShift), u64(3))
    assert_eq(wal_segment_offset(lsn, WalFormatShift), u64(12345))
    assert_eq(wal_segment_lsn(3, WalFormatShift), u64(3 * 67108864))

@test
the_last_byte_of_a_segment_is_in_it_and_the_next_is_in_the_next()
    val end = wal_segment_size(WalFormatShift)
    assert_eq(wal_segment_of(end - 1, WalFormatShift), u64(0))
    assert_eq(wal_segment_offset(end - 1, WalFormatShift), end - 1)
    assert_eq(wal_segment_of(end, WalFormatShift), u64(1))
    assert_eq(wal_segment_offset(end, WalFormatShift), u64(0))

@test
the_largest_lsn_lies_in_the_last_segment()
    val top: u64 = 0xffffffffffffffff
    assert_eq(wal_segment_of(top, WalFormatShift), top >> 26)
    assert_eq(wal_segment_offset(top, WalFormatShift), u64(67108863))

@test
a_smaller_segment_shifts_the_same_way()
    assert_eq(wal_segment_size(16), u64(65536))
    assert_eq(wal_segment_of(65536 * 5 + 7, 16), u64(5))
    assert_eq(wal_segment_first_record(5, 16), u64(65536 * 5 + 4096))
    assert_eq(wal_segment_capacity(16), u64(61440))

@test
the_record_after_one_is_where_it_ends()
    assert_eq(wal_next_record(4096 + 40, 16), u64(4136))

@test
a_record_ending_at_its_segment_s_end_is_followed_past_the_next_header()
    assert_eq(wal_next_record(65536, 16), u64(65536 + 4096))

@test
a_record_ending_less_than_a_header_before_the_end_is_followed_in_the_next_segment()
    assert_eq(wal_next_record(65536 - 24, 16), u64(65536 + 4096))
    assert_eq(wal_next_record(65536 - 8, 16), u64(65536 + 4096))

@test
a_record_ending_exactly_a_header_before_the_end_is_followed_there()
    assert_eq(wal_next_record(65536 - 32, 16), u64(65536 - 32))

@test
blocks_round_down_and_up_to_4_kib()
    assert_eq(wal_block_floor(4096), u64(4096))
    assert_eq(wal_block_floor(8191), u64(4096))
    assert_eq(wal_block_ceil(4096), u64(4096))
    assert_eq(wal_block_ceil(4097), u64(8192))
    assert_eq(wal_block_ceil(0), u64(0))

