module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}

// The structural checks of `query-tree.md` §11 that need no catalog and no types: binders and their
// scope (§8), parameter references (§10.1), the required and forbidden fields of §6, §7 and §9, and
// those of a DDL statement that `ddl.md` §3.5 lists. They run in the phases of §11.2: every name
// error (`Q2…`, `Q6002`) before any type error (`Q6005`), and those before any parameter or structure
// error (`Q4…`, `Q5…`, the other `Q6…`), and within a phase the one that comes first in pre-order.

/** `env` checked as above; the first error of the first phase that has one. */
check_envelope(env: Envelope) -> Result[unit, CodecError] = structural_phases(env).first(env)

/** `env` checked as above; every error of the first phase that has one, sorted by path (§11.2), and
 * none when it passes.
 */
check_errors(env: Envelope) -> Buf[CodecError] = structural_phases(env).errors(env)

/** What the structural checks find in `env`, phase by phase, for `type_envelope` to merge with what
 * the type checker finds.
 */
private[terndb] structural_phases(env: Envelope) -> Phases
    // The first walk only learns which binders the statement introduces anywhere, so the second can
    // tell a binder that is not visible (`Q2006`) from one that does not exist (`Q2002`).
    var gather = Checker(true, set[string](), set[string](), buf[bool](), buf[string](), false, Unrestricted, no_phases(), FirstNode, FirstNode)
    gather.statement(env.statement)

    val used = buf[bool]()

    for _ in 0..<env.params.len()
        used.push(false)

    var c = Checker(false, gather.all, set[string](), used, buf[string](), false, Unrestricted, no_phases(), FirstNode + 1, FirstNode)
    c.statement(env.statement)

    // `/params` comes before `/statement` in pre-order: node 0, before every node of the statement;
    // within it, the list before its declarations.
    if is_ddl(env.statement) && env.params.len() > 0 then
        c.found.add_at(0, 0, refusal("Q6001", "a DDL statement declares parameters", []).at("/params"))

    for i in 0..<used.len()
        if !used[i] then
            val e = refusal("Q4002", s"parameter $i is declared and never referenced", [Detail("param", s"$i")])
            c.found.add_at(0, u64(i) + 1, e.at(s"/params/$i"))

    c.found
end structural_phases

// -- the phases of §11.2 ------------------------------------------------------------------------

/** The pre-order index of the statement root; its `Rel` and `Expr` nodes follow it, and 0 stands for
 * `/params`. A node's index is one more than its span index (§12.2), which `node_paths` is keyed by.
 */
private[terndb] const FirstNode: u64 = 1

/** An error, the pre-order index of the node it is about, and the position within that node of what
 * it is about when that is no node of its own (a parameter declaration under `/params`): the one
 * order of §11.2, since a walk in the order of the encoding meets the nodes in the pre-order of their
 * paths.
 */
private[terndb] struct Found
    node: u64
    within: u64
    error: CodecError

/** The errors of each phase of §11.2, each kept in pre-order of the node it is about, and those of
 * one node in the order they were found.
 */
private[terndb] struct Phases
    names: Buf[Found]
    types: Buf[Found]
    structure: Buf[Found]

    /** `code` recorded in its phase against `node`. */
    record(*self, node: u64, code: string, message: string) = self.add(node, refusal(code, message, []))

    /** `e` recorded in its phase against `node` itself. */
    add(*self, node: u64, e: CodecError) = self.add_at(node, 0, e)

    /** `e` recorded in its phase (§11.2, `ddl.md` §3.1 rule 4) against position `within` of `node`. */
    add_at(*self, node: u64, within: u64, e: CodecError)
        val f = Found(node, within, e)
        val code = e.code

        if code.starts_with("Q2") || code == "Q6002" || code == "Q6004"
            in_order(self.names, f)
        else if code.starts_with("Q3") || code == "Q6005"
            in_order(self.types, f)
        else
            in_order(self.structure, f)

    /** The errors of `self` and of `other`, phase by phase. */
    merged(self, other: Phases) -> Phases
        val out = no_phases()

        for f in self.names
            in_order(out.names, f)
        for f in other.names
            in_order(out.names, f)
        for f in self.types
            in_order(out.types, f)
        for f in other.types
            in_order(out.types, f)
        for f in self.structure
            in_order(out.structure, f)
        for f in other.structure
            in_order(out.structure, f)

        out
    end merged

    /** Every error of the first phase that has one, in order, each with the path of its node in
     * `env`; empty when no phase has one.
     */
    errors(self, env: Envelope) -> Buf[CodecError]
        val out = buf[CodecError]()

        for p in [self.names, self.types, self.structure]
            if p.len() == 0 then continue

            val paths = node_paths(env)

            for f in p
                val i = if f.node >= FirstNode then usize(f.node - FirstNode) else paths.len()
                out.push(if i < paths.len() then f.error.at(paths[i]) else f.error)

            return out

        out
    end errors

    /** The first error of the first phase that has one. */
    first(self, env: Envelope) -> Result[unit, CodecError]
        val all = self.errors(env)

        if all.len() > 0 then return Err(all[0])

        Ok(())
end Phases

private[terndb] no_phases() -> Phases = Phases(buf[Found](), buf[Found](), buf[Found]())

// `f` placed in `fs` after every error about an earlier place or the same one. A walk meets the fields
// of a node in the schema's order, so the errors about one node stay in the order of what in it they
// are about.
private in_order(fs: Buf[Found], f: Found)
    var i = fs.len()

    while i > 0 && before(f, fs[i - 1])
        i -= 1

    fs.insert(i, f)

private before(a: Found, b: Found) -> bool = a.node < b.node || a.node == b.node && a.within < b.within

private struct Checker
    gathering: bool
    all: Set[string]
    seen: Set[string]
    used: Buf[bool]
    ctes: Buf[string]
    in_returning: bool
    rules: DefnRules
    found: Phases
    next: u64
    node: u64

    // -- recording ----------------------------------------------------------------------------

    /** `code` recorded in its phase against the node being checked. */
    report(*self, code: string, message: string) = self.report_on(code, message, [])

    /** `code` recorded as `report` does, with the §11.1 details that name what it is about. */
    report_on(*self, code: string, message: string, details: []const Detail)
        if self.gathering then return

        self.found.add(self.node, refusal(code, message, details))

    /** The pre-order index of a node being entered, which becomes the current one; the caller
     * restores the one it answers when it leaves.
     */
    enter(*self) -> u64
        val was = self.node
        self.node = self.next
        self.next += 1
        was

    /** A binder being introduced: non-empty (§8.2 rule 2, `Q5009`) and unique in the statement
     * (`Q2004`).
     */
    intro(*self, b: string)
        if self.gathering then return ignore(self.all.add(b))

        if b.len == 0 then self.report("Q5009", "a binder is empty")
        if !self.seen.add(b) then self.report_on("Q2004", s"binder '$b' is introduced twice", [Detail("binder", b)])

    opt_intro(*self, b: Option[string]) = b match
        Some(x) -> self.intro(x)
        None -> ()

    /** A reference to binder `b` from an expression that sees `visible`; `hidden` holds the binders
     * of the left input of each `Join` whose right input the reference is inside (§6.5 rule 2).
     */
    refer(*self, b: string, visible: Buf[string], hidden: Buf[string])
        if holds(visible, b) then return

        val about = [Detail("binder", b)]

        if holds(hidden, b)
            self.report_on("Q5006", s"a join's right input refers to '$b' of its left input; that is an Apply", about)
        else if self.all.has(b)
            self.report_on("Q2006", s"binder '$b' is not visible here", about)
        else
            self.report_on("Q2002", s"binder '$b' is unknown", about)

    param(*self, index: u64)
        if index >= u64(self.used.len())
            self.report_on("Q4001", s"parameter $index is not declared", [Detail("param", s"$index")])
        else
            self.used[usize(index)] = true

    unique_names(*self, items: Buf[Item], code: string, what: string)
        val names = set[string]()

        for it in items
            if !names.add(it.name) then
                val key = if what == "record field" then "field" else "column"
                self.report_on(code, s"$what '${it.name}' appears twice", [Detail(key, it.name)])

    // -- statements ---------------------------------------------------------------------------

    statement(*self, s: Statement)
        val none = buf[string]()

        s match
            Query(rel) -> ignore(self.rel(rel, none, none))
            Insert(_, binder, old, columns, source, on_conflict, returning) ->
                self.intro(binder)
                self.opt_intro(old)

                val names = set[string]()

                for c in columns
                    if !names.add(c) then self.report("Q5005", s"column '$c' is listed twice")

                ignore(self.rel(source, none, none))

                on_conflict match
                    Some(oc) ->
                        self.intro(oc.excluded)

                        oc.action match
                            DoUpdate(set, where) ->
                                val sees = both([binder, oc.excluded], none)
                                self.unique_names(set, "Q5005", "column")
                                self.items(set, sees, none)
                                self.opt_expr(where, sees, none)
                            Nothing -> ()
                    None -> ()

                self.returning(returning, with_old([binder], old))
            Update(_, binder, old, from, filter, set, returning) ->
                self.intro(binder)
                self.opt_intro(old)

                val joined = self.opt_rel(from)
                val sees = both([binder], joined)

                self.opt_expr(filter, sees, none)

                if set.len() == 0 then self.report("Q5009", "an update sets no column")

                self.unique_names(set, "Q5005", "column")
                self.items(set, sees, none)
                self.returning(returning, both(with_old([binder], old).view(), joined))
            Delete(_, binder, old, using, filter, returning) ->
                self.intro(binder)
                self.opt_intro(old)

                val joined = self.opt_rel(using)

                self.opt_expr(filter, both([binder], joined), none)
                self.returning(returning, both(with_old([binder], old).view(), joined))
            _ -> self.ddl(s)
    end statement

    opt_rel(*self, r: Option[Rel]) -> Buf[string] = r match
        Some(x) -> self.rel(x, buf[string](), buf[string]())
        None -> buf[string]()

    returning(*self, items: Buf[Item], sees: Buf[string])
        self.in_returning = true
        self.items(items, sees, buf[string]())
        self.in_returning = false

    // -- relations ----------------------------------------------------------------------------

    /** Checks `r`, whose expressions also see `outer` (§8.3 step 2), and answers the binders it
     * exposes to its parent.
     */
    rel(*self, r: Rel, outer: Buf[string], hidden: Buf[string]) -> Buf[string]
        val was = self.in_returning
        val parent = self.enter()
        self.in_returning = false
        val exposed = self.rel_body(r, outer, hidden)
        self.in_returning = was
        self.node = parent
        exposed

    rel_body(*self, r: Rel, outer: Buf[string], hidden: Buf[string]) -> Buf[string] = r match
        Scan(_, binder) ->
            self.intro(binder)
            one(binder)
        Values(binder, columns, rows) ->
            self.intro(binder)

            for row in rows
                if row.len() != columns.len() then self.report("Q5009", "a row of values has the wrong width")
                self.exprs(row, outer, hidden)

            one(binder)
        ParamScan(binder, param) ->
            self.intro(binder)
            self.param(param)
            one(binder)
        Filter(input, predicate) ->
            val inner = self.rel(*input, outer, hidden)
            self.expr(predicate, both(inner.view(), outer), hidden)
            inner
        Project(input, binder, items) ->
            val inner = self.rel(*input, outer, hidden)
            self.intro(binder)

            if items.len() == 0 then self.report("Q5009", "a projection has no items")

            self.unique_names(items, "Q2005", "output column")
            self.items(items, both(inner.view(), outer), hidden)
            one(binder)
        Join(kind, left, right, on, mark, binder) ->
            val l = self.rel(*left, outer, hidden)
            val r2 = self.rel(*right, outer, both(l.view(), hidden))
            self.opt_expr(on, both(both(l.view(), r2).view(), outer), hidden)
            self.mark_fields(kind == MarkJoin, mark, binder)

            kind match
                Semi | Anti -> l
                MarkJoin -> with_old(l.view(), binder)
                _ -> both(l.view(), r2)
        Apply(kind, left, right, on, mark, binder) ->
            val l = self.rel(*left, outer, hidden)
            val r2 = self.rel(*right, both(l.view(), outer), hidden)
            self.opt_expr(on, both(both(l.view(), r2).view(), outer), hidden)
            self.mark_fields(kind == MarkApply, mark, binder)

            kind match
                SemiApply | AntiApply -> l
                MarkApply -> with_old(l.view(), binder)
                _ -> both(l.view(), r2)
        Aggregate(input, binder, keys, aggs) ->
            val inner = self.rel(*input, outer, hidden)
            val sees = both(inner.view(), outer)
            self.intro(binder)
            self.items(keys, sees, hidden)

            for a in aggs
                self.exprs(a.call.args, sees, hidden)
                self.opt_expr(a.call.filter, sees, hidden)
                self.sort_keys(a.call.order, sees, hidden)

            one(binder)
        Window(input, binder, items) ->
            val inner = self.rel(*input, outer, hidden)
            val sees = both(inner.view(), outer)
            self.intro(binder)

            for it in items
                self.win_call(it.call, sees, hidden)

            with_old(inner.view(), Some(binder))
        Sort(input, keys) ->
            val inner = self.rel(*input, outer, hidden)
            self.sort_keys(keys, both(inner.view(), outer), hidden)
            inner
        Limit(input, count, offset, _, _) ->
            val inner = self.rel(*input, outer, hidden)
            self.opt_expr(count, outer, hidden)
            self.opt_expr(offset, outer, hidden)
            inner
        Distinct(input) -> self.rel(*input, outer, hidden)
        SetOp(_, _, binder, inputs) ->
            self.intro(binder)

            if inputs.len() < 2 then self.report("Q5009", "a set operation has fewer than two inputs")

            for i in inputs
                ignore(self.rel(i, outer, hidden))

            one(binder)
        With(recursive, ctes, body) -> self.with(recursive, ctes, *body, outer, hidden)
        CteRef(name, binder) ->
            if !holds(self.ctes, name) then self.report_on("Q2008", s"no enclosing With defines CTE '$name'", [Detail("cte", name)])
            self.intro(binder)
            one(binder)
        Nest(input, binder, keys, _, items, order) ->
            val inner = self.rel(*input, outer, hidden)
            val sees = both(inner.view(), outer)
            self.intro(binder)
            self.items(keys, sees, hidden)
            self.items(items, sees, hidden)
            self.sort_keys(order, sees, hidden)
            one(binder)
        Unnest(input, binder, value, _, _) ->
            val inner = self.rel(*input, outer, hidden)
            self.intro(binder)
            self.expr(value, both(inner.view(), outer), hidden)
            with_old(inner.view(), Some(binder))
        Tag(input, binder, _, _) ->
            ignore(self.rel(*input, outer, hidden))
            self.intro(binder)
            one(binder)
    end rel_body

    // §8.2 rule 4 and §6.5 rule 5: a mark join names its column and its binder; no other kind does.
    mark_fields(*self, is_mark: bool, mark: Option[string], binder: Option[string])
        if is_mark != mark.is_some() || is_mark != binder.is_some() then
            self.report("Q5009", "a mark join needs a mark column and a binder, and no other join has either")

        self.opt_intro(binder)

    with(*self, recursive: bool, ctes: Buf[CteDef], body: Rel, outer: Buf[string], hidden: Buf[string]) -> Buf[string]
        val depth = self.ctes.len()
        val names = set[string]()

        for c in ctes
            if !names.add(c.name) then self.report("Q2004", s"CTE '${c.name}' is defined twice in one With")

        if recursive
            for c in ctes
                self.ctes.push(c.name)

        for c in ctes
            if recursive && c.columns.is_none() then self.report("Q5001", s"recursive CTE '${c.name}' declares no columns")

            ignore(self.rel(c.rel, outer, hidden))

            if !recursive then self.ctes.push(c.name)

        val exposed = self.rel(body, outer, hidden)
        self.ctes.truncate(depth)
        exposed
    end with

    win_call(*self, w: WinCall, sees: Buf[string], hidden: Buf[string])
        self.exprs(w.args, sees, hidden)
        self.exprs(w.partition, sees, hidden)
        self.sort_keys(w.order, sees, hidden)

        w.frame match
            Some(f) ->
                self.opt_expr(f.start.offset, sees, hidden)
                self.opt_expr(f.end.offset, sees, hidden)
            None -> ()

    sort_keys(*self, keys: Buf[SortKey], sees: Buf[string], hidden: Buf[string])
        for k in keys
            self.expr(k.expr, sees, hidden)

    items(*self, items: Buf[Item], sees: Buf[string], hidden: Buf[string])
        for it in items
            self.expr(it.expr, sees, hidden)

    // -- expressions --------------------------------------------------------------------------

    exprs(*self, es: Buf[Expr], sees: Buf[string], hidden: Buf[string])
        for e in es
            self.expr(e, sees, hidden)

    opt_expr(*self, e: Option[Expr], sees: Buf[string], hidden: Buf[string]) = e match
        Some(x) -> self.expr(x, sees, hidden)
        None -> ()

    opt_boxed(*self, e: Option[&Expr], sees: Buf[string], hidden: Buf[string]) = e match
        Some(x) -> self.expr(*x, sees, hidden)
        None -> ()

    expr(*self, e: Expr, sees: Buf[string], hidden: Buf[string])
        val parent = self.enter()
        self.expr_body(e, sees, hidden)
        self.node = parent

    expr_body(*self, e: Expr, sees: Buf[string], hidden: Buf[string]) -> unit = e match
        Col(binder, _) ->
            self.reads(binder)
            self.refer(binder, sees, hidden)
        Row(binder) ->
            self.reads(binder)
            self.refer(binder, sees, hidden)
        Param(index) ->
            if self.rules != Unrestricted then return self.report("Q6006", "a definition expression holds a parameter")

            self.param(index)
        Null(_) | Literal(_, _) -> ()
        Call(function, args) ->
            if self.rules == Deterministic && is_volatile(function) then
                self.report("Q6006", s"'$function' is volatile, and this definition expression must be deterministic")

            self.exprs(args, sees, hidden)
        Cast(inner, _, _) -> self.expr(*inner, sees, hidden)
        If(arms, otherwise) ->
            for a in arms
                self.expr(a.cond, sees, hidden)
                self.expr(a.value, sees, hidden)

            self.opt_boxed(otherwise, sees, hidden)
        Match(scrutinee, arms, otherwise) ->
            self.expr(*scrutinee, sees, hidden)

            for a in arms
                self.intro(a.binder)
                self.expr(a.expr, with_old(sees.view(), Some(a.binder)), hidden)

            self.opt_boxed(otherwise, sees, hidden)
        Record(fields) ->
            self.unique_names(fields, "Q2005", "record field")
            self.items(fields, sees, hidden)
        Field(inner, _) -> self.expr(*inner, sees, hidden)
        Variant(_, _, inner) -> self.expr(*inner, sees, hidden)
        Relation(rel) -> self.subquery(*rel, sees, hidden)
        Scalar(rel) -> self.subquery(*rel, sees, hidden)
        Exists(rel) -> self.subquery(*rel, sees, hidden)
        In(es, rel) ->
            self.exprs(es, sees, hidden)
            self.subquery(*rel, sees, hidden)
        Action ->
            if self.rules != Unrestricted
                self.report("Q6006", "a definition expression holds Action()")
            else if !self.in_returning
                self.report("Q5002", "Action() is valid only in a returning list")
    end expr_body

    /** A relation inside an expression, which no definition expression may hold (`ddl.md` §2.12
     * rule 2).
     */
    subquery(*self, rel: Rel, sees: Buf[string], hidden: Buf[string])
        if self.rules != Unrestricted then return self.report("Q6006", "a definition expression holds a relation")

        ignore(self.rel(rel, sees, hidden))

    /** A read through `binder`, which a default may not make of the row (`ddl.md` §2.7 rule 1). */
    reads(*self, binder: string)
        if self.rules == AsDefault && binder == DefnRow then self.report("Q6006", "a default reads a column")

    // -- DDL, `ddl.md` §3 ------------------------------------------------------------------------

    /** `e`, a definition expression under `rules`, which sees the row as `row` and nothing else. */
    definition(*self, e: Expr, rules: DefnRules)
        val was = self.rules
        self.rules = rules
        self.expr(e, one(DefnRow), buf[string]())
        self.rules = was

    opt_definition(*self, e: Option[Expr], rules: DefnRules) = e match
        Some(x) -> self.definition(x, rules)
        None -> ()

    /** A name a DDL statement gives or refers to: 1–255 octets (`ddl.md` §1 rule 2). */
    name(*self, n: string)
        if n.len == 0 || n.len > MaxNameOctets then
            self.report("Q6019", s"a name is ${n.len} octets; a name is 1 to $MaxNameOctets")

    names(*self, ns: Buf[string])
        for n in ns
            self.name(n)

    qual_name(*self, q: QualName)
        self.name(q.schema)
        self.name(q.name)

    /** The object a statement creates, changes or drops, which may not be in a reserved namespace
     * (`ddl.md` §1 rule 2).
     */
    target(*self, q: QualName)
        self.qual_name(q)
        self.namespace(q.schema)

    namespace(*self, n: string)
        if n == "sys" || n == "catalog" then self.report("Q6014", s"namespace '$n' is reserved")

    /** A list of columns of one table, which names none twice (`Q5005`) and, unless it may be
     * empty, names at least one (`Q5009`).
     */
    column_list(*self, columns: Buf[string], what: string)
        if columns.len() == 0 then self.report("Q5009", s"$what names no column")

        val seen = set[string]()

        for c in columns
            self.name(c)

            if !seen.add(c) then self.report("Q5005", s"column '$c' is listed twice in $what")

    ddl(*self, s: Statement) = s match
        CreateNamespace(name, _) ->
            self.name(name)
            self.namespace(name)
        DropNamespace(name, _, _) ->
            self.name(name)
            self.namespace(name)
        CreateTable(table, columns, primary_key, constraints, _) ->
            self.target(table)

            val seen = set[string]()

            for c in columns
                if !seen.add(c.name) then self.report("Q6002", s"column '${c.name}' is defined twice")

                self.column_def(c)

            if primary_key.len() == 0 then self.report("Q6009", "a table has no primary key")
            else self.column_list(primary_key, "the primary key")

            val named = set[string]()

            for c in constraints
                if !named.add(c.name) then self.report("Q6002", s"constraint '${c.name}' is defined twice")

                self.constraint_def(c)
        DropTable(table, _, _) | DropIndex(table, _) | DropType(table, _) | DropSequence(table, _) | DropView(table, _, _) ->
            self.target(table)
        AlterTable(table, actions) ->
            self.target(table)

            if actions.len() == 0 then self.report("Q5009", "an alter_table has no action")

            self.alter_actions(actions)
        CreateIndex(name, index, _) ->
            self.name(name)
            self.target(index.table)

            if index.keys.len() == 0 then self.report("Q5009", "an index has no key")

            for k in index.keys
                k.key match
                    KeyColumn(c) -> self.name(c)
                    KeyExpr(e) -> self.definition(e, Deterministic)

            self.opt_definition(index.predicate, Deterministic)
        CreateType(type_name, ty, _) ->
            self.target(type_name)

            ty match
                Record(_) | Union(_) | Named(_, _) -> ()
                _ -> self.report("Q6005", "only a record or a union type may be named")

            if mentions(ty, type_name) then self.report("Q6005", s"type '${type_name.name}' refers to itself")
        AlterType(type_name, change) ->
            self.target(type_name)
            self.type_change(change)
        CreateSequence(sequence, options, _) ->
            self.target(sequence)
            self.sequence(options, false, None)
        AlterSequence(sequence, options, restart) ->
            self.target(sequence)
            self.sequence(options, true, restart)
        CreateView(view, query, _) ->
            self.target(view)

            // `query` is a `node Query` (`ddl.md` §3.2 rule 6), which the encoding counts as a node.
            self.next += 1
            ignore(self.rel(query, buf[string](), buf[string]()))
        CreateRole(name, role) -> self.role(name, role)
        AlterRole(name, role, new_name) ->
            self.role(name, role)

            new_name match
                Some(n) -> self.name(n)
                None -> ()
        DropRole(name, _) -> self.name(name)
        Grant(privileges, target, grantee, _) | Revoke(privileges, target, grantee) ->
            if privileges.len() == 0 then self.report("Q5009", "a grant or revoke names no privilege")

            target match
                OnTable(q) | OnSequence(q) | OnType(q) -> self.qual_name(q)
                OnNamespace(n) -> self.name(n)

            self.name(grantee)
        _ -> ()
    end ddl

    role(*self, name: string, role: RoleDef)
        self.name(name)
        self.names(role.member_of)

    /** A column definition (`ddl.md` §2.7, §3.3 rule 1). */
    column_def(*self, c: ColumnDef)
        self.name(c.name)

        if c.identity != NoIdentity && !is_sequence_type(c.ty) then
            self.report("Q6005", s"identity column '${c.name}' is not int16, int32 or int64")

        self.opt_definition(c.default, AsDefault)
        self.opt_definition(c.generated, Deterministic)

        val given = (if c.default != None then 1 else 0) + (if c.generated != None then 1 else 0) + (if c.identity != NoIdentity then 1 else 0)

        if given > 1 then
            self.report("Q6006", s"column '${c.name}' has more than one of a default, a generation and an identity")

        c.sequence match
            Some(d) ->
                if c.identity == NoIdentity then self.report("Q6006", s"column '${c.name}' has a sequence and no identity")
                if d.ty != c.ty then self.report("Q6017", s"the sequence of column '${c.name}' is not of the column's type")

                self.sequence(d, false, None)
            None -> ()
    end column_def

    constraint_def(*self, c: ConstraintDef)
        self.name(c.name)

        c.body match
            Check(e) -> self.definition(e, Deterministic)
            Unique(columns) -> self.column_list(columns, "a unique constraint")
            ForeignKey(columns, ref_table, ref_columns, _, _, _) ->
                self.column_list(columns, "a foreign key")
                self.qual_name(ref_table)
                self.column_list(ref_columns, "a foreign key's referenced columns")

                if columns.len() != ref_columns.len() then
                    self.report("Q6013", "a foreign key's columns and referenced columns differ in number")

    /** A sequence's options (`ddl.md` §2.7 rule 4). Those of a create are checked with their
     * defaults filled in; those of an alter, which keep the sequence's other options, only against
     * each other.
     */
    sequence(*self, d: SequenceDef, alter: bool, restart: Option[i64])
        val (lowest, highest) = sequence_range(d.ty) match
            Some(r) -> r
            None -> return self.report("Q6005", "a sequence is not int16, int32 or int64")

        for v in [d.start, d.min, d.max, restart]
            v match
                Some(x) -> if x < lowest || x > highest then self.report("Q6017", s"sequence option $x is outside its type")
                None -> ()

        val step = d.increment.unwrap_or(1)

        if step == 0 then self.report("Q6017", "a sequence's increment is 0")
        if d.cache == Some(0) then self.report("Q6017", "a sequence's cache is 0")

        if alter
            (d.min, d.max) match
                (Some(lo), Some(hi)) ->
                    if lo > hi then self.report("Q6017", "a sequence's min is above its max")

                    for v in [d.start, restart]
                        v match
                            Some(x) -> if x < lo || x > hi then self.report("Q6017", "a sequence starts outside its range")
                            None -> ()
                _ -> ()

            return

        val lo = d.min.unwrap_or(if step < 0 then lowest else 1)
        val hi = d.max.unwrap_or(highest)
        val first = d.start.unwrap_or(1)

        if lo > hi then self.report("Q6017", "a sequence's min is above its max")
        if first < lo || first > hi then self.report("Q6017", "a sequence starts outside its range")
    end sequence

    type_change(*self, change: TypeChange) = change match
        AppendVariants(variants) ->
            for v in variants
                self.name(v.name)
        AppendFields(fs) ->
            for f in fs
                self.name(f.name)

                f.fill match
                    Some(Literal(_, _)) -> ()
                    Some(_) -> self.report("Q6006", s"the fill of field '${f.name}' is not a constant literal")
                    None ->
                        if !f.ty.is_nullable() then
                            self.report("Q6006", s"field '${f.name}' is not nullable and has no fill")
        RenameMember(old_name, new_name) ->
            self.name(old_name)
            self.name(new_name)
        RenameType(new_name) -> self.name(new_name)

    /** An `AlterTable`'s actions (`ddl.md` §3.3 rule 3). Every action on a column touches its name,
     * and a name touched twice is `Q6016`; a `rename_column` touches its old name and leaves the new
     * one free for the actions after it.
     */
    alter_actions(*self, actions: Buf[AlterAction])
        val touched = set[string]()

        for a in actions
            val subject = a match
                AddColumn(c) ->
                    self.column_def(c)
                    Some(c.name)
                DropColumn(name, _) | SetNullable(name, _) ->
                    self.name(name)
                    Some(name)
                RenameColumn(name, new_name) ->
                    self.name(name)
                    self.name(new_name)

                    if touched.has(new_name) then self.report("Q6016", s"column '$new_name' is renamed onto a name another action uses")

                    Some(name)
                RetypeColumn(name, _, using) ->
                    self.name(name)
                    self.opt_definition(using, AsDefinition)
                    Some(name)
                SetColumnDefault(name, default) ->
                    self.name(name)
                    self.opt_definition(default, AsDefault)
                    Some(name)
                AddConstraint(c, _) ->
                    self.constraint_def(c)
                    None
                DropConstraint(name, _) | ValidateConstraint(name) | SetOwner(name) ->
                    self.name(name)
                    None
                RenameConstraint(name, new_name) ->
                    self.name(name)
                    self.name(new_name)
                    None
                RenameTable(new_name) ->
                    self.name(new_name)
                    None
                SetPrimaryKey(columns) ->
                    self.column_list(columns, "the primary key")
                    None
                Rewrite -> None

            subject match
                Some(c) -> if !touched.add(c) then self.report("Q6016", s"two actions change column '$c'")
                None -> ()
    end alter_actions
end Checker

// -- binder lists -------------------------------------------------------------------------------

private holds(names: Buf[string], name: string) -> bool
    for n in names
        if n == name then return true

    false

private one(b: string) -> Buf[string]
    val out = buf[string]()
    out.push(b)
    out

/** A new list: `a`, then `b`. */
private both(a: []const string, b: Buf[string]) -> Buf[string]
    val out = buf[string]()
    out.extend(a)
    out.extend(b.view())
    out

/** A new list: `a`, then `extra` when it is present. */
private with_old(a: []const string, extra: Option[string]) -> Buf[string]
    val out = buf[string]()
    out.extend(a)

    extra match
        Some(x) -> out.push(x)
        None -> ()

    out

private[terndb] ignore[T](value: T) = ()

// -- DDL ----------------------------------------------------------------------------------------

/** Which rules of `ddl.md` §2.12 an expression is held to. */
private enum DefnRules
    /** A query's or a DML statement's own expression: none. */
    Unrestricted
    /** A default: rule 2, and it reads no column (§2.7 rule 1). */
    AsDefault
    /** A check, a generated column, an index component or predicate: rule 2, and deterministic. */
    Deterministic
    /** Any other definition expression, a retype's `using`: rule 2. */
    AsDefinition

/** The binder through which a definition expression sees the row (`ddl.md` §2.12 rule 1). */
private const DefnRow = "row"

/** The longest name, in octets (`ddl.md` §1 rule 2). */
private const MaxNameOctets: usize = 255

/** Whether the function catalog marks `function` volatile (`query-tree.md` §7.12). */
private is_volatile(function: string) -> bool = function == "statement_timestamp" || function == "next_value"

/** The types a sequence, and so an identity column, may have (`ddl.md` §2.7 rules 3 and 4). */
private is_sequence_type(t: Type) -> bool = sequence_range(t) != None

/** The smallest and largest value of a sequence of type `t`, if it may be one. */
private sequence_range(t: Type) -> Option[(i64, i64)] = t match
    Int16 -> Some((-32768, 32767))
    Int32 -> Some((-2147483648, 2147483647))
    Int64 -> Some((i64::Min, i64::Max))
    _ -> None

/** Whether `t` refers to the named type `q` anywhere inside it. */
private mentions(t: Type, q: QualName) -> bool = t match
    Named(schema, name) -> schema == q.schema && name == q.name
    Nullable(inner) | Bag(inner) | List(inner) -> mentions(*inner, q)
    Record(members) | Union(members) ->
        for m in members
            if mentions(m.ty, q) then return true

        false
    _ -> false
