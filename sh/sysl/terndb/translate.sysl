module sh.sysl.terndb

import sysl.buf.{Buf, buf}

// Reading a row of an older schema version (`ddl.md` §5.3): a column's stored value converted
// through every retype between the row's version and the reader's, in order. Each step is one of
// the lossless conversions of §5.3 rule 3, and a scalar step is the `Cast` of `query-tree.md` §7.6,
// which a lossless conversion never makes round or fail: an integer widening or becoming a float or a
// `decimal(p, 0)`, a `decimal` gaining scale or integer digits, `float32` becoming `float64`, `json`
// becoming its canonical text, and `T` becoming `T?`. A record, union or relation converts member by
// member, matched by position: a record value older than its type lacks the fields appended since,
// and reads each one's fill (§2.8 rule 5), or null. Translation cannot fail on a value of its
// version's type, so a value that does not convert is `data_corrupted` (`D1001`, §5.3 rule 1).
//
// A named type is a reference resolved in the reader's catalog, so a column declared with one has its
// current structure in every version; what changed is the value's shape, which is what the record
// rule reads.
//
// A version that completes a column's conversion (`ddl.md` §8.5 rule 2, `SchemaVersion.completes`)
// is the one step that is not a cast: the column's value there is the conversion its retype recorded
// (`using`, or the strict cast of the column when none was given), evaluated over the row as the
// version before it holds it, as a definition expression (§2.12) is. Its job proved, before the
// version was committed, that it succeeds on every row a snapshot after it can see, and an unaware
// writer's rows are proved at its commit (§6.4 rule 2), so here too a failure is `D1001` to a reader;
// the job and reconciliation take the conversion's own error instead.

private corrupt[T]() -> Result[T, CodecError] = fail("D1001", "a stored value does not convert to its column's type")

/** Each of `rows`, rows of table `t` encoded in their own schema versions, as a record of the
 * columns of `t`'s current version (`ddl.md` §5.3), `c` resolving named types: each column matched
 * by id, one added since reading its fill (a literal, else null), one dropped since skipped, and one
 * present carried through every version between in order, by the lossless conversion where its type
 * changed and by its recorded conversion where a version completes one. A row already in the current
 * version is answered as it is. A recorded conversion that fails answers its own error.
 */
private[terndb] translated_rows(c: MemCatalog, t: CatTable, rows: Buf[StoredRow]) -> Result[Buf[Value], CodecError]
    val out = buf[Value]()
    val now = t.schema_version()
    val schemas = buf[u64]()

    for r in rows
        out.push(r.value)
        var seen = r.schema == now

        for s in schemas
            if s == r.schema then seen = true

        if !seen then schemas.push(r.schema)

    for s in schemas
        val at = buf[usize]()
        val values = buf[Value]()

        for i in 0..<rows.len()
            if rows[i].schema == s
                at.push(i)
                values.push(rows[i].value)

        val done = translated_group(c, t, s, values)?

        for k in 0..<at.len()
            out[at[k]] = done[k]

    Ok(out)
end translated_rows

/** `values`, rows of table `t` all encoded in schema version `schema`, carried version by version to
 * `t`'s current one (`translated_rows`).
 */
private translated_group(c: MemCatalog, t: CatTable, schema: u64, values: Buf[Value]) -> Result[Buf[Value], CodecError]
    var p = t.versions.len()

    for i in 0..<t.versions.len()
        if t.versions[i].number == schema then p = i

    if p == t.versions.len() then return fail("D1001", "the row is not encoded in a schema version of its table")
    val first = t.versions[p].columns
    var cols = first
    var rows = values

    for q in (p + 1)..<t.versions.len()
        val next = t.versions[q]
        val (ids, computed) = recorded_conversions(c, cols, next, rows)?
        val stepped = buf[Value]()

        for n in 0..<rows.len()
            val fields = rows[n] match
                Record(fs) -> fs
                _ -> return fail("D1001", "a stored row is not a record")

            val out = buf[Value]()

            for col in next.columns
                var v = fill_value(col.fill)

                for j in 0..<cols.len()
                    if cols[j].id == col.id && j < fields.len()
                        v = fields[j]
                        var recorded = false

                        for k in 0..<ids.len()
                            if ids[k] == col.id
                                v = computed[k][n]
                                recorded = true

                        if !recorded && cols[j].ty != col.ty then v = converted_value(c, v, cols[j].ty, col.ty)?

                out.push(v)

            stepped.push(Record(out))

        rows = stepped
        cols = next.columns

    // A value of a named type takes the type's current shape, for each column the row itself held.
    val out = buf[Value]()

    for row in rows
        val fields = row match
            Record(fs) -> fs
            _ -> return fail("D1001", "a stored row is not a record")

        val shaped = buf[Value]()

        for j in 0..<cols.len()
            var v = if j < fields.len() then fields[j] else Null
            var held = false

            for f in first
                if f.id == cols[j].id then held = true

            if held && reaches_named(cols[j].ty) then v = converted_value(c, v, cols[j].ty, cols[j].ty)?
            shaped.push(v)

        out.push(Record(shaped))

    Ok(out)
end translated_group

/** The columns version `next` completes the conversion of, by id, each with its value in every one
 * of `rows` (rows of the version whose columns are `cols`): the conversion `cols` records for it,
 * evaluated over the rows and coerced to the column's type in `next`.
 */
private recorded_conversions(c: MemCatalog, cols: Buf[CatColumn], next: SchemaVersion, rows: Buf[Value]) -> Result[(Buf[u32], Buf[Buf[Value]]), CodecError]
    val ids = buf[u32]()
    val exprs = buf[Expr]()
    val types = buf[Type]()

    for id in next.completes
        for col in cols
            if col.id == id
                col.using match
                    Some(u) ->
                        for to in next.columns
                            if to.id == id
                                ids.push(id)
                                exprs.push(u)
                                types.push(to.ty)
                    None -> ()

    val computed = buf[Buf[Value]]()

    if exprs.len() == 0 || rows.len() == 0
        for _ in exprs
            computed.push(buf[Value]())

        return Ok((ids, computed))

    val fs = buf[Field]()

    for col in cols
        fs.push(Field(col.name, resolve_type(c, col.ty)?))

    val vs = def_vectors(c, record(fs.view()), rows, exprs)?

    for k in 0..<vs.len()
        computed.push(values_of(coerce_vector(vs[k], resolve_type(c, types[k])?)?))

    Ok((ids, computed))
end recorded_conversions

/** The value a row of an older version reads for a column added since: its fill. */
private fill_value(fill: Option[Expr]) -> Value = fill match
    Some(Literal(_, v)) -> v
    _ -> Null

/** `v`, a value of `from`, as a value of `to`, where `from` converts to `to` losslessly (`ddl.md` §5.3
 * rule 3). A null stays null; `D1001` where `v` does not convert.
 */
private[terndb] converted_value(c: MemCatalog, v: Value, from: Type, to: Type) -> Result[Value, CodecError]
    if v.is_null() then return Ok(v)

    val (f, _) = structure(c, from)?
    val (u, fills) = structure(c, to)?

    (f, u) match
        (Record(ff), Record(tf)) ->
            val xs = v match
                Record(x) -> x
                _ -> return corrupt()

            if xs.len() > tf.len() then return corrupt()
            val out = buf[Value]()

            for j in 0..<tf.len()
                if j < xs.len()
                    out.push(converted_value(c, xs[j], if j < ff.len() then ff[j].ty else tf[j].ty, tf[j].ty)?)
                else
                    out.push(if j < fills.len() then fills[j] else Null)

            return Ok(Record(out))
        (Union(fv), Union(tv)) ->
            return v match
                Variant(tag, p) ->
                    if tag >= tv.len() then return corrupt()
                    Ok(variant(tag, converted_value(c, *p, if tag < fv.len() then fv[tag].ty else tv[tag].ty, tv[tag].ty)?))
                _ -> corrupt()
        (Bag(fe), Bag(te)) | (List(fe), List(te)) | (List(fe), Bag(te)) ->
            val xs = v match
                Relation(x) -> x
                _ -> return corrupt()
            val out = buf[Value]()

            for x in xs
                out.push(converted_value(c, x, *fe, *te)?)

            return Ok(Relation(out))
        _ -> ()

    if !holds(f, v) then return corrupt()
    if f == u then return Ok(v)

    // A `json` value is held in its canonical form, which is its text (`query-tree.md` §3.5).
    if f == Json
        val s = v match
            Text(x) -> x
            _ -> return corrupt()

        if canonical_json(s) != Some(s) then return corrupt()

    cast_value(v, f, u) match
        Ok(x) -> Ok(x)
        Err(_) -> corrupt()
end converted_value

/** `t` with its nullability and named references stripped, down to its structure, and the fills of
 * the named record it names, if it names one.
 */
private structure(c: MemCatalog, t: Type) -> Result[(Type, Buf[Value]), CodecError]
    var u = t
    var fills = buf[Value]()

    loop
        u match
            Nullable(inner) -> u = *inner
            Named(schema, name) ->
                val i = c.type_at(QualName(schema, name)) match
                    Some(i) -> i
                    None -> return corrupt()

                fills = c.types[i].fills
                u = c.types[i].ty
            _ -> return Ok((u, fills))

/** Whether `t` refers to a named type anywhere in it. */
private reaches_named(t: Type) -> bool
    t match
        Named(_, _) -> return true
        Nullable(e) | Bag(e) | List(e) -> return reaches_named(*e)
        Record(ms) | Union(ms) ->
            for m in ms
                if reaches_named(m.ty) then return true
        _ -> ()

    false

/** Whether `v` is held the way a non-null scalar of `t` is (`value.sysl`). */
private holds(t: Type, v: Value) -> bool = (t, v) match
    (Bool, Bool(_)) -> true
    (Int8 | Int16 | Int32 | Int64 | Int128 | Decimal(_, _) | Date | Time | DateTime | Timestamp, Int(_)) -> true
    (UInt8 | UInt16 | UInt32 | UInt64, UInt(_)) -> true
    (Float32 | Float64, Float(_)) -> true
    (Text | Json, Text(_)) -> true
    (Bytes, Bytes(_)) -> true
    (Interval, Interval(_, _, _)) -> true
    (Uuid, Uuid(_)) -> true
    _ -> false
