module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.slices.contains

// `Scan` over the in-memory store (`query-tree.md` §6.1, `docs/design/executor.md` §4.5): a table's
// rows visible at the transaction's snapshot, and the read recorded in a serializable transaction's
// predicate log (`isolation.md` §4.3, §4.4) with the columns the statement uses of it.

/** The store a statement runs against, its transaction, and what the statement reads of each table
 * it scans (§4.3's `C`): every column named through a binder, and the binders whose rows reach a
 * result, an operator comparing whole rows or a subquery whole, which read every column.
 */
struct Db
    store: &Store
    txn: &Txn
    refs: TreeRefs
    whole: Buf[string]

/** What a statement reads: built from its relations and expressions before it is planned. */
private[terndb] struct Uses
    refs: TreeRefs
    whole: Buf[string]

    /** `r`, whose rows reach their consumer whole when `whole` holds. */
    add_rel(*self, r: Rel, whole: bool)
        val rr = rel_refs(r)
        val reached = buf[string]()
        flow(r, whole, reached, self.whole)

        // A scan the flow did not reach is inside a subquery expression, whose rows are read whole.
        for sc in rr.scans
            if count_of(rr.scans, sc.binder) > count_in(reached, sc.binder) then self.whole.push(sc.binder)

        self.merge(rr)

    add_expr(*self, e: Expr)
        val rr = expr_refs(e)

        for sc in rr.scans
            self.whole.push(sc.binder)

        self.merge(rr)

    add_items(*self, items: Buf[Item])
        for it in items
            self.add_expr(it.expr)

    merge(*self, rr: TreeRefs)
        self.refs.scans.extend(rr.scans.view())
        self.refs.cols.extend(rr.cols.view())
        self.refs.rows.extend(rr.rows.view())
        self.refs.sequences.extend(rr.sequences.view())

    db(self, s: &Store, t: &Txn) -> Db = Db(s, t, self.refs, self.whole)
end Uses

private[terndb] no_uses() -> Uses =
    Uses(TreeRefs(buf[ScanRef](), buf[ColRef](), buf[string](), buf[QualName](), buf[QualName](), false), buf[string]())

private count_of(scans: Buf[ScanRef], b: string) -> usize
    var n: usize = 0

    for s in scans
        if s.binder == b then n += 1

    n

private count_in(names: Buf[string], b: string) -> usize
    var n: usize = 0

    for x in names
        if x == b then n += 1

    n

// The scans of `r` reached through its relational structure, into `reached`, and those whose rows
// reach their consumer whole, into `out`. A `Project`, `Aggregate` or `Nest` reads only the columns
// its expressions name; `Distinct`, `SetOp` and `Tag` read every column; the rest pass their input on.
private flow(r: Rel, whole: bool, reached: Buf[string], out: Buf[string])
    r match
        Scan(_, b) ->
            reached.push(b)
            if whole then out.push(b)
        Values(_, _, _) | ParamScan(_, _) | CteRef(_, _) -> ()
        Filter(i, _) | Sort(i, _) | Limit(i, _, _, _, _) | Unnest(i, _, _, _, _) | Window(i, _, _) -> flow(*i, whole, reached, out)
        Project(i, _, _) | Aggregate(i, _, _, _) | Nest(i, _, _, _, _, _) -> flow(*i, false, reached, out)
        Distinct(i) | Tag(i, _, _, _) -> flow(*i, true, reached, out)
        Join(_, l, x, _, _, _) | Apply(_, l, x, _, _, _) ->
            flow(*l, whole, reached, out)
            flow(*x, whole, reached, out)
        SetOp(_, _, _, inputs) ->
            for x in inputs
                flow(x, true, reached, out)
        With(_, ctes, body) ->
            for c in ctes
                flow(c.rel, true, reached, out)

            flow(*body, whole, reached, out)

/** Whether `x` holds a subquery expression anywhere. */
private[terndb] has_subquery(x: TExpr) -> bool
    if x.sub.is_some() then return true

    for k in x.kids
        if has_subquery(k) then return true

    false

/** The predicate a read of `ct` through `binders` logs (§4.4): `filter` (every row when absent), and
 * the columns the statement reads through those binders, or every column when it reads them whole.
 */
private[terndb] read_pred(d: Db, ct: CatTable, binders: Buf[string], elem: Type, filter: Option[TExpr], ctx: Ctx) -> Pred
    val version = ct.schema_version()
    val binder = binders[0]

    val matches: &Fn(StoredRow) -> bool = filter match
        Some(p) -> r -> row_passes(p, binder, elem, version, ctx, r)
        None -> r -> true

    for b in binders
        if contains(d.whole.view(), b) then return pred_all(matches)

    val ids = buf[u32]()

    for c in ct.columns
        if d.refs.reads_column(binders, c.name) then ids.push(c.id)

    pred(ids.view(), matches)

// Whether the image `r` passes the filter `p`: the membership predicate a validation evaluates on
// another transaction's write images. An image of another schema version, or a filter that fails on
// it, counts as passing, which only widens the predicate (§4.4).
private row_passes(p: TExpr, binder: string, elem: Type, version: u64, ctx: Ctx, r: StoredRow) -> bool
    if r.schema != version then return true

    eval(p, env_of(ctx, binder, vector_of(elem, [r.value]))) match
        Ok(v) -> v.lanes match
            Bools(x) -> x[0] && v.is_valid(0)
            _ -> true
        Err(_) -> true

/** The operator reading `table` under `binder` from `d`'s store at its transaction's snapshot, its
 * read logged with `filter` as its predicate. A view reads its stored query in its place
 * (`exec_view.sysl`), whose scans log their own reads.
 */
private[terndb] scan_op(d: Db, table: QualName, binder: string, elem: Type, filter: Option[TExpr], ctx: Ctx) -> &Operator
    val i = d.store.catalog.table_at(table) match
        Some(i) -> i
        None -> return view_op(d, table, elem, ctx)

    val ct = d.store.catalog.tables[i]
    ScanOp(d.store, d.txn, ct.oid, elem, read_pred(d, ct, items_of([binder]), elem, filter, ctx), buf[ColumnVector](), false, 0)

/** A table's rows visible to `txn`, read from the store on the first pull, all at once and in key
 * order, and handed up in batches of `BatchSize`.
 */
struct ScanOp
    store: &Store
    txn: &Txn
    oid: u64
    elem: Type
    logged: Pred
    batches: Buf[ColumnVector]
    read: bool
    at: usize

impl Operator for ScanOp
    next_batch(*self) -> Result[Option[ColumnVector], CodecError]
        if !self.read
            self.read = true
            val hits = self.store.scan_rows(self.txn, self.oid, self.logged)?
            val rows = buf[Value]()

            for h in hits
                rows.push(h.row.value)

            self.batches = batches_of(vector_of(self.elem, rows.view()))

        while self.at < self.batches.len()
            val b = self.batches[self.at]
            self.at += 1

            if b.len > 0 then return Ok(Some(b))

        Ok(None)
end ScanOp
