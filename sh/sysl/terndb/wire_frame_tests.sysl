module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// The preface, the frame header and the type registry (`wire-protocol.md` §1.2, §1.3, §3.2), and the
// fragmenter (§1.4).

/** The code `r` was refused with, or "ok". */
code_of[T](r: Result[T, CodecError]) -> string = r match
    Ok(_) -> "ok"
    Err(e) -> e.code

@test
the_preface_is_terndb_crlf()
    val out = buf[u8]()
    push_preface(out)

    same_bytes(out, hex("54 45 52 4E 44 42 0D 0A"), "§1.2 preface")
    assert_eq(code_of(check_preface(out.view())), "ok")

@test
a_wrong_or_short_preface_is_refused()
    assert_eq(code_of(check_preface(hex("47 45 54 20 2F 20 48 54").view())), "W1001")
    assert_eq(code_of(check_preface(hex("54 45 52 4E 44 42 0D").view())), "W1001")
    assert_eq(code_of(check_preface(hex("54 45 52 4E 44 42 0D 0A 00").view())), "W1001")

@test
a_header_is_laid_out_as_section_1_3_says()
    val out = buf[u8]()
    push_header(out, FrameHeader(0x0102_0304, 0x11, true, 0x0807_0605_0403_0201))

    same_bytes(out, hex("04 03 02 01  11  01  00 00  01 02 03 04 05 06 07 08"), "§1.3 header")
    assert(parse_header(out.view()).unwrap() == FrameHeader(0x0102_0304, 0x11, true, 0x0807_0605_0403_0201), "it parses back")

@test
a_truncated_header_is_refused()
    val whole = hex("08 00 00 00 04 00 00 00 00 00 00 00 00 00 00 00")

    for n in 0..<16
        assert_eq(code_of(parse_header(whole.view()[0..<n])), "W1001")

    assert_eq(code_of(parse_header(whole.view())), "ok")

@test
every_flag_bit_but_more_is_refused()
    for bit in 1..<8
        val h = hex("08 00 00 00 04 00 00 00 00 00 00 00 00 00 00 00")
        h[5] = u8(1) << bit
        assert_eq(code_of(parse_header(h.view())), "W1001")

@test
a_non_zero_reserved_field_is_refused()
    for at in 6..<8
        val h = hex("08 00 00 00 04 00 00 00 00 00 00 00 00 00 00 00")
        h[at] = 0x80
        assert_eq(code_of(parse_header(h.view())), "W1001")

@test
every_type_octet_is_known_or_refused()
    var known = 0

    for t in 0..<256
        val ty = u8(t)
        val toward = direction_of(ty)

        if type_info(ty, 0).is_some()
            known += 1
            assert_eq(code_of(check_type(ty, toward, 0)), "ok")
            assert_eq(code_of(check_type(ty, if toward == ToServer then ToClient else ToServer, 0)), "W1001")
        else
            assert_eq(code_of(check_type(ty, toward, 0)), "W1001")

    // §3.2 lists 31 types.
    assert_eq(known, 31)

@test
the_replication_types_exist_from_wire_1_1()
    for ty in [u8(0x60), 0x61, 0x62, 0x63, 0x64, 0x65, 0xe0, 0xe1, 0xe2, 0xe3, 0xe4, 0xe5, 0xe6, 0xe7, 0xe8]
        assert_eq(code_of(check_type(ty, direction_of(ty), 0)), "W1001")
        assert_eq(code_of(check_type(ty, direction_of(ty), 1)), "ok")

    for ty in [u8(0x66), 0x6f, 0xe9, 0xef, 0x40, 0x4f, 0xd0, 0xdf]
        assert_eq(code_of(check_type(ty, direction_of(ty), 1)), "W1001")

@test
an_empty_message_is_one_empty_frame()
    same_bytes(fragment(0x03, 0, [], 4), hex("00 00 00 00 03 00 00 00 00 00 00 00 00 00 00 00"), "Terminate")

@test
the_fragmenter_fills_every_frame_but_the_last()
    val payload = hex("01 02 03 04 05 06 07 08 09 0A")
    val frames = fragment(0x11, 3, payload.view(), 4)

    same_bytes(frames, hex("""
        04 00 00 00 11 01 00 00 03 00 00 00 00 00 00 00  01 02 03 04
        04 00 00 00 11 01 00 00 03 00 00 00 00 00 00 00  05 06 07 08
        02 00 00 00 11 00 00 00 03 00 00 00 00 00 00 00  09 0A
        """), "three frames, MORE on two")

    // A payload that is a whole multiple of the frame size ends with a full frame, not an empty one.
    assert_eq(fragment(0x11, 3, payload.view()[0..<8], 4).len(), 2 * 16 + 8)
