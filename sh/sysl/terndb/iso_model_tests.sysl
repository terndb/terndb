module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// The isolation model's rules, one test each, against `isolation.md` §4.1–§4.5 and §5: snapshots
// and the horizon, read committed's statement snapshots, reading one's own writes, first-updater-wins
// against committed and live writers with the waiter resuming, deadlock, the insert rules, the
// predicate log and validation through point, range, predicate and nested reads, read-only and
// empty transactions, and every abort code. Transactions interleave in the order the test calls
// them. The lock-step runs against the store are `iso_lockstep_tests.sysl`.

// -- fixtures --------------------------------------------------------------------------------------

/** `regs(k, v)`, `grp(k, g, v)` and `lists(k, items)`. */
private const R: u64 = 1
private const G: u64 = 2
private const L: u64 = 3

private im_reg(k: i64, v: i64) -> Buf[MoVal] = mo_row([MoInt(k), MoInt(v)])

private im_grp(k: i64, g: i64, v: i64) -> Buf[MoVal] = mo_row([MoInt(k), MoInt(g), MoInt(v)])

/** A model committed at `c = 1` with registers 1 = 10 and 2 = 20, group rows 11 (g 1) and 12 (g 2),
 * and an empty list row 21.
 */
private im_model() -> &IsoModel
    val m = iso_model()
    val t = m.begin(Serializable)
    im_rows(m.insert(t, R, im_reg(1, 10)))
    im_rows(m.insert(t, R, im_reg(2, 20)))
    im_rows(m.insert(t, G, im_grp(11, 1, 0)))
    im_rows(m.insert(t, G, im_grp(12, 2, 0)))
    im_rows(m.insert(t, L, mo_row([MoInt(21), MoList(buf())])))
    assert_eq(im_commit(m, t), 1)
    m

/** The rows a write statement changed, which must have run. */
private im_rows(r: Result[MoDone, string], file: string = __FILE__, line: long = __LINE__) -> usize = r match
    Ok(MoRows(n)) -> n
    Ok(MoWait(h)) ->
        assert(false, s"the statement waits for $h", file, line)
        0
    Err(code) ->
        assert(false, s"the statement fails with $code", file, line)
        0

/** The transaction a write statement waits for, which it must. */
private im_waits(r: Result[MoDone, string], file: string = __FILE__, line: long = __LINE__) -> u64 = r match
    Ok(MoWait(h)) -> h
    Ok(MoRows(_)) ->
        assert(false, "the statement ran instead of waiting", file, line)
        0
    Err(code) ->
        assert(false, s"the statement fails with $code", file, line)
        0

/** "ok", or the code an operation failed with. */
private im_code[T](r: Result[T, string]) -> string = r match
    Ok(_) -> "ok"
    Err(code) -> code

private im_commit(m: &IsoModel, t: u64, file: string = __FILE__, line: long = __LINE__) -> u64 = m.commit(t) match
    Ok(c) -> c
    Err(code) ->
        assert(false, s"the commit fails with $code", file, line)
        0

/** Register `k` as `t` reads it: -1 for no row. */
private im_read(m: &IsoModel, t: u64, k: i64, file: string = __FILE__, line: long = __LINE__) -> i64 = m.get(t, R, k) match
    Ok(Some(img)) -> mo_int(img, 1)
    Ok(None) -> -1
    Err(code) ->
        assert(false, s"the read fails with $code", file, line)
        0

private im_set(m: &IsoModel, t: u64, k: i64, v: i64) -> Result[MoDone, string] = m.update(t, R, MoKey(k), MoSet(1, v))

private im_add(m: &IsoModel, t: u64, k: i64, d: i64) -> Result[MoDone, string] = m.update(t, R, MoKey(k), MoAdd(1, d))

/** The keys a scan of `table` by `f` returns to `t`, which must succeed. */
private im_keys(m: &IsoModel, t: u64, table: u64, f: MoFilter, cols: Buf[usize], file: string = __FILE__, line: long = __LINE__) -> Buf[i64]
    val out = buf[i64]()
    m.scan(t, table, f, cols) match
        Ok(hits) ->
            for h in hits
                out.push(h.key)
        Err(code) -> assert(false, s"the scan fails with $code", file, line)
    out

private im_levels() -> Buf[Isolation] = items_of([Serializable, Snapshot, ReadCommitted])

// -- §4.1 snapshots and the visible horizon ----------------------------------------------------------

@test
a_snapshot_is_the_horizon_at_begin_and_keeps_it_at_snapshot_and_serializable()
    for level in items_of([Serializable, Snapshot])
        val m = im_model()
        val t = m.begin(level)
        assert_eq(m.snapshot_of(t), 1)
        val w = m.begin(Snapshot)
        im_rows(im_set(m, w, 1, 11))
        assert_eq(im_commit(m, w), 2)
        assert_eq(m.horizon, 2)
        assert_eq(im_read(m, t, 1), 10)
        assert_eq(m.snapshot_of(t), 1)
        val later = m.begin(level)
        assert_eq(m.snapshot_of(later), 2)
        assert_eq(im_read(m, later, 1), 11)

@test
read_committed_takes_a_new_snapshot_at_every_statement()
    val m = im_model()
    val t = m.begin(ReadCommitted)
    assert_eq(im_read(m, t, 1), 10)
    assert_eq(m.snapshot_of(t), 1)
    val w = m.begin(Serializable)
    im_rows(im_set(m, w, 1, 11))
    assert_eq(im_read(m, t, 1), 10)
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_read(m, t, 1), 11)
    assert_eq(m.snapshot_of(t), 2)

@test
commit_numbers_are_assigned_in_order_and_each_commit_is_published_before_it_answers()
    val m = im_model()
    val a = m.begin(Serializable)
    val b = m.begin(Snapshot)
    im_rows(im_set(m, a, 1, 11))
    im_rows(im_set(m, b, 2, 21))
    assert_eq(im_commit(m, b), 2)
    assert_eq(m.horizon, 2)
    assert_eq(im_commit(m, a), 3)
    assert_eq(m.horizon, 3)
    val r = m.begin(Snapshot)
    assert_eq(im_read(m, r, 1), 11)
    assert_eq(im_read(m, r, 2), 21)

@test
a_transaction_reads_its_own_writes_and_no_one_else_does_until_it_commits()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        im_rows(im_set(m, t, 1, 11))
        assert_eq(im_read(m, t, 1), 11)
        im_rows(im_add(m, t, 1, 5))
        assert_eq(im_read(m, t, 1), 16)
        im_rows(m.insert(t, R, im_reg(3, 30)))
        assert_eq(im_read(m, t, 3), 30)
        val o = m.begin(ReadCommitted)
        assert_eq(im_read(m, o, 1), 10)
        assert_eq(im_read(m, o, 3), -1)
        val c = im_commit(m, t)
        assert_eq(im_read(m, o, 1), 16)
        assert_eq(im_read(m, o, 3), 30)
        assert_eq(c, 2)

@test
an_aborted_transactions_writes_are_never_visible()
    val m = im_model()
    val t = m.begin(Serializable)
    im_rows(im_set(m, t, 1, 11))
    im_rows(m.insert(t, R, im_reg(3, 30)))
    assert_eq(im_code(m.abort(t)), "ok")
    val r = m.begin(ReadCommitted)
    assert_eq(im_read(m, r, 1), 10)
    assert_eq(im_read(m, r, 3), -1)
    assert_eq(m.horizon, 1)
    // The row is free: a later writer neither waits nor fails.
    val w = m.begin(Snapshot)
    im_rows(im_set(m, w, 1, 12))
    assert_eq(im_commit(m, w), 2)

// -- §5.5 empty and read-only transactions ------------------------------------------------------------

@test
an_empty_transaction_commits_at_its_snapshot_and_publishes_nothing()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        assert_eq(im_commit(m, t), 1)
        assert_eq(m.horizon, 1)
        assert_eq(m.state_of(t), MoCommitted(1))

@test
a_read_committed_reader_commits_at_its_last_statements_snapshot()
    val m = im_model()
    val t = m.begin(ReadCommitted)
    assert_eq(im_read(m, t, 1), 10)
    val w = m.begin(Snapshot)
    im_rows(im_set(m, w, 1, 11))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_read(m, t, 1), 11)
    assert_eq(im_commit(m, t), 2)

@test
a_transaction_with_no_writes_never_fails_validation()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_read(m, t, 1), 10)
    assert_eq(im_keys(m, t, G, MoAll, buf()).len(), 2)
    val w = m.begin(Serializable)
    im_rows(im_set(m, w, 1, 11))
    im_rows(m.insert(w, G, im_grp(13, 1, 0)))
    assert_eq(im_commit(m, w), 2)
    // Serialized at its snapshot, before `w` (§5.5).
    assert_eq(im_commit(m, t), 1)

@test
a_declared_read_only_transaction_keeps_no_log_refuses_writes_and_commits_at_its_snapshot()
    val m = im_model()
    val t = m.begin(Serializable, true)
    assert_eq(im_read(m, t, 1), 10)
    assert_eq(im_keys(m, t, G, MoEq(1, 1), mo_cols([1])).len(), 1)
    assert_eq(m.logged(t), 0)
    val w = m.begin(Serializable)
    im_rows(im_set(m, w, 1, 11))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_commit(m, t), 1)

    for level in im_levels()
        val u = m.begin(level, true)
        assert_eq(im_code(im_set(m, u, 1, 12)), "T4001")
        assert_eq(m.state_of(u), MoAborted("T4001"))
        val v = m.begin(level, true)
        assert_eq(im_code(m.insert(v, R, im_reg(9, 90))), "T4001")
        assert_eq(im_code(m.commit(v)), "T4001")

@test
only_a_serializable_writer_logs_its_reads()
    val m = im_model()
    val ser = m.begin(Serializable)
    val si = m.begin(Snapshot)
    val rc = m.begin(ReadCommitted)
    for t in items_of([ser, si, rc])
        val _ = im_read(m, t, 1)
        val _ = im_keys(m, t, G, MoEq(1, 1), mo_cols([1]))
    assert_eq(m.logged(ser), 2)
    assert_eq(m.logged(si), 0)
    assert_eq(m.logged(rc), 0)
    im_rows(im_add(m, ser, 2, 1))
    assert_eq(m.logged(ser), 3)

// -- §4.2 first-updater-wins ---------------------------------------------------------------------------

@test
a_write_over_a_commit_after_the_snapshot_aborts_at_snapshot_and_serializable()
    for level in items_of([Serializable, Snapshot])
        val m = im_model()
        val t = m.begin(level)
        val w = m.begin(ReadCommitted)
        im_rows(im_set(m, w, 1, 11))
        assert_eq(im_commit(m, w), 2)
        assert_eq(im_code(im_add(m, t, 1, 1)), "T1001")
        assert_eq(m.state_of(t), MoAborted("T1001"))
        assert_eq(im_code(m.commit(t)), "T1001")
        // A delete is a write too.
        val d = m.begin(level)
        val w2 = m.begin(Snapshot)
        im_rows(im_set(m, w2, 2, 21))
        assert_eq(im_commit(m, w2), 3)
        assert_eq(im_code(m.update(d, R, MoKey(2), MoRemove)), "T1001")

@test
a_read_committed_update_applies_to_the_newest_commit_and_loses_no_update()
    val m = im_model()
    val t = m.begin(ReadCommitted)
    assert_eq(im_read(m, t, 1), 10)
    val w = m.begin(Snapshot)
    im_rows(im_add(m, w, 1, 5))
    assert_eq(im_commit(m, w), 2)
    im_rows(im_add(m, t, 1, 1))
    assert_eq(im_read(m, t, 1), 16)
    assert_eq(im_commit(m, t), 3)

@test
a_writer_waits_for_a_live_writer_and_resumes_after_it_aborts()
    for level in im_levels()
        val m = im_model()
        val h = m.begin(Serializable)
        im_rows(im_set(m, h, 1, 11))
        val t = m.begin(level)
        assert_eq(im_waits(im_add(m, t, 1, 1)), h)
        assert_eq(m.waiting(t), h)
        assert_eq(im_read(m, t, 1), 10)
        assert_eq(im_code(m.abort(h)), "ok")
        im_rows(im_add(m, t, 1, 1))
        assert_eq(m.waiting(t), 0)
        assert_eq(im_read(m, t, 1), 11)
        assert_eq(im_commit(m, t), 2)

@test
a_writer_waits_for_a_live_writer_and_after_it_commits_aborts_or_applies_by_level()
    for level in im_levels()
        val m = im_model()
        val h = m.begin(Snapshot)
        im_rows(im_set(m, h, 1, 11))
        val t = m.begin(level)
        assert_eq(im_waits(im_set(m, t, 1, 12)), h)
        assert_eq(im_commit(m, h), 2)
        if level == ReadCommitted
            im_rows(im_add(m, t, 1, 1))
            assert_eq(im_read(m, t, 1), 12)
            assert_eq(im_commit(m, t), 3)
        else
            // The holder committed after the waiter's snapshot (rule 2).
            assert_eq(im_code(im_set(m, t, 1, 12)), "T1001")

@test
a_wait_that_would_close_a_cycle_aborts_the_waiter_with_deadlock_detected()
    for level in im_levels()
        val m = im_model()
        val a = m.begin(level)
        val b = m.begin(Serializable)
        im_rows(im_set(m, a, 1, 11))
        im_rows(im_set(m, b, 2, 21))
        assert_eq(im_waits(im_set(m, a, 2, 22)), b)
        assert_eq(im_code(im_set(m, b, 1, 12)), "T1002")
        assert_eq(m.state_of(b), MoAborted("T1002"))
        // The victim's locks are gone; the transaction already waiting goes on.
        im_rows(im_set(m, a, 2, 22))
        assert_eq(im_commit(m, a), 2)

@test
a_three_way_deadlock_aborts_only_the_transaction_that_closes_it()
    val m = im_model()
    val a = m.begin(Snapshot)
    val b = m.begin(Snapshot)
    val c = m.begin(Snapshot)
    im_rows(im_set(m, a, 1, 11))
    im_rows(im_set(m, b, 2, 21))
    im_rows(m.insert(c, R, im_reg(3, 30)))
    assert_eq(im_waits(im_set(m, a, 2, 22)), b)
    // Row 3 is `c`'s uncommitted insert: an update by `b` would not see it, an insert of its key waits.
    assert_eq(im_waits(m.insert(b, R, im_reg(3, 31))), c)
    assert_eq(im_code(im_set(m, c, 1, 12)), "T1002")
    assert(m.live(a) && m.live(b), "the waiters keep waiting")

@test
a_statement_that_must_wait_writes_nothing()
    val m = im_model()
    val h = m.begin(Serializable)
    im_rows(im_set(m, h, 2, 21))
    val t = m.begin(Snapshot)
    assert_eq(im_waits(m.update(t, R, MoAll, MoAdd(1, 1))), h)
    // Row 1, which the statement also selects, was not written or locked.
    val o = m.begin(Snapshot)
    im_rows(im_set(m, o, 1, 12))
    assert_eq(im_commit(m, o), 2)
    assert_eq(im_read(m, t, 1), 10)

@test
an_update_whose_predicate_no_longer_holds_after_the_wait_skips_the_row_at_read_committed()
    val m = im_model()
    val h = m.begin(Serializable)
    im_rows(m.update(h, G, MoKey(11), MoSet(1, 2)))
    val t = m.begin(ReadCommitted)
    assert_eq(im_waits(m.update(t, G, MoEq(1, 1), MoSet(2, 7))), h)
    assert_eq(im_commit(m, h), 2)
    assert_eq(im_rows(m.update(t, G, MoEq(1, 1), MoSet(2, 7))), 0)
    assert_eq(im_rows(m.update(t, G, MoEq(1, 2), MoSet(2, 7))), 2)

@test
a_write_of_a_row_twice_keeps_one_write_with_the_first_before_and_the_last_after()
    val m = im_model()
    val r = m.begin(Serializable)
    assert_eq(im_read(m, r, 1), 10)
    im_rows(im_set(m, r, 2, 22))
    val w = m.begin(Snapshot)
    im_rows(im_set(m, w, 1, 50))
    im_rows(im_set(m, w, 1, 10))
    assert_eq(im_commit(m, w), 2)
    // `w`'s one write of row 1 left it as it found it: it changes nothing `r` read.
    assert_eq(im_commit(m, r), 3)

// -- §4.2 rule 4 inserts ----------------------------------------------------------------------------

@test
an_insert_of_a_visible_key_is_unique_violation_at_every_level()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        assert_eq(im_code(m.insert(t, R, im_reg(1, 99))), "T3001")
        assert_eq(m.state_of(t), MoAborted("T3001"))
        val own = m.begin(level)
        im_rows(m.insert(own, R, im_reg(5, 50)))
        assert_eq(im_code(m.insert(own, R, im_reg(5, 51))), "T3001")

@test
the_model_refuses_an_insert_of_a_key_committed_after_the_snapshot_by_level()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        val w = m.begin(Serializable)
        im_rows(m.insert(w, R, im_reg(5, 50)))
        assert_eq(im_commit(m, w), 2)
        val want = if level == ReadCommitted then "T3001" else "T1001"
        assert_eq(im_code(m.insert(t, R, im_reg(5, 51))), want)

@test
an_insert_waits_for_a_live_inserter_of_the_same_key()
    for level in im_levels()
        val m = im_model()
        val a = m.begin(Serializable)
        im_rows(m.insert(a, R, im_reg(5, 50)))
        val t = m.begin(level)
        assert_eq(im_waits(m.insert(t, R, im_reg(5, 51))), a)
        assert_eq(im_code(m.abort(a)), "ok")
        im_rows(m.insert(t, R, im_reg(5, 51)))
        assert_eq(im_commit(m, t), 2)

        val b = m.begin(Serializable)
        im_rows(m.insert(b, R, im_reg(6, 60)))
        val u = m.begin(level)
        assert_eq(im_waits(m.insert(u, R, im_reg(6, 61))), b)
        assert_eq(im_commit(m, b), 3)
        assert_eq(im_code(m.insert(u, R, im_reg(6, 61))), if level == ReadCommitted then "T3001" else "T1001")

@test
a_key_deleted_and_reinserted_in_one_transaction_is_one_write()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        assert_eq(im_rows(m.update(t, R, MoKey(1), MoRemove)), 1)
        assert_eq(im_read(m, t, 1), -1)
        im_rows(m.insert(t, R, im_reg(1, 15)))
        assert_eq(im_read(m, t, 1), 15)
        assert_eq(im_rows(m.update(t, R, MoKey(1), MoRemove)), 1)
        im_rows(m.insert(t, R, im_reg(1, 16)))
        val o = m.begin(ReadCommitted)
        assert_eq(im_read(m, o, 1), 10)
        assert_eq(im_commit(m, t), 2)
        assert_eq(im_read(m, o, 1), 16)

@test
a_key_deleted_by_a_committed_transaction_can_be_inserted_again()
    val m = im_model()
    val d = m.begin(Serializable)
    im_rows(m.update(d, R, MoKey(1), MoRemove))
    assert_eq(im_commit(m, d), 2)
    for level in im_levels()
        val t = m.begin(level)
        assert_eq(im_read(m, t, 1), -1)
        im_rows(m.insert(t, R, im_reg(1, 17)))
        assert_eq(im_code(m.abort(t)), "ok")

@test
an_insert_of_a_key_inserted_and_deleted_after_the_snapshot_is_a_serialization_failure()
    // Rule 2 meets rule 4: the newest committed version is a delete the snapshot does not include.
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        val a = m.begin(Snapshot)
        im_rows(m.insert(a, R, im_reg(5, 50)))
        assert_eq(im_commit(m, a), 2)
        val d = m.begin(Snapshot)
        im_rows(m.update(d, R, MoKey(5), MoRemove))
        assert_eq(im_commit(m, d), 3)
        if level == ReadCommitted
            im_rows(m.insert(t, R, im_reg(5, 51)))
            assert_eq(im_commit(m, t), 4)
        else
            assert_eq(im_code(m.insert(t, R, im_reg(5, 51))), "T1001")

@test
an_insert_over_a_delete_committed_after_the_snapshot_is_a_duplicate_except_at_read_committed()
    for level in im_levels()
        val m = im_model()
        val t = m.begin(level)
        val d = m.begin(Snapshot)
        im_rows(m.update(d, R, MoKey(1), MoRemove))
        assert_eq(im_commit(m, d), 2)
        if level == ReadCommitted
            im_rows(m.insert(t, R, im_reg(1, 18)))
            assert_eq(im_commit(m, t), 3)
        else
            // The row is still visible in the snapshot: a duplicate.
            assert_eq(im_code(m.insert(t, R, im_reg(1, 18))), "T3001")

@test
a_write_of_a_key_inserted_after_the_snapshot_sees_no_row()
    val m = im_model()
    val t = m.begin(Snapshot)
    val w = m.begin(Snapshot)
    im_rows(m.insert(w, R, im_reg(5, 50)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_rows(im_set(m, t, 5, 51)), 0)
    assert_eq(im_commit(m, t), 1)

// -- §4.3 the predicate log and validation -----------------------------------------------------------

@test
validation_catches_a_read_write_conflict_through_a_point_read()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_read(m, t, 1), 10)
    im_rows(im_set(m, t, 2, 21))
    val w = m.begin(ReadCommitted)
    im_rows(im_set(m, w, 1, 11))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_code(m.commit(t)), "T1001")
    assert_eq(m.state_of(t), MoAborted("T1001"))
    // Its write was undone.
    val r = m.begin(Snapshot)
    assert_eq(im_read(m, r, 2), 20)

@test
validation_catches_a_point_read_that_found_no_row()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_read(m, t, 5), -1)
    im_rows(im_set(m, t, 2, 21))
    val w = m.begin(Snapshot)
    im_rows(m.insert(w, R, im_reg(5, 50)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_code(m.commit(t)), "T1001")

@test
validation_catches_a_read_write_conflict_through_a_range_read()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, G, MoRange(10, 20), mo_cols([0])).len(), 2)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    im_rows(m.insert(w, G, im_grp(15, 1, 0)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_code(m.commit(t)), "T1001")

@test
a_write_outside_a_range_read_does_not_abort_it()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, G, MoRange(10, 20), mo_cols([0])).len(), 2)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    im_rows(m.insert(w, G, im_grp(25, 1, 0)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_commit(m, t), 3)

@test
validation_catches_a_read_write_conflict_through_a_predicate_read()
    // A row moving into the predicate (its after-image matches) and one moving out (its before-image
    // matches) each abort the reader.
    for moved in items_of([12, 11])
        val m = im_model()
        val t = m.begin(Serializable)
        assert_eq(im_keys(m, t, G, MoEq(1, 1), mo_cols([1])).len(), 1)
        im_rows(im_set(m, t, 1, 11))
        val w = m.begin(Snapshot)
        im_rows(m.update(w, G, MoKey(i64(moved)), MoSet(1, if moved == 12 then 1 else 3)))
        assert_eq(im_commit(m, w), 2)
        assert_eq(im_code(m.commit(t)), "T1001")

@test
the_models_validation_is_column_precise()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, G, MoEq(1, 1), mo_cols([1])).len(), 1)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    // Column `v` of a matching row, which the read did not use.
    im_rows(m.update(w, G, MoKey(11), MoSet(2, 5)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_commit(m, t), 3)

@test
a_write_to_rows_the_predicate_never_matched_does_not_abort_it()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, G, MoEq(1, 1), mo_cols([1])).len(), 1)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    im_rows(m.update(w, G, MoKey(12), MoSet(1, 3)))
    im_rows(m.insert(w, G, im_grp(13, 4, 0)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_commit(m, t), 3)

@test
a_write_statements_predicate_is_logged_and_validated()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_rows(m.update(t, G, MoEq(1, 1), MoSet(2, 9))), 1)
    val w = m.begin(Snapshot)
    im_rows(m.insert(w, G, im_grp(13, 1, 0)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_code(m.commit(t)), "T1001")

@test
validation_ignores_commits_before_the_snapshot_and_the_transactions_own_writes()
    val m = im_model()
    val w = m.begin(Snapshot)
    im_rows(im_set(m, w, 1, 11))
    assert_eq(im_commit(m, w), 2)
    val t = m.begin(Serializable)
    assert_eq(im_read(m, t, 1), 11)
    im_rows(im_set(m, t, 1, 12))
    im_rows(im_set(m, t, 2, 22))
    assert_eq(im_commit(m, t), 3)

@test
validation_counts_writes_at_every_level_and_only_serializable_transactions_validate()
    // A read-committed writer aborts a serializable reader; a snapshot reader is not validated.
    for level in items_of([Serializable, Snapshot])
        val m = im_model()
        val t = m.begin(level)
        assert_eq(im_read(m, t, 1), 10)
        im_rows(im_set(m, t, 2, 21))
        val w = m.begin(ReadCommitted)
        im_rows(im_set(m, w, 1, 11))
        assert_eq(im_commit(m, w), 2)
        assert_eq(im_code(m.commit(t)), if level == Serializable then "T1001" else "ok")

@test
write_skew_commits_at_snapshot_and_is_refused_at_serializable()
    for level in items_of([Serializable, Snapshot])
        val m = im_model()
        val a = m.begin(level)
        val b = m.begin(level)
        assert_eq(im_read(m, a, 1) + im_read(m, a, 2), 30)
        assert_eq(im_read(m, b, 1) + im_read(m, b, 2), 30)
        im_rows(im_add(m, a, 1, -30))
        im_rows(im_add(m, b, 2, -30))
        assert_eq(im_commit(m, a), 2)
        assert_eq(im_code(m.commit(b)), if level == Serializable then "T1001" else "ok")

@test
a_serializable_reader_of_a_commit_that_followed_a_validated_one_still_validates()
    // Two commits during the reader's lifetime: the second conflicts.
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_read(m, t, 2), 20)
    im_rows(m.insert(t, R, im_reg(7, 70)))
    val a = m.begin(Snapshot)
    im_rows(im_set(m, a, 1, 11))
    assert_eq(im_commit(m, a), 2)
    val b = m.begin(Snapshot)
    im_rows(im_set(m, b, 2, 21))
    assert_eq(im_commit(m, b), 3)
    assert_eq(im_code(m.commit(t)), "T1001")

// -- §4.5 nested relations ---------------------------------------------------------------------------

@test
an_append_to_a_nested_list_is_one_write_of_its_row()
    val m = im_model()
    val a = m.begin(Serializable)
    im_rows(m.update(a, L, MoKey(21), MoAppend(1, 7)))
    val b = m.begin(Serializable)
    assert_eq(im_waits(m.update(b, L, MoKey(21), MoAppend(1, 8))), a)
    assert_eq(im_commit(m, a), 2)
    assert_eq(im_code(m.update(b, L, MoKey(21), MoAppend(1, 8))), "T1001")

@test
a_nested_read_returns_one_version_of_its_row_whole()
    val m = im_model()
    val t = m.begin(Snapshot)
    val w = m.begin(Snapshot)
    im_rows(m.update(w, L, MoKey(21), MoAppend(1, 7)))
    im_rows(m.update(w, L, MoKey(21), MoAppend(1, 8)))
    assert_eq(im_commit(m, w), 2)
    m.get(t, L, 21) match
        Ok(Some(img)) -> assert_eq(mo_list(img, 1).len(), 0)
        _ -> assert(false, "the row is visible")
    val r = m.begin(Snapshot)
    m.get(r, L, 21) match
        Ok(Some(img)) ->
            val items = mo_list(img, 1)
            assert_eq(items.len(), 2)
            assert_eq(items[0], 7)
            assert_eq(items[1], 8)
        _ -> assert(false, "the row is visible")

@test
a_predicate_over_a_nested_level_is_validated_on_whole_images()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, L, MoHas(1, 7), mo_cols([1])).len(), 0)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    im_rows(m.update(w, L, MoKey(21), MoAppend(1, 7)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_code(m.commit(t)), "T1001")

@test
a_nested_write_neither_image_of_which_matches_does_not_abort_the_reader()
    val m = im_model()
    val t = m.begin(Serializable)
    assert_eq(im_keys(m, t, L, MoHas(1, 7), mo_cols([1])).len(), 0)
    im_rows(im_set(m, t, 1, 11))
    val w = m.begin(Snapshot)
    im_rows(m.update(w, L, MoKey(21), MoAppend(1, 8)))
    assert_eq(im_commit(m, w), 2)
    assert_eq(im_commit(m, t), 3)

// -- §5 abort rules and codes ------------------------------------------------------------------------

@test
an_aborted_transaction_answers_transaction_aborted_and_its_commit_the_code_that_aborted_it()
    val m = im_model()
    val t = m.begin(Snapshot)
    assert_eq(im_code(m.insert(t, R, im_reg(1, 1))), "T3001")
    assert_eq(im_code(m.get(t, R, 1)), "W2003")
    assert_eq(im_code(m.scan(t, R, MoAll, buf())), "W2003")
    assert_eq(im_code(im_set(m, t, 2, 1)), "W2003")
    assert_eq(im_code(m.insert(t, R, im_reg(9, 9))), "W2003")
    assert_eq(im_code(m.commit(t)), "T3001")
    assert_eq(im_code(m.abort(t)), "ok")
    assert_eq(m.state_of(t), MoAborted("T3001"))

@test
a_rolled_back_transaction_commits_with_transaction_aborted()
    val m = im_model()
    val t = m.begin(Serializable)
    im_rows(im_set(m, t, 1, 11))
    assert_eq(im_code(m.abort(t)), "ok")
    assert_eq(im_code(m.commit(t)), "W2003")
    assert_eq(im_code(im_read_code(m, t)), "W2003")

private im_read_code(m: &IsoModel, t: u64) -> Result[Option[Buf[MoVal]], string] = m.get(t, R, 1)

@test
a_committed_transaction_answers_unknown_transaction()
    val m = im_model()
    val t = m.begin(Serializable)
    im_rows(im_set(m, t, 1, 11))
    assert_eq(im_commit(m, t), 2)
    assert_eq(im_code(m.commit(t)), "W2001")
    assert_eq(im_code(m.abort(t)), "W2001")
    assert_eq(im_code(m.get(t, R, 1)), "W2001")
    assert_eq(im_code(m.get(99, R, 1)), "W2001")
    assert_eq(im_code(m.commit(99)), "W2001")

@test
serialization_failure_is_never_raised_at_read_committed()
    // Every conflict that aborts a snapshot writer: a newer commit, a racing insert, a holder that
    // commits while waited for, a concurrent conflicting commit at commit time.
    val m = im_model()
    val t = m.begin(ReadCommitted)
    assert_eq(im_read(m, t, 1), 10)
    val w = m.begin(Snapshot)
    im_rows(im_set(m, w, 1, 11))
    im_rows(m.insert(w, R, im_reg(5, 50)))
    assert_eq(im_commit(m, w), 2)
    im_rows(im_add(m, t, 1, 1))
    assert_eq(im_code(m.insert(t, R, im_reg(5, 51))), "T3001")
    val u = m.begin(ReadCommitted)
    val h = m.begin(Serializable)
    im_rows(im_set(m, h, 2, 22))
    assert_eq(im_waits(im_add(m, u, 2, 1)), h)
    assert_eq(im_commit(m, h), 3)
    im_rows(im_add(m, u, 2, 1))
    assert_eq(im_commit(m, u), 4)
