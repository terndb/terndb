module sh.sysl.terndb

import sysl.buf.{Buf, buf}
import sysl.text.{char_from_u32, str_builder}

// Every keyword, type name and operator of the dialect is ASCII, so the lexer works on bytes; a byte
// at or above 0x80 is part of an identifier, which keeps every cut on a character boundary.

// The lexical layer of TernDB's SQL dialect (`docs/spec/sql.md` §2): SQL text cut into tokens, each
// with the byte range it was read from. Whitespace and comments separate tokens and are dropped. An
// unquoted identifier is folded to lower case (ASCII letters only) and a quoted one is kept exactly;
// a keyword is an unquoted identifier the parser recognises by its folded spelling, so a quoted
// identifier is never a keyword. A string's escapes are decoded here, and a number keeps its text
// for the translator to type.

/** One token of SQL text. */
enum SqlTok derives Eq
    /** An identifier or keyword: its folded (unquoted) or exact (quoted) name. */
    TkIdent(name: string, quoted: bool)
    /** A string constant, `'…'` or `E'…'`, its escapes decoded. */
    TkString(value: string)
    /** A numeric constant's text: digits, at most one point, and an optional exponent. */
    TkNumber(text: string)
    /** A parameter, `$n` with `n ≥ 1`. */
    TkParam(index: u64)
    /** An operator or punctuation; `!=` is read as `<>`. */
    TkOp(text: string)
    /** The end of the text. */
    TkEnd

/** A token and the bytes `start ..< end` of the text it was read from. */
struct SqlToken derives Eq
    tok: SqlTok
    start: u64
    end: u64

/** A refusal of SQL text (`docs/spec/sql.md` §7): its `errors.md` code, a sentence, and where it is,
 * as a byte offset into the text and as a 1-based line and column, the column counted in characters
 * (Unicode scalar values).
 */
struct SqlError derives Eq
    code: string
    message: string
    offset: u64
    line: u64
    column: u64

/** A refusal at byte `offset`; its line and column are filled in by `sql_located`. */
private[terndb] sql_fail[T](code: string, message: string, offset: u64) -> Result[T, SqlError] =
    Err(SqlError(code, message, offset, 0, 0))

/** `e` with the line and column of its offset in `text`. */
private[terndb] sql_located(text: string, e: SqlError) -> SqlError
    val b = text.bytes
    var line: u64 = 1
    var column: u64 = 1
    var i: usize = 0
    val stop = if e.offset > u64(b.len) then b.len else usize(e.offset)

    while i < stop
        if b[i] == u8('\n')
            line += 1
            column = 1
        else if (b[i] & 0xC0) != 0x80
            column += 1
        i += 1

    SqlError(e.code, e.message, e.offset, line, column)

private sql_is_space(c: u8) -> bool = c == u8(' ') || c == u8('\t') || c == u8('\n') || c == u8('\r') || c == 12

private sql_is_digit(c: u8) -> bool = c >= u8('0') && c <= u8('9')

private sql_ident_start(c: u8) -> bool = (c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) || c == u8('_') || c >= 0x80

private sql_ident_part(c: u8) -> bool = sql_ident_start(c) || sql_is_digit(c) || c == u8('$')

private sql_lower(c: u8) -> u8 = if c >= u8('A') && c <= u8('Z') then c + 32 else c

/** The text's bytes `a ..< b` as a string; the lexer cuts only at character boundaries. */
private sql_cut(text: string, a: usize, b: usize) -> string = text[a..<b]

/** The text of an unquoted identifier, folded: ASCII `A`–`Z` become `a`–`z`, every other byte stays. */
private sql_folded(word: string) -> string
    var lower = true

    for c in word.bytes
        if c >= u8('A') && c <= u8('Z') then lower = false

    if lower then return word

    var sb = str_builder()
    for ch in word.chars
        val u = u32(ch)
        if u >= 65 && u <= 90 then sb.push_char(char(u + 32)) else sb.push_char(ch)

    sb.finish()

/** The tokens of `text`, ending with `TkEnd`, or the first lexical error (`docs/spec/sql.md` §2). */
sql_tokens(text: string) -> Result[Buf[SqlToken], SqlError]
    val b = text.bytes
    val out = buf[SqlToken]()
    var i: usize = 0

    loop
        i = sql_skip(b, i)?
        if i >= b.len then break

        val c = b[i]
        val start = i

        if (c == u8('E') || c == u8('e')) && i + 1 < b.len && b[i + 1] == u8('\'')
            val (s, next) = sql_string(text, i + 1, true)?
            out.push(SqlToken(TkString(s), u64(start), u64(next)))
            i = next
        else if c == u8('\'')
            val (s, next) = sql_string(text, i, false)?
            out.push(SqlToken(TkString(s), u64(start), u64(next)))
            i = next
        else if c == u8('"')
            val (name, next) = sql_quoted_ident(text, i)?
            out.push(SqlToken(TkIdent(name, true), u64(start), u64(next)))
            i = next
        else if sql_ident_start(c)
            while i < b.len && sql_ident_part(b[i])
                i += 1
            out.push(SqlToken(TkIdent(sql_folded(sql_cut(text, start, i)), false), u64(start), u64(i)))
        else if sql_is_digit(c) || (c == u8('.') && i + 1 < b.len && sql_is_digit(b[i + 1]))
            i = sql_number_end(b, i)?
            out.push(SqlToken(TkNumber(sql_cut(text, start, i)), u64(start), u64(i)))
        else if c == u8('$')
            i += 1
            var n: u64 = 0
            var digits = 0
            while i < b.len && sql_is_digit(b[i])
                if n > 100000000 then return sql_fail("Q8003", "a parameter number is too large", u64(start))
                n = n * 10 + u64(b[i] - u8('0'))
                digits += 1
                i += 1
            if digits == 0 then return sql_fail("Q8003", "'$' must be followed by a parameter number (dollar quoting is not supported)", u64(start))
            if n == 0 then return sql_fail("Q8003", "parameters are numbered from $1", u64(start))
            if i < b.len && sql_ident_part(b[i]) then return sql_fail("Q8003", "trailing characters after a parameter", u64(i))
            out.push(SqlToken(TkParam(n), u64(start), u64(i)))
        else
            val (op, next) = sql_operator(b, i)?
            out.push(SqlToken(TkOp(op), u64(start), u64(next)))
            i = next

    out.push(SqlToken(TkEnd, u64(b.len), u64(b.len)))
    Ok(out)
end sql_tokens

/** The first offset at or after `i` that is not whitespace or inside a comment. An unterminated block
 * comment is `Q8002`, reported where it opens.
 */
private sql_skip(b: []const u8, at: usize) -> Result[usize, SqlError]
    var i = at

    loop
        if i >= b.len then return Ok(i)
        val c = b[i]

        if sql_is_space(c)
            i += 1
        else if c == u8('-') && i + 1 < b.len && b[i + 1] == u8('-')
            while i < b.len && b[i] != u8('\n')
                i += 1
        else if c == u8('/') && i + 1 < b.len && b[i + 1] == u8('*')
            val open = i
            var depth = 1
            i += 2
            while depth > 0
                if i >= b.len then return sql_fail("Q8002", "unterminated /* comment", u64(open))
                if b[i] == u8('/') && i + 1 < b.len && b[i + 1] == u8('*')
                    depth += 1
                    i += 2
                else if b[i] == u8('*') && i + 1 < b.len && b[i + 1] == u8('/')
                    depth -= 1
                    i += 2
                else
                    i += 1
        else
            return Ok(i)

/** The string constant whose opening quote is at `q`, its value and the offset after it. Two
 * constants separated only by whitespace that holds a newline are one constant (`sql.md` §2.4). With
 * `escapes` (an `E'…'` constant) a backslash starts an escape.
 */
private sql_string(text: string, q: usize, escapes: bool) -> Result[(string, usize), SqlError]
    val b = text.bytes
    var sb = str_builder()
    var i = q

    loop
        val open = i
        i += 1
        var run = i

        loop
            if i >= b.len then return sql_fail("Q8002", "unterminated string constant", u64(if escapes && open == q then q - 1 else open))
            val c = b[i]

            if c == u8('\'')
                sb.push(sql_cut(text, run, i))
                if i + 1 < b.len && b[i + 1] == u8('\'')
                    sb.push("'")
                    i += 2
                    run = i
                else
                    i += 1
                    break
            else if escapes && c == u8('\\')
                sb.push(sql_cut(text, run, i))
                val (piece, next) = sql_escape(text, i)?
                sb.push(piece)
                i = next
                run = i
            else
                i += 1

        // A continuation: whitespace with a newline, then another quote.
        var j = i
        var newline = false
        while j < b.len && sql_is_space(b[j])
            if b[j] == u8('\n') then newline = true
            j += 1

        if newline && j < b.len && b[j] == u8('\'')
            i = j
        else
            return Ok((sb.finish(), i))
end sql_string

/** The escape whose backslash is at `at`, decoded, and the offset after it. */
private sql_escape(text: string, at: usize) -> Result[(string, usize), SqlError]
    val b = text.bytes
    var i = at + 1
    if i >= b.len then return sql_fail("Q8002", "unterminated string constant", u64(at))

    val c = b[i]
    if c == u8('n') then return Ok(("\n", i + 1))
    if c == u8('t') then return Ok(("\t", i + 1))
    if c == u8('r') then return Ok(("\r", i + 1))
    if c == u8('b') then return Ok((string(char(8)), i + 1))
    if c == u8('f') then return Ok((string(char(12)), i + 1))
    if c == u8('\\') || c == u8('\'') || c == u8('"') then return Ok((sql_cut(text, i, i + 1), i + 1))
    if c != u8('u') && c != u8('U') then return sql_fail("Q8003", "unknown escape sequence in an E'' string", u64(at))

    val digits: usize = if c == u8('u') then 4 else 8
    var u: u32 = 0
    var k: usize = 0
    i += 1

    while k < digits
        if i >= b.len then return sql_fail("Q8003", "a \\u escape needs hexadecimal digits", u64(at))
        val h = sql_lower(b[i])
        var v: u32 = 0
        if sql_is_digit(h)
            v = u32(h - u8('0'))
        else if h >= u8('a') && h <= u8('f')
            v = u32(h - u8('a')) + 10
        else
            return sql_fail("Q8003", "a \\u escape needs hexadecimal digits", u64(at))
        if u > 0x10FFFF then return sql_fail("Q8003", "the escape is not a Unicode scalar value", u64(at))
        u = u * 16 + v
        i += 1
        k += 1

    char_from_u32(u) match
        Some(ch) -> Ok((string(ch), i))
        None -> sql_fail("Q8003", "the escape is not a Unicode scalar value", u64(at))
end sql_escape

/** The quoted identifier whose opening `"` is at `q`: its name (`""` is one `"`) and the offset after
 * it. An empty one is `Q8003`.
 */
private sql_quoted_ident(text: string, q: usize) -> Result[(string, usize), SqlError]
    val b = text.bytes
    var sb = str_builder()
    var i = q + 1
    var run = i

    loop
        if i >= b.len then return sql_fail("Q8002", "unterminated quoted identifier", u64(q))
        if b[i] == u8('"')
            sb.push(sql_cut(text, run, i))
            if i + 1 < b.len && b[i + 1] == u8('"')
                sb.push("\"")
                i += 2
                run = i
            else
                i += 1
                break
        else
            i += 1

    val name = sb.finish()
    if name.len == 0 then return sql_fail("Q8003", "a quoted identifier may not be empty", u64(q))
    Ok((name, i))

/** The offset after the number starting at `at`: `digits[.digits][e[±]digits]` or `.digits[…]`. An
 * exponent without digits, and a letter, digit or `_` straight after the number, are `Q8003`.
 */
private sql_number_end(b: []const u8, at: usize) -> Result[usize, SqlError]
    var i = at

    while i < b.len && sql_is_digit(b[i])
        i += 1

    if i < b.len && b[i] == u8('.')
        i += 1
        while i < b.len && sql_is_digit(b[i])
            i += 1

    if i < b.len && (b[i] == u8('e') || b[i] == u8('E'))
        i += 1
        if i < b.len && (b[i] == u8('+') || b[i] == u8('-')) then i += 1
        if i >= b.len || !sql_is_digit(b[i]) then return sql_fail("Q8003", "an exponent needs digits", u64(at))
        while i < b.len && sql_is_digit(b[i])
            i += 1

    if i < b.len && (sql_ident_part(b[i]) || b[i] == u8('.')) then return sql_fail("Q8003", "trailing characters after a number", u64(i))
    Ok(i)

/** The operator or punctuation at `i` and the offset after it. */
private sql_operator(b: []const u8, i: usize) -> Result[(string, usize), SqlError]
    val c = b[i]
    val d: u8 = if i + 1 < b.len then b[i + 1] else 0

    if c == u8('<') && d == u8('=') then return Ok(("<=", i + 2))
    if c == u8('>') && d == u8('=') then return Ok((">=", i + 2))
    if c == u8('<') && d == u8('>') then return Ok(("<>", i + 2))
    if c == u8('!') && d == u8('=') then return Ok(("<>", i + 2))
    if c == u8('|') && d == u8('|') then return Ok(("||", i + 2))
    if c == u8(':') && d == u8(':') then return Ok(("::", i + 2))

    val singles = "(),;.+-*/%=<>"

    for k in 0..<singles.len
        if singles[k] == c then return Ok((singles[k..<k + 1], i + 1))

    sql_fail("Q8003", "a character that starts no token", u64(i))

/** Whether `text` is a complete input for a line-by-line shell: its last token, outside strings,
 * quoted identifiers and comments, is `;`. Text that ends inside an unterminated string, quoted
 * identifier or block comment is not complete; text after the last `;` that is only whitespace or
 * comments leaves it complete. Errors other than an unterminated construct do not make it
 * incomplete, so the shell sends the text and reports them.
 */
sql_complete(text: string) -> bool
    val b = text.bytes
    var i: usize = 0
    var last: u8 = 0

    loop
        sql_skip(b, i) match
            Ok(j) -> i = j
            Err(_) -> return false

        if i >= b.len then return last == u8(';')
        val c = b[i]

        if (c == u8('E') || c == u8('e')) && i + 1 < b.len && b[i + 1] == u8('\'') && (i == 0 || !sql_ident_part(b[i - 1]))
            sql_string(text, i + 1, true) match
                Ok((_, j)) -> i = j
                Err(e) -> if e.code == "Q8002" then return false else i = b.len
            last = u8('\'')
        else if c == u8('\'')
            sql_string(text, i, false) match
                Ok((_, j)) -> i = j
                Err(e) -> if e.code == "Q8002" then return false else i = b.len
            last = u8('\'')
        else if c == u8('"')
            sql_quoted_ident(text, i) match
                Ok((_, j)) -> i = j
                Err(e) -> if e.code == "Q8002" then return false else i += 2
            last = u8('"')
        else if sql_ident_part(c)
            while i < b.len && sql_ident_part(b[i])
                i += 1
            last = u8('a')
        else
            last = c
            i += 1
end sql_complete
