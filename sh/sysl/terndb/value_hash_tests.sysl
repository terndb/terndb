module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}
import sysl.rand.{Rng, rng}

// Hashing values (`query-tree.md` §3.4, `value_hash.sysl`): `same(a, b)` implies equal hashes, for
// each case the spec names, through records, unions and nested relations, and over random values of
// random types; the batch hashes agree with the value-at-a-time ones; `same_slots` agrees with
// `same`.

private vh(t: Type, v: Value) -> u64 = hash_value(key_hash(), t, v)

private vh_alike(t: Type, a: Value, b: Value, what: string, file: string = __FILE__, line: long = __LINE__)
    assert(same(t, a, b), s"$what: the values are the same", file, line)
    assert_eq(vh(t, a), vh(t, b), s"$what: the hashes agree", file, line)

/** Two values that are not `same` hash apart: not a guarantee of the spec, but of a 64-bit hash on a
 * handful of values, and what shows that the hash reads what it should.
 */
private vh_apart(t: Type, a: Value, b: Value, what: string, file: string = __FILE__, line: long = __LINE__)
    assert(!same(t, a, b), s"$what: the values differ", file, line)
    assert(vh(t, a) != vh(t, b), s"$what: the hashes differ", file, line)

private vh_f(bits: u64) -> Value = Float(real.from_bits(bits))

private vh_ints(xs: []const i128) -> Value
    val out = buf[Value]()

    for x in xs
        out.push(if x < 0 then Null else Int(x))

    Relation(out)

// -- the cases §3.4 names ---------------------------------------------------------------------------

@test
every_nan_hashes_alike()
    val nans = [vh_f(0x7ff8_0000_0000_0000), vh_f(0x7ff8_0000_0000_0001), vh_f(0xfff8_0000_0000_0000), vh_f(0x7ff0_0000_0000_0001),
        vh_f(0xffff_ffff_ffff_ffff)]

    for t in [Float64, Float32, nullable(Float64)]
        for x in nans
            vh_alike(t, nans[0], x, "a NaN")

@test
a_nan_hashes_apart_from_infinity_and_from_null()
    vh_apart(Float64, vh_f(0x7ff8_0000_0000_0000), vh_f(0x7ff0_0000_0000_0000), "NaN and +inf")
    vh_apart(nullable(Float64), vh_f(0x7ff8_0000_0000_0000), Null, "NaN and null")

@test
minus_zero_hashes_as_plus_zero()
    for t in [Float64, Float32]
        vh_alike(t, Float(0.0), vh_f(0x8000_0000_0000_0000), "-0.0 and +0.0")

    vh_apart(Float64, Float(0.0), Float(1.0), "0.0 and 1.0")

@test
numerically_equal_decimals_of_different_scales_hash_alike()
    // 1.50, 1.5 and 1.500000; -1.20 and -1.2; 0 at every scale; 15 as an integer and 15.0.
    assert_eq(vh(Decimal(10, 2), Int(150)), vh(Decimal(10, 1), Int(15)))
    assert_eq(vh(Decimal(10, 2), Int(150)), vh(Decimal(20, 6), Int(1500000)))
    assert_eq(vh(Decimal(10, 2), Int(-120)), vh(Decimal(4, 1), Int(-12)))
    assert_eq(vh(Decimal(10, 0), Int(0)), vh(Decimal(38, 38), Int(0)))
    assert_eq(vh(Int64, Int(15)), vh(Decimal(10, 1), Int(150)))
    assert_eq(vh(Decimal(10, 0), Int(1500)), vh(Decimal(10, 2), Int(150000)))

@test
decimals_of_different_values_hash_apart_whatever_their_scales()
    // 1.5 and 15 share an unscaled value; 1.5 and 0.15 do too.
    assert(vh(Decimal(10, 1), Int(15)) != vh(Decimal(10, 0), Int(15)))
    assert(vh(Decimal(10, 1), Int(15)) != vh(Decimal(10, 2), Int(15)))
    assert(vh(Decimal(10, 1), Int(15)) != vh(Decimal(10, 1), Int(-15)))

@test
an_integer_hashes_as_its_value_at_every_width_signed_or_not()
    val h = vh(Int64, Int(5))

    for t in [Int8, Int16, Int32, Int128]
        assert_eq(vh(t, Int(5)), h)

    for t in [UInt8, UInt16, UInt32, UInt64]
        assert_eq(vh(t, UInt(5)), h)

    assert(vh(Int64, Int(-5)) != h)
    assert(vh(UInt64, UInt(0xffff_ffff_ffff_ffff)) != vh(Int64, Int(-1)))

@test
a_bags_hash_does_not_depend_on_element_order()
    val t = bag(nullable(Int64))
    vh_alike(t, vh_ints([1, 2, 3]), vh_ints([3, 1, 2]), "a permutation")
    vh_alike(t, vh_ints([1, 1, 2, -1]), vh_ints([-1, 2, 1, 1]), "duplicates and a null")
    vh_alike(t, vh_ints([]), vh_ints([]), "the empty bag")

@test
a_bags_hash_counts_each_element()
    val t = bag(nullable(Int64))
    vh_apart(t, vh_ints([1, 1, 2]), vh_ints([1, 2, 2]), "multiplicities")
    vh_apart(t, vh_ints([1, 2]), vh_ints([1, 2, 2]), "one more")
    vh_apart(t, vh_ints([-1]), vh_ints([-1, -1]), "nulls")
    vh_apart(nullable(t), vh_ints([]), Null, "the empty bag and null")

@test
a_lists_hash_depends_on_element_order()
    val t = list(nullable(Int64))
    vh_alike(t, vh_ints([1, 2, 3]), vh_ints([1, 2, 3]), "the same list")
    vh_apart(t, vh_ints([1, 2, 3]), vh_ints([3, 2, 1]), "another order")
    vh_apart(t, vh_ints([1, 2]), vh_ints([1, 2, -1]), "a trailing null")

@test
null_hashes_alike_and_apart_from_every_empty_value()
    vh_alike(nullable(Int64), Null, Null, "null")
    vh_apart(nullable(Text), Null, Text(""), "null and the empty text")
    vh_apart(nullable(record([])), Null, rec([]), "null and the empty record")
    vh_apart(nullable(record([Field("a", nullable(Int64))])), Null, rec([Null]), "null and a record of null")

@test
octet_strings_hash_by_their_octets()
    vh_alike(Text, Text("caf\u{e9}"), Text("caf\u{e9}"), "text")
    vh_apart(Text, Text("caf\u{e9}"), Text("cafe\u{301}"), "a composed and a decomposed accent")
    vh_apart(Text, Text("a"), Text("A"), "case")
    vh_alike(Bytes, bytes_value([0, 255]), bytes_value([0, 255]), "bytes")
    vh_apart(Bytes, bytes_value([0]), bytes_value([0, 0]), "a prefix")
    vh_alike(Json, Text("{\"a\":1}"), Text("{\"a\":1}"), "json")

@test
an_interval_hashes_componentwise()
    vh_alike(Type.Interval, Value.Interval(1, 2, 3), Value.Interval(1, 2, 3), "the same interval")
    vh_apart(Type.Interval, Value.Interval(1, 0, 0), Value.Interval(0, 30, 0), "a month and 30 days")
    vh_apart(Type.Interval, Value.Interval(0, 1, 0), Value.Interval(1, 0, 0), "a day and a month")
    vh_apart(Type.Interval, Value.Interval(-1, 0, 0), Value.Interval(0, -1, 0), "negative parts")

@test
time_types_and_uuids_hash_by_their_numbers()
    for t in [Date, Time, DateTime, Timestamp]
        vh_alike(t, Int(86400), Int(86400), "a time")
        vh_apart(t, Int(1), Int(2), "two times")

    vh_alike(Type.Uuid, Value.Uuid(u128(1) << 100), Value.Uuid(u128(1) << 100), "a uuid")
    vh_apart(Type.Uuid, Value.Uuid(u128(1) << 100), Value.Uuid(u128(1)), "the high and the low half")

@test
booleans_hash_apart()
    vh_alike(Type.Bool, Value.Bool(true), Value.Bool(true), "true")
    vh_apart(Type.Bool, Value.Bool(true), Value.Bool(false), "true and false")

// -- structure --------------------------------------------------------------------------------------

private vh_point() -> Type = record([Field("x", nullable(Float64)), Field("tags", bag(nullable(Int64))), Field("n", nullable(Decimal(10, 2)))])

@test
records_hash_field_by_field_with_every_rule_inside()
    val t = vh_point()
    vh_alike(t, rec([vh_f(0x7ff8_0000_0000_0000), vh_ints([1, 2]), Int(5)]), rec([vh_f(0xfff8_0000_0000_0001), vh_ints([2, 1]), Int(5)]),
        "a NaN field and a bag field")
    vh_alike(t, rec([Float(0.0), vh_ints([]), Null]), rec([vh_f(0x8000_0000_0000_0000), vh_ints([]), Null]), "a zero field and a null field")
    vh_apart(t, rec([Float(1.0), vh_ints([1]), Int(5)]), rec([Float(1.0), vh_ints([1]), Int(6)]), "the last field")

@test
a_records_fields_are_hashed_in_order()
    val t = record([Field("a", Int64), Field("b", Int64)])
    vh_apart(t, rec([Int(1), Int(2)]), rec([Int(2), Int(1)]), "swapped fields")

@test
nested_records_hash_at_every_level()
    val inner = record([Field("z", nullable(Float64)), Field("b", bag(Int64))])
    val t = record([Field("x", Int64), Field("n", nullable(inner))])
    vh_alike(t, rec([Int(1), rec([vh_f(0x7ff8_0000_0000_0002), vh_ints([3, 4])])]), rec([Int(1), rec([vh_f(0x7ff8_0000_0000_0000), vh_ints([4, 3])])]),
        "two levels")
    vh_alike(t, rec([Int(1), Null]), rec([Int(1), Null]), "a null inner record")
    vh_apart(t, rec([Int(1), Null]), rec([Int(1), rec([Null, vh_ints([])])]), "a null inner record and one of a null")

private vh_shape() -> Type = union_of([Field("Circle", record([Field("r", Float64)])), Field("Square", record([Field("r", Float64)])),
    Field("Blob", record([Field("pts", bag(Int64))]))])

@test
unions_hash_by_discriminant_and_payload()
    val t = vh_shape()
    vh_alike(t, variant(0, rec([Float(0.0)])), variant(0, rec([vh_f(0x8000_0000_0000_0000)])), "a zero payload")
    vh_alike(t, variant(2, rec([vh_ints([1, 2, 2])])), variant(2, rec([vh_ints([2, 1, 2])])), "a bag payload")
    vh_apart(t, variant(0, rec([Float(1.0)])), variant(1, rec([Float(1.0)])), "the same payload under two variants")
    vh_apart(t, variant(0, rec([Float(1.0)])), variant(0, rec([Float(2.0)])), "two payloads")

@test
a_nullable_union_hashes_its_null_apart_from_every_variant()
    val t = nullable(vh_shape())
    vh_alike(t, Null, Null, "null")
    vh_apart(t, Null, variant(0, rec([Float(0.0)])), "null and the first variant")

@test
nested_relations_hash_as_their_own_kinds_at_every_level()
    val bb = bag(bag(Int64))
    vh_alike(bb, rel([vh_ints([1, 2]), vh_ints([3])]), rel([vh_ints([3]), vh_ints([2, 1])]), "a bag of bags in any order")
    vh_apart(bb, rel([vh_ints([1, 2]), vh_ints([3])]), rel([vh_ints([1]), vh_ints([2, 3])]), "regrouped elements")

    val lb = list(bag(Int64))
    vh_alike(lb, rel([vh_ints([1, 2]), vh_ints([3])]), rel([vh_ints([2, 1]), vh_ints([3])]), "a list of bags, each in any order")
    vh_apart(lb, rel([vh_ints([1, 2]), vh_ints([3])]), rel([vh_ints([3]), vh_ints([1, 2])]), "a list of bags in another order")

    val bl = bag(list(Int64))
    vh_alike(bl, rel([vh_ints([1, 2]), vh_ints([3])]), rel([vh_ints([3]), vh_ints([1, 2])]), "a bag of lists in any order")
    vh_apart(bl, rel([vh_ints([1, 2])]), rel([vh_ints([2, 1])]), "a bag of a list in another order")

    val br = bag(record([Field("k", Int64), Field("v", bag(nullable(Text)))]))
    vh_alike(br, rel([rec([Int(1), rel([Text("a"), Null])]), rec([Int(2), rel([])])]), rel([rec([Int(2), rel([])]), rec([Int(1), rel([Null, Text("a")])])]),
        "a bag of records holding bags")

@test
a_key_hash_seed_picks_another_function()
    val t = record([Field("a", Int64), Field("b", Text)])
    val v = rec([Int(7), Text("x")])
    assert(hash_value(KeyHash(1, 0xffff_ffff_ffff_ffff), t, v) != hash_value(key_hash(), t, v))
    assert_eq(hash_value(KeyHash(1, 0), t, v), hash_value(KeyHash(1, 0xffff_ffff_ffff_ffff), t, v))

// -- random values ----------------------------------------------------------------------------------

/** A value `same` as `v` of `t` but written differently wherever §3.1 allows: another NaN, the other
 * zero, a bag's elements in another order, at every depth.
 */
private vh_twin(r: *Rng, t: Type, v: Value) -> Value
    if v.is_null() then return v

    t.base() match
        Record(fs) ->
            val xs = xj_fields(v)
            val out = buf[Value]()

            for i in 0..<fs.len()
                out.push(vh_twin(r, fs[i].ty, xs[i]))

            Value.Record(out)
        Union(vs) -> v match
            Variant(tag, p) -> variant(tag, vh_twin(r, vs[tag].ty, *p))
            _ -> panic("a union value was expected")
        Bag(e) | List(e) ->
            val xs = v match
                Relation(es) -> es
                _ -> panic("a relation value was expected")
            var out = buf[Value]()

            for x in xs
                out.push(vh_twin(r, *e, x))

            if t.base() == bag(*e)
                var k = out.len()

                while k > 1
                    val j = usize(r.below(u64(k)))
                    k -= 1
                    val tmp = out[k]
                    out[k] = out[j]
                    out[j] = tmp

            Relation(out)
        Float32 | Float64 -> v match
            Float(x) ->
                if x.is_nan() then vh_f(0xfff8_0000_0000_0abc)
                elif x == 0.0 then Float(-x)
                else v
            _ -> v
        _ -> v
end vh_twin

@test
same_values_hash_alike_over_random_values_of_every_type()
    var r = rng(0x4a5e_0001, 3)

    for round in 0..<400
        val t = rf_type(&r, 0)

        for _ in 0..<4
            val a = rf_value(&r, t)
            val b = vh_twin(&r, t, a)
            assert(same(t, a, b), s"round $round: the twin is the same")
            assert_eq(vh(t, a), vh(t, b), s"round $round: the hashes agree")

@test
same_implies_equal_hashes_over_random_pairs_of_small_values()
    // Small domains, so that many independent pairs are `same`.
    var r = rng(0x4a5e_0002, 5)
    val ts = [nullable(Int64), bag(nullable(Int8)), record([Field("a", nullable(Bool)), Field("b", nullable(Int16))]), list(nullable(Bool)),
        nullable(union_of([Field("A", record([Field("x", nullable(Bool))])), Field("B", record([]))]))]
    var matched = 0

    for round in 0..<2000
        val t = ts[round % ts.len]
        val a = vh_small(&r, t)
        val b = vh_small(&r, t)

        if same(t, a, b)
            matched += 1
            assert_eq(vh(t, a), vh(t, b), s"round $round")

    assert(matched > 200, s"only $matched pairs were the same")

private vh_small(r: *Rng, t: Type) -> Value
    if t.is_nullable() && r.below(3) == 0 then return Null

    t.base() match
        Type.Bool -> Value.Bool(r.below(2) == 0)
        Int8 | Int16 | Int64 -> Int(i128(r.below(3)))
        Record(fs) ->
            val xs = buf[Value]()

            for f in fs
                xs.push(vh_small(r, f.ty))

            Value.Record(xs)
        Union(vs) ->
            val tag = usize(r.below(u64(vs.len())))
            variant(tag, vh_small(r, vs[tag].ty))
        Bag(e) | List(e) ->
            val xs = buf[Value]()

            for _ in 0..<usize(r.below(3))
                xs.push(vh_small(r, *e))

            Relation(xs)
        _ -> panic("vh_small: an unexpected type")

@test
batch_hashes_agree_with_hashes_one_value_at_a_time()
    // Over whole vectors, so that every child vector's offsets are read: a record's fields, a union's
    // payloads in their children, a relation's elements.
    var r = rng(0x4a5e_0003, 9)

    for round in 0..<200
        val t = nullable(rf_type(&r, 0))
        val xs = buf[Value]()

        for _ in 0..<usize(r.below(12))
            xs.push(rf_value(&r, t))

        val v = vector_of(t, xs.view())
        val hs = hash_column(key_hash(), v)
        assert_eq(hs.len(), xs.len())

        for i in 0..<xs.len()
            assert_eq(hs[i], vh(t, xs[i]), s"round $round, slot $i")

        // A gather in another order hashes as its rows do.
        val rows = buf[usize]()

        for i in 0..<xs.len()
            rows.push(xs.len() - 1 - i)

        val back = hash_column(key_hash(), take(v, rows.view()))

        for i in 0..<rows.len()
            assert_eq(back[i], hs[rows[i]], s"round $round, gathered slot $i")

@test
same_slots_agrees_with_same_over_random_values()
    var r = rng(0x4a5e_0004, 11)

    for round in 0..<300
        val t = if round % 2 == 0 then nullable(rf_scalar_type(&r)) else nullable(rf_type(&r, 1))
        val xs = buf[Value]()
        val ys = buf[Value]()

        for _ in 0..<4
            val a = rf_value(&r, t)
            xs.push(a)
            ys.push(if r.below(2) == 0 then vh_twin(&r, t, a) else rf_value(&r, t))

        val a = vector_of(t, xs.view())
        val b = vector_of(t, ys.view())

        for i in 0..<4
            for j in 0..<4
                assert_eq(same_slots(a, i, b, j), same(t, xs[i], ys[j]), s"round $round, slots $i and $j")
