module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}

// Parameter blocks (`wire-protocol.md` §4.2): row-major values by their declared types, columnar bulk
// input, and the [QT] codes with the `/params/<tuple>/<index>` path of the value that failed.

tuples_of(rows: []const []const Value) -> Buf[Buf[Value]]
    val out = buf[Buf[Value]]()

    for r in rows
        val t = buf[Value]()
        t.extend(r)
        out.push(t)

    out

row_params(rows: []const []const Value) -> Params = Params(buf(), tuples_of(rows))

/** Encode, decode and re-encode, which must agree. */
params_round_trip(types: []const Type, p: Params, file: string = __FILE__, line: long = __LINE__) -> Buf[u8]
    val bytes = encode_params(types, p).unwrap()
    val back = decode_params(types, bytes.view()).unwrap()

    assert(back == p, "the parameters decode as they were encoded", file, line)
    same_bytes(encode_params(types, back).unwrap(), bytes, "and re-encode to the same octets", file, line)
    bytes

/** The code and path `bytes` are refused with, as "code path:". */
params_refusal(types: []const Type, bytes: []const u8) -> string = decode_params(types, bytes) match
    Ok(_) -> "ok"
    Err(e) -> s"${e.code} ${e.path}:"

starts(s: string, prefix: string) -> bool = s.starts_with(prefix)

@test
two_int64_parameters_are_sixteen_octets()
    val bytes = params_round_trip([Int64, Int64], row_params([[Int(50), Int(3)]]))

    same_bytes(bytes, hex("01 00  32 00 00 00 00 00 00 00  03 00 00 00 00 00 00 00"), "$0 = 50, $1 = 3")

@test
no_parameters_send_one_empty_tuple()
    val bytes = params_round_trip([], no_params())

    same_bytes(bytes, hex("01 00"), "§4.2 rule 3")

@test
no_tuple_is_q4004()
    assert(starts(params_refusal([], hex("00 00").view()), "Q4004 /params"), "tuple_count 0")
    assert_eq(code_of(encode_params([], Params(buf(), buf()))), "Q4004")

@test
a_parameter_batch_of_three_tuples()
    val bytes = params_round_trip([Int64], row_params([[Int(1)], [Int(2)], [Int(3)]]))

    assert_eq(bytes.len(), 2 + 3 * 8)

@test
many_tuples_of_no_parameters()
    val back = decode_params([], hex("05 00").view()).unwrap()
    assert_eq(back.tuples.len(), 5)

@test
every_scalar_and_every_composite_round_trips()
    val point = record([Field("x", Int16), Field("label", nullable(Text))])
    val shape = union_of([Field("dot", record([])), Field("at", point)])
    val types = [Bool, Int8, UInt64, Int128, Float32, Float64, Decimal(38, 10), Text, Bytes, Json, Date,
        Time, Timestamp, Interval, Uuid, nullable(Int32), nullable(Int32), point, shape, shape, list(point), bag(nullable(Text))]

    val values = [Bool(true), Int(-128), UInt(0xffff_ffff_ffff_ffff), Int(-(i128(1) << 126) * 2), Float(1.5), Float(-0.0),
        Int(123456789), Text("héllo"), bytes_value([0, 255]), Text("{\"a\":1}"), Int(-1), Int(86399999999), Int(0),
        Interval(-1, -2, -3), Uuid(0x0123_4567_89ab_cdef_0123_4567_89ab_cdef), Null, Int(7),
        rec([Int(-2), Null]), variant(0, rec([])), variant(1, rec([Int(5), Text("p")])),
        rel([rec([Int(1), Text("a")]), rec([Int(2), Null])]), rel([Null, Text("x"), Null])]

    params_round_trip(types[..], row_params([values[..]]))

@test
a_columnar_relation_round_trips_and_concatenates_its_batches()
    val t = bag(record([Field("id", Int64), Field("name", Text)]))
    val rows = rel([rec([Int(1), Text("a")]), rec([Int(2), Text("b")])])
    val columnar = buf[u64]()
    columnar.push(1)

    val p = Params(columnar, tuples_of([[Int(9), rows]]))
    val bytes = params_round_trip([Int64, t], p)

    // The empty relation is batch_count 0.
    params_round_trip([Int64, t], Params(columnar, tuples_of([[Int(9), rel([])]])))

    // Two batches decode as their rows in order.
    val b1 = encode_batch(t, [rec([Int(1), Text("a")])], 0).unwrap()
    val b2 = encode_batch(t, [rec([Int(2), Text("b")])], 0).unwrap()
    val two = hex("01  01 01  09 00 00 00 00 00 00 00  02")
    push_bin(two, b1.view())
    push_bin(two, b2.view())

    assert(decode_params([Int64, t], two.view()).unwrap() == p, "two batches are the concatenation of their rows")
    assert(bytes.len() < two.len(), "one batch is shorter")

@test
columnar_indices_are_ascending_in_range_and_relations()
    val t = bag(Int64)
    // Indices 1 then 0: not ascending.
    assert(starts(params_refusal([t, t], hex("01 02 01 00").view()), "Q1001 /params:"), "descending")
    // Index 0 twice.
    assert(starts(params_refusal([t, t], hex("01 02 00 00").view()), "Q1001 /params:"), "repeated")
    // Index 2 of two parameters.
    assert(starts(params_refusal([t, t], hex("01 01 02").view()), "Q1001 /params:"), "out of range")
    // A scalar parameter sent columnar.
    assert(starts(params_refusal([Int64], hex("01 01 00").view()), "Q1001 /params:"), "not a relation")

@test
a_bad_columnar_batch_is_q1001_not_w1008()
    val t = bag(Int64)
    val good = encode_batch(t, [Int(1)], 0).unwrap()
    val bytes = hex("01 01 00 01")
    push_bin(bytes, good.view())
    assert_eq(params_refusal([t], bytes.view()), "ok")

    // A batch tagged for tuple 1.
    val tagged = encode_batch(t, [Int(1)], 1).unwrap()
    val wrong_tuple = hex("01 01 00 01")
    push_bin(wrong_tuple, tagged.view())
    assert(starts(params_refusal([t], wrong_tuple.view()), "Q1001 /params/0/0:"), "tuple is 0")

    // Non-zero padding inside the batch: octet 6, after its six header octets 00 01 01 00 01 08.
    val padded = hex("01 01 00 01")
    val broken = octets(good.view())
    broken[6] = 1
    push_bin(padded, broken.view())
    assert(starts(params_refusal([t], padded.view()), "Q1001 /params/0/0:"), "the batch's own defect")

@test
trailing_octets_are_q1001_at_the_last_tuple()
    assert(starts(params_refusal([Int64], hex("01 00 2A 00 00 00 00 00 00 00 FF").view()), "Q1001 /params/0:"), "one tuple")
    assert(starts(params_refusal([Int8], hex("02 00 01 02 FF").view()), "Q1001 /params/1:"), "two tuples")

@test
every_truncation_of_a_parameter_block_is_q1001()
    val types = [Int64, Text, nullable(Int32), list(Int16)]
    val bytes = encode_params(types, row_params([[Int(1), Text("abc"), Int(2), rel([Int(3), Int(4)])]])).unwrap()

    for n in 0..<bytes.len()
        assert_eq(code_of(decode_params(types, bytes.view()[0..<n])), "Q1001")

@test
non_canonical_values_are_q1003_with_their_path()
    // A bool of 2, a nullable tag of 2, a non-minimal text length.
    assert(starts(params_refusal([Int8, Bool], hex("01 00 05 02").view()), "Q1003 /params/0/1:"), "bool 2")
    assert(starts(params_refusal([nullable(Int8)], hex("01 00 02 05").view()), "Q1003 /params/0/0:"), "nullable tag 2")
    assert(starts(params_refusal([Text], hex("01 00 81 00 61").view()), "Q1003 /params/0/0:"), "non-minimal length")

@test
invalid_utf8_is_q1004_and_bad_json_q1007()
    assert(starts(params_refusal([Text], hex("01 00 01 FF").view()), "Q1004 /params/0/0:"), "text")
    assert(starts(params_refusal([Json], hex("01 00 03 7B 20 7D").view()), "Q1007 /params/0/0:"), "{ } is not canonical")
    assert_eq(params_refusal([Json], hex("01 00 02 7B 7D").view()), "ok")

@test
a_path_steps_into_fields_and_elements()
    val t = list(record([Field("a", Int8), Field("b", Bool)]))
    // Element 1's field 1 is a bool of 7.
    assert(starts(params_refusal([t], hex("01 00 02  01 00  02 07").view()), "Q1003 /params/0/0/1/1:"), "into a list of records")

@test
a_discriminant_past_the_union_is_q1001()
    val u = union_of([Field("a", record([])), Field("b", record([]))])
    assert_eq(params_refusal([u], hex("01 00 01").view()), "ok")
    assert(starts(params_refusal([u], hex("01 00 02").view()), "Q1001 /params/0/0:"), "discriminant 2 of 2")

@test
a_count_too_large_for_the_octets_is_refused_before_it_is_looped()
    // A list of 2^40 int64s in a block of a dozen octets, and as many tuples.
    assert(starts(params_refusal([list(Int64)], hex("01 00 80 80 80 80 80 20").view()), "Q1001 /params/0/0:"), "elements")
    assert(starts(params_refusal([Int64], hex("80 80 80 80 80 20 00").view()), "Q1001 /params:"), "tuples")
    // Empty records take no octets, so a large count of them is real.
    val back = decode_params([list(record([]))], hex("01 00 E8 07").view()).unwrap()
    assert(back.tuples[0][0] match
        Relation(e) -> e.len() == 1000
        _ -> false, "a thousand empty records")

@test
an_unresolved_catalog_type_is_refused()
    assert_eq(code_of(decode_params([Named("app", "money")], hex("01 00 00").view())), "Q1001")
