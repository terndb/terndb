module sh.sysl.terndb
@tests

import sysl.buf.{Buf, buf}
import sysl.container.{Set, set}
import sysl.fs.{entries, exists}
import sysl.path.join
import sysl.text.from_utf8

// `docs/spec/errors.md` is the one registry of error codes. These tests embed it, parse its rows, and
// hold the implementation to it: every code the sources name in a string literal is a registered,
// live code, and the names and retryability the implementation carries are the registry's.

/** One registry row: the code, its snake_case name, the area letter of the section it sits in, whether
 * it is withdrawn, and (for a `T`, `W` or `S` row) whether its R column says the request may be re-run.
 */
struct RegistryRow
    code: string
    name: string
    area: string
    withdrawn: bool
    retryable: bool

/** One source file of the package, by name, as embedded. */
struct SourceText
    file: string
    text: []const u8

/** A code a source names, and the first file that does. */
struct Raised
    code: string
    file: string

private src(out: Buf[SourceText], file: string, text: []const u8) = out.push(SourceText(file, text))

/** Every non-test source file of the package. `embed` takes only a literal path, so a new source file
 * is added here, and `every_source_file_of_the_package_is_listed_in_sources` fails until it is.
