module sh.sysl.terndb_bench

import sysl.buf.{Buf, buf}
import sysl.text.{join, replace_all}

// The data set, generated the same for every engine from the row's own key, so any table can be
// rebuilt row for row without keeping it: a value is a hash of (table, key, column). A scale is the
// number of orders; the other tables are sized from it.

/** A value sent to an engine: a parameter, or one field of a generated row. */
enum Arg derives Eq
    ANull
    AInt(n: long)
    AReal(x: real)
    AText(s: string)

/** splitmix64's finaliser: a well-mixed 64-bit hash of `x`. */
mix(x: u64) -> u64
    var z = x + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z ^ (z >> 31)

/** A value in `0..<n` drawn from (`table`, `key`, `column`). */
draw(table: u64, key: long, column: u64, n: u64) -> long = long(mix(mix(table * 1000003 + column) ^ u64(key)) % n)

const Cities: [20]string = ["oslo", "rome", "lima", "kyiv", "doha", "baku", "riga", "bern", "suva", "apia",
    "male", "lome", "nuuk", "pune", "kobe", "graz", "cork", "bonn", "nice", "turin"]
const Statuses: [4]string = ["new", "paid", "shipped", "returned"]
const Categories: [12]string = ["books", "games", "tools", "garden", "music", "toys", "food", "shoes", "bags",
    "lamps", "paint", "tea"]

struct Scale
    name: string
    orders: long

    users(self) -> long = self.orders / 10
    products(self) -> long = 1000
    lines(self) -> long = self.orders * 2
    emps(self) -> long = self.orders / 10

/** The scales a run may name. */
scale_named(name: string) -> Option[Scale] = name match
    "XS" -> Some(Scale("XS", 1000))
    "S" -> Some(Scale("S", 10000))
    "M" -> Some(Scale("M", 100000))
    "L" -> Some(Scale("L", 1000000))
    _ -> None

/** The tables, each with its DDL. One text serves all three engines: TernDB's SQL reads `bigint`,
 * `text` and `double precision` as PostgreSQL and DuckDB do.
 */
const Tables: [5]string = ["users", "products", "orders", "lines", "emps"]

table_ddl(table: string) -> string = table match
    "users" -> "create table users (id bigint primary key, name text not null, city text not null, age bigint not null, score double precision not null)"
    "products" -> "create table products (id bigint primary key, name text not null, category text not null, price bigint not null)"
    "orders" -> "create table orders (id bigint primary key, user_id bigint not null, amount bigint not null, status text not null, day bigint not null, note text)"
    "lines" -> "create table lines (id bigint primary key, order_id bigint not null, product_id bigint not null, qty bigint not null)"
    "emps" -> "create table emps (id bigint primary key, parent_id bigint, name text not null)"
    _ -> ""

/** How many rows `table` has at scale `s`. */
table_rows(s: Scale, table: string) -> long = table match
    "users" -> s.users()
    "products" -> s.products()
    "orders" -> s.orders
    "lines" -> s.lines()
    "emps" -> s.emps()
    _ -> 0

/** Row `id` (from 1) of `table` at scale `s`. */
row(s: Scale, table: string, id: long) -> Buf[Arg]
    val r = buf[Arg]()
    r.push(AInt(id))
    table match
        "users" ->
            r.push(AText(s"user$id"))
            r.push(AText(Cities[usize(draw(1, id, 1, 20))]))
            r.push(AInt(18 + draw(1, id, 2, 63)))
            r.push(AReal(real(draw(1, id, 3, 100000)) / 100.0))
        "products" ->
            r.push(AText(s"product$id"))
            r.push(AText(Categories[usize(draw(2, id, 1, 12))]))
            r.push(AInt(100 + draw(2, id, 2, 9901)))
        "orders" ->
            r.push(AInt(1 + draw(3, id, 1, u64(s.users()))))
            r.push(AInt(1 + draw(3, id, 2, 100000)))
            r.push(AText(Statuses[usize(draw(3, id, 3, 4))]))
            r.push(AInt(draw(3, id, 4, 365)))
            r.push(if draw(3, id, 5, 10) == 0 then ANull else AText(s"note$id"))
        "lines" ->
            r.push(AInt(1 + (id - 1) / 2))
            r.push(AInt(1 + draw(4, id, 1, 1000)))
            r.push(AInt(1 + draw(4, id, 2, 10)))
        "emps" ->
            r.push(if id == 1 then ANull else AInt((id - 2) / 4 + 1))
            r.push(AText(s"emp$id"))
        _ -> ()
    r

/** `a` as an SQL constant. Generated text never holds a quote, but one is doubled all the same. */
sql_literal(a: Arg) -> string = a match
    ANull -> "NULL"
    AInt(n) -> n.to_string()
    AReal(x) -> real_literal(x)
    AText(s) -> "'" + replace_all(s, "'", "''") + "'"

/** A float as a constant every engine reads back as the same double: its shortest round-trip text,
 * always with a point, so no engine takes it for an integer.
 */
real_literal(x: real) -> string
    val t = x.to_string()
    for b in t.bytes
        if b == u8('.') || b == u8('e') || b == u8('E') || b == u8('n') || b == u8('N') then return t
    t + ".0"

/** One multi-row `INSERT` of rows `from` through `to` of `table`. */
insert_sql(s: Scale, table: string, from: long, to: long) -> string
    var parts = buf[string]()
    for id in from..to
        val cells = buf[string]()
        for a in row(s, table, id)
            cells.push(sql_literal(a))
        parts.push("(" + join(cells.view(), ", ") + ")")
    s"insert into $table values " + join(parts.view(), ", ")

/** Rows `from` through `to` of `table` in PostgreSQL's COPY text format. */
copy_text(s: Scale, table: string, from: long, to: long) -> string
    var lines = buf[string]()
    for id in from..to
        val cells = buf[string]()
        for a in row(s, table, id)
            cells.push(a match
                ANull -> "\\N"
                AInt(n) -> n.to_string()
                AReal(x) -> real_literal(x)
                AText(t) -> t)
        lines.push(join(cells.view(), "\t"))
    join(lines.view(), "\n") + "\n"
