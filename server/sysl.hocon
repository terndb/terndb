// The `terndb` server program: the command line over `sh.sysl.terndb`'s `Server`
// (`docs/design/engine.md` § The server). The library beside it is its one dependency.
package {
  name    = "terndb"
  version = "0.0.1"
  sysl    = "0.11.0"
}

requires {
  os    = true
  heap  = true
  posix = true
  libc  = true
}

dependencies {
  terndb { path = ".." }
}
